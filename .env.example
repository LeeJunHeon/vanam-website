# ─────────────────────────────────────────────────────────────
# VANAM 환경변수 목록 (0252 — 코드가 실제로 읽는 변수 전수)
# - 실제 값이 담긴 .env 는 절대 커밋하지 않는다 (.gitignore 등록 — 공개 저장소)
# - 로컬 개발: 이 파일을 .env 로 복사해 값을 채우면 dev 서버에서 동작한다
# - Cloudflare 배포: Settings > Variables and Secrets 에 같은 이름으로 등록
#   ⚠️ 전부 'Secret' 타입으로 등록한다 (Text 는 대시보드에 평문 노출).
#   ⚠️ 변수명은 복붙하지 말고 손으로 입력 — 이름 끝 공백(PAYPAL_ENV␣ 사고)이
#      조용한 미설정을 만든다.
# - D1 은 환경변수가 아니라 wrangler.jsonc 의 binding "DB"(vanam-orders) 로 연결된다
# ─────────────────────────────────────────────────────────────

# 알림 — Google Chat 웹훅 (미설정 시 전송 생략·서버 콘솔 출력만)
# Cloudflare main 빌드에서만 발송 — 로컬·개발 빌드는 코드에서 차단 (src/lib/chat-mode.js · chat-send.ts)
GOOGLE_CHAT_WEBHOOK=""

# 관리자 로그인 비밀번호 (16자 이상 필수 — admin-auth.ts 의 adminConfigured 가 강제)
ADMIN_PASSWORD=""

# 세션 쿠키 서명 키 — 비밀번호와 반드시 분리. `openssl rand -base64 32` 로 생성.
# 미설정 시 ADMIN_PASSWORD 로 폴백하며 경고 로그가 남는다(쿠키 유출 시 취약).
SESSION_SECRET=""

# 봇 차단 — Cloudflare Turnstile 서버 시크릿 (미설정 시 검증 생략 = fail-open 설계)
# 사이트 키는 공개값이라 클라이언트 코드에 하드코딩되어 있다.
TURNSTILE_SECRET=""

# 견적 요청 접수 확인 메일 — Gmail API(hello@vanam.co.kr 계정, 'gmail.send' 보내기 전용 권한)
# Cloudflare main 빌드만 고객 주소로 발송 — 그 밖의 빌드는 @vanam.co.kr 주소로만 (src/lib/mail-mode.js · mail-send.ts)
# 미설정이면 메일을 보내지 않는다(접수는 그대로 · 관리자 견적 탭에 '메일 설정 없음').
# ⚠️ hello@ 의 비밀번호를 바꾸면 새로고침 토큰이 무효가 된다 — 권한을 다시 승인해 새 토큰을 넣는다.
# ⚠️ OAuth 동의 화면은 '내부(Internal)'로 만든다 — '외부 + 테스트' 상태면 새로고침 토큰이 7일 뒤 만료된다.
# 맥미니 테스트(npm run local)는 이 파일이 아니라 ~/vanam-data/local.vars 에 같은 이름으로 넣는다.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# 확인 메일 첨부 PDF(견적 요청서·예상 견적서) — Cloudflare Browser Run(무료: 하루 10분 · 10초에 1건)
# CF_BROWSER_TOKEN 은 'Browser Rendering - Edit' 권한 하나만 준 API 토큰. 미설정이면 PDF 없이 조회 링크만 보낸다.
CF_ACCOUNT_ID=""
CF_BROWSER_TOKEN=""

# 결제 — PayPal (live · USD 국제결제 전용)
PAYPAL_ENV="live"
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_WEBHOOK_ID=""
