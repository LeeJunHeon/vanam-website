---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "About | VANAM";
const description = "VanaM(반암) is a deep-tech startup developing next-generation semiconductor thin films via an eco-friendly vacuum deposition process. Vision, team, history, and collaborations.";

const team = ['Dr. SD HAN','Dr. WY CHOI','Dr. S AYACHI','Dr. HK SONG','DH YU','BH LEE'];

const history = [
  { year: '2022', items: ['Established VanaM Inc.','Selected for the Initial Startup Package pilot R&D (Ministry of SMEs and Startups)','Named top company, 10th Kibo Venture Camp (KOTEC)'] },
  { year: '2023', items: ['Began an urban semiconductor pilot line in Yeongdeungpo, Seoul','Established a corporate-affiliated research institute'] },
  { year: '2024', items: ['Selected as a Deep-Tech Startup, System Semiconductor Division (Ministry of SMEs and Startups)'] },
  { year: '2025', items: ['SelectUSA 2025 — 2nd place, Open Tech Pitching (National Harbor, MD)','NextCorps Luminate Accelerator, Cohort 8 (Rochester, NY)','PEN CIS US-APAC Venture Summit 2025'] },
];

const achievements = ['CES 2024','AWS Startup Growth Program','NANO Korea 2024','HKTDC Hong Kong Electronics Fair','SEDEX (COEX, Seoul)','Electronica 2024 (Munich)','MRS Fall Meeting (Boston)','CES 2025'];

const partners = ['KIST','Seoul National Univ.','Korea Univ.','Hanyang Univ.','Inha Univ.','Univ. of Cambridge','IBK','KIBO','Amazon (AWS)','RayVac'];

function initials(name){ const p = name.replace('Dr. ','').split(' '); return (p[0][0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
---
<BaseLayout title={title} description={description}>
  <script is:inline>document.documentElement.classList.add('reveal-on')</script>

  <section class="relative mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-[#1EBBF0]">About VANAM</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-white md:text-6xl">Thin Films,<br/>All Around</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60">
        VanaM is a deep-tech startup developing and manufacturing next-generation semiconductor thin films that have yet to be commercialized — built on proprietary technology and core IP, powered by an eco-friendly vacuum deposition process.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="v-reveal grid gap-10 md:grid-cols-3">
      <div class="md:col-span-1"><h2 class="text-2xl font-bold text-white">Company</h2></div>
      <div class="md:col-span-2 space-y-5 text-base leading-relaxed text-white/65">
        <p>We possess innovative proprietary technology and core IP for producing high-performance semiconductor thin films, based on an eco-friendly vacuum deposition process.</p>
        <p>We have constructed an <span class="text-white">urban micro foundry</span> — a semi-cleanroom-level urban fab — enabling rapid thin-film R&amp;D and small-scale production close to our partners.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-[#1EBBF0]">Vision</p>
        <p class="mt-5 text-2xl font-semibold leading-snug text-white md:text-3xl">
          Connect the next world with semiconductor materials — localizing new materials and components, and leading the industry.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-white">Team</h2>
      <p class="mt-3 max-w-2xl text-base text-white/55">
        Ph.D.-level semiconductor researchers, IP &amp; patent attorneys, and facility engineers — combining deep expertise across thin-film materials, intellectual property, and fab construction.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {team.map((name) => (
        <div class="v-reveal rounded-xl border border-white/10 bg-white/[0.03] p-5 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#1EBBF0]/15 text-sm font-bold text-[#1EBBF0]">{initials(name)}</div>
          <p class="mt-4 text-sm font-semibold text-white">{name}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal"><h2 class="text-2xl font-bold text-white">History</h2></div>
      <div class="mt-12 space-y-12">
        {history.map((h) => (
          <div class="v-reveal grid gap-6 md:grid-cols-[120px_1fr]">
            <div class="text-3xl font-bold text-[#1EBBF0]">{h.year}</div>
            <ul class="space-y-3 border-l border-white/10 pl-6">
              {h.items.map((it) => (
                <li class="relative text-base text-white/70">
                  <span class="absolute -left-[1.65rem] top-2 h-2 w-2 rounded-full bg-[#1EBBF0]"></span>
                  {it}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal">
        <h2 class="text-2xl font-bold text-white">Global Activity</h2>
        <p class="mt-3 text-base text-white/55">Exhibitions, conferences, and accelerator programs worldwide.</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {achievements.map((a) => (
          <span class="v-reveal rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-white/70">{a}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal"><h2 class="text-2xl font-bold text-white">Collaboration</h2></div>
    <div class="v-reveal mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {partners.map((p) => (
        <div class="flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-6 text-center text-sm font-medium text-white/60">{p}</div>
      ))}
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <div class="v-reveal">
        <h2 class="text-3xl font-bold text-white md:text-4xl">Let's build what's next.</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-white/60">Partnership, supply, or technical collaboration — we're ready to talk.</p>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-[#1EBBF0] px-7 py-3 font-semibold text-[#06222C] transition hover:brightness-110">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .v-reveal { opacity: 1; transform: none; }
  .reveal-on .v-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
  .reveal-on .v-reveal.is-visible { opacity: 1; transform: none; }
</style>
<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.v-reveal').forEach((el) => obs.observe(el));
</script>
