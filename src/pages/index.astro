---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  { title: 'Customized R&D', desc: '기존 공정으로 구현하기 어려운 특수 박막과 증착 공정 조건을 맞춤형으로 개발합니다.' },
  { title: 'Analysis & Measurements', desc: '박막 물성 분석과 측정으로 공정 최적화와 신뢰성 검증을 지원합니다.' },
  { title: 'Simulation for Materials', desc: '소재 시뮬레이션으로 박막 설계와 공정 개발의 시행착오를 줄입니다.' },
];
const materials = ['VO₂','V₂O₅','TiO₂','Ta₂O₅','HfO₂','ZnO','ITO','IGZO','TiN','AlN','Al₂O₃','ZrO₂','HZO'];
const history = [
  { y: '2022', t: 'VanaM 설립 · 초기창업패키지 선정 · 키보벤처캠프 최우수' },
  { y: '2023', t: '영등포 파일럿 라인 착공 · 부설연구소 설립 · 딥테크 선정' },
  { y: '2024', t: 'CES 2024 · NANO Korea · Electronica Munich · MRS Boston' },
  { y: '2025', t: 'CES 2025 · SelectUSA 2025 피칭 2위 · Luminate Cohort 8' },
];
---

<BaseLayout>
  <section class="relative flex min-h-[88vh] items-center overflow-hidden px-6">
    <div class="vn-grid absolute inset-0"></div>
    <div class="vn-glow-a absolute -left-20 -top-24 h-[420px] w-[480px] rounded-full"></div>
    <div class="vn-glow-b absolute -bottom-32 -right-16 h-[380px] w-[420px] rounded-full"></div>
    <div class="relative mx-auto w-full max-w-6xl">
      <p class="mb-5 font-mono text-xs tracking-[0.25em] text-[#1EBBF0]">VANA&nbsp;MATERIALS&nbsp;LAB.</p>
      <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl">Thin Films,<br />All Around</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/60">친환경 진공 증착 기술로 만드는<br />차세대 반도체 박막 소재</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/technology" class="rounded-full bg-[#1EBBF0] px-6 py-3 text-sm font-semibold text-[#04212E] transition hover:bg-[#5fd0f5]">기술 살펴보기 →</a>
        <a href="/contact" class="rounded-full border border-white/25 px-6 py-3 text-sm font-medium text-white/85 transition hover:border-white hover:text-white">문의하기</a>
      </div>
    </div>
    <div class="vn-bounce absolute bottom-7 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1">
      <span class="font-mono text-[10px] tracking-widest text-white/50">SCROLL</span>
      <span class="text-white/60">↓</span>
    </div>
  </section>

  <section class="vn-reveal mx-auto max-w-6xl px-6 py-20">
    <p class="mb-3 font-mono text-xs tracking-[0.16em] text-[#1EBBF0]">01 / VISION</p>
    <h2 class="mb-5 text-3xl font-semibold text-white">Company Vision</h2>
    <p class="max-w-2xl text-base leading-relaxed text-white/65">VanaM은 혁신적인 증착 소스 기술과 핵심 IP를 기반으로, 아직 상용화되지 않은 차세대 박막 소재를 개발합니다. AI 반도체·양자컴퓨팅·전력반도체 등 딥테크 분야에 필요한 신소재 박막을 만들고, 서울에 친환경 마이크로 파운드리를 구축하고 있습니다.</p>
  </section>

  <section class="vn-reveal mx-auto max-w-6xl px-6 py-12">
    <p class="mb-6 font-mono text-xs tracking-[0.16em] text-[#1EBBF0]">02 / CORE TECHNOLOGIES</p>
    <div class="grid gap-5 sm:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-2xl border border-white/10 bg-white/[0.035] p-6 transition hover:border-[#1EBBF0]/50">
          <h3 class="text-lg font-medium text-white">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/55">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="vn-reveal mx-auto max-w-6xl px-6 py-12">
    <p class="mb-5 font-mono text-xs tracking-[0.16em] text-[#1EBBF0]">03 / MATERIALS</p>
    <div class="flex flex-wrap gap-2">
      {materials.map((m) => (
        <span class="rounded-md border border-[#1EBBF0]/25 bg-[#1EBBF0]/[0.08] px-3 py-1.5 font-mono text-sm text-[#9BDDF5]">{m}</span>
      ))}
    </div>
  </section>

  <section class="vn-reveal mx-auto max-w-6xl px-6 py-12">
    <p class="mb-6 font-mono text-xs tracking-[0.16em] text-[#1EBBF0]">04 / HISTORY</p>
    <div class="divide-y divide-white/10">
      {history.map((h) => (
        <div class="flex gap-5 py-4">
          <span class="w-14 shrink-0 font-mono text-sm text-[#1EBBF0]">{h.y}</span>
          <span class="text-sm text-white/70">{h.t}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="vn-reveal mx-auto max-w-6xl px-6 py-16">
    <div class="relative overflow-hidden rounded-3xl border border-[#1EBBF0]/20 bg-[#0C1320] px-8 py-14 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">함께 만들 박막 솔루션</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/60">맞춤형 박막 R&D · 분석/측정 · 파운드리 서비스에 대해 문의해 주세요.</p>
      <a href="/contact" class="mt-8 inline-block rounded-full bg-[#1EBBF0] px-7 py-3 text-sm font-semibold text-[#04212E] transition hover:bg-[#5fd0f5]">문의하기 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .vn-grid {
    background-image:
      linear-gradient(rgba(30,187,240,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(30,187,240,0.06) 1px, transparent 1px);
    background-size: 42px 42px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
  }
  .vn-glow-a { background: radial-gradient(circle, rgba(30,187,240,0.20), transparent 70%); animation: vnDriftA 14s ease-in-out infinite; }
  .vn-glow-b { background: radial-gradient(circle, rgba(90,80,220,0.15), transparent 70%); animation: vnDriftB 16s ease-in-out infinite; }
  @keyframes vnDriftA { 0%,100% { transform: translate(0,0); } 50% { transform: translate(46px,26px); } }
  @keyframes vnDriftB { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-38px,-20px); } }
  .vn-bounce { animation: vnBounce 1.8s ease-in-out infinite; }
  @keyframes vnBounce { 0%,100% { transform: translate(-50%,0); opacity: .7; } 50% { transform: translate(-50%,7px); opacity: 1; } }
  .vn-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
  .vn-reveal.vn-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .vn-glow-a, .vn-glow-b, .vn-bounce { animation: none; }
    .vn-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('vn-in'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.vn-reveal').forEach((el) => io.observe(el));
</script>
