---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page not found | VanaM"
  description="The page you are looking for could not be found. 요청하신 페이지를 찾을 수 없습니다."
>
  <section class="relative flex min-h-[72vh] items-center justify-center overflow-hidden px-6 py-24">
    <!-- 배경 글로우 (자체 완결형) -->
    <div class="pointer-events-none absolute -left-24 top-8 h-[380px] w-[440px] rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-16 h-[320px] w-[380px] rounded-full bg-accent/[0.07] blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-xl text-center">
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-accent">Error 404</p>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Page not found</h1>
      <p class="mt-2 text-lg text-ink/70">페이지를 찾을 수 없습니다</p>
      <p class="mt-6 text-sm leading-relaxed text-ink/55">
        The page may have been moved, renamed, or no longer exists.<br />
        주소가 변경되었거나 삭제된 페이지입니다.
      </p>
      {/* 두 버튼은 '주 동작 / 보조 동작'이 아니라 **대등한 언어 선택**이다.
          한쪽만 채움 버튼(파란색)이면 그쪽이 권장 선택처럼 보여 어색하다 → 둘 다 보조 버튼으로. */}
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="v-btn-ghost-sm">Home (English)</a>
        <a href="/ko/" class="v-btn-ghost-sm">홈으로 (한국어)</a>
      </div>
    </div>
  </section>
</BaseLayout>
