---
// VanaM 관리자 — 견적·문의 관리
// 접근: 비밀번호 (Cloudflare 워커 Secret: ADMIN_PASSWORD)
// 도메인이 붙으면 Cloudflare Access(구글 로그인)로 전환 권장.
export const prerender = false;

import '../../styles/global.css';
import { isAdmin, adminConfigured } from '../../lib/admin-auth';
import { db } from '../../lib/db';

const authed = await isAdmin(Astro.request);
const configured = adminConfigured();

type Row = {
  id: string; type: string; status: string;
  name: string; email: string; phone: string | null; company: string | null;
  message: string | null;
  product_sku: string | null; product_name: string | null;
  material: string | null; method: string | null; substrate: string | null;
  thickness: string | null; quantity: string | null; deadline: string | null;
  details: string | null;
  quoted_amount: number | null; quote_currency: string | null; quote_note: string | null;
  locale: string | null; created_at: string; updated_at: string | null;
};

let quotes: Row[] = [];
let generals: Row[] = [];
let orders: Row[] = [];
const orderItems: Record<string, { name: string; qty: number; subtotal: number }[]> = {};
let dbError = '';

if (authed) {
  const d = await db();
  if (!d) {
    dbError = 'D1 데이터베이스가 연결되지 않았습니다. (로컬 dev에서는 동작하지 않습니다 — 배포된 사이트에서 확인하세요)';
  } else {
    try {
      const { results } = await d
        .prepare(`SELECT * FROM inquiries ORDER BY created_at DESC LIMIT 300`)
        .all<Row>();
      quotes = results.filter((r) => r.type === 'quote');
      generals = results.filter((r) => r.type === 'general');

      const o = await d
        .prepare(`SELECT * FROM orders ORDER BY created_at DESC LIMIT 300`)
        .all<Row>();
      orders = o.results;

      // 주문 항목을 주문번호별로 묶어둔다
      const it = await d
        .prepare(
          `SELECT oi.order_id, oi.name, oi.qty, oi.subtotal
             FROM order_items oi
             JOIN orders o ON o.id = oi.order_id
            ORDER BY o.created_at DESC`,
        )
        .all<{ order_id: string; name: string; qty: number; subtotal: number }>();
      for (const r of it.results) {
        (orderItems[r.order_id] ??= []).push(r);
      }
    } catch (e) {
      dbError = `조회 실패: ${e}`;
    }
  }
}

// 주문 상태 (결제 연동 전에는 관리자가 통장을 확인하고 '결제 완료'로 바꾼다)
// 배지 표시용 전체 목록 (paid·refunded 는 결제/환불 경로가 기록하며 관리자가 고를 수 없다)
const ORDER_STATUS: { value: string; label: string; color: string }[] = [
  { value: 'pending',   label: '결제 대기', color: 'border-warn/30 bg-warn/10 text-warn' },
  { value: 'paid',      label: '결제 완료', color: 'border-accent/30 bg-accent/10 text-accent' },
  { value: 'preparing', label: '제작 중',   color: 'border-info/30 bg-info/10 text-info' },
  { value: 'shipped',   label: '발송 완료', color: 'border-ok/30 bg-ok/10 text-ok' },
  { value: 'done',      label: '완료',      color: 'border-ok/30 bg-ok/10 text-ok' },
  { value: 'cancelled', label: '취소',      color: 'border-ink/10 bg-ink/5 text-ink/40' },
  { value: 'refunded',  label: '환불',      color: 'border-ink/10 bg-ink/5 text-ink/40' },
];
const ORDER_LABEL = Object.fromEntries(ORDER_STATUS.map((s) => [s.value, s.label]));
const ORDER_COLOR = Object.fromEntries(ORDER_STATUS.map((s) => [s.value, s.color]));
// 관리자가 직접 지정할 수 있는 진행 상태만 추린다.
const ORDER_EDITABLE = ORDER_STATUS.filter((s) => ['preparing', 'shipped', 'done', 'cancelled'].includes(s.value));

const won = (n: number | null) => (n == null ? '—' : `₩${n.toLocaleString('ko-KR')}`);
// Cloudflare Workers 는 UTC 로 동작하므로 getHours() 등이 9시간 어긋난다.
// 표시 기준을 한국 시간으로 못 박는다.
const when = (v: string) => {
  const d = new Date(v);
  if (Number.isNaN(d.getTime())) return v;
  return d.toLocaleString('ko-KR', {
    timeZone: 'Asia/Seoul',
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', hour12: false,
  });
};
const STATUS_KO: Record<string, string> = {
  new: '신규', quoted: '견적 발송', replied: '회신 완료', paid: '결제 완료', closed: '종료',
};
const STATUS_COLOR: Record<string, string> = {
  paid: 'bg-ok/15 text-ok border-ok/30',
  new: 'bg-accent/15 text-accent border-accent/30',
  quoted: 'bg-warn/15 text-warn border-warn/30',
  replied: 'bg-ok/15 text-ok border-ok/30',
  closed: 'bg-ink/5 text-ink/40 border-ink/10',
};

const spec = (r: Row) =>
  [
    r.material && `소재 ${r.material}`,
    r.method && `방식 ${r.method}`,
    r.substrate && `기판 ${r.substrate}`,
    r.thickness && `두께 ${r.thickness}`,
    r.quantity && `수량 ${r.quantity}`,
    r.deadline && `납기 ${r.deadline}`,
  ].filter(Boolean).join(' · ');
---

<html lang="ko" class="bg-canvas">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>VanaM 관리자</title>
    <link rel="icon" href="/favicon.ico" />
    <!-- global.css 를 쓰면 :root{color-scheme:dark} 등 전역 규칙을 그대로 상속받는다 -->
    <!--
      테마 초기화: 스타일보다 먼저 실행돼야 FOUC(다크→라이트 번쩍임)가 없다.
      메인 사이트(BaseLayout)와 같은 'vanam-theme' 키를 공유하므로,
      사이트에서 고른 테마가 /admin 에도 그대로 이어진다.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('vanam-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">

    {!authed ? (
      <!-- ── 로그인 ─────────────────────────────────── -->
      <main class="flex min-h-screen items-center justify-center px-6">
        <div class="w-full max-w-sm">
          <h1 class="text-2xl font-bold">VanaM 관리자</h1>
          {configured ? (
            <>
              <p class="mt-2 text-sm text-ink/50">비밀번호를 입력하세요.</p>
              <form id="login-form" class="mt-8 space-y-4">
                <input id="pw" type="password" autocomplete="current-password" required
                  class="w-full rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-ink outline-none transition focus:border-accent"
                  placeholder="비밀번호" />
                <button type="submit"
                  class="w-full rounded-lg bg-brand px-4 py-3 font-semibold text-onbrand transition hover:brightness-110">
                  로그인
                </button>
                <p id="login-err" class="text-sm text-danger"></p>
              </form>
            </>
          ) : (
            <div class="mt-6 rounded-lg border border-warn/30 bg-warn/10 p-4 text-sm leading-relaxed text-warn">
              <p class="font-semibold">관리자 비밀번호가 설정되지 않았습니다.</p>
              <p class="mt-2 text-warn/80">
                Cloudflare 워커 → Settings → Variables and secrets 에서
                <code class="rounded bg-ink/[0.07] px-1">ADMIN_PASSWORD</code> 를
                <b>Secret</b> 타입으로 등록한 뒤 재배포하세요. (16자 이상)
              </p>
            </div>
          )}
        </div>
      </main>
    ) : (
      <!-- ── 대시보드 ───────────────────────────────── -->
      <main class="mx-auto max-w-7xl px-6 py-10">
        <header class="flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 pb-6">
          <div>
            <h1 class="text-2xl font-bold">VanaM 관리자</h1>
            <p class="mt-1 text-sm text-ink/45">주문 {orders.length}건 · 견적 {quotes.length}건 · 문의 {generals.length}건</p>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="theme-toggle"
              type="button"
              aria-label="라이트 / 다크 테마 전환"
              class="rounded-md p-2 text-ink/60 transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
              </svg>
            </button>
            <button id="logout" class="rounded-lg border border-ink/15 px-4 py-2 text-sm text-ink/60 transition hover:border-ink/40 hover:text-ink">
              로그아웃
            </button>
          </div>
        </header>

        {dbError && (
          <div class="mt-6 rounded-lg border border-danger/30 bg-danger/10 p-4 text-sm text-danger">{dbError}</div>
        )}

        {/* 탭 — 주문·견적·문의·설정. 데이터는 한 번에 조회되므로 전환은 즉시 이뤄진다. */}
        <nav class="mt-8 flex flex-wrap gap-1 border-b border-ink/10" role="tablist">
          <button type="button" data-tab="orders" role="tab"
            class="admin-tab rounded-t-lg px-4 py-2.5 text-sm font-medium transition">
            주문 <span class="ml-1 text-xs opacity-60">{orders.length}</span>
          </button>
          <button type="button" data-tab="quotes" role="tab"
            class="admin-tab rounded-t-lg px-4 py-2.5 text-sm font-medium transition">
            견적 <span class="ml-1 text-xs opacity-60">{quotes.length}</span>
          </button>
          <button type="button" data-tab="generals" role="tab"
            class="admin-tab rounded-t-lg px-4 py-2.5 text-sm font-medium transition">
            문의 <span class="ml-1 text-xs opacity-60">{generals.length}</span>
          </button>
          <button type="button" data-tab="settings" role="tab"
            class="admin-tab rounded-t-lg px-4 py-2.5 text-sm font-medium transition">
            설정
          </button>
        </nav>

        <!-- ── 설정: 환율 ───────────────────────────────── -->
        <!-- 환율의 진실원은 이 화면 하나다(Keystatic 에는 환율 항목이 없다). -->
        <section class="mt-8" data-panel="settings" hidden>
          <div class="rounded-xl border border-ink/10 bg-ink/[0.02] p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg font-semibold text-accent">환율 (USD/KRW)</h2>
              <div class="flex items-center gap-2">
                <button id="fx-refresh" type="button"
                  class="rounded-lg border border-ink/15 px-3 py-1.5 text-sm text-ink/70 transition hover:border-accent hover:text-accent">
                  지금 갱신
                </button>
              </div>
            </div>

            <dl id="fx-body" class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
              <div class="flex justify-between border-b border-ink/10 py-2">
                <dt class="text-ink/50">현재 환율</dt>
                <dd id="fx-rate" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex justify-between border-b border-ink/10 py-2">
                <dt class="text-ink/50">적용 방식</dt>
                <dd id="fx-mode" class="text-ink/90">—</dd>
              </div>
              <div class="flex justify-between border-b border-ink/10 py-2">
                <dt class="text-ink/50">갱신 시각</dt>
                <dd id="fx-updated" class="text-ink/90">—</dd>
              </div>
              <div class="flex justify-between border-b border-ink/10 py-2">
                <dt class="text-ink/50">출처</dt>
                <dd id="fx-source" class="text-ink/90">—</dd>
              </div>
            </dl>

            <div class="mt-4 flex flex-wrap items-end gap-3">
              <label class="text-sm">
                <span class="block text-ink/50">방식</span>
                <select id="fx-mode-sel" class="mt-1 rounded-lg border border-ink/15 bg-canvas px-3 py-1.5 text-sm">
                  <option value="auto">자동 (실시간 시장 환율)</option>
                  <option value="manual">수동 (아래 값 고정)</option>
                </select>
              </label>
              <label class="text-sm">
                <span class="block text-ink/50">수동 환율 (원/$)</span>
                <input id="fx-rate-in" type="number" min="500" max="5000" step="0.01" placeholder="예: 1450"
                  class="mt-1 w-40 rounded-lg border border-ink/15 bg-canvas px-3 py-1.5 text-sm" />
              </label>
              <button id="fx-save" type="button"
                class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-onbrand transition hover:brightness-110">
                저장
              </button>
              <p id="fx-msg" class="text-sm" role="status" aria-live="polite"></p>
            </div>

            <p class="mt-3 text-xs leading-relaxed text-ink/40">
              자동: 하루 한 번 시장 중간환율을 받아 적용합니다. 방문자 접속 시 갱신되며, 조회에 실패하면 마지막 정상값을 유지합니다.
              직전 값 대비 ±10% 넘게 변동하면 적용을 보류하고 알림을 보냅니다.
              수동: 지정한 값만 사용하고 자동 갱신을 하지 않습니다. 저장 즉시 사이트에 반영됩니다.
            </p>
          </div>
        </section>

        <!-- ── 주문 ─────────────────────────────────────── -->
        <section class="mt-8" data-panel="orders">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-lg font-semibold text-accent">주문</h2>
            <p class="text-xs text-ink/35">
              결제 완료·환불은 <span class="text-ink/60">결제 시스템이 기록</span>합니다. 여기서는 진행 상태만 바꿉니다.
            </p>
          </div>

          {orders.length === 0 ? (
            <p class="mt-4 text-sm text-ink/40">아직 주문이 없습니다.</p>
          ) : (
            <div class="mt-5 space-y-4">
              {orders.map((o) => (
                <article class="rounded-xl border border-ink/10 bg-ink/[0.02] p-5" data-order={o.id}>
                  {/* 1행: 상태 · 날짜 · 구분선 */}
                  <div class="flex items-center gap-3">
                    <span class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium ${
                      o.status === 'pending'
                        ? (o.pay_method === 'bank' ? 'border-warn/30 bg-warn/10 text-warn' : 'border-ink/10 bg-ink/5 text-ink/40')
                        : (ORDER_COLOR[o.status] ?? '')
                    }`}>
                      {o.status === 'pending'
                        ? (o.pay_method === 'bank' ? '입금 대기' : '미결제')
                        : (ORDER_LABEL[o.status] ?? o.status)}
                    </span>
                    <span class="shrink-0 text-xs text-ink/35">{when(o.created_at)}</span>
                    <span class="h-px flex-1 bg-ink/10"></span>
                  </div>

                  {/* 본문 3열: 주문번호(좌) · 주문 정보(중앙) · 금액(우)
                      가운데가 비어 보이지 않도록 상세를 중앙에 배치하고, 각 값에 라벨을 붙인다. */}
                  <div class="mt-3 grid gap-6 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_minmax(0,12rem)]">
                    <div class="min-w-0">
                      <p class="text-xs text-ink/40">주문번호</p>
                      <p class="font-mono text-lg font-bold tracking-tight text-ink">{o.id}</p>
                      {o.inquiry_id && <p class="mt-0.5 font-mono text-xs text-info/60">← {o.inquiry_id}</p>}
                      <p class="mt-3 text-xs text-ink/40">주문 상품</p>
                      <ul class="mt-0.5 space-y-0.5 text-sm">
                        {(orderItems[o.id] ?? []).map((i) => (
                          <li class="text-ink/70">{i.name} <span class="text-ink/35">× {i.qty}</span>
                            <span class="ml-1 text-ink/50">{won(i.subtotal)}</span></li>
                        ))}
                      </ul>
                    </div>

                    <dl class="min-w-0 space-y-1.5 text-sm">
                      <div class="flex gap-3">
                        <dt class="w-20 shrink-0 text-xs text-ink/40">이름 / 소속</dt>
                        <dd class="min-w-0 text-ink/75">{o.buyer_name}{o.buyer_company ? ` / ${o.buyer_company}` : ''}</dd>
                      </div>
                      <div class="flex gap-3">
                        <dt class="w-20 shrink-0 text-xs text-ink/40">이메일</dt>
                        <dd class="min-w-0 break-all">
                          <a href={`mailto:${o.buyer_email}`} class="text-accent hover:underline">{o.buyer_email}</a>
                        </dd>
                      </div>
                      {o.buyer_phone && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">연락처</dt>
                          <dd class="text-ink/75">{o.buyer_phone}</dd>
                        </div>
                      )}
                      {o.needs_shipping ? (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">배송지</dt>
                          <dd class="min-w-0 leading-relaxed text-ink/60">
                            [{o.ship_country}] {o.ship_name} · {o.ship_phone}<br />
                            ({o.ship_zip}) {[o.ship_addr1, o.ship_addr2, o.ship_city, o.ship_state].filter(Boolean).join(', ')}
                          </dd>
                        </div>
                      ) : (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">배송</dt>
                          <dd class="text-ink/40">실물 배송 없음 (분석 서비스)</dd>
                        </div>
                      )}
                      {o.ship_memo && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">배송 요청</dt>
                          <dd class="text-ink/60">{o.ship_memo}</dd>
                        </div>
                      )}
                      {o.desired_date && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">희망일</dt>
                          <dd class="text-ink/60">{o.desired_date}</dd>
                        </div>
                      )}
                      {o.order_note && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">요청사항</dt>
                          <dd class="text-ink/60">{o.order_note}</dd>
                        </div>
                      )}
                      {o.ship_courier_acct && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">착불 계정</dt>
                          <dd class="text-ink/60">{o.ship_courier_acct}</dd>
                        </div>
                      )}
                      {o.tax_invoice === 1 && (
                        <div class="flex gap-3">
                          <dt class="w-20 shrink-0 text-xs text-ink/40">세금계산서</dt>
                          <dd class="min-w-0 leading-relaxed text-ink/60">
                            {o.tax_biz_name} ({o.tax_biz_no}){o.tax_ceo ? ` · 대표 ${o.tax_ceo}` : ''}<br />
                            <span class="text-ink/35">수신</span> {o.tax_email}
                          </dd>
                        </div>
                      )}
                    </dl>

                    <div class="text-right">
                      <p class="text-xs text-ink/40">결제 금액</p>
                      <p class="text-2xl font-bold text-ink">
                        {Number(o.paid_usd) > 0
                          ? <>${Number(o.paid_usd).toFixed(2)} <span class="text-sm font-normal text-ink/40">USD</span></>
                          : Number(o.amount_usd) > 0
                            ? <>${Number(o.amount_usd).toFixed(2)} <span class="text-sm font-normal text-ink/40">USD</span></>
                            : won(o.amount)}
                      </p>
                      {(Number(o.paid_usd) > 0 || Number(o.amount_usd) > 0) && (
                        <p class="mt-0.5 text-xs text-ink/35">{won(o.amount)}</p>
                      )}
                    </div>
                  </div>

                  {/* 처리 */}
                  <div class="mt-4 flex flex-wrap items-center justify-end gap-2 border-t border-ink/10 pt-4">
                    <select name="status" class="rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink">
                      {ORDER_EDITABLE.map((st) => (
                        <option value={st.value} selected={st.value === o.status}>{st.label}</option>
                      ))}
                    </select>
                    <input name="trackingCourier" type="text" placeholder="택배사" value={o.tracking_courier ?? ''}
                      class="w-28 rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink placeholder-ink/30" />
                    <input name="trackingNo" type="text" placeholder="송장번호" value={o.tracking_no ?? ''}
                      class="w-40 rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink placeholder-ink/30" />
                    <button type="button" data-save-order={o.id}
                      class="rounded-lg bg-brand px-5 py-2 text-sm font-semibold text-onbrand transition hover:brightness-110">저장</button>
                    {!o.paid_at && o.pay_method === 'bank' && (
                      <button type="button" data-confirm-deposit={o.id}
                        class="rounded-lg border border-ok/30 px-3 py-2 text-sm font-medium text-ok transition hover:bg-ok/10">입금 확인</button>
                    )}
                    {!o.paid_at && o.status !== 'cancelled' && (
                      <button type="button" data-cancel-order={o.id}
                        class="rounded-lg border border-ink/15 px-3 py-2 text-sm font-medium text-ink/50 transition hover:border-danger/40 hover:text-danger">주문 취소</button>
                    )}
                    {o.paid_at && o.paypal_capture_id && o.status !== 'refunded' && (
                      <button type="button" data-refund={o.id}
                        class="rounded-lg border border-danger/30 px-3 py-2 text-sm font-medium text-danger transition hover:bg-danger/10">환불</button>
                    )}
                  </div>

                  <p class="mt-2 text-right text-sm" data-order-status={o.id} role="status" aria-live="polite"></p>
                </article>
              ))}
            </div>
          )}
        </section>

        <!-- ── 견적 ─────────────────────────────────────── -->
        <section class="mt-8" data-panel="quotes" hidden>
          <h2 class="text-lg font-semibold text-accent">견적 요청</h2>
          {quotes.length === 0 ? (
            <p class="mt-4 text-sm text-ink/40">아직 견적 요청이 없습니다.</p>
          ) : (
            <div class="mt-5 space-y-4">
              {quotes.map((r) => (
                <article class="rounded-xl border border-ink/10 bg-ink/[0.02] p-5">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${STATUS_COLOR[r.status] ?? STATUS_COLOR.closed}`}>
                          {STATUS_KO[r.status] ?? r.status}
                        </span>
                        <span class="font-mono text-xs text-ink/35">{r.id}</span>
                        <span class="text-xs text-ink/35">{when(r.created_at)}</span>
                      </div>
                      <p class="mt-2 text-base font-semibold text-ink">{r.product_name ?? r.product_sku}</p>
                      <p class="mt-1 text-sm text-ink/60">
                        {r.name}{r.company ? ` / ${r.company}` : ''} · <a href={`mailto:${r.email}`} class="text-accent hover:underline">{r.email}</a>{r.phone ? ` · ${r.phone}` : ''}
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="text-xs text-ink/35">견적 금액</p>
                      <p class="text-lg font-bold text-ink">{r.quoted_amount == null ? '—' : (r.quote_currency === 'USD' ? '$' + r.quoted_amount.toLocaleString('en-US', { maximumFractionDigits: 2 }) : '₩' + r.quoted_amount.toLocaleString('ko-KR'))}</p>
                    </div>
                  </div>

                  {spec(r) && <p class="mt-3 text-sm leading-relaxed text-ink/50">{spec(r)}</p>}
                  {r.details && <p class="mt-2 whitespace-pre-line rounded-lg bg-ink/[0.07] p-3 text-sm leading-relaxed text-ink/60">{r.details}</p>}

                  <form class="quote-form mt-4 flex flex-wrap items-end gap-3 border-t border-ink/10 pt-4" data-id={r.id}>
                    <div>
                      <label class="block text-xs text-ink/45">통화</label>
                      <select name="currency"
                        class="mt-1 rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink outline-none focus:border-accent">
                        <option value="KRW" selected={(r.quote_currency ?? 'KRW') === 'KRW'}>₩ 원</option>
                        <option value="USD" selected={r.quote_currency === 'USD'}>$ 달러</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-xs text-ink/45">견적 금액 (부가세 포함)</label>
                      <input name="amount" type="number" min="0" step="any" value={r.quoted_amount ?? ''}
                        class="mt-1 w-44 rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink outline-none focus:border-accent" />
                    </div>
                    <div class="min-w-[16rem] flex-1">
                      <label class="block text-xs text-ink/45">메모</label>
                      <input name="note" type="text" value={r.quote_note ?? ''} placeholder="고객 회신에 넣을 설명"
                        class="mt-1 w-full rounded-lg border border-ink/10 bg-ink/[0.03] px-3 py-2 text-sm text-ink outline-none focus:border-accent" />
                    </div>
                    <button type="submit"
                      class="rounded-lg bg-brand px-5 py-2 text-sm font-semibold text-onbrand transition hover:brightness-110">
                      저장
                    </button>
                    <span class="save-msg text-sm"></span>
                  </form>
                </article>
              ))}
            </div>
          )}
        </section>

        <!-- 일반 문의 -->
        <section class="mt-8" data-panel="generals" hidden>
          <h2 class="text-lg font-semibold text-ink/70">일반 문의</h2>
          {generals.length === 0 ? (
            <p class="mt-4 text-sm text-ink/40">아직 문의가 없습니다.</p>
          ) : (
            <div class="mt-5 space-y-3">
              {generals.map((r) => (
                <article class="rounded-xl border border-ink/10 bg-ink/[0.02] p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-xs text-ink/35">{r.id}</span>
                    <span class="text-xs text-ink/35">{when(r.created_at)}</span>
                  </div>
                  <p class="mt-2 text-sm text-ink/60">
                    <b class="text-ink">{r.name}</b>{r.company ? ` / ${r.company}` : ''} · <a href={`mailto:${r.email}`} class="text-accent hover:underline">{r.email}</a>{r.phone ? ` · ${r.phone}` : ''}
                  </p>
                  <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink/70">{r.message}</p>
                </article>
              ))}
            </div>
          )}
        </section>

      </main>
    )}

    <style>
      /* 탭 — 선택된 것만 강조. 밑줄로 현재 위치를 표시한다. */
      .admin-tab {
        color: color-mix(in srgb, var(--color-ink) 45%, transparent);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
      }
      .admin-tab:hover { color: color-mix(in srgb, var(--color-ink) 75%, transparent); }
      .admin-tab[aria-selected='true'] {
        color: var(--color-accent);
        border-bottom-color: var(--color-accent);
      }
    </style>

    <script>
      // ── 탭 ────────────────────────────────────────────
      // 데이터는 이미 서버에서 모두 받아왔으므로 표시만 전환한다.
      (() => {
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.admin-tab'));
        if (tabs.length === 0) return;
        const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

        const show = (name: string) => {
          for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.tab === name));
          for (const p of panels) p.hidden = p.dataset.panel !== name;
          try { sessionStorage.setItem('vanam_admin_tab', name); } catch (e) { /* 무시 */ }
        };

        for (const t of tabs) t.addEventListener('click', () => show(t.dataset.tab!));

        // 새로고침해도 보던 탭이 유지되도록 (작업 흐름이 끊기지 않게)
        let init = 'orders';
        try {
          const saved = sessionStorage.getItem('vanam_admin_tab');
          if (saved && tabs.some((t) => t.dataset.tab === saved)) init = saved;
        } catch (e) { /* 무시 */ }
        show(init);
      })();

      // ── 환율 ──────────────────────────────────────────
      // 값을 넣는 창구는 이 화면 하나뿐이다(Keystatic 에는 환율 항목이 없다).
      (() => {
        const $ = (id: string) => document.getElementById(id);
        const box = $('fx-body');
        if (!box) return;
        const msg = $('fx-msg')!;
        const sel = $('fx-mode-sel') as HTMLSelectElement;
        const input = $('fx-rate-in') as HTMLInputElement;

        const say = (t: string, ok = true) => {
          msg.textContent = t;
          msg.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
        };

        const ago = (iso: string | null) => {
          if (!iso) return '갱신 기록 없음';
          const h = (Date.now() - Date.parse(iso)) / 36e5;
          if (!isFinite(h)) return iso;
          const when = new Date(iso).toLocaleString('ko-KR', { dateStyle: 'short', timeStyle: 'short' });
          const rel = h < 1 ? '방금 전' : h < 24 ? `${Math.floor(h)}시간 전` : `${Math.floor(h / 24)}일 전`;
          return `${when} (${rel})`;
        };

        const paint = (d: Record<string, unknown>) => {
          const rate = Number(d.rate) || 0;
          const mode = String(d.mode ?? 'auto');
          const updated = (d.updatedAt as string) ?? null;
          $('fx-rate')!.textContent = rate ? `${rate.toLocaleString('ko-KR', { maximumFractionDigits: 2 })} 원/$` : '—';
          $('fx-mode')!.textContent = mode === 'manual' ? '수동 (고정)' : '자동 (실시간)';
          $('fx-source')!.textContent = String(d.source ?? '—');

          const el = $('fx-updated')!;
          el.textContent = ago(updated);
          // 자동인데 하루 넘게 갱신이 없으면 눈에 띄게 — 조용히 멈춰 있는 상황을 놓치지 않도록
          const stale = mode === 'auto' && (!updated || Date.now() - Date.parse(updated) > 26 * 36e5);
          el.style.color = stale ? 'var(--color-danger)' : '';

          sel.value = mode === 'manual' ? 'manual' : 'auto';
          if (!input.value && rate) input.value = String(Math.round(rate * 100) / 100);
          input.disabled = sel.value !== 'manual';
        };

        const load = async () => {
          try {
            const r = await fetch('/api/admin/fx', { cache: 'no-store' });
            const j = await r.json();
            if (j.ok) paint(j);
            else say(j.error ?? '조회 실패', false);
          } catch (e) {
            say('환율 정보를 불러오지 못했습니다.', false);
          }
        };

        const post = async (body: Record<string, unknown>) => {
          const r = await fetch('/api/admin/fx', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          return r.json();
        };

        sel.addEventListener('change', () => { input.disabled = sel.value !== 'manual'; });

        $('fx-refresh')?.addEventListener('click', async () => {
          say('갱신 중…');
          try {
            const j = await post({ action: 'refresh' });
            if (j.ok && j.saved) say(`갱신 완료 (${j.reason})`);
            else if (j.ok) say(`갱신하지 않음: ${j.reason}`, false);
            else say(j.error ?? '갱신 실패', false);
          } catch (e) { say('갱신 실패', false); }
          await load();
        });

        $('fx-save')?.addEventListener('click', async () => {
          say('저장 중…');
          try {
            if (sel.value === 'manual') {
              const n = Number(input.value);
              if (!isFinite(n) || n < 500 || n > 5000) { say('500~5000 사이 숫자를 입력해 주세요.', false); return; }
              const a = await post({ action: 'set', rate: n });
              if (!a.ok) { say(a.error === 'out_of_range' ? '범위를 벗어난 값입니다.' : (a.error ?? '저장 실패'), false); return; }
            }
            const b = await post({ action: 'mode', mode: sel.value });
            if (b.ok) say('저장했습니다. 사이트에 즉시 반영됩니다.');
            else say(b.error ?? '저장 실패', false);
          } catch (e) { say('저장 실패', false); }
          await load();
        });

        void load();
      })();

      // 로그인
      const lf = document.getElementById('login-form') as HTMLFormElement | null;
      lf?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const err = document.getElementById('login-err')!;
        err.textContent = '';
        const pw = (document.getElementById('pw') as HTMLInputElement).value;
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        if (res.ok) location.reload();
        else err.textContent = res.status === 503 ? '관리자 비밀번호가 설정되지 않았습니다.' : '비밀번호가 맞지 않습니다.';
      });

      // 로그아웃
      document.getElementById('logout')?.addEventListener('click', async () => {
        await fetch('/api/admin/login', { method: 'DELETE' });
        location.reload();
      });

      // 테마 토글 — 메인 사이트와 같은 'vanam-theme' 키를 공유한다.
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('vanam-theme', next); } catch (e) {}
      });

      // 견적 금액 저장
      document.querySelectorAll<HTMLFormElement>('.quote-form').forEach((f) => {
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          const msg = f.querySelector('.save-msg') as HTMLElement;
          const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
          const data = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
          btn.disabled = true;
          msg.textContent = '저장 중…';
          msg.style.color = 'color-mix(in oklab, var(--color-ink) 50%, transparent)';
          try {
            const res = await fetch('/api/admin/quote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: f.dataset.id, ...data }),
            });
            const j = await res.json();
            if (!res.ok || !j.ok) throw new Error(j.error ?? res.status);
            msg.textContent = '저장됨';
            msg.style.color = 'var(--color-accent)';
            setTimeout(() => location.reload(), 600);
          } catch (err) {
            msg.textContent = `실패: ${err}`;
            msg.style.color = 'var(--color-danger)';
          } finally {
            btn.disabled = false;
          }
        });
      });

      // 주문 상태 저장 (결제 연동 전에는 여기서 입금 확인 → '결제 완료'로 바꾼다)
      // ── 입금 확인 · 환불 ──────────────────────────────
      // 둘 다 되돌리기 어려운 동작이라 확인 절차를 둔다(특히 환불은 실제로 돈이 나간다).
      const orderAction = async (btn: HTMLButtonElement, body: Record<string, unknown>, confirmText: string) => {
        if (!confirm(confirmText)) return;
        const card = btn.closest('article')!;
        const msg = card.querySelector(`[data-order-status="${body.id}"]`) as HTMLElement | null;
        const say = (t: string, ok = true) => {
          if (!msg) return;
          msg.textContent = t;
          msg.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
        };
        btn.disabled = true;
        say('처리 중…');
        try {
          const res = await fetch('/api/admin/order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const j = await res.json();
          if (j.ok) { say('처리했습니다. 새로고침합니다.'); setTimeout(() => location.reload(), 900); return; }
          const MAP: Record<string, string> = {
            already_paid: '이미 결제 처리된 주문입니다.',
            not_paid: '결제되지 않은 주문은 환불할 수 없습니다.',
            already_refunded: '이미 환불된 주문입니다.',
            no_capture_id: '캡처 ID가 없어 자동 환불이 불가합니다. PayPal 대시보드에서 처리하세요.',
            refund_failed: '환불에 실패했습니다. PayPal 응답을 확인하세요.',
            not_found: '주문을 찾을 수 없습니다.',
          };
          say(MAP[j.error] ?? (j.error ?? '처리 실패'), false);
        } catch (e) {
          say('처리 중 오류가 발생했습니다.', false);
        }
        btn.disabled = false;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-confirm-deposit]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.confirmDeposit!;
          void orderAction(btn, { id, action: 'confirmDeposit' },
            `${id}\n\n계좌 입금을 확인하셨습니까?\n결제 완료로 기록됩니다.`);
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-cancel-order]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.cancelOrder!;
          void orderAction(btn, { id, status: 'cancelled' },
            `${id}\n\n이 주문을 취소하시겠습니까?\n(결제되지 않은 주문입니다)`);
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-refund]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.refund!;
          void orderAction(btn, { id, action: 'refund' },
            `${id}\n\n⚠️ PayPal 로 전액 환불합니다.\n실제로 돈이 고객에게 반환되며 되돌릴 수 없습니다.\n\n진행하시겠습니까?`);
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-save-order]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.saveOrder!;
          const card = btn.closest('article')!;
          const msg = card.querySelector(`[data-order-status="${id}"]`) as HTMLElement;
          const pick = (n: string) =>
            (card.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

          btn.disabled = true;
          msg.textContent = '저장 중…';
          msg.style.color = 'color-mix(in oklab, var(--color-ink) 50%, transparent)';
          try {
            const res = await fetch('/api/admin/order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id,
                status: pick('status'),
                trackingCourier: pick('trackingCourier'),
                trackingNo: pick('trackingNo'),
              }),
            });
            const j = await res.json();
            if (!res.ok || !j.ok) throw new Error(j.error ?? res.status);
            msg.textContent = '저장됨';
            msg.style.color = 'var(--color-accent)';
            setTimeout(() => location.reload(), 600);
          } catch (err) {
            msg.textContent = `실패: ${err}`;
            msg.style.color = 'var(--color-danger)';
          } finally {
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
