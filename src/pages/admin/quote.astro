      .qc-no { flex: none; display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: 0.15rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 700; background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-ink); }
