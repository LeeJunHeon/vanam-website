      .qc-methods { display: inline-flex; border-radius: 0.5rem; border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); overflow: hidden; }
      .qc-methods button { padding: 0.4rem 0.85rem; font-size: 0.8125rem; color: color-mix(in srgb, var(--color-ink) 62%, transparent); }
      .qc-methods button + button { border-left: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); }
      .qc-methods button[aria-checked='true'] { background: color-mix(in srgb, var(--color-accent) 18%, transparent); color: var(--color-ink); font-weight: 600; }
      .qc-methods button:hover:not([aria-checked='true']) { background: color-mix(in srgb, var(--color-ink) 5%, transparent); }
      /* position: relative — 표 머리의 화면 낭독용 글자(.qc-sr, absolute)가 스크롤 상자 밖으로 새어 휴대폰 폭에서 가로 넘침을 만들지 않게 */
      .qc-layers { position: relative; margin-top: 1rem; border-radius: 0.5rem; border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent); padding: 0.25rem 0.5rem 0.6rem; overflow-x: auto; }
      .qc-layers-title { padding: 0.5rem 0.25rem 0.25rem; font-size: 0.75rem; color: color-mix(in srgb, var(--color-ink) 58%, transparent); }
