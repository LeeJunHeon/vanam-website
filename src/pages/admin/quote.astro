      .qc-item { border-radius: 0.75rem; border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent); background: color-mix(in srgb, var(--color-ink) 2%, transparent); padding: 1rem 1.25rem 1.1rem; }
