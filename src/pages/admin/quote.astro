---
// VanaM 관리자 — 견적 계산기 · 문의별 견적 편집 (엑셀 V3 견적 파일의 화면판)
//
// ⚠️ 계산은 항상 서버(/api/admin/quote-calc)에서 한다. 엑셀과 같은 엔진(src/lib/quote-engine.js)이고 이 화면은 바꾸지 않는다.
//    이 화면에는 원가·요율·마진 숫자를 내려보내지 않는다 — 드롭다운용 이름 목록만 받는다. 원가 내역은 계산한 뒤에만 보인다.
//
// 화면 구성(10-01 개편 — 관리자가 보자마자 알 수 있게):
//   · 견적서의 한 줄 = 품목 카드 하나. 박막 증착 품목은 카드 안에 층(레시피·두께)이 붙는다.
//     엔진에 보내는 표(items·layers)는 src/lib/quote-editor.js 가 만든다 — 품목 번호·층 순서는 카드 순서로 자동.
//   · 가격 방식(박막 증착 / 단가 입력 / 총액 입력)을 고르면 그 방식에 필요한 칸만 보인다.
//   · 입력을 바꾸면 잠시 뒤 자동으로 다시 계산한다. 결과·오류는 해당 카드와 칸에, 합계·저장은 오른쪽에 늘 보인다.
//   · 견적서 정보(담당자·납기 등)는 금액과 무관 — 바꿔도 다시 계산하지 않고, 저장·미리보기 때 그 순간 값을 쓴다.
//
// 두 가지 모드:
//   · 계산기 모드(/admin/quote)          — 저장 없음(시험·확인용).
//   · 편집 모드(/admin/quote?id=INQ-…)   — 문의별 견적을 불러와 고치고 저장한다(/api/admin/quote-rev).
//     저장하면 새 개정으로 쌓이고 고객 조회·완료 화면·견적서에 바로 반영된다. 저장 금액은 서버가 다시 계산한 값이다.
export const prerender = false;

import '../../styles/global.css';
import { isAdmin } from '../../lib/admin-auth';
import { telKr } from '../../lib/quote-doc';
import company from '../../data/company.json';
import siteData from '../../data/site.json';
import { UNITS } from '../../lib/quote-editor.js';
// 이 빌드의 구글챗 알림 켜짐/꺼짐 — /admin 헤더와 같은 표시
import { CHAT_ENABLED } from '../../lib/chat-send';

const authed = await isAdmin(Astro.request);

// 기본값 — 견적일은 한국 날짜(워커는 UTC 로 돈다)
const todayKst = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
// 편집 모드 — ?id=INQ-… (형식이 틀리면 계산기 모드로 두고 안내만 띄운다)
const idParam = (Astro.url.searchParams.get('id') ?? '').trim().toUpperCase();
const editId = /^INQ-\d{8}-[A-Z0-9]{4}$/.test(idParam) ? idParam : '';
const badId = idParam !== '' && !editId;
const defaults = {
  date: todayKst,
  quoteNo: editId || `TEST-${todayKst.replace(/-/g, '')}`,
  contact: telKr(company.tel),
};
// 고객 화면 견적 상자·견적서 도장/안내 문구 — 조회 화면과 같은 문구(site.json quote.view)
const qvText = editId ? JSON.stringify({ ko: siteData.ko.quote.view, en: siteData.en.quote.view }) : undefined;
---

<html lang="ko" class="bg-canvas">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{editId ? `VanaM 관리자 — 견적 편집 ${editId}` : 'VanaM 관리자 — 견적 계산기'}</title>
    <link rel="icon" href="/favicon.ico" />
    <!-- 테마 초기화: 관리자 화면(/admin)과 같은 'vanam-theme' 키 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('vanam-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    {!authed ? (
      <main class="flex min-h-screen items-center justify-center px-6">
        <div class="w-full max-w-sm text-center">
          <h1 class="text-2xl font-bold">견적 계산기</h1>
          <p class="mt-3 text-sm text-ink/55">관리자 로그인이 필요합니다.</p>
          <a href="/admin" class="mt-6 inline-block rounded-lg border border-ink/15 px-4 py-2 text-sm text-ink/70 transition hover:border-ink/40 hover:text-ink">
            관리자 로그인으로 이동
          </a>
        </div>
      </main>
    ) : (
      <main class="mx-auto max-w-7xl px-6 py-10" id="qc" data-defaults={JSON.stringify(defaults)} data-edit={editId || undefined} data-qv={qvText}>
        <header class="border-b border-ink/10 pb-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="text-2xl font-bold">{editId ? `견적 편집 — ${editId}` : '견적 계산기'}</h1>
              <p id="qc-meta" class="mt-1 text-sm text-ink/45">가격 DB 불러오는 중…</p>
              <p class:list={['chat-state mt-1 text-sm', CHAT_ENABLED ? 'is-on' : 'is-off']}>
                {CHAT_ENABLED ? '구글챗 알림: 켜짐' : '구글챗 알림: 꺼짐 — 로컬/테스트 빌드'}
              </p>
            </div>
            <a href="/admin" class="rounded-lg border border-ink/15 px-4 py-2 text-sm text-ink/60 transition hover:border-ink/40 hover:text-ink">← 관리자</a>
          </div>
          <details class="qc-help mt-4">
            <summary>이 화면 사용법</summary>
            <ol>
              <li>견적서의 한 줄이 <b>품목</b> 하나입니다. 박막 증착은 층(레시피·두께)으로 엑셀과 같은 방식으로 계산되고, 분석·기판·박스처럼 값이 정해진 줄은 단가나 총액으로 넣습니다.</li>
              <li>입력을 바꾸면 금액이 바로 다시 계산됩니다. 계산은 서버가 엑셀과 같은 규칙으로 합니다.</li>
              <li>고칠 곳이 있으면 그 칸이 빨갛게 표시되고, 오른쪽 합계 칸에 목록이 나옵니다(누르면 그 칸으로 갑니다).</li>
              <li>견적서 정보(담당자·납기 등)는 금액과 무관해서 바꿔도 다시 계산하지 않습니다.</li>
              {editId
                ? <li>저장하면 새 개정으로 쌓이고 <b>고객 조회 화면에 바로 보입니다</b>. 저장 없이 시험하려면 관리자 화면 위쪽의 [견적 계산기]를 쓰세요.</li>
                : <li>이 계산기는 저장하지 않습니다. 문의별 견적은 관리자 견적 탭의 [견적 편집]에서 만듭니다.</li>}
            </ol>
          </details>
        </header>

        <div id="qc-dberr" class="mt-6 hidden rounded-lg border border-danger/30 bg-danger/10 p-4 text-sm text-danger"></div>
        {badId && (
          <div class="mt-6 rounded-lg border border-danger/30 bg-danger/10 p-4 text-sm text-danger">접수번호 형식이 아닙니다(INQ-YYYYMMDD-XXXX) — 계산기 모드로 열었습니다.</div>
        )}

        <div class:list={['qc-layout mt-8', editId && 'is-edit']}>
            {editId && (
              <section class="qc-sec" id="qe-panel">
                <h2 class="qc-h2">문의</h2>
                <p id="qe-load" class="qc-sub">불러오는 중…</p>
                <div id="qe-lock" class="qe-alert qe-alert-bad" hidden></div>
                <div id="qe-pricewarn" class="qe-alert qe-alert-warn" hidden>이 견적은 이전 가격 DB로 계산됐습니다 — 다시 계산하면 금액이 달라질 수 있습니다</div>
                <dl id="qe-facts" class="qe-facts" hidden></dl>
                <details class="qe-raw" id="qe-raw" hidden>
                  <summary>고객 요청 원문</summary>
                  <pre id="qe-raw-text"></pre>
                </details>
              </section>
            )}

            <section class="qc-sec" id="qc-items-sec">
              <h2 class="qc-h2">품목</h2>
              <p class="qc-sub">견적서의 한 줄이 품목 하나입니다. 입력을 바꾸면 금액이 바로 다시 계산됩니다.</p>
              <div id="qc-fillnote" class="qe-alert" hidden></div>
              <div id="qc-orphans" class="qe-alert qe-alert-warn" hidden></div>
              <div id="qc-cards" class="qc-cards"></div>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <button type="button" class="qc-btn" data-add="박막자동">+ 박막 증착 품목</button>
                <button type="button" class="qc-btn" data-add="단가입력">+ 금액 입력 품목</button>
                <span id="qc-addnote" class="qc-sub"></span>
              </div>
              <datalist id="qc-units">{UNITS.map((u) => <option value={u} />)}</datalist>
            </section>

            <section class="qc-sec" id="qc-info-sec">
              <h2 class="qc-h2">견적서 정보</h2>
              <p class="qc-sub">견적서 머리에 들어가는 글자입니다. 금액과 무관해서 바꿔도 다시 계산하지 않습니다.</p>
              <div class="qc-info" id="qc-info">
                <label class="qc-field">고객(귀하)<input data-info="customer" /></label>
                <label class="qc-field">참조<input data-info="ref" /></label>
                <label class="qc-field qc-span2">견적명<input data-info="title" /></label>
                <label class="qc-field">견적일<input data-info="date" type="date" /></label>
                <label class="qc-field">견적번호<input data-info="quoteNo" /></label>
                <label class="qc-field">담당자<input data-info="manager" /></label>
                <label class="qc-field">연락처<input data-info="contact" /></label>
                <label class="qc-field qc-span2">납품기한<input data-info="delivery" /></label>
                <label class="qc-field">유효 일수<input data-info="validDays" inputmode="numeric" /></label>
                <label class="qc-field qc-span3">대금 지불방식<input data-info="payment" placeholder="예: 계좌이체" /></label>
              </div>
              <p class="qc-sub">납품기한·유효 일수의 처음 값은 엑셀 가격정책 탭의 기본값입니다.</p>
              {editId && <p id="qe-prevdate" class="qc-sub" hidden></p>}
            </section>

            {editId && (
              <section class="qc-sec" id="qe-history-box">
                <h2 class="qc-h2">개정 이력</h2>
                <p class="qc-sub">저장할 때마다 개정이 하나씩 쌓입니다. 이전 개정을 불러와 저장하면 그 상태로 되돌립니다.</p>
                <div class="mt-3 overflow-x-auto rounded-lg border border-ink/10">
                  <table class="qc-table" id="qe-history"></table>
                </div>
              </section>
            )}

          <aside class="qc-side" aria-label="합계와 저장">
            <div class="qc-card" id="qc-summary">
              <h2 class="qc-h3">합계</h2>
              <p id="qc-state" class="qc-state" aria-live="polite">가격 DB 불러오는 중…</p>
              <ul id="qc-problems" class="qc-problems" hidden></ul>
              <dl class="qc-amounts" id="qc-amounts">
                <div><dt>공급가액</dt><dd id="qc-supply">—</dd></div>
                <div><dt>세액</dt><dd id="qc-vat">—</dd></div>
                <div class="qc-grand"><dt>합계</dt><dd id="qc-total">—</dd></div>
              </dl>
              <p id="qc-korean" class="qc-sub"></p>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <button type="button" id="qc-preview" disabled class="qc-btn">견적서 미리보기</button>
                {editId && (
                  <select id="qe-lang" class="qe-select" aria-label="견적서 언어">
                    <option value="ko">한국어</option>
                    <option value="en">English</option>
                  </select>
                )}
                <button type="button" id="qc-calc" class="qc-link">다시 계산</button>
              </div>
              <p id="qc-note" class="qc-sub"></p>
            </div>

            {editId ? (
              <div class="qc-card" id="qe-save-box">
                <h2 class="qc-h3">저장</h2>
                <label class="qc-field mt-3">메모 (내부용 — 고객에게 보이지 않음 · 500자)<input id="qe-note" maxlength="500" /></label>
                <div class="mt-3 grid gap-2">
                  <button type="button" id="qe-save" disabled class="qc-btn-primary">저장 — 고객 화면에 바로 반영</button>
                  <button type="button" id="qe-save-confirm" disabled class="qc-btn">저장 + 견적 확정</button>
                </div>
                <p id="qe-why" class="qc-sub"></p>
                <ul class="qc-rules">
                  <li id="qe-rule-save">[저장] 새 개정으로 쌓이고, 고객 조회 화면에 '예상 견적(담당자 수정)'으로 바로 보입니다.</li>
                  <li id="qe-rule-confirm">[저장 + 견적 확정] 확정 금액이 이 합계(원화)가 되고, 상태는 '견적 발송', 고객 화면은 '확정 견적'이 됩니다.</li>
                </ul>
                <div id="qe-msg" class="qe-alert" hidden></div>
                <button type="button" id="qc-reset" class="qc-link mt-3">불러온 값으로 되돌리기</button>
              </div>
            ) : (
              <div class="qc-card">
                <h2 class="qc-h3">계산기</h2>
                <p class="qc-sub">이 화면은 저장하지 않습니다 — 금액과 견적서를 미리 확인하는 용도입니다.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button type="button" id="qc-example" class="qc-btn">예시 불러오기</button>
                  <button type="button" id="qc-reset" class="qc-btn">처음부터</button>
                </div>
              </div>
            )}

            {editId && (
              <div class="qc-card" id="qe-view-wrap" hidden>
                <h2 class="qc-h3">고객에게 이렇게 보입니다</h2>
                <p class="qc-sub">지금 저장돼 있는 견적 기준입니다(저장하면 바뀝니다).</p>
                <div id="qe-view" class="mt-3"></div>
              </div>
            )}
          </aside>
        </div>
      </main>
    )}

    <style is:global>
      /* 이 화면 전용 규칙 — 공용 CSS(global)에 새 유틸리티를 만들지 않는다. 색은 모두 테마 토큰(라이트/다크 공통). */
      /* 넓은 화면: 왼쪽 섹션들 | 오른쪽 합계·저장(고정). 좁은 화면: 문의 → 품목 → 합계·저장 → 견적서 정보 → 이력 */
      .qc-layout { display: grid; gap: 2.75rem 2rem; grid-template-columns: minmax(0, 1fr); }
      .qc-layout > * { min-width: 0; }
      @media (min-width: 1024px) {
        .qc-layout { grid-template-columns: minmax(0, 1fr) 21rem; grid-template-rows: repeat(2, auto) 1fr; align-items: start; }
        .qc-layout.is-edit { grid-template-rows: repeat(4, auto) 1fr; }
        .qc-side { grid-column: 2; grid-row: 1 / -1; position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; }
      }
      @media (max-width: 1023.98px) {
        #qe-panel { order: 1; } #qc-items-sec { order: 2; } .qc-side { order: 3; } #qc-info-sec { order: 4; } #qe-history-box { order: 5; }
      }
      .qc-side { display: grid; gap: 1rem; align-content: start; }
      .qc-h2 { font-size: 1.125rem; font-weight: 600; }
      .qc-h3 { font-size: 0.9375rem; font-weight: 600; }
      .qc-sub { margin-top: 0.25rem; font-size: 0.8125rem; line-height: 1.55; color: color-mix(in srgb, var(--color-ink) 52%, transparent); word-break: keep-all; }
      .qc-sub:empty { display: none; }
      .qc-card { border-radius: 0.75rem; border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent); background: color-mix(in srgb, var(--color-ink) 2%, transparent); padding: 1.25rem; }
      .qc-cards { margin-top: 1rem; display: grid; gap: 1rem; }
      .qc-cards > * { min-width: 0; }
      .qc-empty { border: 1px dashed color-mix(in srgb, var(--color-ink) 18%, transparent); border-radius: 0.75rem; padding: 1.25rem; font-size: 0.875rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); }
      .qc-help { font-size: 0.875rem; color: color-mix(in srgb, var(--color-ink) 70%, transparent); }
      .qc-help summary { cursor: pointer; color: var(--color-accent); width: fit-content; }
      .qc-help ol { margin-top: 0.5rem; padding-left: 1.25rem; list-style: decimal; display: grid; gap: 0.25rem; max-width: 52rem; line-height: 1.6; word-break: keep-all; }

      /* 버튼 — /admin 화면과 같은 모양 */
      .qc-btn { border-radius: 0.5rem; border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); padding: 0.5rem 0.9rem; font-size: 0.875rem; color: color-mix(in srgb, var(--color-ink) 75%, transparent); transition: border-color .15s, color .15s; }
      .qc-btn:hover:not(:disabled) { border-color: color-mix(in srgb, var(--color-ink) 40%, transparent); color: var(--color-ink); }
      .qc-btn-primary { border-radius: 0.5rem; background: var(--color-brand); padding: 0.65rem 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-onbrand); transition: filter .15s; }
      .qc-btn-primary:hover:not(:disabled) { filter: brightness(1.1); }
      .qc-btn:disabled, .qc-btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
      .qc-link { font-size: 0.8125rem; color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
      .qc-link:disabled { opacity: 0.4; cursor: not-allowed; }
      .qc-icon { width: 1.75rem; height: 1.75rem; border-radius: 0.375rem; font-size: 0.8125rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); }
      .qc-icon:hover:not(:disabled) { background: color-mix(in srgb, var(--color-ink) 7%, transparent); color: var(--color-ink); }
      .qc-icon:disabled { opacity: 0.25; cursor: default; }
      .qc-del { font-size: 0.8125rem; padding: 0.25rem 0.5rem; border-radius: 0.375rem; color: color-mix(in srgb, var(--color-ink) 50%, transparent); }
      .qc-del:hover, .qc-x:hover:not(:disabled) { color: var(--color-danger); }
      /* 포커스 테두리는 긴 속성 이름으로 쓴다 — 단축 속성 낱말 하나만 있으면 Tailwind 가 클래스로 잡아 공용 CSS(공개 페이지 전부)를 바꾼다 */
      :where(#qc) button:focus-visible, :where(#qc) summary:focus-visible { outline-width: 2px; outline-style: solid; outline-color: var(--color-accent); outline-offset: 2px; }

      /* 입력칸 */
      .qc-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.75rem; color: color-mix(in srgb, var(--color-ink) 58%, transparent); min-width: 0; }
      .qc-field input:not([type='checkbox']):not([type='radio']), .qc-field select, .qc-table input, .qc-table select {
        width: 100%; border-radius: 0.375rem; border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
