      /* 표(층·이력·원가 내역) */
      .qc-table { width: 100%; border-spacing: 0; font-size: 0.8125rem; }
      .qc-table th { text-align: left; font-weight: 600; font-size: 0.75rem; white-space: nowrap; padding: 0.5rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent); }
      .qc-table td { padding: 0.35rem 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 6%, transparent); vertical-align: middle; }
      .qc-table tr:last-child td { border-bottom: 0; }
      .qc-table td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .qc-ltable td { min-width: 5.5rem; }
      .qc-ltable td.qc-lno { min-width: 0; width: 2rem; text-align: center; color: color-mix(in srgb, var(--color-ink) 50%, transparent); }
      .qc-ltable td.qc-lrecipe { min-width: 15rem; width: 45%; }
      .qc-ltable td[data-lf='tempC'] { min-width: 7.5rem; }
