---
import BaseLayout from '../layouts/BaseLayout.astro';
// ※ BaseLayout이 title/description prop을 받는다고 가정(홈/레이아웃과 동일 패턴).
//    prop명이 다르면 이 두 줄만 맞춰주세요.
const title = "문의하기 | VANAM";
const description = "VanaM(반암) 박막 소재 기술 문의. 제품·기술 협업, 견적, 파트너십 문의를 남겨주세요.";
---

<BaseLayout title={title} description={description}>
  <section class="relative mx-auto max-w-3xl px-6 py-28 md:py-36">
    <p class="text-sm font-medium uppercase tracking-widest text-[#1EBBF0]">Contact</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight text-white md:text-5xl">
      함께 만들어갈<br />이야기를 들려주세요
    </h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-white/60">
      박막 소재 적용, 기술 협업, 공급 문의 등 무엇이든 좋습니다.
      영업일 기준 1–2일 내에 회신드립니다.
    </p>

    <form id="contact-form" class="mt-14 space-y-6">
      <!-- 허니팟: 사람에게는 보이지 않음(스팸 차단) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>이 칸은 비워두세요
          <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-white/80">이름 *</label>
          <input id="name" name="name" type="text" required
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder="홍길동" />
        </div>
        <div>
          <label for="company" class="block text-sm font-medium text-white/80">회사 / 소속</label>
          <input id="company" name="company" type="text"
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder="회사명" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-white/80">이메일 *</label>
          <input id="email" name="email" type="email" required
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder="you@company.com" />
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-white/80">연락처</label>
          <input id="phone" name="phone" type="tel"
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder="010-0000-0000" />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-white/80">문의 내용 *</label>
        <textarea id="message" name="message" rows="6" required
          class="mt-2 w-full resize-y rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
          placeholder="문의하실 내용을 자유롭게 적어주세요."></textarea>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" id="submit-btn"
          class="inline-flex items-center gap-2 rounded-lg bg-[#1EBBF0] px-7 py-3 font-semibold text-[#06222C] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
          <span id="submit-label">문의 보내기</span>
        </button>
        <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  // === 폼 전송 엔드포인트 ===
  // 아래 셋 중 하나로 채우세요. 비워두면 데모 모드로 동작합니다.
  //  1) Formspree:        "https://formspree.io/f/XXXXXXX"
  //  2) 서버리스 함수(권장): "/api/contact"  ← 웹훅을 서버측에 숨겨 안전
  //  3) 기존 PHP 호스트 포워더: "https://vanam.co.kr/contact-forward.php"
  // ⚠️ Google Chat 웹훅 URL을 이 클라이언트 코드에 직접 넣지 마세요(노출됨).
  const FORM_ENDPOINT = "";

  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("form-status");
  const btn = document.getElementById("submit-btn");
  const label = document.getElementById("submit-label");

  function setStatus(msg, ok) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? "#1EBBF0" : "#FF6B6B";
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 허니팟이 채워졌으면 봇 → 조용히 성공처럼 처리
    if (form.vanam_hp_email && form.vanam_hp_email.value.trim() !== "") {
      setStatus("문의가 접수되었습니다. 감사합니다.", true);
      form.reset();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    delete data.vanam_hp_email;

    if (!FORM_ENDPOINT) {
      console.log("[contact] FORM_ENDPOINT 미설정. 전송 데이터:", data);
      setStatus("데모 모드: 엔드포인트를 설정하면 실제로 전송됩니다.", true);
      return;
    }

    btn.disabled = true;
    label.textContent = "보내는 중…";
    setStatus("", true);

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      setStatus("문의가 정상적으로 접수되었습니다. 감사합니다!", true);
    } catch (err) {
      console.error(err);
      setStatus("전송에 실패했습니다. 잠시 후 다시 시도해주세요.", false);
    } finally {
      btn.disabled = false;
      label.textContent = "문의 보내기";
    }
  });
</script>
