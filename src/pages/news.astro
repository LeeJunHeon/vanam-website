---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const title = "News | VanaM";
const description = "News and press coverage of VanaM (반암) — semiconductor thin-film materials, VM1, investment, and exhibitions.";

const news = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={title} description={description}>
  <script is:inline>document.documentElement.classList.add('reveal-on')</script>

  <section class="mx-auto max-w-5xl px-6 pt-28 pb-12 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-[#1EBBF0]">News</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-white md:text-6xl">In the press</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60">
        Coverage of VanaM's thin-film materials, products, and milestones.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="space-y-4">
      {news.map((n) => (
        <a href={n.data.url} target="_blank" rel="noopener noreferrer"
           class="v-reveal group flex items-start gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-[#1EBBF0]/40 hover:bg-white/[0.05]">
          <span class="mt-1 shrink-0 rounded-full border border-[#1EBBF0]/30 bg-[#1EBBF0]/10 px-3 py-1 text-xs font-semibold text-[#1EBBF0]">{n.data.tag}</span>
          <span class="flex-1 text-base font-medium leading-relaxed text-white/85 group-hover:text-white">{n.data.title}</span>
          <svg class="mt-1 h-5 w-5 shrink-0 text-white/30 transition group-hover:text-[#1EBBF0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      ))}
    </div>

    <p class="v-reveal mt-10 text-sm text-white/35">
      External links open the original articles. Dates and full text will be added as the news archive is migrated.
    </p>
  </section>
</BaseLayout>

<style>
  .v-reveal { opacity: 1; transform: none; }
  .reveal-on .v-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
  .reveal-on .v-reveal.is-visible { opacity: 1; transform: none; }
</style>
<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.v-reveal').forEach((el) => obs.observe(el));
</script>
