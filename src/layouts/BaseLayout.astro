---
import '../styles/global.css';
import OrganizationSchema from '../components/OrganizationSchema.astro';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
const { title = 'VANAM — 차세대 반도체 박막 소재', description = 'VANA Materials LAB. 친환경 진공 증착 기반 차세대 반도체 박막 소재·공정 기술 기업.' } = Astro.props;
// 각 페이지의 실제 경로를 절대 URL로 (canonical / og:url)
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
// i18n: 현재 locale + 같은 페이지의 양쪽 언어 URL (locale 접두사 제거한 경로 기준)
const currentLocale = Astro.currentLocale ?? 'en';
let basePath = Astro.url.pathname;
if (basePath === '/ko' || basePath === '/ko/') basePath = '/';
else if (basePath.startsWith('/ko/')) basePath = basePath.slice(3);
const enPath = getRelativeLocaleUrl('en', basePath);
const koPath = getRelativeLocaleUrl('ko', basePath);
const enHref = getAbsoluteLocaleUrl('en', basePath);
const koHref = getAbsoluteLocaleUrl('ko', basePath);
const ogLocale = currentLocale === 'ko' ? 'ko_KR' : 'en_US';
const inLang = currentLocale === 'ko' ? 'ko-KR' : 'en-US';
// 현재 locale을 유지하는 내부 링크 헬퍼 (예: ko에서 /about → /ko/about)
const localizedHref = (path) => getRelativeLocaleUrl(currentLocale, path);

// ── GEO/AEO 구조화 데이터 (locale별) ──
const homeUrl = getAbsoluteLocaleUrl(currentLocale, '/');
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "VanaM",
  "alternateName": ["VANAM", "반암"],
  "url": "https://vanam.co.kr",
  "inLanguage": inLang,
  "publisher": { "@type": "Organization", "name": "VanaM Inc.", "url": "https://vanam.co.kr" },
};
const cleanPath = basePath !== '/' ? basePath.replace(/\/$/, '') : '/';
const crumbLabels = currentLocale === 'ko'
  ? { '/about': '회사 소개', '/technology': '기술·솔루션', '/news': '뉴스', '/contact': '문의' }
  : { '/about': 'About', '/technology': 'Technology', '/news': 'News', '/contact': 'Contact' };
const breadcrumbSchema = (cleanPath !== '/' && crumbLabels[cleanPath]) ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": currentLocale === 'ko' ? '홈' : 'Home', "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": crumbLabels[cleanPath], "item": canonicalURL },
  ],
} : null;
// 내비/햄버거 aria 라벨 (스크린리더용 — locale별)
const ui = currentLocale === 'ko'
  ? { mainMenu: '주 메뉴', mobileMenu: '모바일 메뉴', lang: '언어 선택', openMenu: '메뉴 열기', closeMenu: '메뉴 닫기',
      tagline: 'VANA Materials LAB. — 차세대 반도체 박막 소재·공정' }
  : { mainMenu: 'Main menu', mobileMenu: 'Mobile menu', lang: 'Language', openMenu: 'Open menu', closeMenu: 'Close menu',
      tagline: 'VANA Materials LAB. — Next-generation semiconductor thin films & processes' };
const nav = [
  { href: '/', label: 'Home', labelKo: '홈' },
  { href: '/about', label: 'About', labelKo: '회사소개' },
  { href: '/technology', label: 'Technology', labelKo: '기술' },
  { href: '/news', label: 'News', labelKo: '뉴스' },
  { href: '/contact', label: 'Contact', labelKo: '문의' },
];
const navLabel = (item) => currentLocale === 'ko' ? item.labelKo : item.label;
---
<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ko" href={koHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="VanaM" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VanaM — VANA Materials Lab" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/* Pretendard: 렌더 블로킹 회피(media=print → onload 시 all로 전환), 폰트는 swap으로 표시.
        JS 비활성 시 noscript로 동기 로드해 폰트 보장. family·결과는 기존과 동일(static, 'Pretendard'). */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
    </noscript>
    <OrganizationSchema />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {/* 스크롤 등장(reveal) 효과 — 전 페이지 공통, 단일 소스.
        JS 없으면 reveal-on 미적용 → .v-reveal 기본 노출(콘텐츠 안 숨음). */}
    <script is:inline>document.documentElement.classList.add('reveal-on', 'nav-js')</script>
    <style is:global>
      .v-reveal { opacity: 1; transform: none; }
      .reveal-on .v-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
      .reveal-on .v-reveal.is-visible { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal-on .v-reveal { opacity: 1; transform: none; transition: none; }
      }

      /* 모바일 햄버거 메뉴 — JS 없으면 메뉴 기본 노출(접근 보장), JS 있으면 토글.
         데스크톱(md↑)은 가로 내비만 노출(아래 마크업의 hidden md:flex / md:hidden로 처리). */
      #nav-toggle { display: none; }
      .nav-js #mobile-nav { display: none; }
      @media (max-width: 767px) {
        .nav-js #nav-toggle { display: inline-flex; }
        .nav-js #mobile-nav.is-open { display: block; }
      }
      #nav-toggle .nav-icon-close { display: none; }
      #nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
      #nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }
    </style>
  </head>
  <body class="min-h-screen bg-[#0A0E13] text-white/90 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0A0E13]/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href={localizedHref('/')} class="text-lg font-bold tracking-wide text-white">VANAM</a>
        <div class="flex items-center gap-5">
          <nav class="hidden items-center gap-5 text-sm text-white/60 md:flex" aria-label={ui.mainMenu}>
            {nav.map((item) => (
              <a href={localizedHref(item.href)} class="transition hover:text-white">{navLabel(item)}</a>
            ))}
          </nav>
          <div class="hidden items-center gap-1.5 text-xs font-medium md:flex" aria-label={ui.lang}>
            <a href={enPath} hreflang="en" class={currentLocale === 'en' ? 'text-[#1EBBF0]' : 'text-white/50 transition hover:text-white'}>EN</a>
            <span class="text-white/20">/</span>
            <a href={koPath} hreflang="ko" class={currentLocale === 'ko' ? 'text-[#1EBBF0]' : 'text-white/50 transition hover:text-white'}>KO</a>
          </div>
          <button
            id="nav-toggle"
            type="button"
            aria-label={ui.openMenu}
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-label-open={ui.openMenu}
            data-label-close={ui.closeMenu}
            class="-mr-2 items-center justify-center rounded-md p-2 text-white/70 transition hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1EBBF0]"
          >
            <svg class="nav-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="nav-icon-close h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" aria-label={ui.mobileMenu} class="border-t border-white/10 px-6 pb-3 md:hidden">
        {nav.map((item) => (
          <a href={localizedHref(item.href)} class="block py-3 text-base text-white/70 transition hover:text-white">{navLabel(item)}</a>
        ))}
        <div class="mt-2 flex items-center gap-4 border-t border-white/10 pt-3 text-base" aria-label={ui.lang}>
          <a href={enPath} hreflang="en" class={currentLocale === 'en' ? 'text-[#1EBBF0]' : 'text-white/70 transition hover:text-white'}>EN</a>
          <a href={koPath} hreflang="ko" class={currentLocale === 'ko' ? 'text-[#1EBBF0]' : 'text-white/70 transition hover:text-white'}>KO</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-24 border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-12 text-sm text-white/45">
        <p class="font-semibold text-white/70">VANAM INC.</p>
        <p class="mt-1">{ui.tagline}</p>
        <p class="mt-1">(07377) 21-1 Dosin-ro 4-gil, Yeongdeungpo-gu, Seoul</p>
        <p class="mt-1">hello@vanam.co.kr · 02-6951-0922</p>
        <p class="mt-4 text-white/55">© 2026 VANAM INC. All rights reserved.</p>
      </div>
    </footer>
    <script>
      // 공통 reveal 옵저버: .v-reveal 요소가 뷰포트에 들어오면 is-visible 부여
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.v-reveal').forEach((el) => obs.observe(el));
    </script>
    <script>
      // 모바일 햄버거 메뉴 토글 (전 페이지 공통, 바닐라 JS)
      const navToggle = document.getElementById('nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      if (navToggle && mobileNav) {
        const setNavOpen = (open) => {
          mobileNav.classList.toggle('is-open', open);
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? navToggle.dataset.labelClose : navToggle.dataset.labelOpen);
        };
        navToggle.addEventListener('click', () => setNavOpen(!mobileNav.classList.contains('is-open')));
        mobileNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNavOpen(false); });
      }
    </script>
  </body>
</html>
