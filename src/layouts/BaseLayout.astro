---
import '../styles/global.css';
import OrganizationSchema from '../components/OrganizationSchema.astro';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import logoLight from '../assets/brand/logo-light.png';
import company from '../data/company.json';
const { title = 'VANAM — 차세대 반도체 박막 소재', description = 'VANA Materials LAB. 친환경 진공 증착 기반 차세대 반도체 박막 소재·공정 기술 기업.' } = Astro.props;
// 각 페이지의 실제 경로를 절대 URL로 (canonical / og:url)
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
// i18n: 현재 locale + 같은 페이지의 양쪽 언어 URL (locale 접두사 제거한 경로 기준)
const currentLocale = Astro.currentLocale ?? 'en';
let basePath = Astro.url.pathname;
if (basePath === '/ko' || basePath === '/ko/') basePath = '/';
else if (basePath.startsWith('/ko/')) basePath = basePath.slice(3);
const enPath = getRelativeLocaleUrl('en', basePath);
const koPath = getRelativeLocaleUrl('ko', basePath);
const enHref = getAbsoluteLocaleUrl('en', basePath);
const koHref = getAbsoluteLocaleUrl('ko', basePath);
const ogLocale = currentLocale === 'ko' ? 'ko_KR' : 'en_US';
const inLang = currentLocale === 'ko' ? 'ko-KR' : 'en-US';
// 현재 locale을 유지하는 내부 링크 헬퍼 (예: ko에서 /about → /ko/about)
const localizedHref = (path) => getRelativeLocaleUrl(currentLocale, path);

// ── GEO/AEO 구조화 데이터 (locale별) ──
const homeUrl = getAbsoluteLocaleUrl(currentLocale, '/');
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "VanaM",
  "alternateName": ["VANAM", "반암"],
  "url": "https://vanam.co.kr",
  "inLanguage": inLang,
  "publisher": { "@type": "Organization", "name": "VanaM Inc.", "url": "https://vanam.co.kr" },
};
const cleanPath = basePath !== '/' ? basePath.replace(/\/$/, '') : '/';
const crumbLabels = currentLocale === 'ko'
  ? { '/about': '회사 소개', '/technology': '기술·솔루션', '/news': '뉴스', '/blog': '블로그', '/contact': '문의' }
  : { '/about': 'About', '/technology': 'Technology', '/news': 'News', '/blog': 'Blog', '/contact': 'Contact' };
const breadcrumbSchema = (cleanPath !== '/' && crumbLabels[cleanPath]) ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": currentLocale === 'ko' ? '홈' : 'Home', "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": crumbLabels[cleanPath], "item": canonicalURL },
  ],
} : null;
// 내비/햄버거 aria 라벨 (스크린리더용 — locale별)
const ui = currentLocale === 'ko'
  ? { mainMenu: '주 메뉴', mobileMenu: '모바일 메뉴', lang: '언어 선택', openMenu: '메뉴 열기', closeMenu: '메뉴 닫기', theme: '라이트 / 다크 테마 전환',
      tagline: 'VANA Materials LAB. — 차세대 반도체 박막 소재·공정' }
  : { mainMenu: 'Main menu', mobileMenu: 'Mobile menu', lang: 'Language', openMenu: 'Open menu', closeMenu: 'Close menu', theme: 'Toggle light / dark theme',
      tagline: 'VANA Materials LAB. — Next-generation semiconductor thin films & processes' };
// 푸터 사업자 정보 (전자상거래법 표시 의무 항목) — Keystatic '사업자 정보'에서 관리
const isKo = currentLocale === 'ko';
const biz = {
  name: isKo ? company.nameKo : company.nameEn,
  ceo: isKo ? company.ceoKo : (company.ceoEn || company.ceoKo),
  address: isKo ? company.addressKo : (company.addressEn || company.addressKo),
};
const fl = isKo
  ? { ceo: '대표', bizNo: '사업자등록번호', mailOrder: '통신판매업 신고번호',
      privacy: '개인정보처리방침', terms: '이용약관', refund: '환불·교환 정책' }
  : { ceo: 'CEO', bizNo: 'Business Reg. No.', mailOrder: 'E-Commerce Reg. No.',
      privacy: 'Privacy Policy', terms: 'Terms of Service', refund: 'Refund & Exchange' };

const nav = [
  { href: '/', label: 'Home', labelKo: '홈' },
  {
    href: '/about', label: 'About', labelKo: '회사소개',
    children: [
      { href: '/about#vision', label: 'Company', labelKo: '회사 개요' },
      { href: '/about#team', label: 'Team', labelKo: '팀' },
      { href: '/about#history', label: 'History', labelKo: '연혁' },
      { href: '/about#achievement', label: 'Global Activity', labelKo: '글로벌 활동' },
      { href: '/about#collaboration', label: 'Collaboration', labelKo: '협력' },
    ],
  },
  {
    href: '/technology', label: 'Technology', labelKo: '기술',
    children: [
      { href: '/technology#core', label: 'Core Technology', labelKo: '핵심 기술' },
      { href: '/technology#materials', label: 'Material Library', labelKo: '소재 라이브러리' },
      { href: '/technology#fs', label: 'Services', labelKo: '서비스' },
      { href: '/technology#analysis', label: 'Analysis', labelKo: '분석·측정' },
      { href: '/technology#equipment', label: 'Equipment', labelKo: '장비' },
      { href: '/technology#rt', label: 'Applications', labelKo: '응용 분야' },
    ],
  },
  { href: '/product', label: 'Product', labelKo: '제품' },
  { href: '/news', label: 'News', labelKo: '뉴스' },
  { href: '/blog', label: 'Blog', labelKo: '블로그' },
  { href: '/contact', label: 'Contact', labelKo: '문의' },
];
const navLabel = (item) => currentLocale === 'ko' ? item.labelKo : item.label;
const childLabel = (item) => currentLocale === 'ko' ? item.labelKo : item.label;
// 앵커(#) 포함 링크용: getRelativeLocaleUrl 은 경로 끝에 '/'를 붙여 '#vision/' 처럼
// 앵커를 깨뜨린다. 경로와 앵커를 분리해 경로만 지역화하고 앵커를 뒤에 붙인다.
const childHref = (path) => {
  const [p, hash] = path.split('#');
  const base = localizedHref(p);
  return hash ? `${base.replace(/\/$/, '')}#${hash}` : base;
};
---
<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <!--
      ⚠️ 이 스크립트는 반드시 <head> 최상단, 스타일보다 먼저 와야 한다.
      나중에 실행되면 다크로 한 번 그려진 뒤 라이트로 바뀌어 화면이 번쩍인다(FOUC).
      is:inline 이라 Astro 가 번들로 빼지 않고 그대로 인라인한다.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('vanam-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ko" href={koHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="VanaM" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VanaM — VANA Materials Lab" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/* Pretendard: 렌더 블로킹 회피(media=print → onload 시 all로 전환), 폰트는 swap으로 표시.
        JS 비활성 시 noscript로 동기 로드해 폰트 보장. family·결과는 기존과 동일(static, 'Pretendard'). */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
    </noscript>
    <OrganizationSchema />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {/* 스크롤 등장(reveal) 효과 — 전 페이지 공통, 단일 소스.
        JS 없으면 reveal-on 미적용 → .v-reveal 기본 노출(콘텐츠 안 숨음). */}
    <script is:inline>document.documentElement.classList.add('reveal-on', 'nav-js')</script>
    <style is:global>
      .v-reveal { opacity: 1; transform: none; }
      .reveal-on .v-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
      .reveal-on .v-reveal.is-visible { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal-on .v-reveal { opacity: 1; transform: none; transition: none; }
      }

      /* 모바일 햄버거 메뉴 — JS 없으면 메뉴 기본 노출(접근 보장), JS 있으면 토글.
         데스크톱(md↑)은 가로 내비만 노출(아래 마크업의 hidden md:flex / md:hidden로 처리). */
      #nav-toggle { display: none; }
      .nav-js #mobile-nav { display: none; }
      @media (max-width: 767px) {
        .nav-js #nav-toggle { display: inline-flex; }
        .nav-js #mobile-nav.is-open { display: block; }
      }
      #nav-toggle .nav-icon-close { display: none; }
      #nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
      #nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }
    </style>
  </head>
  <body class="min-h-screen bg-canvas text-ink/90 antialiased">
    <header class="sticky top-0 z-50 border-b border-ink/10 bg-canvas/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href={localizedHref('/')} class="shrink-0" aria-label="VANAM">
          <Image src={logo} alt="VANAM — VANA Materials LAB." width={200} height={50} class="logo-dark h-9 w-auto md:h-10" loading="eager" />
          <Image src={logoLight} alt="VANAM — VANA Materials LAB." width={200} height={50} class="logo-light h-9 w-auto md:h-10" loading="eager" />
        </a>
        <div class="flex items-center gap-5">
          <nav class="hidden items-center gap-5 text-sm text-ink/60 md:flex" aria-label={ui.mainMenu}>
            {nav.map((item) => (
              item.children ? (
                <div class="group relative">
                  <a href={localizedHref(item.href)} class="inline-flex items-center gap-1 py-2 transition hover:text-ink">
                    {navLabel(item)}
                    <svg class="h-3 w-3 transition group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </a>
                  <!-- 드롭다운: 호버 시 표시. 상단 padding(pt-2)으로 마우스 이동 간격 확보 -->
                  <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100">
                    <div class="min-w-[13rem] rounded-xl border border-ink/10 bg-canvas p-2 shadow-lg shadow-ink/5">
                      {item.children.map((c) => (
                        <a href={childHref(c.href)} class="block rounded-lg px-3 py-2 text-sm text-ink/70 transition hover:bg-ink/[0.05] hover:text-ink">{childLabel(c)}</a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <a href={localizedHref(item.href)} class="py-2 transition hover:text-ink">{navLabel(item)}</a>
              )
            ))}
          </nav>
          <div class="hidden items-center gap-1.5 text-xs font-medium md:flex" aria-label={ui.lang}>
            <a href={enPath} hreflang="en" class={currentLocale === 'en' ? 'text-accent' : 'text-ink/50 transition hover:text-ink'}>EN</a>
            <span class="text-ink/20">/</span>
            <a href={koPath} hreflang="ko" class={currentLocale === 'ko' ? 'text-accent' : 'text-ink/50 transition hover:text-ink'}>KO</a>
          </div>

          <button
            id="theme-toggle"
            type="button"
            aria-label={ui.theme ?? 'Toggle theme'}
            class="rounded-md p-2 text-ink/60 transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
          <button
            id="nav-toggle"
            type="button"
            aria-label={ui.openMenu}
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-label-open={ui.openMenu}
            data-label-close={ui.closeMenu}
            class="-mr-2 items-center justify-center rounded-md p-2 text-ink/70 transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <svg class="nav-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="nav-icon-close h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" aria-label={ui.mobileMenu} class="border-t border-ink/10 px-6 pb-3 md:hidden">
        {nav.map((item) => (
          <>
            <a href={localizedHref(item.href)} class="block py-3 text-base text-ink/70 transition hover:text-ink">{navLabel(item)}</a>
            {item.children && (
              <div class="mb-1 ml-3 border-l border-ink/10 pl-3">
                {item.children.map((c) => (
                  <a href={childHref(c.href)} class="block py-2 text-sm text-ink/55 transition hover:text-ink">{childLabel(c)}</a>
                ))}
              </div>
            )}
          </>
        ))}
        <div class="mt-2 flex items-center gap-4 border-t border-ink/10 pt-3 text-base" aria-label={ui.lang}>
          <a href={enPath} hreflang="en" class={currentLocale === 'en' ? 'text-accent' : 'text-ink/70 transition hover:text-ink'}>EN</a>
          <a href={koPath} hreflang="ko" class={currentLocale === 'ko' ? 'text-accent' : 'text-ink/70 transition hover:text-ink'}>KO</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-24 border-t border-ink/10">
      <div class="mx-auto max-w-6xl px-6 py-12 text-sm text-ink/45">
        <p class="font-semibold text-ink/70">{biz.name}</p>
        <p class="mt-1">{ui.tagline}</p>

        <!-- 전자상거래법상 표시 의무 항목 (PG 심사 필수) -->
        <div class="mt-5 space-y-1 text-[13px] leading-relaxed text-ink/40">
          <p>{fl.ceo}: {biz.ceo} &nbsp;·&nbsp; {fl.bizNo}: {company.bizNo}</p>
          <p>{fl.mailOrder}: {company.mailOrderNo}</p>
          <p>({company.zip}) {biz.address}</p>
          <p>{company.email} &nbsp;·&nbsp; {company.tel}</p>
        </div>

        <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[13px]" aria-label={fl.privacy}>
          <a href={localizedHref('/privacy')} class="font-medium text-ink/60 transition hover:text-accent">{fl.privacy}</a>
          <a href={localizedHref('/terms')} class="text-ink/45 transition hover:text-accent">{fl.terms}</a>
          <a href={localizedHref('/refund')} class="text-ink/45 transition hover:text-accent">{fl.refund}</a>
        </nav>

        <p class="mt-6 text-ink/55">© 2026 {company.nameEn} All rights reserved.</p>
      </div>
    </footer>
    <script>
      // 공통 reveal 옵저버: .v-reveal 요소가 뷰포트에 들어오면 is-visible 부여
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.v-reveal').forEach((el) => obs.observe(el));
    </script>
    <script>
      // 모바일 햄버거 메뉴 토글 (전 페이지 공통, 바닐라 JS)
      const navToggle = document.getElementById('nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      if (navToggle && mobileNav) {
        const setNavOpen = (open) => {
          mobileNav.classList.toggle('is-open', open);
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? navToggle.dataset.labelClose : navToggle.dataset.labelOpen);
        };
        navToggle.addEventListener('click', () => setNavOpen(!mobileNav.classList.contains('is-open')));
        mobileNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNavOpen(false); });
      }
    </script>

    <script>
      // ── 폼 유효성 검사 메시지 현지화 ──────────────────────────
      // 브라우저 기본 메시지는 '페이지 언어'가 아니라 '브라우저 UI 언어'를 따른다.
      // (한국어 크롬에서는 영문 페이지에서도 한국어로 뜬다)
      // 그래서 페이지 언어에 맞춰 우리가 직접 문구를 지정한다.
      const V_KO = {
        required: '필수 항목입니다.',
        checkbox: '계속하려면 동의해 주세요.',
        select: '항목을 선택해 주세요.',
        email: '올바른 이메일 주소를 입력해 주세요. (예: name@company.com)',
        tel: '올바른 전화번호를 입력해 주세요.',
        number: '올바른 숫자를 입력해 주세요.',
        length: '입력 길이를 확인해 주세요.',
        fallback: '입력값을 확인해 주세요.',
      };
      const V_EN = {
        required: 'This field is required.',
        checkbox: 'Please tick this box to continue.',
        select: 'Please choose an option.',
        email: 'Please enter a valid email address (e.g. name@company.com).',
        tel: 'Please enter a valid phone number.',
        number: 'Please enter a valid number.',
        length: 'Please check the length of your entry.',
        fallback: 'Please check this value.',
      };
      const V = (document.documentElement.lang || 'en').startsWith('ko') ? V_KO : V_EN;

      function validationMessage(el) {
        const v = el.validity;
        if (v.valueMissing) {
          if (el.type === 'checkbox' || el.type === 'radio') return V.checkbox;
          if (el.tagName === 'SELECT') return V.select;
          return V.required;
        }
        if (v.typeMismatch) {
          if (el.type === 'email') return V.email;
          if (el.type === 'tel') return V.tel;
          return V.fallback;
        }
        if (v.badInput) return el.type === 'number' ? V.number : V.fallback;
        if (v.rangeUnderflow || v.rangeOverflow || v.stepMismatch) return V.number;
        if (v.tooLong || v.tooShort) return V.length;
        return V.fallback;
      }

      const isField = (el) =>
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        el instanceof HTMLSelectElement;

      // invalid 이벤트는 버블링되지 않으므로 캡처 단계에서 받는다
      document.addEventListener('invalid', (e) => {
        const el = e.target;
        if (isField(el)) el.setCustomValidity(validationMessage(el));
      }, true);

      // 값을 고치면 커스텀 메시지를 해제해야 다시 정상 판정된다
      const clear = (e) => { if (isField(e.target)) e.target.setCustomValidity(''); };
      document.addEventListener('input', clear, true);
      document.addEventListener('change', clear, true);
    </script>
    <!--
      구 워드프레스의 해시 링크를 새 주소로 넘긴다.
      해시(#team)는 서버로 전송되지 않아 _redirects 로는 처리할 수 없다. 브라우저에서만 가능하다.
        구:  vanam.co.kr/#team              →  신: /about#team
        구:  vanam.co.kr/technology-solution/#core  →  _redirects 가 /technology 로 보내고, 여기서 #core 를 붙인다
    -->
    <script is:inline>
      (function () {
        var h = location.hash.slice(1);
        if (!h) return;
        var p = location.pathname.replace(/\/$/, '');
        var ko = p.indexOf('/ko') === 0;
        var base = ko ? '/ko' : '';
        var home = p === base || p === '';

        // 홈에 있던 구 앵커 → /about
        var ABOUT = ['vision', 'team', 'history', 'achievement', 'collaboration'];
        if (home && ABOUT.indexOf(h) >= 0) {
          location.replace(base + '/about#' + h);
          return;
        }
        // 이미 목적지 페이지인데 해당 요소가 있으면 스크롤만 맞춘다
        var el = document.getElementById(h);
        if (el) el.scrollIntoView();
      })();
    </script>
    <script is:inline>
      // 같은 페이지 안의 앵커(#) 링크를 클릭하면, 페이지를 새로 로드하지 않고
      // 곧바로 부드럽게 스크롤한다. (이게 없으면 /about 에서 /about#team 을 눌러도
      //  브라우저가 페이지를 다시 불러 "로딩 후 전환"되는 느낌이 난다.)
      (function () {
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          // 새 탭·수정키·다운로드·외부 target 은 기본 동작 유지
          if (a.target === '_blank' || a.hasAttribute('download') || a.origin !== location.origin) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

          var hash = a.hash;
          if (!hash || hash.length < 2) return;
          // 경로가 지금 페이지와 같을 때만 (앞뒤 '/' 차이는 무시)
          var here = location.pathname.replace(/\/$/, '');
          var there = a.pathname.replace(/\/$/, '');
          if (here !== there) return;

          var el = document.getElementById(decodeURIComponent(hash.slice(1)));
          if (!el) return;

          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // 주소창 해시도 갱신(뒤로가기·북마크 유지). 스크롤은 위에서 이미 처리.
          history.pushState(null, '', hash);
        });
      })();
    </script>
    <script is:inline>
      // 테마 토글 — 선택은 localStorage 에 남는다.
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('vanam-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
