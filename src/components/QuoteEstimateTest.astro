---
// 견적 테스트 모드 전용 — 고객 견적 폼의 "예상 견적 보기" (운영 빌드에는 포함되지 않음).
//
// QuoteForm.astro 가 테스트 모드(npm run local 빌드)이고 simple 이 아닐 때만 렌더한다.
//   part="panel"  → 버튼 줄 바로 위: 결과 상자 + 접힌 "내부 확인(테스트 전용)"
//                   + 반복 구간·기판 등급 칸(스크립트가 폼의 제자리로 옮겨 붙인다)
//   part="button" → 버튼 줄의 [예상 견적 보기]
//
// 고객에게는 합계(부가세 포함)·USD 환산·유효기간, 또는 "담당자 확인" 항목, 또는 입력 오류만 보인다.
// 품목별 단가·원가·ID 는 접힌 내부 확인(debug)에만 있다 — 운영 전환 시 통째로 제거한다.
//
// ⚠️ 스타일·스크립트는 전부 is:inline, id·class 는 qet- 접두어만. 꺼진 빌드의 공개 결과물이 main 과 같아야 한다.
// ⚠️ 기존 폼의 DOM 은 읽기만 한다. 새 입력(반복 구간·등급)과 계산 금액은 제출·알림·완료 화면에 넣지 않는다
//    — 새 칸에는 name 을 달지 않아 폼 제출 데이터에 섞이지 않는다.
// ⚠️ 계산은 항상 서버(/api/quote-estimate)에서 한다.
const { part } = Astro.props as { part: 'panel' | 'button' };
const en = (Astro.currentLocale ?? 'en') !== 'ko';
---

{part === 'button' ? (
  <button type="button" id="qet-run" class="v-btn-ghost">{en ? 'See estimate' : '예상 견적 보기'}</button>
) : (
  <div id="qet-panel" class="qet-panel" data-locale={en ? 'en' : 'ko'}>
    <div id="qet-result" class="qet-result" hidden aria-live="polite"></div>

    <details id="qet-debug" class="qet-debug">
      <summary>내부 확인 (테스트 전용)</summary>
      <p class="qet-muted">운영 빌드에는 포함되지 않음 · <span id="qet-meta">가격 DB 확인 중…</span></p>
      <div id="qet-debug-body"><p class="qet-muted">[예상 견적 보기]를 누르면 계산 입력·원가 내역이 여기에 나옵니다.</p></div>
    </details>

    {/* 아래 두 블록은 스크립트가 폼의 제자리로 옮긴다(반복 구간 → 공정 시퀀스 아래, 등급 → 전달 방식 아래) */}
    <div id="qet-repeat" class="qet-repeat">
      <label class="qet-check"><input type="checkbox" id="qet-rep-on" />
        {en ? 'Repeat some steps (stack / superlattice)' : '일부 단계를 반복해서 쌓습니다 (적층·초격자)'}</label>
      <div id="qet-rep-fields" class="qet-rep-fields" hidden>
        <div class="qet-rep-row">
          <select id="qet-rep-from" aria-label={en ? 'First step' : '시작 단계'}></select>
          <span>~</span>
          <select id="qet-rep-to" aria-label={en ? 'Last step' : '끝 단계'}></select>
          <span>{en ? 'repeated' : '를'}</span>
          <input id="qet-rep-count" inputmode="numeric" value="2" aria-label={en ? 'Repeat count' : '반복 횟수'} />
          <span>{en ? 'times' : '회 반복'}</span>
        </div>
        <p class="qet-muted">{en
          ? 'e.g. steps 2–3 × 10 → deposits 2·3·2·3… alternately, 10 times.'
          : '예: 2~3단계를 10회 → 2·3·2·3… 순서로 10번 번갈아 증착합니다.'}</p>
      </div>
    </div>
    <div id="qet-grade-wrap" class="qet-grade" hidden>
      <label for="qet-grade" class="qet-label">{en ? 'Substrate grade' : '기판 등급'}</label>
      <select id="qet-grade">
        <option value="">{en ? 'Select grade' : '등급 선택'}</option>
        <option value="Test">Test</option>
        <option value="Prime">Prime</option>
      </select>
    </div>

    <style is:inline>
      .qet-panel { margin-top: 1.5rem; font-size: 0.875rem; }
      .qet-result { border-radius: 0.75rem; padding: 1rem 1.25rem; line-height: 1.7; }
      .qet-result.qet-ok { background: color-mix(in srgb, var(--color-ok) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-ok) 35%, transparent); }
      .qet-result.qet-part { background: color-mix(in srgb, var(--color-warn) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-warn) 35%, transparent); }
      .qet-result.qet-bad { background: color-mix(in srgb, var(--color-danger) 9%, transparent); border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent); }
      .qet-total { font-size: 1.125rem; font-weight: 700; color: var(--color-ink); }
      .qet-result ul { margin: 0.4rem 0 0.4rem 1.2rem; list-style: disc; }
      .qet-muted { color: color-mix(in srgb, var(--color-ink) 55%, transparent); font-size: 0.8125rem; }
      .qet-debug { margin-top: 0.75rem; border: 1px dashed color-mix(in srgb, var(--color-warn) 60%, transparent); border-radius: 0.75rem; padding: 0.5rem 0.9rem; }
      .qet-debug summary { cursor: pointer; font-weight: 600; color: var(--color-warn); }
      .qet-scroll { overflow-x: auto; margin-top: 0.6rem; }
      .qet-t { width: 100%; border-spacing: 0; font-size: 0.75rem; }
      .qet-t th, .qet-t td { padding: 0.25rem 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent); text-align: left; vertical-align: top; }
      .qet-t th { color: color-mix(in srgb, var(--color-ink) 55%, transparent); font-weight: 600; white-space: nowrap; }
      .qet-t td.qet-n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .qet-debug pre { font-size: 0.6875rem; overflow-x: auto; max-height: 22rem; background: color-mix(in srgb, var(--color-ink) 4%, transparent); padding: 0.6rem; border-radius: 0.5rem; }
      .qet-repeat { margin-top: 1rem; }
      .qet-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: color-mix(in srgb, var(--color-ink) 75%, transparent); cursor: pointer; }
      .qet-rep-fields { margin-top: 0.6rem; }
      .qet-rep-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
      .qet-rep-row select, .qet-rep-row input, .qet-grade select { border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); border-radius: 0.375rem; padding: 0.35rem 0.5rem; background: var(--color-canvas); color: var(--color-ink); font-size: 0.8125rem; }
      .qet-rep-row input { width: 4.5rem; }
      .qet-grade { margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; max-width: 16rem; }
      .qet-label { font-size: 0.875rem; font-weight: 500; color: color-mix(in srgb, var(--color-ink) 80%, transparent); }
      .qet-flag { box-shadow: 0 0 0 2px var(--color-danger); }
    </style>

    <script is:inline>
      (() => {
        const $ = (id) => document.getElementById(id);
        const panel = $('qet-panel');
        const form = $('quote-form');
        const list = $('q-process-list');
        if (!panel || !form || !list) return;
        const API = '/api/quote-estimate';
        const EN = panel.dataset.locale === 'en';
        const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        const fmt = (n) => (typeof n === 'number' ? n.toLocaleString('ko-KR', { maximumFractionDigits: 4 }) : esc(n));
        const T = EN ? {
          step: (n, s) => `Step ${n} · ${s}`,
          estimate: (c) => `Estimated total about <span class="qet-total">${esc(c.totalUsdText)}</span> (${esc(c.totalKrwText)} incl. VAT)`,
          valid: (c) => `Valid for ${c.validDays} days from today (until ${esc(c.validUntil)})`,
          estNote: 'This is an estimate. We will send a confirmed quote after review.',
          manual: 'The items below cannot be priced automatically. Our team will review them and send you a quote.',
          manualCta: (l) => `Please click [${esc(l)}].`,
          invalid: 'Please check the following:',
          fail: 'Could not calculate the estimate. Please try again later.',
        } : {
          step: (n, s) => `${n}단계 · ${s}`,
          estimate: (c) => `예상 견적 합계 <span class="qet-total">${esc(c.totalKrwText)}</span> (부가세 포함) · 약 ${esc(c.totalUsdText)}`,
          valid: (c) => `유효기간: 오늘부터 ${c.validDays}일 (${esc(c.validUntil)}까지)`,
          estNote: '예상 금액이며 담당자 확인 후 확정 견적을 보내드립니다.',
          manual: '아래 항목은 자동 계산이 되지 않아 담당자가 확인 후 견적을 보내드립니다.',
          manualCta: () => '[견적 요청하기]를 눌러 주세요.',
          invalid: '아래 내용을 확인해 주세요.',
          fail: '예상 견적을 계산하지 못했습니다. 잠시 후 다시 시도해 주세요.',
        };

        // 새 입력칸에서 Enter 를 눌러도 견적 요청이 제출되지 않게 한다(칸들이 폼 안에 있다).
        const noEnter = (el) => el?.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target?.tagName === 'INPUT') e.preventDefault(); });

        // ── 반복 구간·등급 칸을 폼의 제자리로 옮긴다 ─────────────────────
        const repeat = $('qet-repeat'), gradeWrap = $('qet-grade-wrap');
        const seqInput = $('q-process-sequence');
        if (seqInput?.parentElement) seqInput.parentElement.insertBefore(repeat, seqInput); // 공정 시퀀스 바로 아래
        const delivery = $('q-delivery');
        if (delivery?.parentElement) delivery.parentElement.appendChild(gradeWrap);       // 전달 방식 칸 아래
        noEnter(repeat);

        // ── 폼 읽기(읽기 전용) ────────────────────────────────────────
        const rows = () => Array.from(list.querySelectorAll('.q-process-row'));
        const readSteps = () => rows().map((row) => {
          const q = (s) => row.querySelector(s);
          const matWrap = q('.q-material-wrap'), valWrap = q('.q-value-wrap');
          return {
            process: q('.q-row-process')?.value ?? '',
            material: matWrap && !matWrap.hidden ? (q('.q-row-material')?.value ?? '') : '',
            value: valWrap && !valWrap.hidden ? (q('.q-row-value')?.value ?? '').trim() : '',
            unit: q('.q-row-unit')?.textContent ?? '',
            etc: (q('.q-row-etc')?.value ?? '').trim(),
          };
        });
        const val = (id) => ($(id)?.value ?? '').trim();

        // ── 반복 구간 선택지: 현재 공정 행에 맞춰 갱신 ───────────────────
        const repOn = $('qet-rep-on'), repFields = $('qet-rep-fields');
        const repFrom = $('qet-rep-from'), repTo = $('qet-rep-to');
        const refreshRepeat = () => {
          repFields.hidden = !repOn.checked;
          const steps = readSteps();
          for (const sel of [repFrom, repTo]) {
            const keep = sel.value;
            sel.innerHTML = steps.map((s, i) => `<option value="${i + 1}">${esc(T.step(i + 1, [s.process, s.material].filter(Boolean).join(' ') || '—'))}</option>`).join('');
            if (keep && Number(keep) <= steps.length) sel.value = keep;
            else if (sel === repTo && steps.length) sel.value = String(steps.length);
          }
        };
        repOn.addEventListener('change', refreshRepeat);

        // ── 기판 등급: 구매 요청 + Silicon·Silicon oxide 일 때만 ────────
        const GRADED = ['Silicon', 'Silicon oxide'];
        const gradeVisible = () => val('q-delivery') === 'purchase' && GRADED.includes(val('q-substrate-type'));
        const refreshGrade = () => { gradeWrap.hidden = !gradeVisible(); };

        new MutationObserver(refreshRepeat).observe(list, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
        list.addEventListener('change', refreshRepeat);
        for (const id of ['q-delivery', 'q-substrate-type']) $(id)?.addEventListener('change', refreshGrade);
        refreshRepeat();
        refreshGrade();

        // ── 결과 표시 ─────────────────────────────────────────────────
        const out = $('qet-result');
        const clearFlags = () => document.querySelectorAll('.qet-flag').forEach((el) => el.classList.remove('qet-flag'));
        const fieldEl = (e) => {
          const row = e.step ? rows()[e.step - 1] : null;
          const byField = {
            sampleCount: () => $('q-sample-count'),
            process: () => (row ? row.querySelector('.q-row-process') : $('q-process-add')),
            material: () => row?.querySelector('.q-row-material'),
            value: () => row?.querySelector('.q-row-value'),
            repeat: () => repFrom,
            repeatCount: () => $('qet-rep-count'),
            substrateGrade: () => $('qet-grade'),
          }[e.field];
          return byField ? byField() : null;
        };
        const showCustomer = (c) => {
          clearFlags();
          out.hidden = false;
          if (c.kind === 'estimate') {
            out.className = 'qet-result qet-ok';
            out.innerHTML = `<p>${T.estimate(c)}</p>${c.validUntil ? `<p>${T.valid(c)}</p>` : ''}<p class="qet-muted">${esc(T.estNote)}</p>`;
          } else if (c.kind === 'manual') {
            out.className = 'qet-result qet-part';
            const label = $('quote-submit-label')?.textContent?.trim() || '';
            out.innerHTML = `<p>${esc(T.manual)}</p><ul>${c.manual.map((m) => `<li>${esc(m)}</li>`).join('')}</ul><p>${T.manualCta(label)}</p>`;
          } else {
            out.className = 'qet-result qet-bad';
            out.innerHTML = `<p>${esc(T.invalid)}</p><ul>${(c.errors ?? []).map((e) => `<li>${esc(e.message)}</li>`).join('')}</ul>`;
            const first = (c.errors ?? []).map(fieldEl).find(Boolean);
            for (const e of c.errors ?? []) fieldEl(e)?.classList.add('qet-flag');
            if (first) { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); first.focus?.({ preventScroll: true }); }
            return;
          }
          out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        // ── 내부 확인(debug) ──────────────────────────────────────────
        const BD = [['layerCount', '층 수'], ['equipmentId', '장비 ID'], ['materialCost', '재료비/회'], ['depositMin', '증착시간/회'],
          ['depositCost', '증착장비비/회'], ['loadingMin', '로딩 분/회'], ['setupMin', '셋업 분/회'], ['plasmaMin', '플라즈마 분/회'],
          ['waitMin', '대기 분/회'], ['ratePerMin', '장비요율'], ['substrateCost', '기판원가/회'], ['cost', '원가/회'],
          ['markup', '가산율'], ['markupAmount', '가산금액/회'], ['priceBeforeFloor', '절삭 전 단가']];
        let lastDoc = null;
        const showDebug = (d) => {
          const body = $('qet-debug-body');
          if (!d) { body.innerHTML = '<p class="qet-muted">debug 없음</p>'; return; }
          const r = d.result;
          let h = `<p class="qet-muted">엔진 상태: ${esc(r?.status ?? '(계산 안 함)')} · 환율 ${fmt(d.fx?.rate)} (${esc(d.fx?.source)})</p>`;
          if (r) {
            h += '<div class="qet-scroll"><table class="qet-t"><thead><tr><th>품목</th><th>상태</th><th>회수</th><th>단가</th><th>공급가액</th><th>세액</th><th>합계</th></tr></thead><tbody>' +
              r.items.map((it, i) => `<tr><td>${esc(d.input.items[i]?.name)}</td><td>${esc(it.status)}</td><td class="qet-n">${fmt(d.input.items[i]?.qty)}</td>` +
                `<td class="qet-n">${fmt(it.unitPrice)}</td><td class="qet-n">${fmt(it.supply)}</td><td class="qet-n">${fmt(it.vat)}</td><td class="qet-n">${fmt(it.total)}</td></tr>`).join('') +
              '</tbody></table></div>';
            h += '<div class="qet-scroll"><table class="qet-t"><thead><tr><th>원가 내역</th>' + r.items.map((it) => `<th>품목 ${esc(it.no)}</th>`).join('') + '</tr></thead><tbody>' +
              BD.map(([k, l]) => `<tr><th>${esc(l)}</th>${r.items.map((it) => `<td class="qet-n">${fmt(it.breakdown?.[k])}</td>`).join('')}</tr>`).join('') + '</tbody></table></div>';
            h += '<div class="qet-scroll"><table class="qet-t"><thead><tr><th>품목</th><th>순서</th><th>레시피</th><th>상태</th><th>두께</th><th>층 반복</th><th>재료비</th><th>증착시간 분</th><th>증착장비비</th></tr></thead><tbody>' +
              r.layers.map((l) => `<tr><td class="qet-n">${esc(l.itemNo)}</td><td class="qet-n">${esc(l.order)}</td><td>${esc(l.recipeId)}</td><td>${esc(l.status)}</td>` +
                `<td class="qet-n">${fmt(l.thicknessNm)}</td><td class="qet-n">${fmt(l.repeat)}</td><td class="qet-n">${fmt(l.materialCost)}</td><td class="qet-n">${fmt(l.depositMin)}</td><td class="qet-n">${fmt(l.depositCost)}</td></tr>`).join('') +
              '</tbody></table></div>';
          }
          h += `<details><summary>flags</summary><pre>${esc(JSON.stringify(d.flags, null, 2))}</pre></details>`;
          h += `<details><summary>계산 입력(items·layers)·산정 제외</summary><pre>${esc(JSON.stringify({ input: d.input, extras: d.extras, plan: d.plan }, null, 2))}</pre></details>`;
          h += `<p><button type="button" class="v-btn-ghost" id="qet-doc"${d.docHtml ? '' : ' disabled'}>예상 견적서 미리보기</button></p>`;
          body.innerHTML = h;
          lastDoc = d.docHtml;
          $('qet-doc')?.addEventListener('click', () => {
            if (!lastDoc) return;
            const w = window.open('', '_blank');
            if (!w) return;
            w.document.write(lastDoc);
            w.document.close();
            // 자동 인쇄하지 않는다 — 창 안의 버튼으로만 인쇄(quote-doc.ts 규칙과 같음)
            w.document.getElementById('vn-doc-print')?.addEventListener('click', () => w.print());
            w.document.getElementById('vn-doc-close')?.addEventListener('click', () => w.close());
          });
        };

        // ── 계산 ───────────────────────────────────────────────────────
        const run = async () => {
          const body = {
            form: {
              steps: readSteps(),
              repeatGroup: repOn.checked ? { from: repFrom.value, to: repTo.value, count: val('qet-rep-count') } : null,
              measurements: Array.from(form.querySelectorAll('input[name="measurements"]:checked')).map((el) => el.value),
              sampleCount: val('q-sample-count'),
              delivery: val('q-delivery'),
              substrateType: val('q-substrate-type'),
              substrateSize: val('q-substrate-size'),
              substrateGrade: gradeVisible() ? val('qet-grade') : '',
              locale: EN ? 'en' : 'ko',
            },
            doc: { name: val('q-name'), company: val('q-company'), productName: form.dataset.productName ?? '' },
          };
          try {
            const res = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const j = await res.json().catch(() => null);
            if (!j?.ok) throw new Error(j?.message ?? j?.error ?? `HTTP ${res.status}`);
            showCustomer(j.customer);
            showDebug(j.debug);
          } catch (e) {
            out.hidden = false;
            out.className = 'qet-result qet-bad';
            out.innerHTML = `<p>${esc(T.fail)}</p>`;
            $('qet-debug-body').innerHTML = `<pre>${esc(String(e))}</pre>`;
          }
        };
        document.addEventListener('click', (e) => { if (e.target?.closest?.('#qet-run')) run(); });

        fetch(API).then((r) => r.json()).then((j) => {
          const lg = j?.importLog;
          $('qet-meta').textContent = j?.ok ? `로컬 가격 DB${lg ? ` · ${lg.imported_at} · ${lg.rules_version} · sha256 ${lg.sha256}` : ''}` : (j?.hint ?? '가격 DB 확인 실패');
        }).catch(() => { $('qet-meta').textContent = '가격 DB 확인 실패'; });
      })();
    </script>
  </div>
)}
