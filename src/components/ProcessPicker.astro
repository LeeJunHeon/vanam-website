---
// 공정 의뢰 선택 창 — 박막 증착 서비스 4종 중 하나를 고르면 그 제품 페이지의 견적 요청서(#quote)로 간다.
// 여는 쪽: data-process-open 을 단 링크(홈 히어로 [공정 의뢰] · 문의 페이지 '공정 의뢰는 여기를 클릭하세요').
// 그 링크의 href 는 제품 목록(/product)이라 JS 가 없거나 새 탭으로 열면 그냥 목록으로 간다.
// 선택지는 products 컬렉션에서 뽑는다(category 'coating' · 게시된 것 · order 순) — 제품을 추가/숨기면 여기도 따라온다.
// 네이티브 <dialog>.showModal(): 배경 비활성·Esc 닫기·포커스 가두기는 브라우저가 맡는다.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteData from '../data/site.json';
import { CATEGORY_TO_PRODUCT } from '../lib/material-value.js';

const locale = Astro.currentLocale ?? 'en';
const isKo = locale === 'ko';
const site = siteData[locale] ?? siteData.en;
const t = site.processPicker;
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
// 카드 둘째 줄 — 그 제품 페이지에서 고를 수 있는 라이브러리 소재(소재 CTA 가 그 제품으로 보내는 분류) 앞 3개 + 나머지 수.
// 라이브러리 order 순, 같은 화학식(Sputter·ALD 중복)은 하나로. 대응 소재가 없는 제품(다층)은 한 줄 소개를 쓴다.
const library = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const SHOW = 3;
function materialHint(productId: string): string | null {
  const formulas = [...new Set(library.filter((m) => CATEGORY_TO_PRODUCT[m.data.category] === productId).map((m) => m.data.formula))];
  if (!formulas.length) return null;
  const rest = formulas.length - SHOW;
  const head = formulas.slice(0, SHOW).join(' · ');
  // 꼬리(외 N종)는 줄바꿈으로 떨어지지 않게 나눔 없는 공백( )으로 붙인다
  return rest > 0 ? `${head} ${isKo ? `외 ${rest}종` : `+${rest} more`}` : head;
}

const services = (await getCollection('products'))
  .filter((p) => p.data.published && p.data.category === 'coating')
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    name: isKo ? p.data.name : (p.data.name_en ?? p.data.name),
    line2: materialHint(p.id) ?? (isKo ? p.data.summary : (p.data.summary_en ?? p.data.summary)),
    img: p.data.image ? productImages[p.data.image]?.default : undefined,
    href: `${lhref(`/product/${p.id}`)}#quote`,
  }));
---

<dialog id="process-picker" aria-labelledby="pp-title" aria-describedby="pp-intro"
  class="pp m-auto max-h-[min(88dvh,46rem)] w-[min(48rem,calc(100vw-2rem))] max-w-none overflow-y-auto overscroll-contain rounded-2xl border border-ink/10 bg-canvas p-0 text-ink shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-[2px]">
  <div class="p-5 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="pp-title" class="break-keep text-xl font-semibold leading-snug text-ink sm:text-2xl">{t.title}</h2>
        <p id="pp-intro" class="mt-1.5 break-keep text-sm leading-relaxed text-ink/60">{t.intro}</p>
      </div>
      <button type="button" data-pp-close aria-label={t.close}
        class="-mr-1.5 -mt-1 shrink-0 rounded-full p-2 text-ink/50 transition hover:bg-ink/5 hover:text-ink">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {services.map((s) => (
        <li>
          <a href={s.href} data-pp-option={s.id}
            class="group flex items-center gap-4 rounded-xl border border-ink/10 bg-ink/[0.02] p-3 transition hover:border-accent/60 hover:bg-accent/[0.06]">
            <span class="h-14 w-[4.5rem] shrink-0 overflow-hidden rounded-lg bg-gradient-to-br from-panel2 to-canvas sm:h-16 sm:w-[5.25rem]">
              {s.img && <Image src={s.img} alt="" width={168} height={128} class="h-full w-full object-cover" />}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold leading-snug text-ink transition group-hover:text-accent">{s.name}</span>
              <span class="mt-0.5 line-clamp-2 block break-keep text-sm leading-snug text-ink/55">{s.line2}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              class="shrink-0 text-ink/30 transition group-hover:translate-x-0.5 group-hover:text-accent"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6 break-keep border-t border-ink/10 pt-4 text-sm text-ink/60">
      {t.unsure} <a href={lhref('/contact')} class="ml-1 font-medium text-accent underline-offset-4 hover:underline">{t.unsureCta} →</a>
    </p>
  </div>
</dialog>

<style>
  /* 열릴 때만 짧게 떠오른다. 동작 줄이기 설정이면 생략. */
  .pp[open] { animation: pp-in 0.18s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes pp-in { from { opacity: 0; transform: translateY(10px) scale(0.985); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pp[open] { animation: none; } }
  /* 열려 있는 동안 뒤 페이지 스크롤을 막는다. gutter 를 남겨 스크롤바가 사라지며 화면이 옆으로 튀지 않게. */
  :global(html.pp-lock) { overflow: hidden; scrollbar-gutter: stable; }
</style>

<script>
  (() => {
    const dlg = document.getElementById('process-picker') as HTMLDialogElement | null;
    // showModal 이 없는 아주 오래된 브라우저는 링크 기본 동작(제품 목록)으로 둔다.
    if (!dlg || typeof dlg.showModal !== 'function') return;
    let opener: HTMLElement | null = null;

    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('[data-process-open]') as HTMLElement | null;
      if (!a) return;
      // 새 탭·수정키·가운데 클릭은 기본 동작(제품 목록으로 이동) 유지
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (dlg.open) return;
      opener = a;
      document.documentElement.classList.add('pp-lock');
      dlg.showModal();
    });

    dlg.addEventListener('close', () => {
      document.documentElement.classList.remove('pp-lock');
      opener?.focus({ preventScroll: true });
      opener = null;
    });
    // 바깥(배경) 클릭 → 닫기. 창 자체는 여백이 0 이라 target 이 dialog 면 배경을 누른 것이다.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelectorAll('[data-pp-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    // 뒤로가기(bfcache)로 돌아왔을 때 창이 열린 채 남지 않게
    window.addEventListener('pagehide', () => { if (dlg.open) dlg.close(); });
  })();
</script>
