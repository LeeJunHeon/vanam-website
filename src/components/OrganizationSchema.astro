---
// Organization JSON-LD.
// NOTE: logo 필드는 일시 제거됨. 기존 https://vanam.co.kr/logo.png 는 실제로
// 존재하지 않아(404) 검색엔진에 깨진 로고를 알리는 문제가 있었음. logo 는
// 선택 필드라 없어도 유효한 스키마가 됨. 실제 로고 파일이 확보되면 적정 크기
// 래스터(PNG/JPG, 권장 ≥112×112)를 public/ 에 올린 뒤 아래에 다시 추가할 것:
//   "logo": "https://vanam.co.kr/<로고파일>",
const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "VanaM Inc.",
  "alternateName": ["VANAM", "반암"],
  "url": "https://vanam.co.kr",
  "slogan": "Thin Films, All Around",
  "description": "Developer and manufacturer of next-generation semiconductor thin films based on an eco-friendly vacuum deposition process.",
  "foundingDate": "2022",
  "email": "hello@vanam.co.kr",
  "telephone": "+82-2-6951-0922",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "KR",
    "addressRegion": "Seoul",
    "addressLocality": "Yeongdeungpo-gu",
    "streetAddress": "21-1 Dosin-ro 4-gil",
    "postalCode": "07377"
  },
  "sameAs": [
    "https://www.linkedin.com/in/vanam-inc-62395132b/",
    "https://www.youtube.com/@VanaMaterials"
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
