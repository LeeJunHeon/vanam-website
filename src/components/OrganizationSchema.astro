---
// Organization JSON-LD.
// logo (0253 복원): 과거 /logo.png 가 404 라 일시 제거했었다.
// 실제 로고(src/assets/brand/logo.png, 640×155 — 양변 ≥112px 충족)를 public/logo.png 로
// 배포해 고정 URL 로 복원한다. 해시 URL 을 안 쓰는 이유: 스키마 로고가 빌드마다 바뀌면
// 검색엔진 캐시가 매번 무효화되기 때문.
const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "VanaM Inc.",
  "alternateName": ["VANAM", "반암"],
  "url": "https://vanam.co.kr",
  "logo": "https://vanam.co.kr/logo.png",
  "slogan": "Thin Films, All Around",
  "description": "Developer and manufacturer of next-generation semiconductor thin films based on an eco-friendly vacuum deposition process.",
  "foundingDate": "2022",
  "email": "hello@vanam.co.kr",
  "telephone": "+82-2-6951-0922",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "KR",
    "addressRegion": "Seoul",
    "addressLocality": "Yeongdeungpo-gu",
    "streetAddress": "21-1 Dosin-ro 4-gil",
    "postalCode": "07377"
  },
  "sameAs": [
    "https://www.linkedin.com/company/vanaminc/",
    "https://www.youtube.com/@VanaMaterials",
    "https://smartstore.naver.com/ybjstore",
    "https://linktr.ee/vanaminc"
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
