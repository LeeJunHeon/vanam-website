---
// FAQPage JSON-LD. 화면의 FAQ 와 같은 원본(src/lib/faq.ts)에서 받은 항목을 그대로 쓴다 —
// 호출부(Contact.astro)가 화면에 그린 항목 목록을 items 로 넘긴다. 답은 같은 문장의 일반 텍스트다.
import type { FaqItem } from '../lib/faq';

interface Props { items: FaqItem[] }
const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---
{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
