---
// FAQPage JSON-LD. published:true 이고 answer가 비어있지 않은 항목만 포함. locale별 언어.
import { getCollection } from 'astro:content';

const locale = Astro.currentLocale ?? 'en';
const q = (f) => locale === 'en' ? (f.data.question_en ?? f.data.question) : f.data.question;
const a = (f) => locale === 'en' ? (f.data.answer_en ?? f.data.answer) : f.data.answer;

const faqs = (await getCollection('faq'))
  .filter((f) => f.data.published && f.data.answer.trim() !== '')
  .sort((a, b) => a.data.order - b.data.order);

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": q(f),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a(f),
    },
  })),
};
---
{faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
