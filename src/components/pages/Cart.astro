---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.cartPage;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';

// 장바구니는 브라우저에 {sku, qty}만 저장한다. 이름·가격은 항상 이 카탈로그에서 조회한다.
// (가격을 브라우저에 저장하면 조작될 수 있고, 관리자가 가격을 바꿔도 반영되지 않는다)
const catalog = (await getCollection('products'))
  .filter((p) => p.data.published && p.data.pricingType === 'fixed' && typeof p.data.price === 'number')
  .map((p) => ({
    sku: p.id,
    name: isKo ? p.data.name : (p.data.name_en ?? p.data.name),
    price: p.data.price,
    url: `${base}/product/${p.id}`,
  }));

// 웨이퍼(공정가) — sku 'wafer:{id}' (서버 /api/order 와 동일 규칙)
const waferCatalog = (await getCollection('wafers'))
  .filter((w) => w.data.published !== false && typeof w.data.priceKrw === 'number' && w.data.priceKrw > 0)
  .map((w) => ({
    sku: `wafer:${w.id}`,
    name: isKo ? w.data.name : ((w.data as Record<string, unknown>).name_en as string ?? w.data.name),
    price: w.data.priceKrw as number,
    url: `${base}/wafers/${w.id}`,
  }));

// 견적 품목 — 견적 제품(고정가 아님) + 가격 미정 웨이퍼. 결제 합계에서 제외되고 견적 요청으로 안내한다.
const quoteCatalog = [
  ...(await getCollection('products'))
    .filter((p) => p.data.published && !(p.data.pricingType === 'fixed' && typeof p.data.price === 'number'))
    .map((p) => ({
      sku: p.id,
      name: isKo ? p.data.name : (p.data.name_en ?? p.data.name),
      price: 0,
      quote: true,
      url: `${base}/product/${p.id}#quote`,
    })),
  ...(await getCollection('wafers'))
    .filter((w) => w.data.published !== false && !(typeof w.data.priceKrw === 'number' && w.data.priceKrw > 0))
    .map((w) => ({
      sku: `wafer:${w.id}`,
      name: isKo ? w.data.name : ((w.data as Record<string, unknown>).name_en as string ?? w.data.name),
      price: 0,
      quote: true,
      url: `${base}/wafers/${w.id}#quote`,
    })),
];
---

<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <section class="relative mx-auto max-w-4xl px-6 py-28 md:py-36">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.eyebrow}</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{c.heading}</h1>

    <div id="cart-root" class="mt-12"
      data-empty={c.empty}
      data-remove={c.remove}
      data-total={c.total}
      data-vat={s.vatIncluded}
      data-checkout={c.checkout}
      data-checkout-url={`${base}/checkout`}
      data-continue={c.continueShopping}
      data-shop-url={`${base}/product`}
      data-quote-badge={c.quoteBadge}
      data-quote-cta={c.quoteRowCta}
      data-quote-note={c.quoteNote}
      data-quote-only={c.quoteOnly}
      data-local-note={s.cartLocalNote}
      data-usd-rate={company.usdRate || 1500}>
      <p class="text-ink/50">…</p>
    </div>

    <script type="application/json" id="catalog" set:html={JSON.stringify([...catalog, ...waferCatalog, ...quoteCatalog])} is:inline></script>
  </section>
</BaseLayout>

<script>
  type Item = { sku: string; qty: number };
  type Product = { sku: string; name: string; price: number; url: string; quote?: boolean };

  const CART_KEY = 'vanam_cart';
  const root = document.getElementById('cart-root')!;
  const M = root.dataset;
  const catalog: Product[] = JSON.parse(document.getElementById('catalog')!.textContent ?? '[]');
  const byId = new Map(catalog.map((p) => [p.sku, p]));
  const won = (n: number) => new Intl.NumberFormat('ko-KR').format(n);
  const RATE = Number(M.usdRate) || 1500;
  const usd = (krw: number) =>
    '$' + (krw / RATE).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const read = (): Item[] => {
    try { return JSON.parse(localStorage.getItem(CART_KEY) ?? '[]'); } catch { return []; }
  };
  const write = (items: Item[]) => {
    localStorage.setItem(CART_KEY, JSON.stringify(items));
    document.querySelectorAll('.cart-count').forEach((el) => {
      el.textContent = String(items.reduce((s, i) => s + i.qty, 0));
    });
  };

  function render() {
    // localStorage 는 사용자가 마음대로 고칠 수 있다.
    // 카탈로그에 없는 항목은 제거하고, 수량은 반드시 1~99 정수로 강제한다.
    // (문자열이 그대로 innerHTML/속성에 들어가면 마크업이 깨지거나 주입될 수 있다)
    const items = read()
      .filter((i) => i && typeof i.sku === 'string' && byId.has(i.sku))
      .map((i) => ({ sku: i.sku, qty: Math.max(1, Math.min(99, Math.floor(Number(i.qty)) || 1)) }));
    write(items);

    if (items.length === 0) {
      root.innerHTML = `
        <p class="text-ink/50">${M.empty}</p>
        <a href="${M.shopUrl}" class="mt-6 inline-flex items-center gap-2 rounded-lg border border-ink/15 px-5 py-3 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">${M.continue} →</a>`;
      return;
    }

    const buyables = items.filter((i) => !byId.get(i.sku)!.quote);
    const hasQuote = buyables.length !== items.length;
    const total = buyables.reduce((sum, i) => sum + byId.get(i.sku)!.price * i.qty, 0);
    const rows = items.map((i) => {
      const p = byId.get(i.sku)!;
      return `
        <div class="flex flex-wrap items-center gap-4 py-5" data-sku="${p.sku}">
          <div class="min-w-0 flex-1">
            <a href="${p.url}" class="font-medium text-ink transition hover:text-accent">${p.name}</a>
            ${p.quote
              ? `<p class="mt-1"><span class="inline-flex rounded-full border border-accent/30 bg-accent/[0.06] px-2.5 py-0.5 text-xs font-semibold text-accent">${M.quoteBadge}</span></p>`
              : `<p class="mt-1 text-sm text-ink/50">${usd(p.price)} <span class="text-xs text-ink/30">(₩${won(p.price)})</span></p>`}
          </div>
          <div class="flex items-center gap-1">
            <button type="button" data-act="dec" class="size-9 rounded-lg border border-ink/15 text-ink/70 transition hover:border-accent hover:text-ink">−</button>
            <input type="number" min="1" max="99" value="${i.qty}" data-act="qty"
              class="h-9 w-14 rounded-lg border border-ink/10 bg-ink/[0.03] text-center text-ink outline-none focus:border-accent [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" />
            <button type="button" data-act="inc" class="size-9 rounded-lg border border-ink/15 text-ink/70 transition hover:border-accent hover:text-ink">+</button>
          </div>
          ${p.quote
            ? `<a href="${p.url}" class="w-28 shrink-0 text-right text-sm font-semibold text-accent transition hover:underline">${M.quoteCta}</a>`
            : `<p class="w-28 shrink-0 text-right font-semibold text-ink">${usd(p.price * i.qty)}</p>`}
          <button type="button" data-act="del" class="shrink-0 text-sm text-ink/40 transition hover:text-danger">${M.remove}</button>
        </div>`;
    }).join('');

    root.innerHTML = `
      <div class="divide-y divide-ink/10 border-y border-ink/10">${rows}</div>
      <div class="mt-8 flex items-end justify-between">
        <p class="text-sm text-ink/50">${M.total} <span class="ml-1 text-xs text-ink/30">(${M.vat})</span></p>
        <div class="text-right">
          <p class="text-3xl font-bold text-ink">${usd(total)}</p>
          <p class="mt-1 text-xs text-ink/35">≈ ₩${won(total)}</p>
        </div>
      </div>
      ${hasQuote ? `<p class="mt-3 text-sm leading-relaxed text-ink/50">${M.quoteNote}</p>` : ''}
      <div class="mt-8">
        ${buyables.length > 0
          ? `<a href="${M.checkoutUrl}"
              class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">${M.checkout}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>`
          : `<p class="text-sm font-medium text-ink/50">${M.quoteOnly}</p>`}
      </div>
      <a href="${M.shopUrl}" class="mt-6 inline-block text-sm text-ink/50 transition hover:text-accent">← ${M.continue}</a>
      <p class="mt-8 text-xs leading-relaxed text-ink/35">${M.localNote}</p>`;
  }

  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null;
    if (!btn || btn.tagName === 'INPUT') return;
    const sku = btn.closest('[data-sku]')!.getAttribute('data-sku')!;
    const items = read();
    const hit = items.find((i) => i.sku === sku);
    if (!hit) return;

    const act = btn.dataset.act;
    if (act === 'inc') hit.qty = Math.min(99, hit.qty + 1);
    else if (act === 'dec') hit.qty = Math.max(1, hit.qty - 1);
    else if (act === 'del') items.splice(items.indexOf(hit), 1);
    else return;

    write(items);
    render();
  });

  root.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.dataset.act !== 'qty') return;
    const sku = input.closest('[data-sku]')!.getAttribute('data-sku')!;
    const items = read();
    const hit = items.find((i) => i.sku === sku);
    if (!hit) return;
    hit.qty = Math.max(1, Math.min(99, parseInt(input.value, 10) || 1));
    write(items);
    render();
  });

  render();
</script>
