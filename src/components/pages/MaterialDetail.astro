---
// 물질 상세 페이지.
//   Technology 의 물질 배지를 누르면 이 페이지로 온다.
//   ⚠️ 상세 이미지·설명은 추후 제공 예정 → 지금은 "준비 중" placeholder 로 처리해
//      콘텐츠가 비어도 페이지가 깨지지 않게 한다. (image 필드가 채워지면 자동으로 이미지 노출)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { material } = Astro.props;
const d = material.data;
const locale = Astro.currentLocale ?? 'en';
const isKo = locale === 'ko';

// 표시용 명칭: name(정식명)이 있으면 쓰고, 없으면 formula(화학식)로 대체
const displayName = isKo
  ? (d.name_ko ?? d.name ?? d.formula)
  : (d.name ?? d.formula);
const desc = isKo ? (d.description_ko ?? d.description) : d.description;

const catLabel = isKo
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속', Semiconductor: '반도체' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal', Semiconductor: 'Semiconductor' };
const sysLabel = d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator';

// 상세 이미지: 파일이 실제로 있을 때만 최적화 생성. 없으면 null → placeholder 표시.
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
let detailImg: Awaited<ReturnType<typeof getImage>> | null = null;
if (d.image && matImages[d.image]) {
  const mod = await matImages[d.image]();
  detailImg = await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 90 });
}

// ── A4 사양 레이아웃 자산 (materials/<id>/fig-*.webp, target.webp) ──
const matDir = `/src/assets/materials/${material.id}`;
async function resolveAsset(name: string) {
  const key = `${matDir}/${name}`;
  if (!matImages[key]) return null;
  const mod = await matImages[key]();
  return await getImage({ src: mod.default, width: 900, format: 'webp', quality: 88 });
}
const figImgs: { src: string }[] = [];
for (const f of d.figs ?? []) {
  const g = await resolveAsset(f);
  if (g) figImgs.push(g);
}
const targetPhoto = d.targetImg ? await resolveAsset(d.targetImg) : null;
const hasA4 = (d.filmSpecs?.length ?? 0) + (d.band2Specs?.length ?? 0) + figImgs.length > 0;

const backHref = isKo ? '/ko/technology' : '/technology';
const t = {
  back: isKo ? '← 기술 소개로' : '← Back to Technology',
  system: isKo ? '증착 방식' : 'Deposition',
  category: isKo ? '분류' : 'Category',
  formula: isKo ? '화학식' : 'Formula',
  imgSoon: isKo ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  descSoon: isKo ? '상세 설명이 곧 추가됩니다.' : 'A detailed description will be added soon.',
  cta: isKo ? '이 물질로 견적 문의' : 'Request a quote for this material',
};
// 물질 분류 → 해당 제품 페이지. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const catToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };
const productId = catToProduct[d.category] ?? null;
const quoteHref = productId
  ? (isKo ? `/ko/product/${productId}` : `/product/${productId}`)
  : (isKo ? '/ko/contact' : '/contact');
---

<BaseLayout title={`${displayName} | VanaM`} description={desc ?? `${displayName} — VanaM thin-film material`}>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <a href={backHref} class="text-sm text-ink/55 transition hover:text-accent">{t.back}</a>

    <div class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-2">
      <h1 class="text-4xl font-bold text-ink">{displayName}</h1>
      <span class="rounded-md border border-accent/30 bg-accent/[0.06] px-2.5 py-1 text-lg font-semibold text-accent">{d.formula}</span>
    </div>

    <!-- 메타 정보 -->
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div><span class="text-ink/45">{t.system}: </span><span class="text-ink/80">{sysLabel}</span></div>
      <div><span class="text-ink/45">{t.category}: </span><span class="text-ink/80">{catLabel[d.category]}</span></div>
      <div><span class="text-ink/45">{t.formula}: </span><span class="text-ink/80">{d.formula}</span></div>
    </div>

    <!-- A4 사양 레이아웃 (PPT 이식) — 구조화 데이터가 있으면 슬라이드 구성 그대로,
         없으면 기존 이미지·설명 폴백 -->
    {hasA4 ? (
      <>
        {desc && <p class="mt-8 max-w-3xl whitespace-pre-line text-[15px] leading-relaxed text-ink/65">{desc}</p>}

        <div class="mt-10 flex items-center gap-3">
          <span class="h-6 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          <h2 class="text-2xl font-bold text-ink">Specifications</h2>
        </div>

        <div class="mt-6">
          <p class="v-badge">Thin-Film Specifications</p>
          {figImgs.length > 0 && (
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {figImgs.map((g, i) => (
                <div class="flex items-center justify-center rounded-xl border border-ink/10 bg-plate p-2">
                  <img src={g.src} alt={`${displayName} characterization data ${i + 1}`} class="max-h-64 w-auto max-w-full" loading="lazy" />
                </div>
              ))}
            </div>
          )}
          {(d.filmSpecs?.length ?? 0) > 0 && (
            <ul class="mt-4 space-y-1.5 border-l-2 border-accent/50 pl-4">
              {(d.filmSpecs ?? []).map((s) => {
                const i = s.indexOf(':');
                const split = i > 0 && i < 44;
                return (
                  <li class="text-[13px] leading-relaxed text-ink/70">
                    {split ? (
                      <>
                        <span class="font-semibold text-ink/85">{s.slice(0, i).trim()}</span>
                        <span> : {s.slice(i + 1).trim()}</span>
                      </>
                    ) : (
                      s
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>

        {((d.band2Specs?.length ?? 0) > 0 || targetPhoto) && (
          <div class="mt-8">
            <p class="v-badge">{d.band2Title ?? 'Target Specifications'}</p>
            <div class="mt-4 flex flex-wrap items-start gap-6">
              <ul class="min-w-0 flex-1 space-y-1.5 border-l-2 border-accent/50 pl-4">
                {(d.band2Specs ?? []).map((s) => {
                  const i = s.indexOf(':');
                  const split = i > 0 && i < 44;
                  return (
                    <li class="text-[13px] leading-relaxed text-ink/70">
                      {split ? (
                        <>
                          <span class="font-semibold text-ink/85">{s.slice(0, i).trim()}</span>
                          <span> : {s.slice(i + 1).trim()}</span>
                        </>
                      ) : (
                        s
                      )}
                    </li>
                  );
                })}
              </ul>
              {targetPhoto && (
                <div class="w-44 shrink-0 rounded-xl border border-ink/10 bg-plate p-3 text-center">
                  <img src={targetPhoto.src} alt={`${displayName} sputtering target`} class="mx-auto w-full" loading="lazy" />
                  <span class="mt-2 inline-block rounded bg-ink/80 px-2.5 py-0.5 text-[11px] font-bold tracking-wide text-canvas">Target</span>
                </div>
              )}
            </div>
          </div>
        )}
      </>
    ) : (
      <>
        <!-- 상세 이미지 (있으면 노출, 없으면 placeholder) -->
        <div class="mt-10 overflow-hidden v-card">
          {detailImg ? (
            <img src={detailImg.src} alt={displayName} class="w-full" loading="lazy" />
          ) : (
            <div class="flex aspect-[16/9] flex-col items-center justify-center gap-3 text-center">
              <svg class="h-12 w-12 text-ink/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" />
              </svg>
              <p class="text-sm text-ink/40">{t.imgSoon}</p>
            </div>
          )}
        </div>

        <!-- 상세 설명 (있으면 노출, 없으면 placeholder) -->
        <div class="mt-10 max-w-3xl">
          {desc ? (
            <p class="whitespace-pre-line text-base leading-relaxed text-ink/75">{desc}</p>
          ) : (
            <p class="text-base text-ink/40">{t.descSoon}</p>
          )}
        </div>
      </>
    )}

    <!-- 견적 문의 CTA -->
    <div class="mt-12">
      <a href={quoteHref}
        class="v-btn-sm">
        {t.cta} →
      </a>
    </div>
  </section>
</BaseLayout>
