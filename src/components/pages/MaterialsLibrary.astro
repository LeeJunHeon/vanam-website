---
// Materials Library 전용 페이지 (0166, 구조 개편 2/3)
// 구 Technology 의 소재 섹션(배지 그리드)과 모달 패널 콘텐츠를 원문 이식해
// "상단 인덱스 → 하단 전체 상세 카드" 로 재구성. 배지 클릭 = 해당 카드로 스크롤(+하이라이트).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import PeriodicBg from '../materials/PeriodicBg.astro';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const tech = site.technology;
const title = `${tech.materialsHeading} | ${locale === 'ko' ? '반암(VanaM)' : 'VanaM'}`;
const description = tech.materialsLibraryDesc;
const about = site.about; // CTA 문구는 구 About 원문 사용 (0172 — tech 와 중복 회피)

// materials 컬렉션에서 system 별로 category→formula[] 그룹을 재구성.
// order 순으로 정렬해 기존 객체의 키/배열 순서를 그대로 보존한다.
const allMaterials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
function groupBySystem(system) {
  const groups = {};
  for (const m of allMaterials) {
    if (m.data.system !== system) continue;
    // 물질 상세 팝업을 위해 formula 와 id(파일명=slug)를 함께 보관
    (groups[m.data.category] ??= []).push({ formula: m.data.formula, id: m.id });
  }
  return groups;
}
const sputter = groupBySystem('sputter');
const ald = groupBySystem('ald');

// 서비스·분석·장비·주문절차·응용분야 섹션은 Product 페이지로 이동/삭제됨 (2026-07 개편)

// 소재 카테고리 라벨 (표시용) — 로직(enum)은 그대로, 표시만 locale별.
const catLabel = locale === 'ko'
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속', Semiconductor: '반도체' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal', Semiconductor: 'Semiconductor' };

// 물질 분류 → 해당 제품 페이지 ID. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const matToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };

// ── 물질 상세 팝업(모달)용 데이터 ──────────────────────────
//   배지를 누르면 페이지 이동 대신 모달로 표시한다.
//   빌드 타임에 물질 데이터를 JSON 으로 만들어 페이지에 심고, 클릭 시 클라이언트에서 채운다.
//   이미지는 파일이 실제로 있을 때만 최적화 생성 → 없으면 placeholder. (MaterialDetail 과 동일 로직)
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
// 팝업 패널 데이터: A4 구성(도판·사양·타깃)을 서버에서 미리 최적화·조립한다.
// 패널은 실제 HTML 로 렌더되어 hidden 토글만 하므로 /technology 자체가 SEO 대상이 된다.
type MatPanel = {
  id: string; formula: string; name: string; system: string; category: string;
  quoteHref: string; desc: string; figs: string[]; targetSrc: string;
  filmSpecs: string[]; band2Title: string; band2Specs: string[]; hasA4: boolean;
};
const matPanels: MatPanel[] = [];
for (const m of allMaterials) {
  const d = m.data;
  const figs: string[] = [];
  for (const f of d.figs ?? []) {
    const key = `/src/assets/materials/${m.id}/${f}`;
    if (matImages[key]) {
      const mod = await matImages[key]();
      figs.push((await getImage({ src: mod.default, width: 900, format: 'webp', quality: 88 })).src);
    }
  }
  let targetSrc = '';
  if (d.targetImg) {
    const key = `/src/assets/materials/${m.id}/${d.targetImg}`;
    if (matImages[key]) {
      const mod = await matImages[key]();
      targetSrc = (await getImage({ src: mod.default, width: 520, format: 'webp', quality: 88 })).src;
    }
  }
  const filmSpecs = d.filmSpecs ?? [];
  const band2Specs = d.band2Specs ?? [];
  matPanels.push({
    id: m.id,
    formula: d.formula,
    name: locale === 'ko' ? (d.name_ko ?? d.name ?? d.formula) : (d.name ?? d.formula),
    system: d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator',
    category: catLabel[d.category],
    quoteHref: lhref(matToProduct[d.category] ? `/product/${matToProduct[d.category]}` : '/contact'),
    desc: (locale === 'ko' ? (d.description_ko ?? d.description) : d.description) ?? '',
    figs,
    targetSrc,
    filmSpecs,
    band2Title: d.band2Title ?? 'Target Specifications',
    band2Specs,
    hasA4: filmSpecs.length + band2Specs.length + figs.length > 0,
  });
}
const mt = {
  system: locale === 'ko' ? '증착 방식' : 'Deposition',
  category: locale === 'ko' ? '분류' : 'Category',
  imgSoon: locale === 'ko' ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  preparing: locale === 'ko' ? '상세 자료를 준비 중입니다. 견적 문의는 아래 버튼으로 가능합니다.' : 'Detailed data is being prepared. You can still request a quote below.',
  cta: locale === 'ko' ? '이 물질로 견적 문의' : 'Request a quote for this material',
  close: locale === 'ko' ? '닫기' : 'Close',
};

// SEO(0169): 아코디언 본문(HTML 내 존재 = 색인 대상)과 별개로, 소재 전목록을 기계가독 형태로 명시 제공
const materialsLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  numberOfItems: matPanels.length,
  itemListElement: matPanels.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    // ⚠️ 'Product' 로 쓰면 안 된다.
    //    구글은 Product 에 offers·review·aggregateRating 중 하나를 **필수**로 요구하는데,
    //    이 소재들은 가격이 아니라 '문의' 기반이라 셋 다 넣을 수 없다.
    //    그래서 49개 전부 "잘못된 항목"으로 잡혔다(Search Console 제품 스니펫 오류).
    //    억지로 가격을 지어내면 가이드라인 위반이므로, 의미에 맞는 'Thing' 으로 둔다.
    // ⚠️ url 도 49개가 전부 목록 페이지를 가리키고 있었다 → 각자의 상세 페이지로 바꾼다.
    //    UI 진입 경로가 없는 상세 페이지들에게 유일한 발견 통로가 되어 준다.
    item: {
      '@type': 'Thing',
      name: p.name ? `${p.formula} (${p.name})` : p.formula,
      description: `${p.system} · ${p.category}`,
      url: new URL(lhref(`/materials/${p.id}`), Astro.site).href,
    },
  })),
};
---
<BaseLayout title={title} description={description} zebra>

  <section class="relative overflow-hidden">
    {/* 주기율표 배경 — 본문과 같은 컨테이너(max-w-6xl + px-6) 안에 두어 콘텐츠 라인을 벗어나지 않게 한다.
        이전에는 섹션 기준 right-0 이라 화면 오른쪽 끝까지 삐져나갔다. 마스크·불투명도는 그대로. */}
    <div class="pointer-events-none absolute inset-0 flex justify-center" aria-hidden="true">
      <div class="flex w-full max-w-6xl px-6">
        <div class="ml-auto w-full text-ink opacity-[0.32] md:w-[64%] dark:opacity-[0.40]"
          style="-webkit-mask-image: radial-gradient(ellipse 75% 70% at 70% 45%, #000 30%, transparent 78%); mask-image: radial-gradient(ellipse 75% 70% at 70% 45%, #000 30%, transparent 78%);">
          <PeriodicBg />
        </div>
      </div>
    </div>
    <div class="relative v-wrap pt-28 pb-12 md:pt-36">
      <div class="v-reveal">
        <h1 class="text-4xl font-bold leading-tight text-ink md:text-5xl">{tech.materialsHeading}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/60">{tech.materialsLibraryDesc}</p>
      </div>
    </div>
  </section>

  <section>
    <div class="v-wrap py-16">
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="v-reveal v-card p-7">
        {/* h1(페이지 제목) 바로 다음 단계여야 한다. h3 이면 단계를 건너뛰어 접근성 감점(제목 순서). */}
        <h2 class="text-lg font-bold text-accent">PVD — Sputter &amp; Evaporator</h2>
        {Object.entries(sputter).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="v-reveal v-card p-7">
        <h2 class="text-lg font-bold text-accent">ALD</h2>
        {Object.entries(ald).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </section>


  <section>
    <div class="v-wrap py-24 text-center">
      <div class="v-reveal">
        <h2 class="text-3xl font-bold text-ink md:text-4xl" set:html={about.ctaHeadingHtml}></h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-ink/60" set:html={about.ctaBodyHtml}></p>
        <a href={lhref('/contact')} class="mt-8 v-btn">{about.ctaButton}</a>
      </div>
    </div>
  </section>
  <!-- ── 물질 상세 팝업(모달) ──────────────────────────────
       물질 배지를 누르면 이 모달이 열린다(페이지 이동 없음).
       내용은 아래 JSON 데이터에서 클라이언트가 채운다. 이미지 없으면 placeholder. -->
  <div
    id="mat-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label={locale === "ko" ? "물질 상세" : "Material details"}
  >
    <div class="mat-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="mat-panel relative max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl border border-ink/10 bg-canvas p-6 shadow-2xl md:p-8">
      <button
        type="button"
        class="mat-close absolute right-3 top-3 rounded-md p-2.5 text-ink/50 transition hover:bg-ink/10 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label={mt.close}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      {matPanels.map((p) => (
        <div data-mat-panel={p.id} class="hidden">
          <div class="pr-8">
            <h2 class="flex flex-wrap items-end gap-x-3 gap-y-1">
              <span class="text-5xl font-black leading-none tracking-tight text-ink">{p.formula}</span>
              <span class="pb-1 text-base font-medium text-ink/55">({p.name})</span>
            </h2>
            <div class="mt-3 flex flex-wrap gap-x-8 gap-y-1.5 text-sm">
              <div><span class="text-ink/45">{mt.system}: </span><span class="text-ink/80">{p.system}</span></div>
              <div><span class="text-ink/45">{mt.category}: </span><span class="text-ink/80">{p.category}</span></div>
            </div>
          </div>

          {p.hasA4 ? (
            <>
              <div class="mt-6 flex items-center gap-2.5">
                <span class="h-5 w-1 rounded-full bg-accent" aria-hidden="true"></span>
                <h3 class="text-xl font-bold text-ink">Specifications</h3>
              </div>

              <p class="mt-4 inline-flex items-center gap-2 rounded-md border border-accent/30 bg-accent/[0.08] px-3 py-1 text-[13px] font-bold text-accent">Thin-Film Specifications</p>
              {p.figs.length > 0 && (
                <div class={'mt-3 grid grid-cols-2 gap-2 ' + (p.figs.length <= 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3')}>
                  {p.figs.map((src, i) => (
                    <div class="flex items-center justify-center rounded-lg border border-ink/10 bg-plate p-1.5">
                      <img src={src} alt={`${p.name} characterization data ${i + 1}`} class="max-h-40 w-auto max-w-full" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
              {p.filmSpecs.length > 0 && (
                <ul class="mt-3.5 space-y-1.5 border-l-2 border-accent/50 pl-4">
                  {p.filmSpecs.map((sp) => {
                    const ci = sp.indexOf(':');
                    const split = ci > 0 && ci < 44;
                    return (
                      <li class="text-sm leading-relaxed text-ink/70">
                        {split ? (
                          <>
                            <span class="font-semibold text-ink/85">{sp.slice(0, ci).trim()}</span>
                            <span> : {sp.slice(ci + 1).trim()}</span>
                          </>
                        ) : (
                          sp
                        )}
                      </li>
                    );
                  })}
                </ul>
              )}

              {(p.band2Specs.length > 0 || p.targetSrc) && (
                <>
                  <p class="mt-6 inline-flex items-center gap-2 rounded-md border border-accent/30 bg-accent/[0.08] px-3 py-1 text-[13px] font-bold text-accent">{p.band2Title}</p>
                  <div class="mt-3.5 flex flex-wrap items-start gap-6">
                    {p.band2Specs.length > 0 && (
                      <ul class="min-w-0 flex-1 basis-60 space-y-1.5 border-l-2 border-accent/50 pl-4">
                        {p.band2Specs.map((sp) => {
                          const ci = sp.indexOf(':');
                          const split = ci > 0 && ci < 44;
                          return (
                            <li class="text-sm leading-relaxed text-ink/70">
                              {split ? (
                                <>
                                  <span class="font-semibold text-ink/85">{sp.slice(0, ci).trim()}</span>
                                  <span> : {sp.slice(ci + 1).trim()}</span>
                                </>
                              ) : (
                                sp
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {p.targetSrc && (
                      <div class="w-36 shrink-0 text-center sm:w-40">
                        <img src={p.targetSrc} alt={`${p.name} sputtering target`} class="mx-auto w-full rounded-lg drop-shadow-md" loading="lazy" />
                        <span class="mt-2 inline-block rounded bg-ink/80 px-3 py-0.5 text-[11px] font-bold tracking-wide text-canvas">Target</span>
                      </div>
                    )}
                  </div>
                </>
              )}
            </>
          ) : (
            <p class="mt-6 rounded-lg border border-dashed border-ink/20 bg-ink/[0.03] px-4 py-7 text-center text-sm text-ink/45">{mt.preparing}</p>
          )}

          <div class="mt-8">
            <a href={p.quoteHref} class="v-btn-sm">
              {mt.cta} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>


  <script>
    const modal = document.getElementById('mat-modal');
    if (modal) {
      const panels = modal.querySelectorAll<HTMLElement>('[data-mat-panel]');
      const scroller = modal.querySelector<HTMLElement>('.mat-panel');
      const closeBtn = modal.querySelector<HTMLElement>('.mat-close');
      const backdrop = modal.querySelector<HTMLElement>('.mat-backdrop');
      let lastFocused: HTMLElement | null = null;

      function open(id: string) {
        let found = false;
        panels.forEach((p) => {
          const on = p.getAttribute('data-mat-panel') === id;
          p.classList.toggle('hidden', !on);
          if (on) found = true;
        });
        if (!found) return;
        lastFocused = document.activeElement as HTMLElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        if (scroller) scroller.scrollTop = 0;
        closeBtn?.focus();
      }

      function close() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        lastFocused?.focus();
      }

      document.querySelectorAll<HTMLElement>('[data-mat]').forEach((btn) => {
        btn.addEventListener('click', () => open(btn.getAttribute('data-mat') || ''));
      });
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('flex')) close();
      });
    }
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(materialsLd)} />
</BaseLayout>
