---
// 주문서. 장바구니(고정가) 또는 견적(견적가) 양쪽에서 들어온다.
//   /checkout             → 장바구니 항목으로 주문
//   /checkout?quote=INQ-…  → 관리자가 금액을 책정한 견적으로 주문
//
// ⚠️ prerender=false 는 이 컴포넌트가 아니라 '페이지 파일'(src/pages/...)에 있어야 한다.
//    컴포넌트에 써두면 Astro가 읽지 않아 정적 생성되고, 쿼리스트링(?id=, ?quote=)을 못 읽는다.
//
// ⚠️ 금액은 화면에 "표시"만 한다. 실제 결제 금액은 서버(/api/order)가 다시 계산한다.
//
// 해외 주문: 국가를 먼저 고르고, 대한민국이면 (우편번호·주소·상세주소),
//            해외면 (Address 1·2 · City · State · Postal code) 를 받는다.
//            관세·수입부가세가 수령인 부담임을 고지한다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import company from '../../data/company.json';
import { COUNTRIES } from '../../lib/countries';
import { shipLabel, isCollect } from '../../lib/shipping';
import { db } from '../../lib/db';
import { getRate, pickWaitUntil } from '../../lib/fx';

const locale = (Astro.currentLocale ?? 'en') as 'ko' | 'en';
const isKo = locale === 'ko';
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

// ── 견적 주문이면 DB에서 확정 금액을 읽는다 ──
const quoteId = Astro.url.searchParams.get('quote') ?? '';
let quote: {
  id: string; product_sku: string | null; product_name: string | null;
  quoted_amount: number | null; name: string; email: string; status: string;
} | null = null;
let quoteError = '';

if (quoteId) {
  if (!/^INQ-\d{8}-[A-Z0-9]{4}$/.test(quoteId)) {
    quoteError = isKo ? '잘못된 견적 번호입니다.' : 'Invalid quote reference.';
  } else {
    const d = await db();
    if (!d) {
      quoteError = isKo ? '견적을 불러올 수 없습니다.' : 'Unable to load the quote.';
    } else {
      quote = await d
        .prepare(`SELECT id, product_sku, product_name, quoted_amount, name, email, status FROM inquiries WHERE id = ?`)
        .bind(quoteId)
        .first();
      if (!quote) quoteError = isKo ? '견적을 찾을 수 없습니다.' : 'Quote not found.';
      else if (!quote.quoted_amount) quoteError = isKo ? '아직 금액이 책정되지 않았습니다.' : 'This quote has not been priced yet.';
      else if (quote.status === 'closed') quoteError = isKo ? '종료된 견적입니다.' : 'This quote is closed.';
    }
  }
}

// ── 상품 카탈로그 (금액 표시 + 배송 필요 여부) ──
const all = await getCollection('products');
const products = all
  .filter((p) => p.data.published && p.data.pricingType === 'fixed' && typeof p.data.price === 'number')
  .map((p) => ({
    sku: p.id,
    name: locale === 'en' ? (p.data.name_en ?? p.data.name) : p.data.name,
    price: p.data.price as number,
    ship: p.data.requiresShipping !== false,
  }));

// 웨이퍼(공정가) — sku 'wafer:{id}', 물품이므로 배송 필요
const waferProducts = (await getCollection('wafers'))
  .filter((w) => w.data.published !== false && typeof w.data.priceKrw === 'number' && w.data.priceKrw > 0)
  .map((w) => ({
    sku: `wafer:${w.id}`,
    name: locale === 'en' ? ((w.data as Record<string, unknown>).name_en as string ?? w.data.name) : w.data.name,
    price: w.data.priceKrw as number,
    ship: true,
  }));

// 견적 주문의 배송 필요 여부는 원본 상품에서 가져온다
const quoteNeedsShipping = quote
  ? all.find((p) => p.id === quote!.product_sku)?.data.requiresShipping !== false
  : false;

const countries = COUNTRIES.map((c) => ({ code: c.code, label: isKo ? c.ko : c.en }));

// 배송비 정책 (Keystatic '사업자 정보'에서 국내/해외 각각 설정)
// 표시 환율은 서버가 저장한 라이브 값을 쓴다.
// 빌드 시점 company.usdRate 를 박아두면 환율이 바뀌어도 화면만 옛 금액에 머문다.
let liveRate = company.usdRate || 1500;
try {
  liveRate = (await getRate(await db(), pickWaitUntil(Astro.locals))).rate || liveRate;
} catch (e) {
  console.error('[checkout] 환율 조회 실패 — 폴백:', e);
}

const shipFeeDomestic = shipLabel(company.shipDomesticMode, locale);
const shipFeeIntl = shipLabel(company.shipIntlMode, locale);
const collectDomestic = isCollect(company.shipDomesticMode);
const collectIntl = isCollect(company.shipIntlMode);

const t = isKo
  ? {
      meta: '주문서 | VanaM', metaDesc: '주문 정보를 입력하고 결제를 진행합니다.',
      eyebrow: '주문서', heading: '주문 정보',
      empty: '장바구니가 비어 있습니다.', backToShop: '제품으로 돌아가기',
      buynowExpired: '주문 정보가 만료되었습니다. 상품 페이지에서 다시 시도해 주세요.',
      secBuyer: '주문자', secShip: '배송지', secTax: '세금계산서', secAgree: '확인 및 동의', secSummary: '주문 요약',
      desiredDate: '희망 완료일 (선택)', desiredDateShip: '희망 배송일 (선택)', desiredDatePh: '예: 2026-09 또는 자유롭게 기재',
      orderNote: '요청사항 (선택)', orderNotePh: '추가 요청·참고사항이 있으면 적어주세요',
      name: '이름', email: '이메일', phone: '연락처', company: '회사 / 소속',
      phoneHint: '해외 연락처는 국가번호를 포함해 주세요 (예: +1 555 000 0000)',
      noShip: '이 주문은 실물 배송이 없습니다. 결과는 입력하신 이메일로 안내드립니다.',
      shipSame: '주문자와 동일',
      shipName: '수령인', shipPhone: '수령인 연락처',
      country: '국가', countryOther: '국가명 직접 입력',
      zip: '우편번호', addr1: '주소', addr2: '상세 주소',
      addr1Intl: '주소 (Address line 1)', addr2Intl: '상세 주소 (Address line 2)',
      city: '도시 (City)', state: '주 / 도 (State / Province)',
      shipMemo: '배송 요청사항',
      customs: '해외 배송의 수입 관세·부가세 및 통관 비용은 수령인 부담입니다.',
      courier: '택배사 계정번호 (FedEx / DHL / UPS 등)',
      courierHint: '착불 배송이므로 수령인의 택배사 계정으로 배송비가 청구됩니다. 계정번호가 없으시면 비워두시고, 담당자가 별도로 안내드립니다.',
      taxWant: '세금계산서가 필요합니다 (사업자)',
      taxHint: '카드 결제 시에는 카드매출전표가 적격 증빙이 되어 세금계산서가 중복 발행되지 않습니다. 세금계산서가 필요하시면 가상계좌·계좌이체를 선택해 주세요.',
      taxIntl: '해외 주문에는 상업 송장(Commercial Invoice)을 이메일로 보내드립니다.',
      taxBizNo: '사업자등록번호', taxBizName: '상호', taxCeo: '대표자', taxEmail: '계산서 수신 이메일',
      privacy: '주문 처리를 위한 개인정보 수집·이용에 동의합니다.',
      agreeTerms: '주문 제작품(맞춤 코팅·주문 시편)과 착수된 분석 용역은 청약철회가 제한됨을 확인했으며, 이에 동의합니다.',
      agreeDetail: '이용자의 주문에 따라 개별 생산되는 재화는 「전자상거래법」 제17조 제2항 제5호에 따라 청약철회가 제한됩니다. 다만 하자·오배송의 경우에는 교환·환불이 가능합니다.',
      seePolicy: '환불·교환 정책 보기',
      shipping: '배송비', total: '총 결제 금액', vat: '부가세 포함',
      fxNote: '환율에 따라 가격이 변동될 수 있습니다.',
      submit: '결제하기', sending: '주문 생성 중…',
      errBiz: '사업자등록번호가 올바르지 않습니다.',
      errFail: '주문 생성에 실패했습니다. 잠시 후 다시 시도해 주세요.',
      errCaptcha: '봇 확인이 끝날 때까지 잠시 기다렸다가 다시 시도해주세요.',
      captchaHint: '보안 확인이 끝나면 결제 버튼이 활성화됩니다.',
      payMethod: '결제 방법',
      payPaypal: 'PayPal 결제',
      payPaypalNote: '해외 발행 카드 · 해외 PayPal 계정. 한국에서 발행된 카드는 PayPal 결제가 불가합니다.',
      payBank: '계좌이체 (국내)',
      payBankNote: '주문 접수 후 담당자가 이메일로 계좌를 안내드립니다. 세금계산서 발행 가능.',
      submitBank: '주문 접수하기',
    }
  : {
      meta: 'Checkout | VanaM', metaDesc: 'Enter your order details and pay.',
      eyebrow: 'Checkout', heading: 'Order details',
      empty: 'Your cart is empty.', backToShop: 'Back to products',
      buynowExpired: 'This order session has expired. Please start again from the product page.',
      secBuyer: 'Purchaser', secShip: 'Shipping', secTax: 'Tax invoice', secAgree: 'Confirm & agree', secSummary: 'Order summary',
      desiredDate: 'Desired completion (optional)', desiredDateShip: 'Preferred delivery date (optional)', desiredDatePh: 'e.g. 2026-09, or free text',
      orderNote: 'Additional requests (optional)', orderNotePh: 'Anything else we should know',
      name: 'Name', email: 'Email', phone: 'Phone', company: 'Company / Affiliation',
      phoneHint: 'Please include your country code (e.g. +1 555 000 0000)',
      noShip: 'This order does not require physical delivery. Results are sent to the email you provide.',
      shipSame: 'Same as purchaser',
      shipName: 'Recipient', shipPhone: 'Recipient phone',
      country: 'Country', countryOther: 'Country name',
      zip: 'Postal code', addr1: 'Address', addr2: 'Address line 2',
      addr1Intl: 'Address line 1', addr2Intl: 'Address line 2',
      city: 'City', state: 'State / Province',
      shipMemo: 'Delivery note',
      customs: 'Import duties, taxes and customs charges for international delivery are payable by the recipient.',
      courier: 'Courier account number (FedEx / DHL / UPS)',
      courierHint: 'Shipping is freight collect, so it will be billed to the recipient’s courier account. Leave blank if you do not have one and we will contact you.',
      taxWant: 'I need a Korean tax invoice (business)',
      taxHint: 'For card payments the card receipt is the qualifying document, so a separate tax invoice is not issued. If you need one, please choose virtual account or bank transfer.',
      taxIntl: 'A commercial invoice will be emailed to you for international orders.',
      taxBizNo: 'Business reg. no.', taxBizName: 'Company name', taxCeo: 'Representative', taxEmail: 'Invoice email',
      privacy: 'I agree to the collection and use of my personal data to process this order.',
      agreeTerms: 'I understand and agree that made-to-order items (custom coating, made-to-order samples) and commenced analysis services are not eligible for withdrawal.',
      agreeDetail: 'Goods produced individually to your order are excluded from withdrawal under the Act on Consumer Protection in Electronic Commerce. Defects and incorrect deliveries remain eligible for exchange or refund.',
      seePolicy: 'View refund policy',
      shipping: 'Shipping', total: 'Total', vat: 'VAT included',
      fxNote: 'Prices may vary with the exchange rate.',
      submit: 'Proceed to payment', sending: 'Creating order…',
      errBiz: 'The business registration number is not valid.',
      errFail: 'Could not create the order. Please try again.',
      errCaptcha: 'Please wait a moment for the verification to finish, then try again.',
      captchaHint: 'The payment button unlocks once the security check completes.',
      payMethod: 'Payment method',
      payPaypal: 'Pay with PayPal',
      payPaypalNote: 'Cards or PayPal accounts issued outside Korea. Korean-issued cards cannot be used.',
      payBank: 'Bank transfer (Korea)',
      payBankNote: 'We will email you the bank details after your order is received.',
      submitBank: 'Place order',
    };

const req = ' *';
const inputClass =
  'v-input';
const labelClass = 'block text-sm font-medium text-ink/80';
const legendClass = 'text-sm font-medium uppercase tracking-widest text-accent';
---

<BaseLayout title={t.meta} description={t.metaDesc}>
  <section class="mx-auto max-w-5xl px-6 py-28 md:py-32">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{t.eyebrow}</p>
    <h1 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">{t.heading}</h1>

    {quoteError ? (
      <div class="mt-10 rounded-xl border border-warn/30 bg-warn/10 p-6">
        <p class="text-warn">{quoteError}</p>
        <a href={lhref('/product')} class="mt-4 inline-block text-sm text-accent hover:underline">{t.backToShop} →</a>
      </div>
    ) : (
      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_20rem]">
        <form id="checkout-form" class="space-y-12"
          data-quote={quote?.id ?? ''}
          data-quote-ship={quote ? String(quoteNeedsShipping) : ''}
          data-msg-biz={t.errBiz}
          data-msg-fail={t.errFail}
          data-msg-captcha={t.errCaptcha}
          data-label-send={t.submit}
          data-label-send-bank={t.submitBank}
          data-label-sending={t.sending}
          data-buynow-expired={t.buynowExpired}>
          <div class="absolute left-[-9999px]" aria-hidden="true">
            {/* 스팸 방지 미끼칸. 이름에 email 이 들어가면 크롬 자동완성이 채워버려 정상 주문이 막힌다 → 중립적 이름 사용 */}
            <input type="text" name="vanam_hp_note" tabindex="-1" autocomplete="new-password" />
          </div>

          <fieldset>
            <legend class={legendClass}>{t.secBuyer}</legend>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div>
                <label for="buyerName" class={labelClass}>{t.name}{req}</label>
                <input id="buyerName" name="buyerName" type="text" required autocomplete="name" class={inputClass} value={quote?.name ?? ''} />
              </div>
              <div>
                <label for="buyerEmail" class={labelClass}>{t.email}{req}</label>
                <input id="buyerEmail" name="buyerEmail" type="email" required autocomplete="email" class={inputClass} value={quote?.email ?? ''} />
              </div>
              <div>
                <label for="buyerPhone" class={labelClass}>{t.phone}{req}</label>
                <input id="buyerPhone" name="buyerPhone" type="tel" required autocomplete="tel" class={inputClass} />
                <p class="mt-1.5 text-xs text-ink/35">{t.phoneHint}</p>
              </div>
              <div>
                <label for="buyerCompany" class={labelClass}>{t.company}</label>
                <input id="buyerCompany" name="buyerCompany" type="text" autocomplete="organization" class={inputClass} />
              </div>
              <div class="sm:col-span-2">
                <label for="desiredDate" class={labelClass}>{quote ? t.desiredDate : t.desiredDateShip}</label>
                <input id="desiredDate" name="desiredDate" type="text" class={inputClass} placeholder={t.desiredDatePh} />
              </div>
              <div class="sm:col-span-2">
                <label for="orderNote" class={labelClass}>{t.orderNote}</label>
                <textarea id="orderNote" name="orderNote" rows="3" class={`${inputClass} resize-y`} placeholder={t.orderNotePh}></textarea>
              </div>
            </div>
          </fieldset>

          <fieldset id="ship-section" hidden>
            <legend class={legendClass}>{t.secShip}</legend>

            <label class="mt-5 flex cursor-pointer items-center gap-3 text-sm text-ink/70">
              <input type="checkbox" id="ship-same" checked class="size-4 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
              <span>{t.shipSame}</span>
            </label>

            <div class="mt-5 space-y-6">
              <div id="ship-person" class="grid gap-6 md:grid-cols-2" hidden>
                <div>
                  <label for="shipName" class={labelClass}>{t.shipName}{req}</label>
                  <input id="shipName" name="shipName" type="text" class={inputClass} />
                </div>
                <div>
                  <label for="shipPhone" class={labelClass}>{t.shipPhone}{req}</label>
                  <input id="shipPhone" name="shipPhone" type="tel" class={inputClass} />
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <label for="shipCountry" class={labelClass}>{t.country}{req}</label>
                  <select id="shipCountry" name="shipCountry" class={inputClass}>
                    {countries.map((c) => (
                      <option value={c.code} selected={isKo && c.code === 'KR'}>{c.label}</option>
                    ))}
                  </select>
                </div>
                <div id="country-other-wrap" hidden>
                  <label for="shipCountryOther" class={labelClass}>{t.countryOther}{req}</label>
                  <input id="shipCountryOther" name="shipCountryOther" type="text" class={inputClass} />
                </div>
              </div>

              <div id="addr-kr" class="space-y-6">
                <div class="grid gap-6 md:grid-cols-[10rem_1fr]">
                  <div>
                    <label for="shipZip" class={labelClass}>{t.zip}{req}</label>
                    <input id="shipZip" name="shipZip" type="text" inputmode="numeric" autocomplete="postal-code" class={inputClass} />
                  </div>
                  <div>
                    <label for="shipAddr1" class={labelClass}>{t.addr1}{req}</label>
                    <input id="shipAddr1" name="shipAddr1" type="text" autocomplete="street-address" class={inputClass} />
                  </div>
                </div>
                <div>
                  <label for="shipAddr2" class={labelClass}>{t.addr2}</label>
                  <input id="shipAddr2" name="shipAddr2" type="text" class={inputClass} />
                </div>
              </div>

              <div id="addr-intl" class="space-y-6" hidden>
                <div>
                  <label for="shipAddr1Intl" class={labelClass}>{t.addr1Intl}{req}</label>
                  <input id="shipAddr1Intl" type="text" autocomplete="address-line1" class={inputClass} />
                </div>
                <div>
                  <label for="shipAddr2Intl" class={labelClass}>{t.addr2Intl}</label>
                  <input id="shipAddr2Intl" type="text" autocomplete="address-line2" class={inputClass} />
                </div>
                <div class="grid gap-6 md:grid-cols-3">
                  <div>
                    <label for="shipCity" class={labelClass}>{t.city}{req}</label>
                    <input id="shipCity" name="shipCity" type="text" autocomplete="address-level2" class={inputClass} />
                  </div>
                  <div>
                    <label for="shipState" class={labelClass}>{t.state}</label>
                    <input id="shipState" name="shipState" type="text" autocomplete="address-level1" class={inputClass} />
                  </div>
                  <div>
                    <label for="shipZipIntl" class={labelClass}>{t.zip}{req}</label>
                    <input id="shipZipIntl" type="text" autocomplete="postal-code" class={inputClass} />
                  </div>
                </div>
                <div class="rounded-lg border border-ink/10 bg-ink/[0.02] p-4">
                  <p class="text-xs leading-relaxed text-ink/50">{t.customs}</p>
                </div>
              </div>

              <!-- 착불일 때만 노출: 수령인의 택배사 계정으로 배송비가 청구된다 -->
              <div id="courier-wrap" hidden>
                <label for="shipCourierAcct" class={labelClass}>{t.courier}</label>
                <input id="shipCourierAcct" name="shipCourierAcct" type="text" class={inputClass} />
                <p class="mt-1.5 text-xs leading-relaxed text-ink/35">{t.courierHint}</p>
              </div>

              <div>
                <label for="shipMemo" class={labelClass}>{t.shipMemo}</label>
                <input id="shipMemo" name="shipMemo" type="text" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <div id="no-ship-note" class="rounded-lg border border-ink/10 bg-ink/[0.02] p-5" hidden>
            <p class="text-sm text-ink/55">{t.noShip}</p>
          </div>

          <fieldset id="tax-section">
            <legend class={legendClass}>{t.secTax}</legend>

            <div id="tax-kr">
              <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm text-ink/70">
                <input type="checkbox" id="tax-want" class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
                <span>{t.taxWant}</span>
              </label>
              <p class="mt-3 text-xs leading-relaxed text-ink/40">{t.taxHint}</p>

              <div id="tax-fields" class="mt-6 grid gap-6 md:grid-cols-2" hidden>
                <div>
                  <label for="taxBizNo" class={labelClass}>{t.taxBizNo}{req}</label>
                  <input id="taxBizNo" name="taxBizNo" type="text" inputmode="numeric" placeholder="000-00-00000" class={inputClass} />
                </div>
                <div>
                  <label for="taxBizName" class={labelClass}>{t.taxBizName}{req}</label>
                  <input id="taxBizName" name="taxBizName" type="text" class={inputClass} />
                </div>
                <div>
                  <label for="taxCeo" class={labelClass}>{t.taxCeo}</label>
                  <input id="taxCeo" name="taxCeo" type="text" class={inputClass} />
                </div>
                <div>
                  <label for="taxEmail" class={labelClass}>{t.taxEmail}{req}</label>
                  <input id="taxEmail" name="taxEmail" type="email" class={inputClass} />
                </div>
              </div>
            </div>

            <p id="tax-intl" class="mt-5 text-sm leading-relaxed text-ink/50" hidden>{t.taxIntl}</p>
          </fieldset>

          <fieldset>
            <legend class={legendClass}>{t.secAgree}</legend>
            <div class="mt-5 space-y-5">
              <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
                <input type="checkbox" name="privacy" required value="agreed"
                  class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
                <span>{t.privacy}{req}</span>
              </label>

              <div class="rounded-lg border border-warn/25 bg-warn/[0.06] p-4">
                <label class="flex cursor-pointer items-start gap-3 text-sm text-warn">
                  <input type="checkbox" name="agreeTerms" required value="agreed"
                    class="mt-0.5 size-4 shrink-0 rounded border-warn/40 bg-overlay/20 accent-warn" />
                  <span>{t.agreeTerms}{req}</span>
                </label>
                <p class="mt-3 pl-7 text-xs leading-relaxed text-warn/60">{t.agreeDetail}</p>
                <a href={lhref('/refund')} target="_blank" rel="noopener"
                  class="mt-2 inline-block pl-7 text-xs text-warn underline hover:text-warn">{t.seePolicy} ↗</a>
              </div>

              {/* Turnstile 봇 검증 위젯 */}
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAD5eNOFVFYfnvXUA"
                data-theme="auto"
                data-language="auto"
                data-refresh-expired="auto"
              ></div>
            </div>
          </fieldset>
        </form>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-xl border border-ink/10 bg-ink/[0.02] p-6">
            <p class={legendClass}>{t.secSummary}</p>

            {quote ? (
              <div class="mt-5 space-y-1 border-b border-ink/10 pb-5">
                <p class="text-sm text-ink/80">{quote.product_name}</p>
                <p class="font-mono text-xs text-ink/35">{quote.id}</p>
              </div>
            ) : (
              <ul id="summary-lines" class="mt-5 space-y-3 border-b border-ink/10 pb-5 text-sm"></ul>
            )}

            <dl class="mt-5 space-y-2 text-sm">
              <div class="flex justify-between gap-4 text-ink/50">
                <dt class="shrink-0">{t.shipping}</dt>
                <dd id="ship-fee" class="text-right text-xs leading-relaxed">{shipFeeDomestic}</dd>
              </div>
            </dl>

            <div class="mt-5 flex items-end justify-between border-t border-ink/10 pt-5">
              <div>
                <p class="text-sm text-ink/60">{t.total}</p>
                <p class="text-xs text-ink/35">{t.vat}</p>
              </div>
              <p id="summary-total" data-usd-rate={liveRate} class="text-2xl font-bold text-ink">
                {quote ? `$${Number(quote.quoted_amount ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '$0.00'}
              </p>
            </div>
            <p class="mt-2 text-right text-xs text-ink/35">{t.fxNote}</p>

            {/* 결제 수단 선택.
                PayPal 은 한국 계정 간 거래를 지원하지 않아(원화 미지원 + 국내거래 차단)
                국내 고객은 결제 자체가 실패한다. 배송지로 추측하지 않고 본인이 고르게 한다. */}
            <fieldset class="mt-6">
              <legend class="text-sm text-ink/60">{t.payMethod}</legend>
              <div class="mt-2 space-y-2">
                <label class="flex cursor-pointer gap-3 rounded-lg border border-ink/10 bg-ink/[0.02] p-3 transition hover:border-accent/40">
                  <input type="radio" form="checkout-form" name="payMethod" value="paypal" checked class="mt-1 shrink-0" />
                  <span class="min-w-0">
                    <span class="block text-sm font-medium text-ink">{t.payPaypal}</span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-ink/40">{t.payPaypalNote}</span>
                  </span>
                </label>
                <label class="flex cursor-pointer gap-3 rounded-lg border border-ink/10 bg-ink/[0.02] p-3 transition hover:border-accent/40">
                  <input type="radio" form="checkout-form" name="payMethod" value="bank" class="mt-1 shrink-0" />
                  <span class="min-w-0">
                    <span class="block text-sm font-medium text-ink">{t.payBank}</span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-ink/40">{t.payBankNote}</span>
                  </span>
                </label>
              </div>
            </fieldset>

            <button type="submit" form="checkout-form" id="pay-btn"
              class="mt-6 v-btn-block disabled:cursor-not-allowed disabled:opacity-50">
              <span id="pay-label">{t.submit}</span>
            </button>
            <p id="pay-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
            <p id="pay-hint" class="mt-2 hidden text-xs text-ink/45">{t.captchaHint}</p>

            <p id="empty-cart" class="mt-4 text-center text-sm text-ink/40" hidden>
              <span id="empty-msg">{t.empty}</span> <a href={lhref('/product')} class="text-accent hover:underline">{t.backToShop} →</a>
            </p>
          </div>
        </aside>
      </div>
    )}

    <script type="application/json" id="catalog" is:inline set:html={JSON.stringify([...products, ...waferProducts])}></script>
    <script type="application/json" id="ship-fees" is:inline set:html={JSON.stringify({
      domestic: shipFeeDomestic, intl: shipFeeIntl,
      collectDomestic, collectIntl,
    })}></script>
  </section>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { initTelInput, normalizeTelInputs } from '../../lib/telInput';

  import { liveRate, cachedRate } from '../../lib/fx-client';

  // Turnstile 전역 API 타입 (api.js 가 window.turnstile 을 주입한다)
  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }

  // 저장소 접근은 전부 lib/cart 한 곳을 통한다 (Item 형도 거기서 온다 — 중복 선언 금지)
  import { readCart, readBuyNow, clearBuyNow, removeKeys, itemKey, type CartItem as Item } from '../../lib/cart';

  type Product = { sku: string; name: string; price: number; ship: boolean };

  const form = document.getElementById('checkout-form') as HTMLFormElement | null;
  if (form) {
    const M = form.dataset;
    const quoteId = M.quote || '';

    // 전화번호 입력(구매자·수령인)에 국가번호 드롭다운 적용
    const lang = document.documentElement.lang || "en";
    const buyerPhoneEl = document.getElementById('buyerPhone') as HTMLInputElement | null;
    if (buyerPhoneEl) initTelInput(buyerPhoneEl, lang);
    const shipPhoneEl = document.getElementById('shipPhone') as HTMLInputElement | null;
    if (shipPhoneEl) initTelInput(shipPhoneEl, lang);

    const catalog: Product[] = JSON.parse(document.getElementById('catalog')?.textContent ?? '[]');
    const fees = JSON.parse(document.getElementById('ship-fees')?.textContent ?? '{}');
    const byId = new Map(catalog.map((p) => [p.sku, p]));

    const $ = (id: string) => document.getElementById(id)!;
    const $i = (id: string) => document.getElementById(id) as HTMLInputElement;

    const linesEl = document.getElementById('summary-lines');
    const totalEl = $('summary-total');
    let rateSynced = false;
    const emptyEl = $('empty-cart');
    const btn = $('pay-btn') as HTMLButtonElement;
    const label = $('pay-label');
    const statusEl = $('pay-status');
    const hintEl = $('pay-hint');
    const feeEl = $('ship-fee');

    // 캐시된 환율을 먼저 써서 첫 렌더부터 최신 금액이 나오게 한다(깜빡임 방지).
    let RATE = cachedRate() || Number((totalEl as HTMLElement | null)?.dataset.usdRate) || 1500;
    const usd = (krw: number) =>
      '$' + (krw / RATE).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    // ── 주문 품목: 소스 결정 → 요약 렌더 ───────────────
    // 규칙: 주문서는 진입 URL 로 '선언된 소스 하나만' 읽는다.
    //   /checkout?buynow=1 → sessionStorage 즉시 구매 항목
    //   /checkout          → localStorage 장바구니
    // 키 존재 여부로 추측하면 두 흐름이 섞인다:
    //   · 즉시 구매를 취소하고 남은 잔여 키가 나중의 장바구니 주문을 가로채고,
    //   · 즉시 구매 완료 후 되돌아오면 키가 없어 장바구니로 폴백되어 '다른 주문서'가 된다.
    const isBuyNow = !quoteId && new URLSearchParams(location.search).has('buynow');
    let items: Item[] = [];
    let needsShipping = quoteId ? M.quoteShip === 'true' : false;
    // 상태 플래그는 모든 사용처보다 먼저 선언한다.
    // let 이 사용처 아래에 있으면 TDZ ReferenceError 로 스크립트가 통째로 죽는다(전례 있음).
    let gateBusy = false;   // 제출 중·잠금 상태 — 게이트가 버튼을 다시 열지 못하게 한다
    let orderDone = false;  // 이 페이지에서 주문을 마쳤는지 (bfcache 복원 감지용)

    // 품목·합계 표시만 담당한다. 환율이 갱신되면 이 함수를 다시 호출해 같은 품목을 새 환율로 그린다.
    function render() {
      let total = 0;
      linesEl!.innerHTML = '';
      for (const i of items) {
        const p = byId.get(i.sku)!;
        const sub = p.price * i.qty;
        total += sub;
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3';
        li.innerHTML =
          `<span class="text-ink/70">${p.name} <span class="text-ink/35">× ${i.qty}</span></span>` +
          `<span class="shrink-0 text-ink/80">${usd(sub)}</span>`;
        linesEl!.appendChild(li);
      }
      totalEl.textContent = usd(total);
    }

    if (!quoteId) {
      if (isBuyNow) {
        // 즉시 구매: 세션 키만 읽는다. 장바구니는 읽지도, 건드리지도 않는다.
        items = readBuyNow();
      } else {
        // 장바구니: 이전 즉시 구매의 잔여 키가 끼어들지 않도록 먼저 비운다.
        clearBuyNow();
        items = readCart();
      }
      // 형식·수량 정리는 lib/cart 가 한다. 여기서는 카탈로그에 없는 품목만 걷어낸다.
      items = items.filter((i) => byId.has(i.sku));
      for (const i of items) if (byId.get(i.sku)!.ship) needsShipping = true;

      render();

      // 소스가 비면 결제를 잠근다 — 주문서 URL 직접 진입, 주문 완료 후 재방문,
      // 즉시 구매 세션 만료(새 탭에 URL 만 옮겨 붙인 경우 등)가 여기 해당한다.
      if (items.length === 0) {
        btn.disabled = true;
        gateBusy = true; // syncGate 가 버튼을 다시 열지 못하게
        if (isBuyNow) {
          const m = document.getElementById('empty-msg');
          if (m) m.textContent = M.buynowExpired!;
        }
        emptyEl.hidden = false;
      }

      // HTML 이 캐시되었거나 SSR 환율 조회가 실패했을 수 있다.
      // 현재 환율을 받아 값이 다르면 한 번만 다시 그린다(레이아웃 변화 없음).
      if (!rateSynced) {
        rateSynced = true;
        void liveRate(RATE).then((r) => {
          if (r > 0 && Math.abs(r - RATE) > 0.5) { RATE = r; render(); }
        });
      }
    }

    // 배송이 필요 없는 주문이면 배송지 섹션을 감춘다
    $('ship-section').hidden = !needsShipping;
    $('no-ship-note').hidden = needsShipping;

    const setReq = (id: string, on: boolean) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.required = on;
    };

    // 숨겨진 필드가 required 로 남으면 브라우저가 제출을 막으면서도
    // 경고를 띄울 대상을 찾지 못해 **아무 반응 없이 멈춘다**
    // (콘솔: "An invalid form control ... is not focusable").
    // 화면에 보이지 않는 입력은 required 를 해제하고 검증에서 제외한다.
    const isHidden = (el: HTMLElement) => !el.offsetParent && getComputedStyle(el).position !== 'fixed';
    const syncHiddenRequired = () => {
      for (const el of Array.from(form.elements) as HTMLElement[]) {
        const f = el as HTMLInputElement;
        if (!f.name || f.type === 'hidden') continue;
        if (isHidden(f)) {
          if (f.required) { f.dataset.wasRequired = '1'; f.required = false; }
          f.disabled = true;            // 값도 함께 전송되지 않도록
        } else if (f.dataset.wasRequired === '1') {
          f.disabled = false;
          f.required = true;
          delete f.dataset.wasRequired;
        } else if (f.disabled && f.dataset.autoDisabled === '1') {
          f.disabled = false;
        }
      }
    };

    // ── 국가에 따라 주소 폼·세금계산서 전환 ────────────
    const countrySel = document.getElementById('shipCountry') as HTMLSelectElement;
    const taxWant = $i('tax-want');

    function applyCountry() {
      if (!needsShipping) {
        feeEl.textContent = fees.domestic;
        return;
      }
      const c = countrySel.value;
      const isKR = c === 'KR';

      $('country-other-wrap').hidden = c !== 'OTHER';
      setReq('shipCountryOther', c === 'OTHER');

      $('addr-kr').hidden = !isKR;
      $('addr-intl').hidden = isKR;

      setReq('shipZip', isKR);
      setReq('shipAddr1', isKR);
      setReq('shipAddr1Intl', !isKR);
      setReq('shipCity', !isKR);
      setReq('shipZipIntl', !isKR);

      // 세금계산서는 한국 사업자만
      $('tax-kr').hidden = !isKR;
      $('tax-intl').hidden = isKR;
      if (!isKR) {
        taxWant.checked = false;
        $('tax-fields').hidden = true;
        for (const id of ['taxBizNo', 'taxBizName', 'taxEmail']) setReq(id, false);
      }

      feeEl.textContent = isKR ? fees.domestic : fees.intl;

      // 착불이면 수령인의 택배사 계정번호를 받는다
      $('courier-wrap').hidden = !(isKR ? fees.collectDomestic : fees.collectIntl);
    }
    countrySel?.addEventListener('change', applyCountry);
    applyCountry();
    syncHiddenRequired();

    // ── 배송지: 주문자와 동일 ──────────────────────────
    const shipSame = $i('ship-same');
    function applySame() {
      $('ship-person').hidden = shipSame.checked;
      setReq('shipName', !shipSame.checked);
      setReq('shipPhone', !shipSame.checked);
    }
    shipSame?.addEventListener('change', applySame);
    applySame();
    syncHiddenRequired();

    // ── 세금계산서 ─────────────────────────────────────
    taxWant?.addEventListener('change', () => {
      $('tax-fields').hidden = !taxWant.checked;
      for (const id of ['taxBizNo', 'taxBizName', 'taxEmail']) setReq(id, taxWant.checked);
      syncHiddenRequired();
    });

    function validBizNo(raw: string) {
      const n = raw.replace(/\D/g, '');
      if (n.length !== 10) return false;
      const w = [1, 3, 7, 1, 3, 7, 1, 3, 5];
      let sum = 0;
      for (let i = 0; i < 9; i++) sum += Number(n[i]) * w[i];
      sum += Math.floor((Number(n[8]) * 5) / 10);
      return (10 - (sum % 10)) % 10 === Number(n[9]);
    }

    const setStatus = (msg: string, ok: boolean) => {
      statusEl.textContent = msg;
      statusEl.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
      // 이 문구는 버튼 아래에 있어 화면 밖으로 밀리기 쉽다.
      // 안 보이면 사용자에겐 "눌러도 아무 반응 없음"으로 보이므로 반드시 시야로 끌어온다.
      if (msg && !ok) {
        try { statusEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) {}
      }
    };

    // ── 버튼 게이팅 ────────────────────────────────────
    // 필수 입력·필수 동의가 모두 충족될 때만 결제 버튼을 연다.
    // (기존엔 항상 활성 → 미입력 상태로 눌러 실패 원인을 알기 어려웠다)
    // gateBusy 플래그는 위(소스 결정 블록)에서 선언한다 — 빈 소스 잠금이 먼저 쓰기 때문.
    const fieldsOk = () => {
      if (!quoteId && items.length === 0) return false;
      const els = Array.from(form.elements) as HTMLElement[];
      for (const el of els) {
        const f = el as HTMLInputElement;
        if (!f.name || f.disabled || f.type === 'hidden') continue;
        if (f.name === 'vanam_hp_note') continue;
        if (isHidden(f)) continue;                    // 화면에 없는 입력은 판정하지 않는다
        if (f.required && !f.checkValidity()) return false;
      }
      return true;
    };
    // Turnstile 토큰은 5분이면 만료되고, 갱신 요청이 실패하면 조용히 비워진다.
    // 토큰이 없는 상태로 버튼을 열어두면 "눌러도 반응 없음" 으로 보이므로 게이트에 포함한다.
    const tokenEl = () => form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;
    const hasToken = () => Boolean(tokenEl()?.value);
    const gateOk = () => fieldsOk() && hasToken();

    const syncGate = () => {
      if (gateBusy) return;
      const okAll = gateOk();
      btn.disabled = !okAll;
      // 입력은 다 됐는데 보안 확인만 안 끝난 경우 — 왜 못 누르는지 알려준다
      // 보안 확인 대기 상태는 '오류'가 아니다.
      // 1초마다 오류 문구를 다시 띄우고 화면을 스크롤하면 무한 반복처럼 보인다.
      // 조용한 힌트만 켜고, 실제 오류 문구는 사용자가 제출을 시도했을 때만 띄운다.
      if (hintEl) hintEl.classList.toggle('hidden', !(!okAll && fieldsOk() && !hasToken()));
    };
    // 결제 수단에 따라 버튼 문구를 바꾼다 — 계좌이체는 '결제'가 아니라 '주문 접수'다.
    const payMethod = () =>
      (document.querySelector('input[name="payMethod"]:checked') as HTMLInputElement | null)?.value ?? 'paypal';
    const syncPayLabel = () => {
      if (gateBusy) return;
      label.textContent = payMethod() === 'bank' ? M.labelSendBank! : M.labelSend!;
    };
    // 라디오는 요약 카드(폼 바깥)에 있어 form 의 change 이벤트로는 잡히지 않는다.
    // form 속성으로 폼에 소속시켰더라도 이벤트 버블링 경로는 DOM 트리를 따르므로 직접 연결한다.
    const payRadios = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="payMethod"]'),
    );
    for (const r of payRadios) r.addEventListener('change', syncPayLabel);
    syncPayLabel();

    form.addEventListener('input', syncGate);
    form.addEventListener('change', syncGate);
    // Turnstile 이 토큰을 비동기로 넣고 만료 시 지우므로 주기적으로 다시 확인한다
    setInterval(syncGate, 1000);
    syncGate();

    // ── 제출 ───────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      syncHiddenRequired();
      e.preventDefault();

      // 미끼칸이 차 있어도 조용히 되돌리지 않는다.
      // 브라우저 자동완성이 채우는 오탐이 흔한데, 예전 방식(form.reset() 후 무반응)은
      // "버튼을 눌러도 아무 일도 안 일어나는" 증상으로 나타났다. 값만 비우고 진행한다.
      // (직접 POST 하는 봇은 서버측 미끼칸 검사와 Turnstile 이 막는다)
      const hp = form.elements.namedItem('vanam_hp_note') as HTMLInputElement | null;
      if (hp) hp.value = '';

      // 전화번호(구매자·수령인)를 국제표준(+82...)으로 변환한 뒤 수집
      normalizeTelInputs(form);
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      // 라디오가 폼 바깥에 있어 FormData 가 놓칠 수 있다. 판정값을 명시적으로 싣는다.
      data.payMethod = payMethod();
      delete data.vanam_hp_note;

      // Turnstile 토큰 확인 (FormData 가 cf-turnstile-response 를 자동 수집한다)
      if (!data['cf-turnstile-response']) {
        setStatus(M.msgCaptcha!, false);
        return;
      }

      const isKR = !needsShipping || countrySel.value === 'KR';

      if (taxWant.checked && isKR && !validBizNo(data.taxBizNo ?? '')) {
        setStatus(M.msgBiz!, false);
        return;
      }

      if (needsShipping) {
        if (shipSame.checked) {
          data.shipName = data.buyerName;
          data.shipPhone = data.buyerPhone ?? '';
        }
        // 해외 주소 입력칸은 name 을 두지 않았다 (국내 칸과 이름이 겹치면 빈 값이 덮어쓴다).
        // 해외일 때만 여기서 값을 옮겨 담는다.
        if (!isKR) {
          data.shipAddr1 = $i('shipAddr1Intl').value.trim();
          data.shipAddr2 = $i('shipAddr2Intl').value.trim();
          data.shipZip = $i('shipZipIntl').value.trim();
        }
      }

      const payload: Record<string, unknown> = {
        ...data,
        needsShipping,
        taxInvoice: taxWant.checked && isKR,
        locale: document.documentElement.lang || 'en',
      };
      if (quoteId) payload.inquiryId = quoteId;
      else payload.items = items;

      gateBusy = true;
      btn.disabled = true;
      label.textContent = M.labelSending!;
      setStatus('', true);

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const j = await res.json();
        if (!res.ok || !j.ok) throw new Error(j.error ?? res.status);

        if (!quoteId) {
          if (isBuyNow) {
            // 즉시 구매: 세션 키만 정리한다. 장바구니는 손대지 않는다.
            clearBuyNow();
          } else {
            // 장바구니: '이번 주문에 포함된 줄만' 제거한다(배지 갱신까지 removeKeys 가 한다).
            // 전체를 비우면 이번 주문에 포함되지도 않은 견적 품목까지 사라진다.
            // 견적 품목만 남은 장바구니(합계 $0.00 + 견적 요청서 인쇄)는 설계된 정상 상태다.
            removeKeys(items.map(itemKey));
          }
        }
        orderDone = true;
        const base = document.documentElement.lang === 'ko' ? '/ko' : '';
        // 계좌이체는 결제 단계가 없다. 완료 화면에서 안내만 받도록 표식을 넘긴다.
        const suffix = payMethod() === 'bank' ? '&pay=bank' : '';
        // href 대신 replace — 주문서를 히스토리에서 제거한다(PRG 패턴).
        // 완료 화면에서 뒤로가기를 누르면 주문서가 아니라 그 이전 페이지(장바구니·상품)로 간다.
        location.replace(`${base}/order/done?id=${encodeURIComponent(j.orderId)}${suffix}`);
      } catch (err) {
        console.error(err);
        // 원인을 감추면 어느 칸이 문제인지 알 수 없다 — 서버 코드별 안내로 바꾼다
        const code = String((err as Error)?.message ?? '');
        const MAP: Record<string, string> = {
          missing_buyer: '주문자 이름과 이메일을 확인해 주세요 · Check buyer name and email.',
          invalid_email: '이메일 형식이 올바르지 않습니다 · Invalid email format.',
          need_privacy: '개인정보 수집·이용 동의가 필요합니다 · Privacy consent required.',
          need_terms: '주문 제작품 청약철회 제한 고지 동의가 필요합니다 · Terms consent required.',
          missing_ship: '배송지 정보를 모두 입력해 주세요 · Complete the shipping address.',
          bad_items: '장바구니 상품을 다시 확인해 주세요 · Check the cart items.',
          captcha_failed: '자동입력 방지 확인에 실패했습니다. 잠시 후 다시 시도해 주세요 · Captcha failed, please retry.',
        };
        if (MAP[code]) { setStatus(MAP[code], false); gateBusy = false; btn.disabled = false; label.textContent = M.labelSend!; window.turnstile?.reset(); return; }
        // 토큰은 1회용 — 실패 시 리셋해 재시도를 준비한다. (성공 시엔 페이지가 이동하므로 불필요)
        window.turnstile?.reset();
        setStatus(M.msgFail!, false);
        gateBusy = false;
        btn.disabled = false;
        label.textContent = M.labelSend!;
      }
    });

    // bfcache(뒤로가기 캐시) 안전망.
    // replace 로 히스토리에서 지워도 iOS Safari 등은 다른 경로의 뒤로가기로
    // 이 페이지를 '제출 당시 상태 그대로' 되살릴 수 있다. 주문을 마친 페이지가
    // 되살아나면 새로고침해 저장소 기준의 현재 상태(빈 소스 잠금)로 되돌린다.
    // 주문 전에 이탈했다 돌아온 경우는 입력값 보존이 이득이므로 건드리지 않는다.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted && orderDone) location.reload();
    });
  }
</script>
