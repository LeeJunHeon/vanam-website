---
// 주문서. 장바구니(고정가) 또는 견적(견적가) 양쪽에서 들어온다.
//   /checkout            → 장바구니 항목으로 주문
//   /checkout?quote=INQ-… → 관리자가 금액을 책정한 견적으로 주문
//
// ⚠️ 금액은 화면에 "표시"만 하고, 실제 결제 금액은 서버(/api/order)가 다시 계산한다.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import { db } from '../../lib/db';

const locale = (Astro.currentLocale ?? 'en') as 'ko' | 'en';
const isKo = locale === 'ko';
const site = siteData[locale] ?? siteData.en;
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

// 견적 주문이면 DB에서 확정 금액을 읽는다
const quoteId = Astro.url.searchParams.get('quote') ?? '';
let quote: { id: string; product_name: string | null; quoted_amount: number | null; name: string; email: string; status: string } | null = null;
let quoteError = '';

if (quoteId) {
  if (!/^INQ-\d{8}-[A-Z0-9]{4}$/.test(quoteId)) {
    quoteError = isKo ? '잘못된 견적 번호입니다.' : 'Invalid quote reference.';
  } else {
    const d = await db();
    if (!d) {
      quoteError = isKo ? '견적을 불러올 수 없습니다.' : 'Unable to load the quote.';
    } else {
      quote = await d
        .prepare(`SELECT id, product_name, quoted_amount, name, email, status FROM inquiries WHERE id = ?`)
        .bind(quoteId)
        .first();
      if (!quote) quoteError = isKo ? '견적을 찾을 수 없습니다.' : 'Quote not found.';
      else if (!quote.quoted_amount) quoteError = isKo ? '아직 금액이 책정되지 않았습니다.' : 'This quote has not been priced yet.';
      else if (quote.status === 'closed') quoteError = isKo ? '종료된 견적입니다.' : 'This quote is closed.';
    }
  }
}

// 고정가 상품 카탈로그 (장바구니 금액 표시용 — 실제 계산은 서버가 한다)
const products = (await getCollection('products'))
  .filter((p) => p.data.published && p.data.pricingType === 'fixed' && typeof p.data.price === 'number')
  .map((p) => ({
    sku: p.id,
    name: locale === 'en' ? (p.data.name_en ?? p.data.name) : p.data.name,
    price: p.data.price as number,
  }));

const t = isKo
  ? {
      meta: '주문서 | VANAM', metaDesc: '주문 정보를 입력하고 결제를 진행합니다.',
      eyebrow: '주문서', heading: '주문 정보',
      empty: '장바구니가 비어 있습니다.', backToShop: '스토어로 돌아가기',
      secBuyer: '주문자', secShip: '배송지', secTax: '세금계산서', secAgree: '확인 및 동의', secSummary: '주문 요약',
      name: '이름 *', email: '이메일 *', phone: '연락처', company: '회사 / 소속',
      shipSame: '주문자와 동일',
      shipName: '수령인', shipPhone: '수령인 연락처', shipZip: '우편번호',
      shipAddr1: '주소', shipAddr2: '상세 주소', shipMemo: '배송 요청사항',
      taxWant: '세금계산서가 필요합니다 (사업자)',
      taxHint: '카드 결제 시에는 카드매출전표가 적격 증빙이 되어 세금계산서가 중복 발행되지 않습니다. 세금계산서가 필요하시면 가상계좌·계좌이체를 선택해 주세요.',
      taxBizNo: '사업자등록번호 *', taxBizName: '상호 *', taxCeo: '대표자', taxEmail: '계산서 수신 이메일 *',
      privacy: '주문 처리를 위한 개인정보 수집·이용에 동의합니다. *',
      agreeTerms: '주문 제작품(맞춤 코팅·주문 시편)과 착수된 분석 용역은 청약철회가 제한됨을 확인했으며, 이에 동의합니다. *',
      agreeDetail: '이용자의 주문에 따라 개별 생산되는 재화는 「전자상거래법」 제17조 제2항 제5호에 따라 청약철회가 제한됩니다. 다만 하자·오배송의 경우에는 교환·환불이 가능합니다.',
      seePolicy: '환불·교환 정책 보기',
      shipping: '배송비', total: '총 결제 금액', vat: '부가세 포함',
      submit: '결제하기', sending: '주문 생성 중…',
      qty: '수량',
      errRequired: '필수 항목을 확인해 주세요.',
      errBiz: '사업자등록번호가 올바르지 않습니다.',
      errFail: '주문 생성에 실패했습니다. 잠시 후 다시 시도해 주세요.',
      pendingTitle: '결제 시스템 준비 중',
      pendingBody: '주문은 정상 접수되었습니다. 결제 연동이 완료되면 결제 링크를 보내드립니다.',
      orderNo: '주문번호',
    }
  : {
      meta: 'Checkout | VANAM', metaDesc: 'Enter your order details and pay.',
      eyebrow: 'Checkout', heading: 'Order details',
      empty: 'Your cart is empty.', backToShop: 'Back to store',
      secBuyer: 'Purchaser', secShip: 'Shipping', secTax: 'Tax invoice', secAgree: 'Confirm & agree', secSummary: 'Order summary',
      name: 'Name *', email: 'Email *', phone: 'Phone', company: 'Company / Affiliation',
      shipSame: 'Same as purchaser',
      shipName: 'Recipient', shipPhone: 'Recipient phone', shipZip: 'Postal code',
      shipAddr1: 'Address', shipAddr2: 'Address line 2', shipMemo: 'Delivery note',
      taxWant: 'I need a tax invoice (business)',
      taxHint: 'For card payments the card receipt is the qualifying document, so a separate tax invoice is not issued. If you need one, please choose virtual account or bank transfer.',
      taxBizNo: 'Business reg. no. *', taxBizName: 'Company name *', taxCeo: 'Representative', taxEmail: 'Invoice email *',
      privacy: 'I agree to the collection and use of my personal data to process this order. *',
      agreeTerms: 'I understand and agree that made-to-order items (custom coating, made-to-order samples) and commenced analysis services are not eligible for withdrawal. *',
      agreeDetail: 'Goods produced individually to your order are excluded from withdrawal under the Act on Consumer Protection in Electronic Commerce. Defects and incorrect deliveries remain eligible for exchange or refund.',
      seePolicy: 'View refund policy',
      shipping: 'Shipping', total: 'Total', vat: 'VAT included',
      submit: 'Proceed to payment', sending: 'Creating order…',
      qty: 'Qty',
      errRequired: 'Please check the required fields.',
      errBiz: 'The business registration number is not valid.',
      errFail: 'Could not create the order. Please try again.',
      pendingTitle: 'Payment coming soon',
      pendingBody: 'Your order has been received. We will send a payment link once the gateway is live.',
      orderNo: 'Order no.',
    };

const inputClass =
  'mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]';
const labelClass = 'block text-sm font-medium text-white/80';
const legendClass = 'text-sm font-medium uppercase tracking-widest text-[#1EBBF0]';
---

<BaseLayout title={t.meta} description={t.metaDesc}>
  <section class="mx-auto max-w-5xl px-6 py-28 md:py-32">
    <p class="text-sm font-medium uppercase tracking-widest text-[#1EBBF0]">{t.eyebrow}</p>
    <h1 class="mt-4 text-3xl font-bold leading-tight text-white md:text-4xl">{t.heading}</h1>

    {quoteError ? (
      <div class="mt-10 rounded-xl border border-amber-400/30 bg-amber-400/10 p-6">
        <p class="text-amber-200">{quoteError}</p>
        <a href={lhref('/shop')} class="mt-4 inline-block text-sm text-[#1EBBF0] hover:underline">{t.backToShop} →</a>
      </div>
    ) : (
      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_20rem]">
        <!-- ── 입력 ─────────────────────────────── -->
        <form id="checkout-form" class="space-y-12"
          data-quote={quote?.id ?? ''}
          data-msg-required={t.errRequired}
          data-msg-biz={t.errBiz}
          data-msg-fail={t.errFail}
          data-label-send={t.submit}
          data-label-sending={t.sending}>
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset>
            <legend class={legendClass}>{t.secBuyer}</legend>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div>
                <label for="buyerName" class={labelClass}>{t.name}</label>
                <input id="buyerName" name="buyerName" type="text" required autocomplete="name" class={inputClass}
                  value={quote?.name ?? ''} />
              </div>
              <div>
                <label for="buyerEmail" class={labelClass}>{t.email}</label>
                <input id="buyerEmail" name="buyerEmail" type="email" required autocomplete="email" class={inputClass}
                  value={quote?.email ?? ''} />
              </div>
              <div>
                <label for="buyerPhone" class={labelClass}>{t.phone}</label>
                <input id="buyerPhone" name="buyerPhone" type="tel" autocomplete="tel" class={inputClass} />
              </div>
              <div>
                <label for="buyerCompany" class={labelClass}>{t.company}</label>
                <input id="buyerCompany" name="buyerCompany" type="text" autocomplete="organization" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class={legendClass}>{t.secShip}</legend>
            <label class="mt-5 flex cursor-pointer items-center gap-3 text-sm text-white/70">
              <input type="checkbox" id="ship-same" checked
                class="size-4 rounded border-white/20 bg-white/[0.03] accent-[#1EBBF0]" />
              <span>{t.shipSame}</span>
            </label>
            <div class="mt-5 space-y-6">
              <div id="ship-person" class="grid gap-6 md:grid-cols-2" hidden>
                <div>
                  <label for="shipName" class={labelClass}>{t.shipName}</label>
                  <input id="shipName" name="shipName" type="text" class={inputClass} />
                </div>
                <div>
                  <label for="shipPhone" class={labelClass}>{t.shipPhone}</label>
                  <input id="shipPhone" name="shipPhone" type="tel" class={inputClass} />
                </div>
              </div>
              <div class="grid gap-6 md:grid-cols-[10rem_1fr]">
                <div>
                  <label for="shipZip" class={labelClass}>{t.shipZip}</label>
                  <input id="shipZip" name="shipZip" type="text" inputmode="numeric" class={inputClass} />
                </div>
                <div>
                  <label for="shipAddr1" class={labelClass}>{t.shipAddr1}</label>
                  <input id="shipAddr1" name="shipAddr1" type="text" autocomplete="street-address" class={inputClass} />
                </div>
              </div>
              <div>
                <label for="shipAddr2" class={labelClass}>{t.shipAddr2}</label>
                <input id="shipAddr2" name="shipAddr2" type="text" class={inputClass} />
              </div>
              <div>
                <label for="shipMemo" class={labelClass}>{t.shipMemo}</label>
                <input id="shipMemo" name="shipMemo" type="text" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class={legendClass}>{t.secTax}</legend>
            <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm text-white/70">
              <input type="checkbox" id="tax-want" name="taxInvoice"
                class="mt-0.5 size-4 shrink-0 rounded border-white/20 bg-white/[0.03] accent-[#1EBBF0]" />
              <span>{t.taxWant}</span>
            </label>
            <p class="mt-3 text-xs leading-relaxed text-white/40">{t.taxHint}</p>

            <div id="tax-fields" class="mt-6 grid gap-6 md:grid-cols-2" hidden>
              <div>
                <label for="taxBizNo" class={labelClass}>{t.taxBizNo}</label>
                <input id="taxBizNo" name="taxBizNo" type="text" inputmode="numeric" placeholder="000-00-00000" class={inputClass} />
              </div>
              <div>
                <label for="taxBizName" class={labelClass}>{t.taxBizName}</label>
                <input id="taxBizName" name="taxBizName" type="text" class={inputClass} />
              </div>
              <div>
                <label for="taxCeo" class={labelClass}>{t.taxCeo}</label>
                <input id="taxCeo" name="taxCeo" type="text" class={inputClass} />
              </div>
              <div>
                <label for="taxEmail" class={labelClass}>{t.taxEmail}</label>
                <input id="taxEmail" name="taxEmail" type="email" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class={legendClass}>{t.secAgree}</legend>
            <div class="mt-5 space-y-5">
              <label class="flex cursor-pointer items-start gap-3 text-sm text-white/70">
                <input type="checkbox" name="privacy" required value="agreed"
                  class="mt-0.5 size-4 shrink-0 rounded border-white/20 bg-white/[0.03] accent-[#1EBBF0]" />
                <span>{t.privacy}</span>
              </label>

              <!-- 청약철회 제한 — 주문 "전"에 개별 고지하고 동의를 받아야 법적 효력이 있다 -->
              <div class="rounded-lg border border-amber-400/25 bg-amber-400/[0.06] p-4">
                <label class="flex cursor-pointer items-start gap-3 text-sm text-amber-100">
                  <input type="checkbox" name="agreeTerms" required value="agreed"
                    class="mt-0.5 size-4 shrink-0 rounded border-amber-300/40 bg-black/20 accent-amber-400" />
                  <span>{t.agreeTerms}</span>
                </label>
                <p class="mt-3 pl-7 text-xs leading-relaxed text-amber-200/60">{t.agreeDetail}</p>
                <a href={lhref('/refund')} target="_blank" rel="noopener"
                  class="mt-2 inline-block pl-7 text-xs text-amber-200 underline hover:text-amber-100">{t.seePolicy} ↗</a>
              </div>
            </div>
          </fieldset>
        </form>

        <!-- ── 주문 요약 ─────────────────────────── -->
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-xl border border-white/10 bg-white/[0.02] p-6">
            <p class={legendClass}>{t.secSummary}</p>

            {quote ? (
              <div class="mt-5 space-y-1 border-b border-white/10 pb-5">
                <p class="text-sm text-white/80">{quote.product_name}</p>
                <p class="font-mono text-xs text-white/35">{quote.id}</p>
              </div>
            ) : (
              <ul id="summary-lines" class="mt-5 space-y-3 border-b border-white/10 pb-5 text-sm"></ul>
            )}

            <dl class="mt-5 space-y-2 text-sm">
              <div class="flex justify-between text-white/50">
                <dt>{t.shipping}</dt>
                <dd>{isKo ? company.shipFeeKo : (company.shipFeeEn || company.shipFeeKo)}</dd>
              </div>
            </dl>

            <div class="mt-5 flex items-end justify-between border-t border-white/10 pt-5">
              <div>
                <p class="text-sm text-white/60">{t.total}</p>
                <p class="text-xs text-white/35">{t.vat}</p>
              </div>
              <p id="summary-total" class="text-2xl font-bold text-white">
                {quote ? `₩${(quote.quoted_amount ?? 0).toLocaleString('ko-KR')}` : '₩0'}
              </p>
            </div>

            <button type="submit" form="checkout-form" id="pay-btn"
              class="mt-6 w-full rounded-lg bg-[#1EBBF0] px-6 py-3.5 font-semibold text-[#06222C] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50">
              <span id="pay-label">{t.submit}</span>
            </button>
            <p id="pay-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>

            <p id="empty-cart" class="mt-4 text-center text-sm text-white/40" hidden>
              {t.empty} <a href={lhref('/shop')} class="text-[#1EBBF0] hover:underline">{t.backToShop} →</a>
            </p>
          </div>
        </aside>
      </div>
    )}

    <!-- 서버가 아는 고정가 카탈로그 (표시용 — 실제 금액은 서버가 재계산) -->
    <script type="application/json" id="catalog" is:inline set:html={JSON.stringify(products)}></script>
  </section>
</BaseLayout>

<script>
  type Item = { sku: string; qty: number };
  type Product = { sku: string; name: string; price: number };

  const form = document.getElementById('checkout-form') as HTMLFormElement | null;
  if (form) {
    const M = form.dataset;
    const quoteId = M.quote || '';
    const CART_KEY = 'vanam_cart';

    const catalog: Product[] = JSON.parse(document.getElementById('catalog')?.textContent ?? '[]');
    const byId = new Map(catalog.map((p) => [p.sku, p]));

    const linesEl = document.getElementById('summary-lines');
    const totalEl = document.getElementById('summary-total')!;
    const emptyEl = document.getElementById('empty-cart')!;
    const btn = document.getElementById('pay-btn') as HTMLButtonElement;
    const label = document.getElementById('pay-label')!;
    const statusEl = document.getElementById('pay-status')!;

    const won = (n: number) => `₩${n.toLocaleString('ko-KR')}`;

    // 장바구니 → 요약 (견적 주문은 서버 렌더된 값을 그대로 쓴다)
    let items: Item[] = [];
    if (!quoteId) {
      try { items = JSON.parse(localStorage.getItem(CART_KEY) ?? '[]'); } catch { items = []; }
      items = items.filter((i) => byId.has(i.sku) && i.qty > 0);

      let total = 0;
      linesEl!.innerHTML = '';
      for (const i of items) {
        const p = byId.get(i.sku)!;
        const sub = p.price * i.qty;
        total += sub;
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3';
        li.innerHTML =
          `<span class="text-white/70">${p.name} <span class="text-white/35">× ${i.qty}</span></span>` +
          `<span class="shrink-0 text-white/80">${won(sub)}</span>`;
        linesEl!.appendChild(li);
      }
      totalEl.textContent = won(total);

      if (items.length === 0) {
        btn.disabled = true;
        emptyEl.hidden = false;
      }
    }

    // 배송지: 주문자와 동일
    const shipSame = document.getElementById('ship-same') as HTMLInputElement;
    const shipPerson = document.getElementById('ship-person')!;
    shipSame.addEventListener('change', () => { shipPerson.hidden = shipSame.checked; });

    // 세금계산서 필드 토글
    const taxWant = document.getElementById('tax-want') as HTMLInputElement;
    const taxFields = document.getElementById('tax-fields')!;
    const taxReq = ['taxBizNo', 'taxBizName', 'taxEmail'];
    taxWant.addEventListener('change', () => {
      taxFields.hidden = !taxWant.checked;
      for (const id of taxReq) {
        (document.getElementById(id) as HTMLInputElement).required = taxWant.checked;
      }
    });

    // 사업자등록번호 체크섬 (서버에서도 검증하지만 즉시 피드백)
    function validBizNo(raw: string) {
      const n = raw.replace(/\D/g, '');
      if (n.length !== 10) return false;
      const w = [1, 3, 7, 1, 3, 7, 1, 3, 5];
      let sum = 0;
      for (let i = 0; i < 9; i++) sum += Number(n[i]) * w[i];
      sum += Math.floor((Number(n[8]) * 5) / 10);
      return (10 - (sum % 10)) % 10 === Number(n[9]);
    }

    function setStatus(msg: string, ok: boolean) {
      statusEl.textContent = msg;
      statusEl.style.color = ok ? '#1EBBF0' : '#F87171';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const hp = form.elements.namedItem('vanam_hp_email') as HTMLInputElement | null;
      if (hp && hp.value.trim() !== '') { form.reset(); return; }

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      delete data.vanam_hp_email;

      if (taxWant.checked && !validBizNo(data.taxBizNo ?? '')) {
        setStatus(M.msgBiz!, false);
        return;
      }

      // 배송지가 주문자와 동일하면 채워 보낸다
      if (shipSame.checked) {
        data.shipName = data.buyerName;
        data.shipPhone = data.buyerPhone ?? '';
      }

      const payload: Record<string, unknown> = {
        ...data,
        taxInvoice: taxWant.checked,
        locale: document.documentElement.lang || 'en',
      };
      if (quoteId) payload.inquiryId = quoteId;
      else payload.items = items;

      btn.disabled = true;
      label.textContent = M.labelSending!;
      setStatus('', true);

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const j = await res.json();
        if (!res.ok || !j.ok) throw new Error(j.error ?? res.status);

        // 결제 연동 전: 주문번호를 보여주고 장바구니를 비운다.
        // 토스 연동 후에는 여기서 결제창을 띄운다.
        if (!quoteId) localStorage.removeItem(CART_KEY);
        const base = document.documentElement.lang === 'ko' ? '/ko' : '';
        location.href = `${base}/order/done?id=${encodeURIComponent(j.orderId)}`;
      } catch (err) {
        console.error(err);
        setStatus(M.msgFail!, false);
        btn.disabled = false;
        label.textContent = M.labelSend!;
      }
    });
  }
</script>
