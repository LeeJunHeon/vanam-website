---
// 웨이퍼 목록 페이지. Product 의 'Wafers' 카드를 클릭하면 이 페이지(/wafers)가 뜬다.
// Shop.astro 와 동일한 카드 디자인. wafers 컬렉션(전부 견적)을 진열하고,
// 각 웨이퍼 클릭 → 상세/견적(/wafers/[id]) 로 이동. 데이터가 없으면 안내 문구를 보여준다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import { formatUsd } from '../../lib/price';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';
const usdRate = company.usdRate || 1500;   // 달러 환산 환율 (Keystatic '사업자 정보')

// 웨이퍼 이미지 에셋 매핑: wafers/*.json 의 image 경로 → ImageMetadata
const waferImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/wafers/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const wafers = (await getCollection('wafers'))
  .filter((w) => w.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const name = (w) => (isKo ? w.data.name : (w.data.name_en ?? w.data.name));
const summary = (w) => (isKo ? (w.data.summary ?? '') : (w.data.summary_en ?? w.data.summary ?? ''));
---

<BaseLayout title={s.waferMetaTitle} description={s.waferMetaDescription}>
  <section class="relative mx-auto max-w-6xl px-6 py-28 md:py-36">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="v-reveal">
        <a href={`${base}/product`} class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink/50 transition hover:text-accent">← {s.waferBack}</a>
        <p class="text-sm font-medium uppercase tracking-widest text-accent">{s.catWafer}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{s.waferPageTitle1}<br />{s.waferPageTitle2}</h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">{s.waferIntro}</p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a href={`${base}/order/lookup`} class="inline-flex items-center rounded-lg border border-ink/15 px-5 py-2.5 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">{s.trackOrder}</a>
        <a href={`${base}/cart`} class="inline-flex items-center gap-2 rounded-lg border border-ink/15 px-5 py-2.5 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">
          {s.cart} <span class="cart-count rounded bg-brand px-1.5 py-0.5 text-xs font-bold text-onbrand">0</span>
        </a>
      </div>
    </div>

    {wafers.length === 0 ? (
      <p class="mt-16 text-ink/50">{s.waferEmpty}</p>
    ) : (
      <div class="v-reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {wafers.map((w) => {
          const img = w.data.image ? waferImages[w.data.image]?.default : undefined;
          const href = `${base}/wafers/${w.id}`;
          return (
            <article class="group flex flex-col overflow-hidden rounded-xl border border-ink/10 bg-ink/[0.02] transition hover:border-accent/50">
              <a href={href} class="block">
                <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-panel2 to-canvas">
                  {img ? (
                    <Image src={img} alt={name(w)} width={600} height={450} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center">
                      <span class="text-3xl font-bold text-ink/15">VanaM</span>
                    </div>
                  )}
                </div>
              </a>
              <div class="flex flex-1 flex-col p-5">
                <a href={href}>
                  <h2 class="text-lg font-semibold leading-snug text-ink transition group-hover:text-accent">{name(w)}</h2>
                </a>
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/50">{summary(w)}</p>
                <div class="mt-5 flex items-end justify-between gap-3 pt-1">
                  {typeof w.data.priceKrw === 'number' && w.data.priceKrw > 0 ? (
                    <p class="text-lg font-bold text-ink">{formatUsd(w.data.priceKrw, usdRate)}<span class="ml-1 text-[11px] font-normal text-ink/40">USD</span></p>
                  ) : (
                    <p class="text-base font-semibold text-accent">{s.priceOnRequest}</p>
                  )}
                  <a href={href} class="shrink-0 text-sm font-medium text-ink/60 transition hover:text-accent">{s.viewDetail} →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>
