---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import QuoteForm from '../QuoteForm.astro';
import company from '../../data/company.json';
import { formatUsd } from '../../lib/price';

const { product } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';

const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const d = product.data;
const name = isKo ? d.name : (d.name_en ?? d.name);
const summary = isKo ? d.summary : (d.summary_en ?? d.summary);
const description = isKo ? d.description : (d.description_en ?? d.description);
const leadTime = isKo ? d.leadTime : (d.leadTime_en ?? d.leadTime);
const shipping = isKo ? d.shipping : (d.shipping_en ?? d.shipping);
const img = d.image ? productImages[d.image]?.default : undefined;
const isFixed = d.pricingType === 'fixed' && typeof d.price === 'number';
const usdRate = company.usdRate || 1380;
---

<BaseLayout title={`${name} | ${locale === 'ko' ? '반암(VanaM)' : 'VanaM'}`} description={summary}>
  <section class="relative v-wrap py-28 md:py-32">
    <a href={`${base}/product`} class="text-sm text-ink/50 transition hover:text-accent">← {s.backToShop}</a>

    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      {/* 이미지.
          ⚠️ self-start 가 없으면 grid 기본 정렬(stretch)이 이 박스를 오른쪽 컬럼 높이까지 늘여
             4:3 사진 아래에 빈 테두리 공간이 남는다(lg 이상에서만 보였다).
             self-start 로 박스 높이를 사진 높이에 묶고, 오른쪽 내용이 길 때는 sticky 로 따라오게 한다.
             top-28(112px)은 고정 헤더(로고 40 + py-4 32 + 보더 1 = 73px)보다 넉넉히 아래다.
             1열이 되는 lg 미만에서는 두 클래스 모두 적용되지 않아 기존 그대로다. */}
      <div class="self-start overflow-hidden rounded-xl border border-ink/10 bg-gradient-to-br from-panel2 to-canvas lg:sticky lg:top-28">
        <div class="aspect-[4/3]">
          {img ? (
            <Image src={img} alt={name} width={900} height={675} class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-4xl font-bold text-ink/15" aria-hidden="true">VanaM</span>
            </div>
          )}
        </div>
      </div>

      <!-- 정보 -->
      <div>
        <h1 class="text-3xl font-bold leading-tight text-ink md:text-4xl">{name}</h1>
        <p class="mt-4 text-base leading-relaxed text-ink/60">{summary}</p>

        <div class="mt-8 border-y border-ink/10 py-6">
          {isFixed ? (
            <div>
              <p class="text-3xl font-bold text-ink">
                <span data-krw={d.price}>{formatUsd(d.price, usdRate)}</span><span class="ml-2 text-sm font-normal text-ink/40">USD</span>
              </p>
              <p class="mt-1.5 text-xs text-ink/35">{s.fxNote}</p>
            </div>
          ) : (
            <p class="text-2xl font-semibold text-accent">{s.priceOnRequest}</p>
          )}
        </div>

        {isFixed ? (
          <div class="mt-8 flex flex-wrap items-end gap-4"
            data-sku={product.id} data-name={name} data-price={d.price} data-msg-added={s.added}>
            <div>
              <label for="qty" class="block text-sm font-medium text-ink/80">{s.quantity}</label>
              <input id="qty" type="number" min="1" max="99" value="1"
                class="mt-2 w-24 rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-center text-ink outline-none transition focus:border-accent focus:ring-1 focus:ring-accent [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" />
            </div>
            <button type="button" id="add-btn"
              class="v-btn">
              {s.addToCart}
            </button>
            <a href={`${base}/cart`} class="v-btn-ghost">
              {s.cart} <span class="cart-count inline-flex h-5 min-w-5 items-center justify-center rounded bg-brand px-1.5 text-xs font-bold leading-none text-onbrand">0</span>
            </a>
            <p id="add-status" class="w-full text-sm text-accent" role="status" aria-live="polite"></p>
          </div>
        ) : (
          <div class="mt-8">
            <a href="#quote" data-open-quote id="quote-add" data-sku={product.id}
              class="v-btn">
              {s.requestQuote} ↓
            </a>
          </div>
        )}

        <p class="mt-6 text-sm text-ink/40">{s.guestNote}</p>
        <p class="mt-2 text-xs leading-relaxed text-ink/35">{s.cartLocalNote}</p>

        {(leadTime || shipping) && (
          <dl class="mt-8 space-y-2 text-sm">
            {leadTime && (
              <div class="flex gap-3">
                <dt class="w-20 shrink-0 text-ink/40">{s.leadTimeLabel}</dt>
                <dd class="text-ink/70">{leadTime}</dd>
              </div>
            )}
            {shipping && (
              <div class="flex gap-3">
                <dt class="w-20 shrink-0 text-ink/40">{s.shippingLabel}</dt>
                <dd class="text-ink/70">{shipping}</dd>
              </div>
            )}
          </dl>
        )}
        {d.requiresShipping !== false && (
          <p class="mt-4 text-xs leading-relaxed text-ink/45">{s.shippingNote}</p>
        )}
      </div>
    </div>

    {d.specs.length > 0 && (
      <div class="mt-20 max-w-3xl">
        <h2 class="text-sm font-medium uppercase tracking-widest text-accent">{s.specs}</h2>
        <dl class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
          {d.specs.map((sp) => (
            <div class="grid grid-cols-3 gap-4 py-4">
              <dt class="text-sm text-ink/50">{isKo ? sp.label : (sp.label_en ?? sp.label)}</dt>
              <dd class="col-span-2 text-sm text-ink/90">{isKo ? sp.value : (sp.value_en ?? sp.value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {description && (
      <div class="mt-16 max-w-3xl whitespace-pre-line text-base leading-relaxed text-ink/70">{description}</div>
    )}

    {!isFixed && <QuoteForm product={product} productName={name} />}
  </section>
</BaseLayout>

<script>
  // 저장소 접근은 전부 lib/cart 한 곳을 통한다
  import { addToCart, clampQty, paintCount } from '../../lib/cart';

  const btn = document.getElementById('add-btn');
  btn?.addEventListener('click', () => {
    const box = btn.closest('[data-sku]') as HTMLElement;
    const qtyEl = document.getElementById('qty') as HTMLInputElement;
    addToCart(box.dataset.sku!, clampQty(qtyEl.value));

    const st = document.getElementById('add-status')!;
    st.textContent = box.dataset.msgAdded!;
    setTimeout(() => { st.textContent = ''; }, 2500);
  });

  // ⚠️ '견적 요청' 버튼은 폼으로 스크롤만 시킨다.
  //    예전에는 이 버튼이 장바구니에 {sku, qty:1} 을 몰래 넣어서, 아무것도 작성하지 않았는데
  //    빈 견적이 장바구니에 담기는 것처럼 보였다. 담기는 견적 폼의 '장바구니에 추가' 가 맡는다.

  paintCount();
</script>

<script>
  // 정적 페이지라 가격이 빌드 시점 환율로 박힌다. 현재 환율로 표시만 갱신한다.
  import '../../lib/fx-client';
</script>
