---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import QuoteForm from '../QuoteForm.astro';

const { product } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';

const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const d = product.data;
const name = isKo ? d.name : (d.name_en ?? d.name);
const summary = isKo ? d.summary : (d.summary_en ?? d.summary);
const description = isKo ? d.description : (d.description_en ?? d.description);
const leadTime = isKo ? d.leadTime : (d.leadTime_en ?? d.leadTime);
const shipping = isKo ? d.shipping : (d.shipping_en ?? d.shipping);
const img = d.image ? productImages[d.image]?.default : undefined;
const isFixed = d.pricingType === 'fixed' && typeof d.price === 'number';
const won = (n: number) => new Intl.NumberFormat('ko-KR').format(n);
---

<BaseLayout title={`${name} | VANAM`} description={summary}>
  <section class="relative mx-auto max-w-6xl px-6 py-28 md:py-32">
    <a href={`${base}/product`} class="text-sm text-ink/50 transition hover:text-accent">← {s.backToShop}</a>

    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      <!-- 이미지 -->
      <div class="overflow-hidden rounded-xl border border-ink/10 bg-gradient-to-br from-panel2 to-canvas">
        <div class="aspect-[4/3]">
          {img ? (
            <Image src={img} alt={name} width={900} height={675} class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-4xl font-bold text-ink/15">VANAM</span>
            </div>
          )}
        </div>
      </div>

      <!-- 정보 -->
      <div>
        <h1 class="text-3xl font-bold leading-tight text-ink md:text-4xl">{name}</h1>
        <p class="mt-4 text-base leading-relaxed text-ink/60">{summary}</p>

        <div class="mt-8 border-y border-ink/10 py-6">
          {isFixed ? (
            <p class="text-3xl font-bold text-ink">
              ₩{won(d.price)}<span class="ml-2 text-sm font-normal text-ink/40">{s.vatIncluded}</span>
            </p>
          ) : (
            <p class="text-2xl font-semibold text-accent">{s.priceOnRequest}</p>
          )}
        </div>

        {isFixed ? (
          <div class="mt-8 flex flex-wrap items-end gap-4"
            data-sku={product.id} data-name={name} data-price={d.price} data-msg-added={s.added}>
            <div>
              <label for="qty" class="block text-sm font-medium text-ink/80">{s.quantity}</label>
              <input id="qty" type="number" min="1" max="99" value="1"
                class="mt-2 w-24 rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-ink outline-none transition focus:border-accent focus:ring-1 focus:ring-accent" />
            </div>
            <button type="button" id="add-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">
              {s.addToCart}
            </button>
            <a href={`${base}/cart`} class="inline-flex items-center gap-2 rounded-lg border border-ink/15 px-5 py-3 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">
              {s.cart} <span class="cart-count rounded bg-brand px-1.5 py-0.5 text-xs font-bold text-onbrand">0</span>
            </a>
            <p id="add-status" class="w-full text-sm text-accent" role="status" aria-live="polite"></p>
          </div>
        ) : (
          <div class="mt-8">
            <a href="#quote" data-open-quote
              class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">
              {s.requestQuote} ↓
            </a>
          </div>
        )}

        <p class="mt-6 text-sm text-ink/40">{s.guestNote}</p>

        {(leadTime || shipping) && (
          <dl class="mt-8 space-y-2 text-sm">
            {leadTime && (
              <div class="flex gap-3">
                <dt class="w-20 shrink-0 text-ink/40">{s.leadTimeLabel}</dt>
                <dd class="text-ink/70">{leadTime}</dd>
              </div>
            )}
            {shipping && (
              <div class="flex gap-3">
                <dt class="w-20 shrink-0 text-ink/40">{s.shippingLabel}</dt>
                <dd class="text-ink/70">{shipping}</dd>
              </div>
            )}
          </dl>
        )}
      </div>
    </div>

    {d.specs.length > 0 && (
      <div class="mt-20 max-w-3xl">
        <h2 class="text-sm font-medium uppercase tracking-widest text-accent">{s.specs}</h2>
        <dl class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
          {d.specs.map((sp) => (
            <div class="grid grid-cols-3 gap-4 py-4">
              <dt class="text-sm text-ink/50">{sp.label}</dt>
              <dd class="col-span-2 text-sm text-ink/90">{sp.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {description && (
      <div class="mt-16 max-w-3xl whitespace-pre-line text-base leading-relaxed text-ink/70">{description}</div>
    )}

    {!isFixed && <QuoteForm product={product} productName={name} />}
  </section>
</BaseLayout>

<script>
  const CART_KEY = 'vanam_cart';
  const read = () => { try { return JSON.parse(localStorage.getItem(CART_KEY) ?? '[]'); } catch { return []; } };
  const paint = () => {
    const n = read().reduce((s: number, i: { qty: number }) => s + i.qty, 0);
    document.querySelectorAll('.cart-count').forEach((el) => { el.textContent = String(n); });
  };

  const btn = document.getElementById('add-btn');
  btn?.addEventListener('click', () => {
    const box = btn.closest('[data-sku]') as HTMLElement;
    const qtyEl = document.getElementById('qty') as HTMLInputElement;
    const qty = Math.max(1, Math.min(99, parseInt(qtyEl.value, 10) || 1));
    const sku = box.dataset.sku!;

    const cart = read();
    const hit = cart.find((i: { sku: string }) => i.sku === sku);
    if (hit) hit.qty = Math.min(99, hit.qty + qty);
    else cart.push({ sku, qty });
    localStorage.setItem(CART_KEY, JSON.stringify(cart));

    paint();
    const st = document.getElementById('add-status')!;
    st.textContent = box.dataset.msgAdded!;
    setTimeout(() => { st.textContent = ''; }, 2500);
  });

  paint();
</script>
