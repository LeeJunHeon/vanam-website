---
// 블로그 글 상세 페이지 — body(마크다운)가 있는 글만 /blog/[id] 로 생성된다.
//   구성: 뒤로가기 → 카테고리·날짜 → 제목 → 요약 → 대표 이미지(썸네일) →
//         본문(마크다운 렌더) → 사진 갤러리 → 원문 보기 버튼 → BlogPosting JSON-LD
//   SEO 정공법의 골격: 본문·사진이 우리 도메인의 실제 HTML 로 렌더되어 색인된다.
//   마크다운 → HTML 변환은 빌드 타임(marked)이라 클라이언트 비용 0.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { marked } from 'marked';

const { post } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';
const d = post.data;

// 블로그 이미지 에셋 (Keystatic 업로드, 항목별 하위폴더 대응)
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/blog/**/*.{png,jpg,jpeg,webp,avif,gif}',
  { eager: true },
);

const title = isKo ? (d.title_ko ?? d.title) : d.title;
const excerpt = isKo ? (d.excerpt_ko ?? d.excerpt) : d.excerpt;
const bodyMd = isKo ? (d.body_ko ?? d.body) : d.body;
const bodyHtml = bodyMd ? marked.parse(bodyMd) : '';
const hero = d.thumbnail ? thumbs[d.thumbnail]?.default : undefined;
const gallery = (d.images ?? []).map((p: string) => thumbs[p]?.default).filter(Boolean) as ImageMetadata[];

// 퍼감(repost) 글용 LinkedIn 임베드 — linkedinUrl 이 있을 때만 iframe 을 렌더한다.
//   URL 의 activity ID 를 뽑아 공식 임베드 경로로 바꾼다. 퍼감 URN 을 그대로 쓰면
//   원본 글과 "…님이 퍼감" 헤더까지 함께 렌더된다(2026-08 실측 확인).
//   ⚠ 공개 게시물만 렌더되며, 원본이 삭제되면 빈 iframe 이 남는다.
const toLinkedInEmbed = (u?: string) => {
  if (!u) return undefined;
  const m = u.match(/urn:li:(?:activity|ugcPost|share):(\d+)/) ?? u.match(/activity[-:](\d+)/);
  return m ? `https://www.linkedin.com/embed/feed/update/urn:li:activity:${m[1]}` : undefined;
};
const embedSrc = toLinkedInEmbed(d.linkedinUrl);

// 요약(excerpt)은 ①목록 카드 미리보기 ②메타 설명 용도다.
// 상세 페이지에서는 본문 전문이 바로 아래에 나오므로, 요약이 본문 첫머리와
// 겹치면 같은 문장이 두 번 보인다(짧은 글은 통째로 중복). 겹칠 때는 렌더하지 않는다.
// ⚠ description={excerpt || title} 은 그대로 둔다 — 메타 설명은 계속 필요하다.
//   비교 기준: 마크다운 강조 마커(**, _, `)와 끝 문장부호·말줄임표를 걷어내고
//   소문자로 맞춘다. 요약은 본문 첫 문장을 잘라 만든 것이라 이 차이만 보정하면 겹침이 잡힌다.
const cmpKey = (v?: string) =>
  (v ?? '')
    .replace(/[*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/[…."'’”),\]!?]+$/g, '')
    .trim()
    .toLowerCase();
const bodyLead = cmpKey(
  (bodyMd ?? '')
    .split('\n')
    .filter((l) => !l.trim().startsWith('#'))
    .join(' '),
);
const excerptKey = cmpKey(excerpt);
const showExcerpt = excerptKey.length > 0 && !bodyLead.startsWith(excerptKey);

const CAT_LABEL: Record<string, string> = { linkedin: 'LinkedIn', agent: 'Agent' };
const cat = d.category ?? 'linkedin';
const fmtDate = (dt: Date) =>
  dt.toLocaleDateString(isKo ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const canonical = new URL(`${base}/blog/${post.id}`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  inLanguage: isKo ? 'ko-KR' : 'en-US',
  url: canonical,
  mainEntityOfPage: canonical,
  publisher: { '@type': 'Organization', name: 'VanaM Inc.', url: 'https://vanam.co.kr' },
  ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
  ...(d.url ? { sameAs: [d.url] } : {}),
};

const t = {
  back: isKo ? '← 블로그' : '← Back to Blog',
  original: isKo ? 'LinkedIn에서 원문 보기' : 'View original on LinkedIn',
  photos: isKo ? 'Photos' : 'Photos',
};
---

<BaseLayout title={`${title} | VanaM Blog`} description={excerpt || title}>
  <article class="v-wrap pt-28 pb-24 md:pt-32">
    <a href={`${base}/news#blog`} class="text-sm text-ink/45 transition hover:text-accent">{t.back}</a>

    <div class="mt-8 flex flex-wrap items-center gap-3 text-xs">
      <span class={`rounded-full border border-ink/10 bg-ink/[0.03] px-2.5 py-1 font-semibold ${cat === 'linkedin' ? 'text-[#0A66C2]' : 'text-accent'}`}>
        {CAT_LABEL[cat] ?? cat}
      </span>
      {d.date && <span class="text-ink/40">{fmtDate(d.date)}</span>}
    </div>

    <h1 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">{title}</h1>
    {showExcerpt && <p class="mt-4 text-lg leading-relaxed text-ink/55">{excerpt}</p>}

    {hero && (
      <Image src={hero} alt={title} width={1280}
        class="mt-8 w-full v-card" />
    )}

    {bodyHtml && <div class="post-body mt-10 max-w-3xl" set:html={bodyHtml} />}

    {embedSrc && (
      <div class="mt-10 overflow-hidden rounded-2xl border border-ink/10 bg-ink/[0.02]">
        <iframe
          src={embedSrc}
          height="560"
          width="100%"
          frameborder="0"
          allowfullscreen
          loading="lazy"
          title={title}
          class="block w-full"
        ></iframe>
      </div>
    )}

    {gallery.length > 0 && (
      <div class="mt-12">
        <p class="text-sm font-medium uppercase tracking-widest text-accent">{t.photos}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {gallery.map((g) => (
            <Image src={g} alt="" width={880} class="w-full rounded-xl border border-ink/10 bg-ink/[0.03]" />
          ))}
        </div>
      </div>
    )}

    {d.url && (
      <div class="mt-12 border-t border-ink/10 pt-8">
        <a href={d.url} target="_blank" rel="noopener noreferrer"
          class="v-btn-ghost-sm">
          {t.original}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
      </div>
    )}
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
</BaseLayout>

<style is:global>
  /* 본문(마크다운 렌더) 타이포그래피 — 색은 전부 --v-ink 기반이라 라이트/다크 자동 대응 */
  .post-body { font-size: 1.0625rem; }
  .post-body p { margin: 1rem 0; line-height: 1.85; color: color-mix(in srgb, var(--v-ink) 72%, transparent); }
  .post-body h2 { margin: 2.25rem 0 0.75rem; font-size: 1.375rem; font-weight: 700; color: color-mix(in srgb, var(--v-ink) 92%, transparent); }
  .post-body h3 { margin: 1.75rem 0 0.5rem; font-size: 1.125rem; font-weight: 600; color: color-mix(in srgb, var(--v-ink) 88%, transparent); }
  .post-body a { color: var(--v-accent); text-decoration: underline; text-underline-offset: 3px; }
  .post-body a:hover { opacity: 0.8; }
  .post-body ul, .post-body ol { margin: 1rem 0; padding-left: 1.4rem; color: color-mix(in srgb, var(--v-ink) 72%, transparent); }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li { margin: 0.4rem 0; line-height: 1.75; }
  .post-body strong { font-weight: 700; color: color-mix(in srgb, var(--v-ink) 90%, transparent); }
  .post-body em { color: color-mix(in srgb, var(--v-ink) 55%, transparent); }
  .post-body blockquote { margin: 1.25rem 0; border-left: 3px solid var(--v-accent); padding-left: 1rem; color: color-mix(in srgb, var(--v-ink) 60%, transparent); }
  .post-body img { margin: 1.25rem 0; border-radius: 0.75rem; border: 1px solid color-mix(in srgb, var(--v-ink) 10%, transparent); }
  .post-body hr { margin: 2rem 0; border: 0; border-top: 1px solid color-mix(in srgb, var(--v-ink) 10%, transparent); }
  .post-body code { font-size: 0.9em; padding: 0.15em 0.4em; border-radius: 0.375rem; background: color-mix(in srgb, var(--v-ink) 7%, transparent); }
</style>
