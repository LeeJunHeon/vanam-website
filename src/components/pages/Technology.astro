  <script>
    // 모바일(저전력·데이터 절약 모드)에서 autoplay가 무시되는 경우 대비:
    // 화면 진입 시 + 첫 터치 시 play()를 다시 시도한다.
    const kick = document.querySelector<HTMLVideoElement>('video[data-autoplay-kick]');
    if (kick) {
      const tryPlay = () => { kick.play().catch(() => {}); };
      new IntersectionObserver((es) => { if (es[0].isIntersecting) tryPlay(); }, { threshold: 0.2 }).observe(kick);
      window.addEventListener('touchstart', tryPlay, { once: true, passive: true });
      document.addEventListener('visibilitychange', () => { if (!document.hidden) tryPlay(); });
    }
  </script>
