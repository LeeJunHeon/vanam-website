---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const tech = site.technology;
const title = tech.metaTitle;
const description = tech.metaDescription;
const valueProps = tech.valueProps;

// materials 컬렉션에서 system 별로 category→formula[] 그룹을 재구성.
// order 순으로 정렬해 기존 객체의 키/배열 순서를 그대로 보존한다.
const allMaterials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
function groupBySystem(system) {
  const groups = {};
  for (const m of allMaterials) {
    if (m.data.system !== system) continue;
    // 물질 상세 팝업을 위해 formula 와 id(파일명=slug)를 함께 보관
    (groups[m.data.category] ??= []).push({ formula: m.data.formula, id: m.id });
  }
  return groups;
}
const sputter = groupBySystem('sputter');
const ald = groupBySystem('ald');

// 서비스·분석·장비·주문절차·응용분야 섹션은 Product 페이지로 이동/삭제됨 (2026-07 개편)

// 소재 카테고리 라벨 (표시용) — 로직(enum)은 그대로, 표시만 locale별.
const catLabel = locale === 'ko'
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal' };

// 물질 분류 → 해당 제품 페이지 ID. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const matToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };

// ── 물질 상세 팝업(모달)용 데이터 ──────────────────────────
//   배지를 누르면 페이지 이동 대신 모달로 표시한다.
//   빌드 타임에 물질 데이터를 JSON 으로 만들어 페이지에 심고, 클릭 시 클라이언트에서 채운다.
//   이미지는 파일이 실제로 있을 때만 최적화 생성 → 없으면 placeholder. (MaterialDetail 과 동일 로직)
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
const materialInfo: Record<string, {
  formula: string; name: string; category: string; system: string; desc: string; img: string;
}> = {};
for (const m of allMaterials) {
  const d = m.data;
  let img = '';
  if (d.image && matImages[d.image]) {
    const mod = await matImages[d.image]();
    img = (await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 90 })).src;
  }
  materialInfo[m.id] = {
    formula: d.formula,
    name: locale === 'ko' ? (d.name_ko ?? d.name ?? d.formula) : (d.name ?? d.formula),
    category: catLabel[d.category],
    system: d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator',
    desc: (locale === 'ko' ? (d.description_ko ?? d.description) : d.description) ?? '',
    img,
    // 견적 CTA 목적지: 물질 분류에 맞는 제품(견적 폼). 분류 없으면 contact.
    quoteHref: lhref(matToProduct[d.category] ? `/product/${matToProduct[d.category]}` : '/contact'),
  };
}
const mt = {
  system: locale === 'ko' ? '증착 방식' : 'Deposition',
  category: locale === 'ko' ? '분류' : 'Category',
  imgSoon: locale === 'ko' ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  cta: locale === 'ko' ? '이 물질로 견적 문의' : 'Request a quote for this material',
  close: locale === 'ko' ? '닫기' : 'Close',
};
const contactHref = lhref('/contact');
// Tech 상세 비주얼(코어 파이프라인·P2·양자) 자산 — 라이트박스 대형본 포함
const techImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/tech/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const techAsset = (pth: string) => techImages[`/src/assets/tech/${pth}`]?.default;
const techLarge: Record<string, string> = {};
for (const pth of Object.keys(techImages)) {
  techLarge[pth] = (await getImage({ src: techImages[pth].default, width: 1200, format: 'webp' })).src;
}


---
<BaseLayout title={title} description={description} zebra>

  <section>
  <div class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Technology &amp; Solution</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{tech.heroTitle.line1}<br/>{tech.heroTitle.line2}</h1>
      <p class="mt-6 max-w-2xl whitespace-pre-line text-lg leading-relaxed text-ink/60">{tech.heroSubtitle}</p>
    </div>
  </div>
  </section>

  <section>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="sr-only">{tech.keyAdvantages}</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {valueProps.map((v) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
          <h3 class="text-lg font-bold text-ink">{v.h}</h3>
          <p class="mt-3 text-base leading-relaxed text-ink/60" set:html={v.d}></p>
        </div>
      ))}
    </div>
  </div>
  </section>

  <section id="core" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Core Technology</p>
        <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.coreTechHeading}</h2>
        <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.coreTechBody}</p>
      </div>

      {(() => {
        const cv = (tech as any).coreViz;
        // 01~05는 하나의 순환 사이클(조치 → 수집 루프백), 02~04는 CORE VALUE 존.
        // 06(검증·학습)은 사이클 결과를 축적하는 바깥 층으로 표현한다.
        const rows = [...cv.stages.slice(0, 5), { cycle: true }, ...cv.stages.slice(5)];
        const CORE_RI = [1, 2, 3];
        return (
          <div class="v-reveal mt-12">
            <div>
              {rows.map((row: any, ri: number) =>
                row.cycle ? (
                  <div class="relative flex gap-5 md:gap-7">
                    <div class="flex w-12 shrink-0 flex-col items-center md:w-14">
                      <span class="w-px flex-[0.6] bg-accent/25"></span>
                      <Image src={techAsset('core/step6-loop.jpg')!} alt={cv.cycle.t} width={96} class="my-1.5 h-10 w-10 rounded-full border border-accent/30 bg-plate object-contain p-1.5" />
                      <span class="w-px flex-1 bg-accent/25"></span>
                    </div>
                    <div class="min-w-0 flex-1 pb-10 pt-2">
                      <p class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent/[0.06] px-3.5 py-1.5 text-xs font-bold text-accent">↻ {cv.cycle.t}</p>
                      <p class="mt-2 text-xs leading-relaxed text-ink/55">{cv.cycle.s}</p>
                    </div>
                  </div>
                ) : (
                  <div class="relative flex gap-5 md:gap-7">
                    {CORE_RI.includes(ri) && (
                      <span
                        aria-hidden="true"
                        class={`absolute -inset-x-3 -z-10 border-x border-accent/15 bg-accent/[0.045] md:-inset-x-5 ${
                          ri === 1
                            ? '-top-3 bottom-0 rounded-t-2xl border-t'
                            : ri === 3
                              ? 'top-0 bottom-7 rounded-b-2xl border-b'
                              : 'inset-y-0'
                        }`}
                      ></span>
                    )}
                    <div class="flex w-12 shrink-0 flex-col items-center md:w-14">
                      <span class="text-3xl font-bold leading-none text-accent/20 md:text-4xl">{row.no}</span>
                      <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
                      {ri < rows.length - 1 && <span class="mt-1.5 w-px flex-1 bg-accent/25"></span>}
                    </div>

                    <div class={`min-w-0 flex-1 ${ri < rows.length - 1 ? 'pb-10' : ''}`}>
                      {ri === 1 && (
                        <span class="absolute right-0 top-0 rounded-full border border-accent/30 bg-canvas px-3 py-1 text-[10px] font-bold tracking-widest text-accent md:-right-1">{cv.valuesTitle}</span>
                      )}
                      <p class="flex items-center gap-2 pt-1 text-base font-bold text-ink md:text-lg">
                        {row.t}
                        {row.icon && techAsset(`core/${row.icon}`) && (
                          <Image src={techAsset(`core/${row.icon}`)!} alt="" width={64} class="h-6 w-6 rounded border border-ink/10 bg-plate object-contain p-0.5" />
                        )}
                      </p>
                      <div class="mt-3 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
                        {row.items.map((it: any) => (
                          <div class={row.items.length === 1 ? 'sm:col-span-2 lg:col-span-3' : ''}>
                            {it.h && <p class="text-xs font-bold tracking-wide text-accent">{it.h}</p>}
                            {it.bullets && (
                              <ul class="mt-1 space-y-0.5 text-xs leading-relaxed text-ink/60">
                                {it.bullets.map((b: string) => <li>· {b}</li>)}
                              </ul>
                            )}
                            {it.media && (
                              <div class={`mt-2.5 grid gap-2.5 ${it.media.length >= 3 ? 'max-w-2xl grid-cols-3' : 'max-w-md grid-cols-2'}`}>
                                {it.media.map((mm: any) => (
                                  <figure class="min-w-0">
                                    {mm.zoom ? (
                                      <button type="button"
                                        class="tech-zoom block w-full cursor-zoom-in overflow-hidden rounded-md border border-ink/10 bg-plate p-1.5 transition hover:border-accent/60"
                                        data-full={techLarge[`/src/assets/tech/core/${mm.f}`]}
                                        data-name={`${row.t}${mm.cap ? ` — ${mm.cap}` : ''}`}
                                        aria-label={`${mm.cap || row.t} 확대`}>
                                        <Image src={techAsset(`core/${mm.f}`)!} alt={`${row.t}${mm.cap ? ` — ${mm.cap}` : ''}`} width={480} class="w-full object-contain" />
                                      </button>
                                    ) : (
                                      <div class="flex h-full items-center justify-center rounded-md border border-ink/10 bg-plate p-2">
                                        <Image src={techAsset(`core/${mm.f}`)!} alt={`${row.t}${mm.cap ? ` — ${mm.cap}` : ''}`} width={200} class="max-h-20 w-auto object-contain" />
                                      </div>
                                    )}
                                    {mm.cap && <figcaption class="mt-1 text-center text-[10px] text-ink/45">{mm.cap}</figcaption>}
                                  </figure>
                                ))}
                              </div>
                            )}
                            {it.alarms && (
                              <div class="mt-2.5 flex flex-wrap gap-1.5">
                                {cv.alarms.map((a2: { t: string }, i2: number) => (
                                  <span class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${i2 === 0 ? 'border-ok text-ok' : i2 === 1 ? 'border-warn text-warn' : 'border-danger text-danger'}`}>{a2.t}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ),
              )}
            </div>

            <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2.5">
              <span class="text-[11px] font-bold tracking-wide text-accent">{cv.valuesTitle}</span>
              {cv.values.map((v: string, vi: number) => (
                <>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-canvas px-3 py-1.5 text-xs font-semibold text-ink/80">
                    {techAsset(`core/value-${vi + 1}.jpg`) && (
                      <Image src={techAsset(`core/value-${vi + 1}.jpg`)!} alt="" width={32} class="h-4 w-4 rounded-[3px] object-contain" />
                    )}
                    {v}
                  </span>
                  <span class="text-ink/30">→</span>
                </>
              ))}
              <span class="rounded-full bg-accent px-4 py-1.5 text-xs font-bold text-white">{cv.finalGoal}</span>
            </div>
          </div>
        );
      })()}
    </div>
  </section>

  <!-- ── Project 1: Quantum Photonics ──────────────────
       Core Technology 바로 다음. (바로 아래에 Project 2: 에너지 반응형 상세 섹션이 이어진다) -->
  <section id="project1" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.quantumEyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.quantumHeading}</h2>
      <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.quantumBody}</p>
    </div>

    <div class="v-reveal mt-12 grid gap-5 sm:grid-cols-2">
      {tech.quantumItems.map((q) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.03] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-bold text-accent">{q.name}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink/65">{q.desc}</p>
        </div>
      ))}
    </div>

    <div class="v-reveal mt-8">
      <p class="text-sm font-medium text-ink/50">{tech.quantumTargetLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {tech.quantumTargets.map((t) => (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 text-sm text-ink/80">{t}</span>
        ))}
      </div>
    </div>

    </div>
  </section>

  <!-- ── Project 2: Energy-Responsive Semiconductor ──────
       Project 1(양자)과 동일한 문법: 아이브로우 → 헤딩 → 본문 → 2열 카드 → 타깃 칩. -->
  <section id="project2" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.p2Eyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.p2Heading}</h2>
      <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.p2Body}</p>
    </div>

    <div class="v-reveal mt-12 grid gap-5 sm:grid-cols-2">
      {tech.p2Items.map((q) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.03] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-bold text-accent">{q.name}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink/65">{q.desc}</p>
        </div>
      ))}
    </div>

    <div class="v-reveal mt-8">
      <p class="text-sm font-medium text-ink/50">{tech.p2TargetLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {tech.p2Targets.map((t) => (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 text-sm text-ink/80">{t}</span>
        ))}
      </div>
    </div>

    </div>
  </section>

  <section id="materials" class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.materialsHeading}</h2>
      <p class="mt-3 max-w-2xl text-base text-ink/55">{tech.materialsLibraryDesc}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
        <h3 class="text-lg font-bold text-accent">PVD — Sputter &amp; Evaporator</h3>
        {Object.entries(sputter).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
        <h3 class="text-lg font-bold text-accent">ALD</h3>
        {Object.entries(ald).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  </section>


  <section>
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <div class="v-reveal">
        <h2 class="text-3xl font-bold text-ink md:text-4xl">{tech.ctaHeading}</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-ink/60" set:html={tech.ctaBodyHtml}></p>
        <a href={lhref('/contact')} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">{tech.ctaButton}</a>
      </div>
    </div>
  </section>

  <!-- ── 물질 상세 팝업(모달) ──────────────────────────────
       물질 배지를 누르면 이 모달이 열린다(페이지 이동 없음).
       내용은 아래 JSON 데이터에서 클라이언트가 채운다. 이미지 없으면 placeholder. -->
  <div
    id="mat-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mat-modal-name"
  >
    <div class="mat-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="mat-panel relative max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-ink/10 bg-canvas p-6 shadow-2xl md:p-8">
      <button
        type="button"
        class="mat-close absolute right-4 top-4 rounded-md p-1.5 text-ink/50 transition hover:bg-ink/10 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label={mt.close}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <div class="flex flex-wrap items-end gap-x-4 gap-y-2 pr-8">
        <h2 id="mat-modal-name" class="text-3xl font-bold text-ink" data-slot="name"></h2>
        <span class="rounded-md border border-accent/30 bg-accent/[0.06] px-2.5 py-1 text-lg font-semibold text-accent" data-slot="formula"></span>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <div><span class="text-ink/45">{mt.system}: </span><span class="text-ink/80" data-slot="system"></span></div>
        <div><span class="text-ink/45">{mt.category}: </span><span class="text-ink/80" data-slot="category"></span></div>
      </div>

      <!-- 자료 이미지: A4 세로형 기준 — 원본 비율 그대로 세로 최대 75vh 까지 키우고
           폭은 비율에 따라 자동(가운데 정렬). 설명 대기 문구를 없앤 만큼 이미지가 커진다. -->
      <div class="mt-6">
        <img data-slot="img" alt="" class="hidden mx-auto max-h-[75vh] w-auto max-w-full rounded-xl border border-ink/10 object-contain" loading="lazy" />
        <div data-slot="img-ph" class="flex aspect-[16/9] flex-col items-center justify-center gap-3 rounded-xl border border-ink/10 bg-ink/[0.03] text-center">
          <svg class="h-12 w-12 text-ink/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <p class="text-sm text-ink/40">{mt.imgSoon}</p>
        </div>
      </div>

      <p class="mt-6 hidden whitespace-pre-line text-base leading-relaxed text-ink/75" data-slot="desc"></p>

      <div class="mt-8">
        <a data-slot="quote" href={contactHref} class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">
          {mt.cta} →
        </a>
      </div>
    </div>
  </div>

  <script type="application/json" id="mat-data" is:inline set:html={JSON.stringify(materialInfo)}></script>

  <script>
    const modal = document.getElementById('mat-modal');
    const dataEl = document.getElementById('mat-data');
    if (modal && dataEl) {
      const data = JSON.parse(dataEl.textContent || '{}');
      const slot = (name: string) => modal.querySelector<HTMLElement>(`[data-slot="${name}"]`);
      const imgEl = slot('img') as HTMLImageElement | null;
      const imgPh = slot('img-ph');
      const descEl = slot('desc');
      const closeBtn = modal.querySelector<HTMLElement>('.mat-close');
      const backdrop = modal.querySelector<HTMLElement>('.mat-backdrop');
      let lastFocused: HTMLElement | null = null;

      const show = (el: HTMLElement | null) => el?.classList.remove('hidden');
      const hide = (el: HTMLElement | null) => el?.classList.add('hidden');

      function open(id: string) {
        const m = data[id];
        if (!m) return;
        const name = slot('name'); if (name) name.textContent = m.name;
        const formula = slot('formula'); if (formula) formula.textContent = m.formula;
        const system = slot('system'); if (system) system.textContent = m.system;
        const category = slot('category'); if (category) category.textContent = m.category;

        // 견적 CTA 링크를 이 물질의 제품 페이지로 교체
        const quote = slot('quote') as HTMLAnchorElement | null;
        if (quote && m.quoteHref) quote.href = m.quoteHref;

        if (m.img && imgEl) {
          imgEl.src = m.img; imgEl.alt = m.name; show(imgEl); hide(imgPh);
        } else {
          if (imgEl) imgEl.removeAttribute('src'); hide(imgEl); show(imgPh);
        }

        if (m.desc && descEl) {
          descEl.textContent = m.desc; show(descEl);
        } else {
          hide(descEl);
        }

        lastFocused = document.activeElement as HTMLElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      }

      function close() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        lastFocused?.focus();
      }

      document.querySelectorAll<HTMLElement>('[data-mat]').forEach((btn) => {
        btn.addEventListener('click', () => open(btn.getAttribute('data-mat') || ''));
      });
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('flex')) close();
      });
    }
  </script>
  <!-- Tech 비주얼 라이트박스 -->
  <dialog id="tech-lightbox" class="m-auto w-[min(92vw,860px)] rounded-2xl border border-ink/10 bg-canvas p-0 backdrop:bg-black/70">
    <div class="relative p-5">
      <button type="button" id="tech-lb-close" aria-label="닫기"
        class="absolute right-3 top-3 z-10 grid h-9 w-9 place-items-center rounded-full border border-ink/15 bg-canvas text-ink/60 transition hover:border-accent hover:text-accent">✕</button>
      <div class="rounded-xl border border-ink/10 bg-plate p-4">
        <img id="tech-lb-img" src="" alt="" class="mx-auto max-h-[70vh] w-auto object-contain" />
      </div>
      <p id="tech-lb-name" class="mt-3 text-center text-sm font-semibold text-ink/80"></p>
    </div>
  </dialog>

  <script>
    const tlb = document.getElementById('tech-lightbox') as HTMLDialogElement | null;
    const tlbImg = document.getElementById('tech-lb-img') as HTMLImageElement | null;
    const tlbName = document.getElementById('tech-lb-name');
    if (tlb && tlbImg && tlbName) {
      document.querySelectorAll<HTMLButtonElement>('.tech-zoom').forEach((btn) => {
        btn.addEventListener('click', () => {
          tlbImg.src = btn.dataset.full ?? '';
          tlbImg.alt = btn.dataset.name ?? '';
          tlbName.textContent = btn.dataset.name ?? '';
          tlb.showModal();
        });
      });
      document.getElementById('tech-lb-close')?.addEventListener('click', () => tlb.close());
      tlb.addEventListener('click', (ev) => { if (ev.target === tlb) tlb.close(); });
    }
  </script>
</BaseLayout>
