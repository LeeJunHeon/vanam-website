  <!-- ── 물질 상세 팝업(모달) ──────────────────────────────
       물질 배지를 누르면 이 모달이 열린다(페이지 이동 없음).
       내용은 아래 JSON 데이터에서 클라이언트가 채운다. 이미지 없으면 placeholder. -->
  <div
    id="mat-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mat-modal-name"
  >
    <div class="mat-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="mat-panel relative max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-ink/10 bg-canvas p-6 shadow-2xl md:p-8">
      <button
        type="button"
        class="mat-close absolute right-4 top-4 rounded-md p-1.5 text-ink/50 transition hover:bg-ink/10 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label={mt.close}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <div class="flex flex-wrap items-end gap-x-4 gap-y-2 pr-8">
        <h2 id="mat-modal-name" class="text-3xl font-bold text-ink" data-slot="name"></h2>
        <span class="rounded-md border border-accent/30 bg-accent/[0.06] px-2.5 py-1 text-lg font-semibold text-accent" data-slot="formula"></span>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <div><span class="text-ink/45">{mt.system}: </span><span class="text-ink/80" data-slot="system"></span></div>
        <div><span class="text-ink/45">{mt.category}: </span><span class="text-ink/80" data-slot="category"></span></div>
      </div>

      <!-- 자료 이미지: A4 세로형 기준 — 원본 비율 그대로 세로 최대 75vh 까지 키우고
           폭은 비율에 따라 자동(가운데 정렬). 설명 대기 문구를 없앤 만큼 이미지가 커진다. -->
      <div class="mt-6">
        <img data-slot="img" alt="" class="hidden mx-auto max-h-[75vh] w-auto max-w-full rounded-xl border border-ink/10 object-contain" loading="lazy" />
        <div data-slot="img-ph" class="flex aspect-[16/9] flex-col items-center justify-center gap-3 rounded-xl border border-ink/10 bg-ink/[0.03] text-center">
          <svg class="h-12 w-12 text-ink/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <p class="text-sm text-ink/40">{mt.imgSoon}</p>
        </div>
      </div>

      <p class="mt-6 hidden whitespace-pre-line text-base leading-relaxed text-ink/75" data-slot="desc"></p>

      <div class="mt-8">
        <a data-slot="quote" href={contactHref} class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">
          {mt.cta} →
        </a>
      </div>
    </div>
  </div>

  <script type="application/json" id="mat-data" is:inline set:html={JSON.stringify(materialInfo)}></script>

  <script>
    const modal = document.getElementById('mat-modal');
    const dataEl = document.getElementById('mat-data');
    if (modal && dataEl) {
      const data = JSON.parse(dataEl.textContent || '{}');
      const slot = (name: string) => modal.querySelector<HTMLElement>(`[data-slot="${name}"]`);
      const imgEl = slot('img') as HTMLImageElement | null;
      const imgPh = slot('img-ph');
      const descEl = slot('desc');
      const closeBtn = modal.querySelector<HTMLElement>('.mat-close');
      const backdrop = modal.querySelector<HTMLElement>('.mat-backdrop');
      let lastFocused: HTMLElement | null = null;

      const show = (el: HTMLElement | null) => el?.classList.remove('hidden');
      const hide = (el: HTMLElement | null) => el?.classList.add('hidden');

      function open(id: string) {
        const m = data[id];
        if (!m) return;
        const name = slot('name'); if (name) name.textContent = m.name;
        const formula = slot('formula'); if (formula) formula.textContent = m.formula;
        const system = slot('system'); if (system) system.textContent = m.system;
        const category = slot('category'); if (category) category.textContent = m.category;

        // 견적 CTA 링크를 이 물질의 제품 페이지로 교체
        const quote = slot('quote') as HTMLAnchorElement | null;
        if (quote && m.quoteHref) quote.href = m.quoteHref;

        if (m.img && imgEl) {
          imgEl.src = m.img; imgEl.alt = m.name; show(imgEl); hide(imgPh);
        } else {
          if (imgEl) imgEl.removeAttribute('src'); hide(imgEl); show(imgPh);
        }

        if (m.desc && descEl) {
          descEl.textContent = m.desc; show(descEl);
        } else {
          hide(descEl);
        }

        lastFocused = document.activeElement as HTMLElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      }

      function close() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        lastFocused?.focus();
      }

      document.querySelectorAll<HTMLElement>('[data-mat]').forEach((btn) => {
        btn.addEventListener('click', () => open(btn.getAttribute('data-mat') || ''));
      });
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('flex')) close();
      });
    }
  </script>
  <!-- Tech 비주얼 라이트박스 -->
  <dialog id="tech-lightbox" class="m-auto w-[min(92vw,860px)] rounded-2xl border border-ink/10 bg-canvas p-0 backdrop:bg-black/70">
    <div class="relative p-5">
      <button type="button" id="tech-lb-close" aria-label="닫기"
        class="absolute right-3 top-3 z-10 grid h-9 w-9 place-items-center rounded-full border border-ink/15 bg-canvas text-ink/60 transition hover:border-accent hover:text-accent">✕</button>
      <div class="rounded-xl border border-ink/10 bg-plate p-4">
        <img id="tech-lb-img" src="" alt="" class="mx-auto max-h-[70vh] w-auto object-contain" />
      </div>
      <p id="tech-lb-name" class="mt-3 text-center text-sm font-semibold text-ink/80"></p>
    </div>
  </dialog>

  <script>
    const tlb = document.getElementById('tech-lightbox') as HTMLDialogElement | null;
    const tlbImg = document.getElementById('tech-lb-img') as HTMLImageElement | null;
    const tlbName = document.getElementById('tech-lb-name');
    if (tlb && tlbImg && tlbName) {
      document.querySelectorAll<HTMLButtonElement>('.tech-zoom').forEach((btn) => {
        btn.addEventListener('click', () => {
          tlbImg.src = btn.dataset.full ?? '';
          tlbImg.alt = btn.dataset.name ?? '';
          tlbName.textContent = btn.dataset.name ?? '';
          tlb.showModal();
        });
      });
      document.getElementById('tech-lb-close')?.addEventListener('click', () => tlb.close());
      tlb.addEventListener('click', (ev) => { if (ev.target === tlb) tlb.close(); });
    }
  </script>
</BaseLayout>
