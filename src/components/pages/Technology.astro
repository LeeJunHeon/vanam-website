---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const tech = site.technology;
const title = tech.metaTitle;
const description = tech.metaDescription;
const valueProps = tech.valueProps;

// materials 컬렉션에서 system 별로 category→formula[] 그룹을 재구성.
// order 순으로 정렬해 기존 객체의 키/배열 순서를 그대로 보존한다.
const allMaterials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
function groupBySystem(system) {
  const groups = {};
  for (const m of allMaterials) {
    if (m.data.system !== system) continue;
    // 물질 상세 팝업을 위해 formula 와 id(파일명=slug)를 함께 보관
    (groups[m.data.category] ??= []).push({ formula: m.data.formula, id: m.id });
  }
  return groups;
}
const sputter = groupBySystem('sputter');
const ald = groupBySystem('ald');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);



// 증착 장비 · 공정 데이터 수집 시스템
const equipment = (await getCollection('equipment')).sort((a, b) => a.data.order - b.data.order);

// 분석·측정 항목 (제품의 분석 상품과 연결)
const analysisAll = (await getCollection('analysis')).sort((a, b) => a.data.order - b.data.order);
const analysisMaterial = analysisAll.filter((a) => a.data.group === 'material');
const analysisDevice = analysisAll.filter((a) => a.data.group === 'device');

// 증착 프로세스 6단계
const processSteps = (tech.process ?? []) as { t: string; d: string }[];

const applications = tech.applications;

// 소재 카테고리 라벨 (표시용) — 로직(enum)은 그대로, 표시만 locale별.
const catLabel = locale === 'ko'
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal' };

// 물질 분류 → 해당 제품 페이지 ID. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const matToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };

// ── 물질 상세 팝업(모달)용 데이터 ──────────────────────────
//   배지를 누르면 페이지 이동 대신 모달로 표시한다.
//   빌드 타임에 물질 데이터를 JSON 으로 만들어 페이지에 심고, 클릭 시 클라이언트에서 채운다.
//   이미지는 파일이 실제로 있을 때만 최적화 생성 → 없으면 placeholder. (MaterialDetail 과 동일 로직)
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
const materialInfo: Record<string, {
  formula: string; name: string; category: string; system: string; desc: string; img: string;
}> = {};
for (const m of allMaterials) {
  const d = m.data;
  let img = '';
  if (d.image && matImages[d.image]) {
    const mod = await matImages[d.image]();
    img = (await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 90 })).src;
  }
  materialInfo[m.id] = {
    formula: d.formula,
    name: locale === 'ko' ? (d.name_ko ?? d.name ?? d.formula) : (d.name ?? d.formula),
    category: catLabel[d.category],
    system: d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator',
    desc: (locale === 'ko' ? (d.description_ko ?? d.description) : d.description) ?? '',
    img,
    // 견적 CTA 목적지: 물질 분류에 맞는 제품(견적 폼). 분류 없으면 contact.
    quoteHref: lhref(matToProduct[d.category] ? `/product/${matToProduct[d.category]}` : '/contact'),
  };
}
const mt = {
  system: locale === 'ko' ? '증착 방식' : 'Deposition',
  category: locale === 'ko' ? '분류' : 'Category',
  imgSoon: locale === 'ko' ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  descSoon: locale === 'ko' ? '상세 설명이 곧 추가됩니다.' : 'A detailed description will be added soon.',
  cta: locale === 'ko' ? '이 물질로 견적 문의' : 'Request a quote for this material',
  close: locale === 'ko' ? '닫기' : 'Close',
};
const contactHref = lhref('/contact');
---
<BaseLayout title={title} description={description}>

  <section class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Technology &amp; Solution</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{tech.heroTitle.line1}<br/>{tech.heroTitle.line2}</h1>
      <p class="mt-6 max-w-2xl whitespace-pre-line text-lg leading-relaxed text-ink/60">{tech.heroSubtitle}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="sr-only">{tech.keyAdvantages}</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {valueProps.map((v) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
          <h3 class="text-lg font-bold text-ink">{v.h}</h3>
          <p class="mt-3 text-base leading-relaxed text-ink/60" set:html={v.d}></p>
        </div>
      ))}
    </div>
  </section>

  <section id="core" class="scroll-mt-24 border-y border-ink/10 bg-ink/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Core Technology</p>
        <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.coreTechHeading}</h2>
        <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.coreTechBody}</p>
      </div>
    </div>
  </section>

  <section id="materials" class="scroll-mt-24 mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.materialsHeading}</h2>
      <p class="mt-3 max-w-2xl text-base text-ink/55">{tech.materialsLibraryDesc}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
        <h3 class="text-lg font-bold text-accent">PVD — Sputter &amp; Evaporator</h3>
        {Object.entries(sputter).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
        <h3 class="text-lg font-bold text-accent">ALD</h3>
        {Object.entries(ald).map(([group, items]) => (
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/55">{catLabel[group]}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {items.map((m) => (
                <button type="button" data-mat={m.id}
                  class="cursor-pointer rounded-md border border-ink/10 bg-ink/[0.04] px-2.5 py-1 text-sm text-ink/75 transition hover:border-accent/40 hover:bg-accent/[0.08] hover:text-accent">
                  {m.formula}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 기존 벌크 vs 반암 박막 ─────────────────────────
       VANAM의 경쟁력을 숫자로 증명하는 표. "1개월 → 6시간", "15단계 → 4단계".
       왼쪽(기존)은 흐리게, 오른쪽(반암)은 시안으로 — 눈이 오른쪽으로 가게 만든다. -->
  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.quantumEyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.quantumHeading}</h2>
      <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.quantumBody}</p>
    </div>

    <div class="v-reveal mt-12 grid gap-5 sm:grid-cols-2">
      {tech.quantumItems.map((q) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.03] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-bold text-accent">{q.name}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink/65">{q.desc}</p>
        </div>
      ))}
    </div>

    <div class="v-reveal mt-8">
      <p class="text-sm font-medium text-ink/50">{tech.quantumTargetLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {tech.quantumTargets.map((t) => (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 text-sm text-ink/80">{t}</span>
        ))}
      </div>
    </div>
    </div>
  </section>

  <section id="fs" class="scroll-mt-24 border-t border-ink/10 bg-ink/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal"><h2 class="text-2xl font-bold text-ink">{tech.servicesHeading}</h2></div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-6">
            <div class="text-sm font-bold text-accent">0{i+1}</div>
            <h3 class="mt-3 text-lg font-bold text-ink">{locale === 'ko' ? (s.data.title_ko ?? s.data.title) : s.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{locale === 'ko' ? (s.data.description_ko ?? s.data.description) : s.data.description}</p>
            {(() => {
              const bl = (locale === 'ko' ? s.data.bullets_ko : s.data.bullets) ?? s.data.bullets ?? [];
              return bl.length > 0 && (
                <ul class="mt-4 space-y-1.5 border-t border-ink/[0.08] pt-4">
                  {bl.map((b) => (
                    <li class="flex gap-2 text-xs leading-relaxed text-ink/45">
                      <span class="mt-[7px] size-1 shrink-0 rounded-full bg-accent/50"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              );
            })()}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 분석 · 측정 ─────────────────────────────────────
       WP에만 있던 장비 목록(SEM/TEM/XRD/XPS…)을 옮겨왔다.
       제품의 분석 서비스 상품과 직결되는 정보라, 칩 형태로 한눈에 보이게 한다. -->
  <section id="analysis" class="scroll-mt-24 mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.analysisHeading}</h2>
      <p class="mt-3 text-base text-ink/55">{tech.analysisSub}</p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {[
        { title: tech.analysisMaterial, items: analysisMaterial },
        { title: tech.analysisDevice, items: analysisDevice },
      ].map((g) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-6">
          <p class="text-xs font-medium uppercase tracking-widest text-accent">{g.title}</p>
          <ul class="mt-5 space-y-3">
            {g.items.map((a) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 border-b border-ink/[0.06] pb-3 last:border-b-0 last:pb-0">
                <span class="font-mono text-sm font-semibold text-ink">{a.data.name}</span>
                <span class="text-xs text-ink/40">
                  {locale === 'ko' ? (a.data.description_ko ?? a.data.description) : a.data.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ── 장비 ────────────────────────────────────────────
       "30년 경력 진공장비 전문가와 자체 개발" — WP에 묻혀 있던 강력한 신뢰 요소. -->
  <section id="equipment" class="scroll-mt-24 border-y border-ink/10 bg-ink/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal">
        <h2 class="text-2xl font-bold text-ink">{tech.equipmentHeading}</h2>
        <p class="mt-3 max-w-3xl text-base text-ink/55">{tech.equipmentSub}</p>
      </div>

      {(() => {
        const deposition = equipment.filter((e) => e.data.category === 'deposition');
        const first = deposition[0];        // Sputter — 전체 폭
        const rest = deposition.slice(1);   // ALD, Evaporator — 아래 2열
        return (
          <div class="mt-10 space-y-4">
            {first && (
              <div class="v-reveal rounded-xl border border-ink/10 bg-ink/[0.03] p-5">
                <h3 class="text-base font-bold text-ink">{locale === 'ko' ? (first.data.name_ko ?? first.data.name) : first.data.name}</h3>
                <p class="mt-2 whitespace-pre-line text-xs leading-relaxed text-ink/50">
                  {locale === 'ko' ? (first.data.description_ko ?? first.data.description) : first.data.description}
                </p>
              </div>
            )}
            {rest.length > 0 && (
              <div class="grid gap-4 sm:grid-cols-2">
                {rest.map((e) => (
                  <div class="v-reveal flex h-full flex-col rounded-xl border border-ink/10 bg-ink/[0.03] p-5">
                    <h3 class="text-base font-bold text-ink">{locale === 'ko' ? (e.data.name_ko ?? e.data.name) : e.data.name}</h3>
                    <p class="mt-2 whitespace-pre-line text-xs leading-relaxed text-ink/50">
                      {locale === 'ko' ? (e.data.description_ko ?? e.data.description) : e.data.description}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })()}

      {equipment.filter((e) => e.data.category === 'data').map((e) => (
        <div class="v-reveal mt-4 rounded-xl border border-accent/25 bg-accent/[0.05] p-6">
          <h3 class="text-base font-bold text-accent">{locale === 'ko' ? (e.data.name_ko ?? e.data.name) : e.data.name}</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink/60">
            {locale === 'ko' ? (e.data.description_ko ?? e.data.description) : e.data.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── 증착 의뢰 프로세스 ──────────────────────────────
       WP의 "Deposition Process" 설명을 6단계로 정리했다.
       마지막에 견적 요청으로 이어진다 — 제품과 연결되는 지점. -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.processHeading}</h2>
      <p class="mt-3 text-base text-ink/55">{tech.processSub}</p>
    </div>

    <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((st, i) => (
        <li class="v-reveal bg-canvas p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-bold text-ink">{st.t}</h3>
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-ink/50">{st.d}</p>
        </li>
      ))}
    </ol>

    <div class="v-reveal mt-8 flex flex-wrap items-center gap-4">
      <a href={lhref('/product')}
        class="inline-flex items-center gap-2 rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">
        {tech.processCta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <section id="rt" class="scroll-mt-24 border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.applicationsHeading}</h2>
      <p class="mt-3 text-base text-ink/55">{tech.applicationsDesc}</p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      {applications.map((a) => (
        <span class="v-reveal rounded-full border border-accent/30 bg-accent/10 px-4 py-2 text-sm font-medium text-ink/80">{a}</span>
      ))}
    </div>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <div class="v-reveal">
        <h2 class="text-3xl font-bold text-ink md:text-4xl">{tech.ctaHeading}</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-ink/60" set:html={tech.ctaBodyHtml}></p>
        <a href={lhref('/contact')} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">{tech.ctaButton}</a>
      </div>
    </div>
  </section>

  <!-- ── 물질 상세 팝업(모달) ──────────────────────────────
       물질 배지를 누르면 이 모달이 열린다(페이지 이동 없음).
       내용은 아래 JSON 데이터에서 클라이언트가 채운다. 이미지 없으면 placeholder. -->
  <div
    id="mat-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mat-modal-name"
  >
    <div class="mat-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="mat-panel relative max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-ink/10 bg-canvas p-6 shadow-2xl md:p-8">
      <button
        type="button"
        class="mat-close absolute right-4 top-4 rounded-md p-1.5 text-ink/50 transition hover:bg-ink/10 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label={mt.close}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <div class="flex flex-wrap items-end gap-x-4 gap-y-2 pr-8">
        <h2 id="mat-modal-name" class="text-3xl font-bold text-ink" data-slot="name"></h2>
        <span class="rounded-md border border-accent/30 bg-accent/[0.06] px-2.5 py-1 text-lg font-semibold text-accent" data-slot="formula"></span>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <div><span class="text-ink/45">{mt.system}: </span><span class="text-ink/80" data-slot="system"></span></div>
        <div><span class="text-ink/45">{mt.category}: </span><span class="text-ink/80" data-slot="category"></span></div>
      </div>

      <div class="mt-6 overflow-hidden rounded-xl border border-ink/10 bg-ink/[0.03]">
        <img data-slot="img" alt="" class="hidden w-full" loading="lazy" />
        <div data-slot="img-ph" class="flex aspect-[16/9] flex-col items-center justify-center gap-3 text-center">
          <svg class="h-12 w-12 text-ink/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <p class="text-sm text-ink/40">{mt.imgSoon}</p>
        </div>
      </div>

      <div class="mt-6">
        <p class="hidden whitespace-pre-line text-base leading-relaxed text-ink/75" data-slot="desc"></p>
        <p class="text-base text-ink/40" data-slot="desc-ph">{mt.descSoon}</p>
      </div>

      <div class="mt-8">
        <a data-slot="quote" href={contactHref} class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">
          {mt.cta} →
        </a>
      </div>
    </div>
  </div>

  <script type="application/json" id="mat-data" is:inline set:html={JSON.stringify(materialInfo)}></script>

  <script>
    const modal = document.getElementById('mat-modal');
    const dataEl = document.getElementById('mat-data');
    if (modal && dataEl) {
      const data = JSON.parse(dataEl.textContent || '{}');
      const slot = (name: string) => modal.querySelector<HTMLElement>(`[data-slot="${name}"]`);
      const imgEl = slot('img') as HTMLImageElement | null;
      const imgPh = slot('img-ph');
      const descEl = slot('desc');
      const descPh = slot('desc-ph');
      const closeBtn = modal.querySelector<HTMLElement>('.mat-close');
      const backdrop = modal.querySelector<HTMLElement>('.mat-backdrop');
      let lastFocused: HTMLElement | null = null;

      const show = (el: HTMLElement | null) => el?.classList.remove('hidden');
      const hide = (el: HTMLElement | null) => el?.classList.add('hidden');

      function open(id: string) {
        const m = data[id];
        if (!m) return;
        const name = slot('name'); if (name) name.textContent = m.name;
        const formula = slot('formula'); if (formula) formula.textContent = m.formula;
        const system = slot('system'); if (system) system.textContent = m.system;
        const category = slot('category'); if (category) category.textContent = m.category;

        // 견적 CTA 링크를 이 물질의 제품 페이지로 교체
        const quote = slot('quote') as HTMLAnchorElement | null;
        if (quote && m.quoteHref) quote.href = m.quoteHref;

        if (m.img && imgEl) {
          imgEl.src = m.img; imgEl.alt = m.name; show(imgEl); hide(imgPh);
        } else {
          if (imgEl) imgEl.removeAttribute('src'); hide(imgEl); show(imgPh);
        }

        if (m.desc && descEl) {
          descEl.textContent = m.desc; show(descEl); hide(descPh);
        } else {
          hide(descEl); show(descPh);
        }

        lastFocused = document.activeElement as HTMLElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      }

      function close() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        lastFocused?.focus();
      }

      document.querySelectorAll<HTMLElement>('[data-mat]').forEach((btn) => {
        btn.addEventListener('click', () => open(btn.getAttribute('data-mat') || ''));
      });
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('flex')) close();
      });
    }
  </script>
</BaseLayout>
