---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const tech = site.technology;
const title = tech.metaTitle;
const description = tech.metaDescription;
const valueProps = tech.valueProps;

// materials 컬렉션에서 system 별로 category→formula[] 그룹을 재구성.
// order 순으로 정렬해 기존 객체의 키/배열 순서를 그대로 보존한다.
const allMaterials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
function groupBySystem(system) {
  const groups = {};
  for (const m of allMaterials) {
    if (m.data.system !== system) continue;
    // 물질 상세 팝업을 위해 formula 와 id(파일명=slug)를 함께 보관
    (groups[m.data.category] ??= []).push({ formula: m.data.formula, id: m.id });
  }
  return groups;
}
const sputter = groupBySystem('sputter');
const ald = groupBySystem('ald');

// 서비스·분석·장비·주문절차·응용분야 섹션은 Product 페이지로 이동/삭제됨 (2026-07 개편)

// 소재 카테고리 라벨 (표시용) — 로직(enum)은 그대로, 표시만 locale별.
const catLabel = locale === 'ko'
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal' };

// 물질 분류 → 해당 제품 페이지 ID. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const matToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };

// ── 물질 상세 팝업(모달)용 데이터 ──────────────────────────
//   배지를 누르면 페이지 이동 대신 모달로 표시한다.
//   빌드 타임에 물질 데이터를 JSON 으로 만들어 페이지에 심고, 클릭 시 클라이언트에서 채운다.
//   이미지는 파일이 실제로 있을 때만 최적화 생성 → 없으면 placeholder. (MaterialDetail 과 동일 로직)
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
const materialInfo: Record<string, {
  formula: string; name: string; category: string; system: string; desc: string; img: string;
}> = {};
for (const m of allMaterials) {
  const d = m.data;
  let img = '';
  if (d.image && matImages[d.image]) {
    const mod = await matImages[d.image]();
    img = (await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 90 })).src;
  }
  materialInfo[m.id] = {
    formula: d.formula,
    name: locale === 'ko' ? (d.name_ko ?? d.name ?? d.formula) : (d.name ?? d.formula),
    category: catLabel[d.category],
    system: d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator',
    desc: (locale === 'ko' ? (d.description_ko ?? d.description) : d.description) ?? '',
    img,
    // 견적 CTA 목적지: 물질 분류에 맞는 제품(견적 폼). 분류 없으면 contact.
    quoteHref: lhref(matToProduct[d.category] ? `/product/${matToProduct[d.category]}` : '/contact'),
  };
}
const mt = {
  system: locale === 'ko' ? '증착 방식' : 'Deposition',
  category: locale === 'ko' ? '분류' : 'Category',
  imgSoon: locale === 'ko' ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  cta: locale === 'ko' ? '이 물질로 견적 문의' : 'Request a quote for this material',
  close: locale === 'ko' ? '닫기' : 'Close',
};
const contactHref = lhref('/contact');
// Tech 상세 비주얼(코어 파이프라인·P2·양자) 자산 — 라이트박스 대형본 포함
const techImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/tech/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const techAsset = (pth: string) => techImages[`/src/assets/tech/${pth}`]?.default;
const techLarge: Record<string, string> = {};
for (const pth of Object.keys(techImages)) {
  techLarge[pth] = (await getImage({ src: techImages[pth].default, width: 1200, format: 'webp' })).src;
}


---
<BaseLayout title={title} description={description} zebra>

  <section>
  <div class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Technology &amp; Solution</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{tech.heroTitle.line1}<br/>{tech.heroTitle.line2}</h1>
      <p class="mt-6 max-w-2xl whitespace-pre-line text-lg leading-relaxed text-ink/60">{tech.heroSubtitle}</p>
    </div>
  </div>
  </section>

  <section>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="sr-only">{tech.keyAdvantages}</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {valueProps.map((v) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
          <h3 class="text-lg font-bold text-ink">{v.h}</h3>
          <p class="mt-3 text-base leading-relaxed text-ink/60" set:html={v.d}></p>
        </div>
      ))}
    </div>
  </div>
  </section>

  <section id="core" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Core Technology</p>
        <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.coreTechHeading}</h2>
        <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.coreTechBody}</p>
      </div>

      {(() => {
        const cv = (tech as any).coreViz;
        // 슬라이드 원본 레이아웃: [1 수집] [2·3·4 통합 박스] [5 조치] [6 검증] + 하단 피드백 순환 화살표.
        const asset = (f: string) => techAsset(`core/${f}`)!;
        const large = (f: string) => techLarge[`/src/assets/tech/core/${f}`];
        const pill = (idx: number) =>
          `mb-3 block rounded-lg px-3 py-2 text-center text-[12px] font-bold leading-snug text-white ${[1, 2, 3].includes(idx) ? 'bg-accent' : 'bg-ink/80'}`;
        const zoomBtn = 'tech-zoom block w-full cursor-zoom-in overflow-hidden rounded-md border border-ink/10 bg-plate p-1.5 transition hover:border-accent/60';
        return (
          <div class="v-reveal mt-12">
            <div class="grid gap-5 lg:grid-cols-[0.92fr_3.35fr_1.08fr_1.08fr] lg:gap-4">

              {/* ── 1. 데이터 수집 ── */}
              <div>
                <p class={pill(0)}>{cv.heads[0].no}. {cv.heads[0].t}</p>
                <div class="space-y-3 rounded-xl border border-ink/15 p-3">
                  {cv.col1.map((eq: any) => (
                    <div class="rounded-lg border border-dashed border-ink/20 p-2.5 text-center">
                      <p class="text-[11px] font-bold text-accent">{eq.label}</p>
                      <Image src={asset(eq.img)} alt={`${eq.label} system`} width={220} class="mx-auto mt-1.5 h-16 w-auto object-contain md:h-20" />
                    </div>
                  ))}
                </div>
              </div>

              {/* ── 2·3·4 통합 박스 ── */}
              <div>
                <div class="mb-3 grid grid-cols-1 gap-2 sm:grid-cols-3 lg:grid-cols-[0.95fr_1.55fr_1fr] lg:gap-3">
                  <p class={pill(1) + ' !mb-0'}>{cv.heads[1].no}. {cv.heads[1].t}</p>
                  <p class={pill(2) + ' !mb-0'}>{cv.heads[2].no}. {cv.heads[2].t}</p>
                  <p class={pill(3) + ' !mb-0'}>{cv.heads[3].no}. {cv.heads[3].t}</p>
                </div>
                <div class="rounded-2xl border-2 border-accent/40 bg-accent/[0.02] p-3.5">
                  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[0.95fr_1.55fr_1fr] lg:gap-3.5">

                    {/* 2 — 통합·전처리 */}
                    <div class="flex flex-col">
                      <div class="rounded-lg border border-ink/15 bg-canvas p-3">
                        <p class="text-[11px] font-bold text-accent">{cv.s2.a.h}</p>
                        <div class="mt-2 flex items-start gap-2">
                          <ul class="min-w-0 flex-1 space-y-0.5 text-[10.5px] leading-relaxed text-ink/60">
                            {cv.s2.a.bullets.map((b: string) => <li>· {b}</li>)}
                          </ul>
                          <Image src={asset(cv.s2.a.img)} alt={cv.s2.a.h} width={120} class="h-11 w-11 shrink-0 object-contain" />
                        </div>
                      </div>
                      <p class="my-1.5 text-center text-base font-bold leading-none text-accent">↓</p>
                      <div class="rounded-lg border border-ink/15 bg-canvas p-3">
                        <p class="text-[11px] font-bold text-accent">{cv.s2.b.h}</p>
                        <div class="mt-2 flex items-start gap-2">
                          <Image src={asset(cv.s2.b.img)} alt={cv.s2.b.h} width={120} class="h-11 w-11 shrink-0 object-contain" />
                          <ul class="min-w-0 flex-1 space-y-0.5 text-[10.5px] leading-relaxed text-ink/60">
                            {cv.s2.b.bullets.map((b: string) => <li>· {b}</li>)}
                          </ul>
                        </div>
                      </div>
                      <p class="mt-2.5 inline-flex items-center gap-1.5 self-start rounded-full border border-ok px-3 py-1 text-[11px] font-bold text-ok">✓ {cv.s2.badge}</p>
                    </div>

                    {/* 3 — 다변량 분석 · 변화 감지 */}
                    <div class="flex flex-col gap-3">
                      <div class="rounded-lg border border-ink/15 bg-canvas p-3">
                        <p class="text-[11px] font-bold text-accent">{cv.s3.dash.h}</p>
                        <div class="mt-2 grid grid-cols-3 gap-2">
                          {cv.s3.dash.panels.map((pn: any) => (
                            <figure class="min-w-0">
                              <figcaption class="mb-1 text-center text-[9.5px] font-semibold leading-tight text-ink/55">{pn.t}</figcaption>
                              <button type="button" class={zoomBtn} data-full={large(pn.img)} data-name={pn.t} aria-label={`${pn.t} 확대`}>
                                <Image src={asset(pn.img)} alt={pn.t} width={360} class="aspect-square w-full object-contain" />
                              </button>
                              {pn.cap && <p class="mt-1 text-center text-[8.5px] leading-tight text-ink/40">{pn.cap}</p>}
                            </figure>
                          ))}
                        </div>
                      </div>
                      <div class="rounded-lg border border-ink/15 bg-canvas p-3">
                        <p class="text-[11px] font-bold text-accent">{cv.s3.change.h}</p>
                        <div class="mt-2 grid grid-cols-2 gap-2">
                          {cv.s3.change.panels.map((pn: any) => (
                            <figure class="min-w-0">
                              <figcaption class="mb-1 text-center text-[9.5px] font-semibold leading-tight text-ink/55">{pn.t}</figcaption>
                              <button type="button" class={zoomBtn} data-full={large(pn.img)} data-name={pn.t} aria-label={`${pn.t} 확대`}>
                                <Image src={asset(pn.img)} alt={pn.t} width={420} class="aspect-square w-full object-contain" />
                              </button>
                            </figure>
                          ))}
                        </div>
                      </div>
                      <div class="rounded-lg border border-ink/15 bg-canvas p-3">
                        <p class="text-center text-[11px] font-bold text-ink/70">{cv.s3.alarm.t}</p>
                        <div class="mt-2 grid grid-cols-3 gap-1.5">
                          {cv.s3.alarm.levels.map((lv: any, li: number) => (
                            <div class={`rounded-md border p-1.5 text-center ${li === 0 ? 'border-ok/50 bg-ok/10' : li === 1 ? 'border-warn/50 bg-warn/10' : 'border-danger/50 bg-danger/10'}`}>
                              <p class={`text-[10.5px] font-bold ${li === 0 ? 'text-ok' : li === 1 ? 'text-warn' : 'text-danger'}`}>{lv.t}</p>
                              <p class="mt-0.5 text-[9px] leading-tight text-ink/60">{lv.l1}</p>
                              <p class="text-[9px] leading-tight text-ink/45">{lv.l2}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    {/* 4 — 진단 · 원인 추정 */}
                    <div class="flex flex-col gap-2.5">
                      {cv.s4.charts.map((ch: any) => (
                        <figure class="rounded-lg border border-ink/15 bg-canvas p-2.5">
                          <figcaption class="mb-1.5 text-center text-[9.5px] font-semibold leading-tight text-ink/55">{ch.t}</figcaption>
                          <button type="button" class={zoomBtn} data-full={large(ch.img)} data-name={ch.t} aria-label={`${ch.t} 확대`}>
                            <Image src={asset(ch.img)} alt={ch.t} width={420} class="max-h-24 w-full object-contain" />
                          </button>
                        </figure>
                      ))}
                      <div class="rounded-lg border border-accent/40 bg-canvas p-2.5">
                        <p class="text-center text-[11px] font-bold text-accent">{cv.s4.result.h}</p>
                        <p class="mt-1 text-center text-[9.5px] leading-relaxed text-ink/60">{cv.s4.result.s}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* ── 5. 의사결정 · 조치 ── */}
              <div>
                <p class={pill(4)}>{cv.heads[4].no}. {cv.heads[4].t}</p>
                <div class="rounded-xl border border-ink/15 p-3">
                  <p class="text-center text-[11px] font-bold text-accent">{cv.s5.feedback}</p>
                  <div class="mt-2.5 rounded-lg border border-ink/15 bg-canvas p-2.5">
                    <p class="text-[11px] font-bold text-ink/70">{cv.s5.decision.h}</p>
                    <div class="mt-2 space-y-2.5">
                      {cv.s5.decision.rows.map((r: any) => (
                        <div class="flex items-start gap-2">
                          <Image src={asset(r.img)} alt="" width={80} class="h-7 w-7 shrink-0 rounded border border-ink/10 bg-plate object-contain p-0.5" />
                          <div class="min-w-0">
                            <p class="text-[10.5px] font-bold leading-tight text-accent">{r.t}</p>
                            <p class="text-[9.5px] leading-tight text-ink/50">{r.s}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="mt-2.5 rounded-lg border border-ink/15 bg-canvas p-2.5">
                    <p class="text-[11px] font-bold text-accent">{cv.s5.conduct.h}</p>
                    <ul class="mt-1.5 space-y-0.5 text-[9.5px] leading-relaxed text-ink/60">
                      {cv.s5.conduct.lines.map((l: string) => <li>· {l}</li>)}
                    </ul>
                  </div>
                </div>
              </div>

              {/* ── 6. 검증 · 학습 ── */}
              <div>
                <p class={pill(5)}>{cv.heads[5].no}. {cv.heads[5].t}</p>
                <div class="flex flex-col gap-2.5">
                  {cv.s6.cards.map((c: any) => (
                    c.loop ? (
                      <div class="flex items-center gap-2.5 rounded-xl border border-ink/15 p-3">
                        <Image src={asset(c.img)} alt={c.t} width={100} class="h-9 w-9 shrink-0 object-contain" />
                        <p class="text-[11px] font-bold leading-tight text-accent">{c.t}</p>
                      </div>
                    ) : (
                      <div class="rounded-xl border border-ink/15 p-3">
                        <p class="text-center text-[11px] font-bold text-accent">{c.t}</p>
                        {c.img && (
                          <button type="button" class={`${zoomBtn} mt-2`} data-full={large(c.img)} data-name={c.t} aria-label={`${c.t} 확대`}>
                            <Image src={asset(c.img)} alt={c.t} width={420} class="max-h-24 w-full object-contain" />
                          </button>
                        )}
                        {c.bullets && (
                          <ul class="mt-1.5 space-y-0.5 text-[9.5px] leading-relaxed text-ink/60">
                            {c.bullets.map((b: string) => <li>· {b}</li>)}
                          </ul>
                        )}
                      </div>
                    )
                  ))}
                </div>
              </div>
            </div>

            {/* ── 하단 피드백 순환 화살표 (6 → 1) ── */}
            <div class="relative mt-5 hidden h-10 lg:block" aria-hidden="true">
              <svg class="absolute inset-0 h-full w-full text-accent/45" viewBox="0 0 1000 40" preserveAspectRatio="none" fill="none">
                <path d="M 985 0 L 985 22 L 22 22 L 22 8" stroke="currentColor" stroke-width="3" />
                <path d="M 12 14 L 22 2 L 32 14" stroke="currentColor" stroke-width="3" fill="none" />
              </svg>
            </div>
            <p class="mt-2 text-center lg:mt-0">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent/[0.06] px-3.5 py-1.5 text-xs font-bold text-accent">↻ {cv.cycle.t}</span>
              <span class="mt-1.5 block text-[11px] leading-relaxed text-ink/50">{cv.cycle.s}</span>
            </p>

            {/* ── Core Value 스트립 (새 아이콘 + Final goal 트로피) ── */}
            <div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-2.5">
              <span class="text-[11px] font-bold tracking-wide text-accent">{cv.valuesTitle}</span>
              {cv.values.map((v: string, vi: number) => (
                <>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-canvas px-3 py-1.5 text-xs font-semibold text-ink/80">
                    {techAsset(`core/value-${vi + 1}.jpg`) && (
                      <Image src={techAsset(`core/value-${vi + 1}.jpg`)!} alt="" width={40} class="h-4.5 w-4.5 rounded-[3px] object-contain" />
                    )}
                    {v}
                  </span>
                  <span class="text-ink/30">→</span>
                </>
              ))}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-4 py-1.5 text-xs font-bold text-white">
                {techAsset('core/value-goal.jpg') && (
                  <Image src={techAsset('core/value-goal.jpg')!} alt="" width={40} class="h-4.5 w-4.5 rounded-[3px] bg-white/90 object-contain p-0.5" />
                )}
                {cv.finalGoal}
              </span>
            </div>
          </div>
        );
      })()}
    </div>
  </section>

  <!-- ── Project 1: Quantum Photonics ──────────────────
       Core Technology 바로 다음. (바로 아래에 Project 2: 에너지 반응형 상세 섹션이 이어진다) -->
  <section id="project1" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.quantumEyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.quantumHeading}</h2>
      <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.quantumBody}</p>
    </div>

    <div class="v-reveal mt-12 grid gap-5 sm:grid-cols-2">
      {tech.quantumItems.map((q) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.03] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-bold text-accent">{q.name}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink/65">{q.desc}</p>
        </div>
      ))}
    </div>

    <div class="v-reveal mt-8">
      <p class="text-sm font-medium text-ink/50">{tech.quantumTargetLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {tech.quantumTargets.map((t) => (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 text-sm text-ink/80">{t}</span>
        ))}
      </div>
    </div>

    </div>
  </section>

  <!-- ── Project 2: Energy-Responsive Semiconductor ──────
       Project 1(양자)과 동일한 문법: 아이브로우 → 헤딩 → 본문 → 2열 카드 → 타깃 칩. -->
  <section id="project2" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.p2Eyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.p2Heading}</h2>
      <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.p2Body}</p>
    </div>

    <div class="v-reveal mt-12 grid gap-5 sm:grid-cols-2">
      {tech.p2Items.map((q) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.03] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-bold text-accent">{q.name}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink/65">{q.desc}</p>
        </div>
      ))}
    </div>

    <div class="v-reveal mt-8">
      <p class="text-sm font-medium text-ink/50">{tech.p2TargetLabel}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {tech.p2Targets.map((t) => (
