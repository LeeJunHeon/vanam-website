---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const tech = site.technology;
const title = tech.metaTitle;
const description = tech.metaDescription;
const valueProps = tech.valueProps;

// materials 컬렉션에서 system 별로 category→formula[] 그룹을 재구성.
// order 순으로 정렬해 기존 객체의 키/배열 순서를 그대로 보존한다.
const allMaterials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
function groupBySystem(system) {
  const groups = {};
  for (const m of allMaterials) {
    if (m.data.system !== system) continue;
    // 물질 상세 팝업을 위해 formula 와 id(파일명=slug)를 함께 보관
    (groups[m.data.category] ??= []).push({ formula: m.data.formula, id: m.id });
  }
  return groups;
}
const sputter = groupBySystem('sputter');
const ald = groupBySystem('ald');

// 서비스·분석·장비·주문절차·응용분야 섹션은 Product 페이지로 이동/삭제됨 (2026-07 개편)

// 소재 카테고리 라벨 (표시용) — 로직(enum)은 그대로, 표시만 locale별.
const catLabel = locale === 'ko'
  ? { Oxide: '산화물', Nitride: '질화물', Metal: '금속' }
  : { Oxide: 'Oxide', Nitride: 'Nitride', Metal: 'Metal' };

// 물질 분류 → 해당 제품 페이지 ID. 견적 CTA 를 그 제품(견적 폼)으로 보낸다.
const matToProduct: Record<string, string> = { Oxide: 'oxides', Nitride: 'nitrides', Metal: 'metals' };

// ── 물질 상세 팝업(모달)용 데이터 ──────────────────────────
//   배지를 누르면 페이지 이동 대신 모달로 표시한다.
//   빌드 타임에 물질 데이터를 JSON 으로 만들어 페이지에 심고, 클릭 시 클라이언트에서 채운다.
//   이미지는 파일이 실제로 있을 때만 최적화 생성 → 없으면 placeholder. (MaterialDetail 과 동일 로직)
const matImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/materials/**/*.{png,jpg,jpeg,webp,avif}',
);
const materialInfo: Record<string, {
  formula: string; name: string; category: string; system: string; desc: string; img: string;
}> = {};
for (const m of allMaterials) {
  const d = m.data;
  let img = '';
  if (d.image && matImages[d.image]) {
    const mod = await matImages[d.image]();
    img = (await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 90 })).src;
  }
  materialInfo[m.id] = {
    formula: d.formula,
    name: locale === 'ko' ? (d.name_ko ?? d.name ?? d.formula) : (d.name ?? d.formula),
    category: catLabel[d.category],
    system: d.system === 'ald' ? 'ALD' : 'PVD — Sputter & Evaporator',
    desc: (locale === 'ko' ? (d.description_ko ?? d.description) : d.description) ?? '',
    img,
    // 견적 CTA 목적지: 물질 분류에 맞는 제품(견적 폼). 분류 없으면 contact.
    quoteHref: lhref(matToProduct[d.category] ? `/product/${matToProduct[d.category]}` : '/contact'),
  };
}
const mt = {
  system: locale === 'ko' ? '증착 방식' : 'Deposition',
  category: locale === 'ko' ? '분류' : 'Category',
  imgSoon: locale === 'ko' ? '상세 이미지 준비 중입니다.' : 'Detailed image coming soon.',
  cta: locale === 'ko' ? '이 물질로 견적 문의' : 'Request a quote for this material',
  close: locale === 'ko' ? '닫기' : 'Close',
};
const contactHref = lhref('/contact');
// Tech 상세 비주얼(코어 파이프라인·P2·양자) 자산
const techImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/tech/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const techAsset = (pth: string) => techImages[`/src/assets/tech/${pth}`]?.default;


---
<BaseLayout title={title} description={description} zebra>

  <section>
  <div class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Technology &amp; Solution</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{tech.heroTitle.line1}<br/>{tech.heroTitle.line2}</h1>
      <p class="mt-6 max-w-2xl whitespace-pre-line text-lg leading-relaxed text-ink/60">{tech.heroSubtitle}</p>
    </div>
  </div>
  </section>

  <section>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="sr-only">{tech.keyAdvantages}</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {valueProps.map((v) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-7">
          <h3 class="text-lg font-bold text-ink">{v.h}</h3>
          <p class="mt-3 text-base leading-relaxed text-ink/60" set:html={v.d}></p>
        </div>
      ))}
    </div>
  </div>
  </section>

  <section id="core" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Core Technology</p>
        <h2 class="mt-5 text-3xl font-bold leading-snug text-ink">{tech.coreTechHeading}</h2>
        <p class="mt-5 text-base leading-relaxed text-ink/65">{tech.coreTechBody}</p>
      </div>

      {(() => {
        const cv = (tech as any).coreViz;
        // 세로 파이프라인(컴팩트): 슬라이드의 좌→우 6단계를 내용 그대로 위→아래로 재배치.
        // 2·3·4 는 통합 강조 박스(시안), 좌측 브래킷 화살표가 5(Action Execution/Feedback)→1 순환을 표현.
        // 브래킷 정렬: 래퍼 A 를 [1 헤더 시작 ~ 5 헤더 끝]으로 잡아 위·아래 스텁이 각 번호 필의
        // 정중앙(top/bottom 14.5px = 필 반지름 16 − 선두께/2)에 정적으로 맞도록 했다. 5의 본문부터는 래퍼 B.
        const asset = (f: string) => techAsset(`core/${f}`)!;
        const pill = (i: number) =>
          `grid h-8 w-8 shrink-0 place-items-center rounded-full text-[13px] font-bold ${[1, 2, 3].includes(i) ? 'bg-brand text-onbrand' : 'bg-ink/80 text-canvas'}`;
        const card = 'rounded-xl border border-ink/15 bg-canvas p-3';
        const cardH = 'text-[12px] font-bold text-accent';
        const imgBox = 'overflow-hidden rounded-lg border border-ink/10 bg-plate p-1';
        const capCls = 'mb-1 flex-1 text-center text-[11px] font-semibold leading-snug text-ink/60';
        // 단계 사이 세로 흐름 화살표 — 박스 밖(중립)·박스 안(시안 구분선) 두 가지
        const flow = () => (
          <p class="my-2.5 text-center text-xl font-bold leading-none text-ink/40" aria-hidden="true">↓</p>
        );
        const flowIn = () => (
          <div class="my-4 flex items-center gap-4" aria-hidden="true">
            <span class="h-px flex-1 bg-accent/20"></span>
            <span class="text-lg font-bold leading-none text-accent/70">↓</span>
            <span class="h-px flex-1 bg-accent/20"></span>
          </div>
        );
        // 단계 헤더 — 번호 필(2·3·4 시안 채움, 1·5·6 남색) + 제목. 5는 우측에 피드백 라벨.
        const head = (i: number) => (
          <div class="flex flex-wrap items-center gap-2.5">
            <span class={pill(i)}>{cv.heads[i].no}</span>
            <h3 class="text-[14px] font-bold text-ink md:text-[15px]">{cv.heads[i].t}</h3>
            {i === 4 && (
              <span class="rounded-full border border-accent/40 bg-accent/[0.06] px-2.5 py-1 text-[11px] font-bold text-accent sm:ml-auto">{cv.s5.feedback}</span>
            )}
          </div>
        );
        return (
          <div class="v-reveal mt-10">

            {/* ── 래퍼 A: 1 헤더 ~ 5 헤더 + 좌측 피드백 브래킷 (5 필 중앙 → 좌측 상승 → 1 필 중앙, 데스크톱) ── */}
            <div class="relative lg:pl-12">
              <div class="pointer-events-none absolute bottom-[14.5px] left-0 top-[14.5px] hidden w-6 rounded-l-2xl border-y-[3px] border-l-[3px] border-accent/45 lg:block" aria-hidden="true"></div>
              <div class="pointer-events-none absolute left-[22px] top-[9px] hidden h-0 w-0 border-y-[7px] border-l-[10px] border-y-transparent border-l-accent/60 lg:block" aria-hidden="true"></div>
              <span class="pointer-events-none absolute left-[1.5px] top-1/2 hidden -translate-x-1/2 -translate-y-1/2 rotate-180 rounded-full border border-accent/30 bg-canvas px-1.5 py-2.5 text-[11px] font-bold tracking-wide text-accent [writing-mode:vertical-rl] lg:inline-block" aria-hidden="true">↻ {cv.cycle.t}</span>

              {/* ── 1. 데이터 수집 ── */}
              <div>
                {head(0)}
                <div class="mt-3 grid gap-3 sm:grid-cols-3">
                  {cv.col1.map((eq: any) => (
                    <div class="rounded-xl border border-dashed border-ink/25 bg-canvas p-3 text-center">
                      <p class="text-[12px] font-bold text-accent">{eq.label}</p>
                      <Image src={asset(eq.img)} alt={`${eq.label} system`} width={220} class="mx-auto mt-1.5 h-14 w-auto object-contain md:h-16" />
                    </div>
                  ))}
                </div>
              </div>

              {flow()}

              {/* ── 2·3·4 통합 강조 박스 ── */}
              <div class="rounded-2xl border-2 border-accent/40 bg-accent/[0.03] p-3.5 sm:p-5">

                {/* 2 — 데이터 통합 · 전처리: A → B 가로 배치(아이콘 좌측 통일) + Data quality 배지 */}
                {head(1)}
                <div class="mt-3 grid gap-3 lg:grid-cols-[1fr_auto_1fr]">
                  <div class={card}>
                    <p class={cardH}>{cv.s2.a.h}</p>
                    <div class="mt-2 flex items-center gap-3">
                      <Image src={asset(cv.s2.a.img)} alt={cv.s2.a.h} width={140} class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12" />
                      <ul class="min-w-0 flex-1 space-y-0.5 text-[11.5px] leading-relaxed text-ink/60">
                        {cv.s2.a.bullets.map((b: string) => <li>· {b}</li>)}
                      </ul>
                    </div>
                  </div>
                  <div class="hidden items-center lg:flex" aria-hidden="true">
                    <span class="text-lg font-bold text-accent/70">→</span>
                  </div>
                  <div class={card}>
                    <p class={cardH}>{cv.s2.b.h}</p>
                    <div class="mt-2 flex items-center gap-3">
                      <Image src={asset(cv.s2.b.img)} alt={cv.s2.b.h} width={140} class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12" />
                      <ul class="min-w-0 flex-1 space-y-0.5 text-[11.5px] leading-relaxed text-ink/60">
                        {cv.s2.b.bullets.map((b: string) => <li>· {b}</li>)}
                      </ul>
                    </div>
                  </div>
                </div>
                <p class="mt-3 text-center">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-ok bg-ok/10 px-3.5 py-1 text-[11.5px] font-bold text-ok">✓ {cv.s2.badge}</span>
                </p>

                {flowIn()}

                {/* 3 — 다변량 분석 · 변화 감지: 대시보드 전폭 → 변화감지 + Alarm 표 */}
                {head(2)}
                <div class="mt-3 space-y-3">
                  <div class={card}>
                    <p class={cardH}>{cv.s3.dash.h}</p>
                    <div class="mt-2 grid gap-3 sm:grid-cols-3">
                      {cv.s3.dash.panels.map((pn: any) => (
                        <figure class="flex min-w-0 flex-col">
                          <figcaption class={capCls}>
                            {pn.t}
                            {pn.cap && <span class="mt-0.5 block text-[10px] font-medium text-ink/55">{pn.cap}</span>}
                          </figcaption>
                          <div class={imgBox}>
                            <Image src={asset(pn.img)} alt={pn.t} width={360} class="h-32 w-full object-contain" />
                          </div>
                        </figure>
                      ))}
                    </div>
                  </div>
                  <div class="grid gap-3 lg:grid-cols-[1.3fr_1fr]">
                    <div class={card}>
                      <p class={cardH}>{cv.s3.change.h}</p>
                      <div class="mt-2 grid grid-cols-2 gap-3">
                        {cv.s3.change.panels.map((pn: any) => (
                          <figure class="flex min-w-0 flex-col">
                            <figcaption class={capCls}>{pn.t}</figcaption>
                            <div class={imgBox}>
                              <Image src={asset(pn.img)} alt={pn.t} width={360} class="h-32 w-full object-contain" />
                            </div>
                          </figure>
                        ))}
                      </div>
                    </div>
                    <div class={`${card} flex flex-col`}>
                      <p class="text-center text-[12px] font-bold text-ink/75">{cv.s3.alarm.t}</p>
                      <div class="mt-2 grid flex-1 grid-cols-3 gap-2">
                        {cv.s3.alarm.levels.map((lv: any, li: number) => (
                          <div class={`flex flex-col justify-center rounded-lg border p-2 text-center ${li === 0 ? 'border-ok/50 bg-ok/10' : li === 1 ? 'border-warn/50 bg-warn/10' : 'border-danger/50 bg-danger/10'}`}>
                            <p class={`text-[12px] font-bold ${li === 0 ? 'text-ok' : li === 1 ? 'text-warn' : 'text-danger'}`}>{lv.t}</p>
                            <p class="mt-0.5 text-[11px] leading-tight text-ink/65">{lv.l1}</p>
                            <p class="mt-0.5 text-[10.5px] leading-tight text-ink/50">{lv.l2}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                {flowIn()}

                {/* 4 — 진단 · 원인 추정: 차트 3장 가로 + Diagnosis result 밴드 */}
                {head(3)}
                <div class="mt-3 grid gap-3 sm:grid-cols-3">
                  {cv.s4.charts.map((ch: any) => (
                    <figure class={`${card} flex flex-col`}>
                      <figcaption class={capCls}>{ch.t}</figcaption>
                      <div class={imgBox}>
                        <Image src={asset(ch.img)} alt={ch.t} width={360} class="h-28 w-full object-contain" />
                      </div>
                    </figure>
                  ))}
                </div>
                <div class="mt-3 rounded-xl border-2 border-accent/50 bg-canvas p-3 text-center">
                  <p class="text-[12px] font-bold text-accent">{cv.s4.result.h}</p>
                  <p class="mx-auto mt-1 max-w-xl text-[11.5px] leading-relaxed text-ink/60">{cv.s4.result.s}</p>
                </div>
              </div>

              {flow()}

              {/* ── 5. 의사결정 · 조치 — 헤더 (브래킷 하단 스텁이 이 필 중앙에 닿는다) ── */}
              <div>
                {head(4)}
              </div>
            </div>

            <div class="lg:pl-12">
              {/* ── 5. 본문 ── */}
              <div class="mt-3 grid gap-3 lg:grid-cols-[2.2fr_1fr]">
                <div class={card}>
                  <p class="text-[12px] font-bold text-ink/75">{cv.s5.decision.h}</p>
                  <div class="mt-2 grid gap-2.5 sm:grid-cols-2">
                    {cv.s5.decision.rows.map((r: any) => (
                      <div class="flex items-center gap-2.5 rounded-lg border border-ink/10 p-2.5">
                        <Image src={asset(r.img)} alt="" width={96} class="h-9 w-9 shrink-0 rounded-md border border-ink/10 bg-plate object-contain p-1" />
                        <div class="min-w-0">
                          <p class="text-[12px] font-bold leading-tight text-accent">{r.t}</p>
                          <p class="mt-0.5 text-[10.5px] leading-snug text-ink/55">{r.s}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
                <div class={`${card} flex flex-col justify-center`}>
                  <p class={cardH}>{cv.s5.conduct.h}</p>
                  <ul class="mt-1.5 space-y-0.5 text-[11.5px] leading-relaxed text-ink/60">
                    {cv.s5.conduct.lines.map((l: string) => <li>· {l}</li>)}
                  </ul>
                </div>
              </div>

              {flow()}

              {/* ── 6. 검증 · 학습 ── */}
              <div>
                {head(5)}
                <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                  {cv.s6.cards.map((c: any) => (
                    c.loop ? (
                      <div class={`${card} flex flex-col items-center justify-center gap-2 text-center`}>
                        <Image src={asset(c.img)} alt={c.t} width={110} class="h-10 w-10 object-contain" />
                        <p class="text-[12px] font-bold leading-snug text-accent">{c.t}</p>
                      </div>
                    ) : (
                      <div class={`${card} flex flex-col`}>
                        <p class="text-center text-[12px] font-bold leading-snug text-accent">{c.t}</p>
                        {c.img && (
                          <div class={`${imgBox} mt-2.5`}>
                            <Image src={asset(c.img)} alt={c.t} width={360} class="h-24 w-full object-contain" />
                          </div>
                        )}
                        {c.bullets && (
                          <ul class="mt-2.5 space-y-0.5 text-[11px] leading-relaxed text-ink/60">
                            {c.bullets.map((b: string) => <li>· {b}</li>)}
                          </ul>
                        )}
                      </div>
                    )
                  ))}
                </div>
              </div>

              {/* 순환 설명 — 모바일에선 좌측 브래킷 대신 배지로 표시 */}
              <p class="mt-5 text-center">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent/[0.06] px-3 py-1 text-[11.5px] font-bold text-accent lg:hidden">↻ {cv.cycle.t}</span>
                <span class="mt-1.5 block text-[11.5px] leading-relaxed text-ink/60">{cv.cycle.s}</span>
              </p>

              {/* ── Core Value — 파이프라인의 결론 밴드 (가치 4종 → Final goal 3줄) ── */}
              <div class="mt-8 rounded-2xl border border-ink/15 bg-ink/[0.03] p-4 sm:p-5">
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  <p class="text-[12px] font-bold tracking-wide text-accent">{cv.valuesTitle}</p>
                  <p class="text-[11px] font-semibold text-ink/60">{cv.valuesSub}</p>
                </div>
                <div class="mt-3 grid items-stretch gap-2.5 sm:grid-cols-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr]">
                  {cv.values.map((v: string, vi: number) => (
                    <>
                      <div class="flex items-center justify-center gap-2 rounded-xl border border-ink/15 bg-canvas px-3.5 py-2.5">
                        {techAsset(`core/value-${vi + 1}.jpg`) && (
                          <Image src={techAsset(`core/value-${vi + 1}.jpg`)!} alt="" width={72} class="h-7 w-7 rounded-md object-contain" />
                        )}
                        <span class="text-[12px] font-bold text-ink/85">{v}</span>
                      </div>
                      {vi < cv.values.length - 1 && (
                        <span class="hidden items-center justify-center text-base font-bold text-accent/70 lg:flex" aria-hidden="true">→</span>
                      )}
                    </>
                  ))}
                </div>
                <div class="mt-3 flex flex-col items-center gap-2 rounded-xl bg-ink px-4 py-3 text-center sm:flex-row sm:justify-center sm:gap-3.5">
                  <span class="flex items-center gap-2">
                    {techAsset('core/value-goal.jpg') && (
                      <Image src={techAsset('core/value-goal.jpg')!} alt="" width={56} class="h-7 w-7 rounded-md object-contain" />
                    )}
                    <span class="text-[12.5px] font-bold text-canvas">{cv.finalGoal.t}</span>
                  </span>
                  <span class="hidden h-4 w-px bg-canvas/30 sm:block" aria-hidden="true"></span>
                  <p class="text-[12px] font-semibold leading-relaxed text-canvas">{cv.finalGoal.lines.join(' · ')}</p>
                </div>
              </div>
            </div>
          </div>
        );
      })()}
    </div>
  </section>

  <!-- ── Project 1: Quantum Photonics ──────────────────
       Core Technology 바로 다음. (바로 아래에 Project 2: 에너지 반응형 상세 섹션이 이어진다) -->
  <section id="project1" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{tech.quantumEyebrow}</p>
