---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteData from '../../data/site.json';

const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const home = site.home;
const pillars = home.pillars;
const title = home.metaTitle;
const description = home.metaDescription;
---

<BaseLayout title={title} description={description}>
  <!-- 시네마틱 히어로: 소개 영상(분자 결합 클립)을 프레임 시퀀스로 쪼개
       풀블리드 캔버스에 핀 고정(sticky 100vh, 스테이지 280vh)하고 스크롤로 스크럽한다.
       러프(lerp) 재생헤드가 스크롤을 부드럽게 뒤쫓고, 텍스트 카피는 여정 초반에 페이드아웃,
       종점은 canvas 톤 그라디언트로 다음 섹션에 핸드오프. (애플 제품 페이지 기법) -->
  <section id="vn-vhero" class="vn-vhero relative overflow-hidden bg-[#0b0d10]">
    <link rel="preload" as="image" href="/media/hero-poster.webp" fetchpriority="high" />
    {/* 네이티브 비디오 파이프라인(컴포지터 직결) — 부드러움은 브라우저가 보증.
        확대(scale)를 걸지 않는다: 5% 확대는 좌우를 2.5%씩 잘라 우상단 로고 워터마크를 먹는다.
        소스는 텍스트 제거본을 전 구간 전수 스캔해 안전 크롭(y=88·높이 904)한 것이라 상단 검은 띠가 없고,
        색보정(eq)은 걸지 않는다 — 원본 그레이딩이 이미 정상 노출이라 손대면 하이라이트만 날아간다.
        object-cover + 상단 기준 정렬이라 검은 여백 없이 상단 로고가 항상 온전히 보인다. */}
    <video id="vn-vid" class="absolute inset-0 h-full w-full object-cover [object-position:center_top]" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.webp" aria-hidden="true"></video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_42%,transparent_55%,rgba(0,0,0,0.38))]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-44 bg-gradient-to-b from-transparent to-canvas" aria-hidden="true"></div>

    <div id="vh-copy" class="absolute inset-0 flex items-center px-6">
      <div class="vn-copy-in mx-auto w-full max-w-6xl">
        <!-- 히어로는 테마와 무관하게 항상 다크 영상 배경.
             라이트 테마의 accent(#0e7fa8 — 흰 배경 대비용)가 여기선 어둡게 보이므로
             다크 테마의 시안(#1ebbf0)으로 고정한다. -->
        <p translate="no" class="mb-5 font-mono text-xs tracking-[0.25em] text-[#1ebbf0]">VANA&nbsp;MATERIALS&nbsp;LAB.</p>
        <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl">{home.heroTitle.line1}<br />{home.heroTitle.line2}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">{home.heroSubtitle.line1}{home.heroSubtitle.line2 && <><br />{home.heroSubtitle.line2}</>}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={lhref('/technology')} class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">{home.heroCtaPrimary}</a>
          <a href={lhref('/contact')} class="rounded-full border border-white/40 px-6 py-3 text-sm font-medium text-white/90 transition hover:border-white hover:text-white">{home.heroCtaSecondary}</a>
        </div>
      </div>
    </div>

    <div id="vh-hint" class="vn-bounce absolute bottom-7 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1">
      <span class="font-mono text-[10px] tracking-widest text-white/60">SCROLL</span>
      <span class="text-white/70">↓</span>
    </div>
  </section>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-20">
    <p class="mb-3 font-mono text-xs tracking-[0.16em] text-accent">01 / VISION</p>
    <h2 class="mb-5 text-3xl font-semibold text-ink">{home.visionHeading}</h2>
    <p class="max-w-2xl whitespace-pre-line text-base leading-relaxed text-ink/65">{home.visionBody}</p>
  </section>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-12">
    <p class="mb-6 font-mono text-xs tracking-[0.16em] text-accent">02 / CORE TECHNOLOGIES</p>
    <h2 class="sr-only">{locale === 'ko' ? '핵심 기술' : 'Core technologies'}</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.035] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-medium text-ink">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/55">{p.desc}</p>
          {p.note && <p class="mt-3 text-sm leading-relaxed text-danger">{p.note}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-16">
    <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-panel px-8 py-14 text-center">
      <h2 class="text-2xl font-semibold text-ink sm:text-3xl">{home.ctaHeading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/60" set:html={home.ctaBodyHtml}></p>
      <a href={lhref('/contact')} class="mt-8 inline-block rounded-full bg-brand px-7 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">{home.ctaButton}</a>
    </div>
  </section>
</BaseLayout>

<script>
  // 비디오 히어로: 소스 선택·자동재생·카피 페이드·탭 숨김 일시정지
  (() => {
    const sec = document.getElementById('vn-vhero');
    const vid = document.getElementById('vn-vid') as HTMLVideoElement | null;
    if (!sec || !vid) return;
    const MOBILE = window.matchMedia('(max-width: 768px)').matches;
    vid.src = MOBILE ? '/media/hero-loop-m.mp4' : '/media/hero-loop.mp4';
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (rm) { vid.autoplay = false; vid.loop = false; vid.pause(); }
    else { const pr = vid.play(); if (pr && pr.catch) pr.catch(() => {}); }
    const copy = document.getElementById('vh-copy');
    const hint = document.getElementById('vh-hint');
    const onScroll = () => {
      const y = window.scrollY;
      const t = Math.min(1, y / (window.innerHeight * 0.55));
      if (copy) {
        copy.style.opacity = String(1 - t);
        copy.style.transform = `translateY(${-30 * t}px)`;
        copy.style.pointerEvents = t > 0.6 ? 'none' : '';
      }
      if (hint) hint.style.opacity = String(1 - Math.min(1, y / 120));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) vid.pause();
      else if (!rm) vid.play().catch(() => {});
    });
  })();
</script>

<style>
  .vn-grid {
    background-image:
      linear-gradient(var(--v-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--v-grid-line) 1px, transparent 1px);
    background-size: 42px 42px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
  }
  .vn-glow-a { background: radial-gradient(circle, var(--v-glow-a), transparent 70%); animation: vnDriftA 14s ease-in-out infinite; }
  .vn-glow-b { background: radial-gradient(circle, var(--v-glow-b), transparent 70%); animation: vnDriftB 16s ease-in-out infinite; }
  @keyframes vnDriftA { 0%,100% { transform: translate(0,0); } 50% { transform: translate(46px,26px); } }
  @keyframes vnDriftB { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-38px,-20px); } }
  .vn-bounce { animation: vnBounce 1.8s ease-in-out infinite; }
  @keyframes vnBounce { 0%,100% { transform: translate(-50%,0); opacity: .7; } 50% { transform: translate(-50%,7px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .vn-glow-a, .vn-glow-b, .vn-bounce { animation: none; }
  }
  /* 히어로 높이를 영상 비율(1920×904 = 2.1239:1) 이내로 제한한다.
     컨테이너가 영상보다 세로로 길어지면 object-cover 가 좌우를 잘라 우상단 로고를 먹으므로,
     높이 상한을 100vw/2.1239 (=47.08vw) 으로 둔다. cover 유지라 검은 여백은 생기지 않는다. */
  .vn-vhero { height: min(100svh, max(560px, 47.08vw)); min-height: 560px; }
  .vn-copy-in { animation: vnCopyIn .9s cubic-bezier(.2,.7,.2,1) .12s backwards; }
  @keyframes vnCopyIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .vn-copy-in { animation: none; } }
</style>
