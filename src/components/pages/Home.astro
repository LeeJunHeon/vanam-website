---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteData from '../../data/site.json';

const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const home = site.home;
const pillars = home.pillars;
const title = home.metaTitle;
const description = home.metaDescription;
---

<BaseLayout title={title} description={description}>
  <!-- 시네마틱 히어로: 소개 영상(분자 결합 클립)을 프레임 시퀀스로 쪼개
       풀블리드 캔버스에 핀 고정(sticky 100vh, 스테이지 280vh)하고 스크롤로 스크럽한다.
       러프(lerp) 재생헤드가 스크롤을 부드럽게 뒤쫓고, 텍스트 카피는 여정 초반에 페이드아웃,
       종점은 canvas 톤 그라디언트로 다음 섹션에 핸드오프. (애플 제품 페이지 기법) -->
  <div id="vn-stage" class="relative h-[320vh] bg-[#0b0d10]">
    <link rel="preload" as="image" href="/media/hero/f001.avif" media="(min-width: 769px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/media/hero-m/f001.avif" media="(max-width: 768px)" fetchpriority="high" />
    {/* 히어로는 헤더 "아래"에서 시작해 절대 가려지지 않는다.
        헤더 높이를 CSS 변수로 잡아 sticky 오프셋·높이에 그대로 쓰므로,
        스크롤 0에서 이미 고정된 상태 = 위치 이동도 없고 죽은 구간도 없다.
        파싱 중 동기 실행이라 레이아웃 시프트 없음. */}
    <script is:inline>
      (() => {
        const header = document.querySelector('header');
        if (!header) return;
        const apply = () => document.documentElement.style.setProperty('--vn-head', header.offsetHeight + 'px');
        apply();
        if ('ResizeObserver' in window) new ResizeObserver(apply).observe(header);
        window.addEventListener('resize', apply);
      })();
    </script>
    <div class="sticky w-full overflow-hidden" style="top:var(--vn-head,0px);height:calc(100dvh - var(--vn-head,0px))">
      <canvas id="vn-scrub" class="h-full w-full transform-gpu"></canvas>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_42%,transparent_55%,rgba(0,0,0,0.38))]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-44 bg-gradient-to-b from-transparent to-canvas" aria-hidden="true"></div>

      <div id="vn-hero-copy" class="absolute inset-0 flex items-center px-6">
        <div class="vn-copy-in mx-auto w-full max-w-6xl">
          <p class="mb-5 font-mono text-xs tracking-[0.25em] text-accent">VANA&nbsp;MATERIALS&nbsp;LAB.</p>
          <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl">{home.heroTitle.line1}<br />{home.heroTitle.line2}</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">{home.heroSubtitle.line1}<br />{home.heroSubtitle.line2}</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href={lhref('/technology')} class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">{home.heroCtaPrimary}</a>
            <a href={lhref('/contact')} class="rounded-full border border-white/40 px-6 py-3 text-sm font-medium text-white/90 transition hover:border-white hover:text-white">{home.heroCtaSecondary}</a>
          </div>
        </div>
      </div>

      <div id="vn-scroll-hint" class="vn-bounce absolute bottom-7 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1">
        <span class="font-mono text-[10px] tracking-widest text-white/60">SCROLL</span>
        <span class="text-white/70">↓</span>
      </div>
    </div>
  </div>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-20">
    <p class="mb-3 font-mono text-xs tracking-[0.16em] text-accent">01 / VISION</p>
    <h2 class="mb-5 text-3xl font-semibold text-ink">{home.visionHeading}</h2>
    <p class="max-w-2xl whitespace-pre-line text-base leading-relaxed text-ink/65">{home.visionBody}</p>
  </section>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-12">
    <p class="mb-6 font-mono text-xs tracking-[0.16em] text-accent">02 / CORE TECHNOLOGIES</p>
    <h2 class="sr-only">{locale === 'ko' ? '핵심 기술' : 'Core technologies'}</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-2xl border border-ink/10 bg-ink/[0.035] p-6 transition hover:border-accent/50">
          <h3 class="text-lg font-medium text-ink">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/55">{p.desc}</p>
          {p.note && <p class="mt-3 text-sm leading-relaxed text-danger">{p.note}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="v-reveal mx-auto max-w-6xl px-6 py-16">
    <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-panel px-8 py-14 text-center">
      <h2 class="text-2xl font-semibold text-ink sm:text-3xl">{home.ctaHeading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/60" set:html={home.ctaBodyHtml}></p>
      <a href={lhref('/contact')} class="mt-8 inline-block rounded-full bg-brand px-7 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">{home.ctaButton}</a>
    </div>
  </section>
</BaseLayout>

<script>
  // 시네마틱 스크럽 v4 — "스크롤 중에는 디코드하지 않는다"가 설계 원칙.
  //
  // 실측(사용자 브라우저): AVIF 디코드 13ms/프레임 vs drawImage 0.03ms.
  // 60fps 예산이 16.7ms 이므로 스크롤 도중 디코드가 한 번이라도 끼면 바로 끊긴다.
  // → 압축 데이터(blob)만 받아두고, 디코드는 createImageBitmap 으로 워커 스레드에서
  //   재생헤드 주변만 미리 해둔다. 스크럽 중 메인 스레드가 하는 일은 blit(0.03ms)뿐.
  // → 디코드된 비트맵은 메모리를 크게 먹으므로 재생헤드 기준 LRU 로 상한을 둔다.
  (() => {
    const canvas = document.getElementById('vn-scrub') as HTMLCanvasElement | null;
    const stage = document.getElementById('vn-stage');
    const copy = document.getElementById('vn-hero-copy');
    const hint = document.getElementById('vn-scroll-hint');
    if (!canvas || !stage) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const N = 161;
    const MOBILE = window.matchMedia('(max-width: 768px)').matches;
    const DIR = MOBILE ? '/media/hero-m/' : '/media/hero/';
    const src = (i: number) => `${DIR}f${String(i + 1).padStart(3, '0')}.avif`;

    const blobs: (Blob | null)[] = new Array(N).fill(null);   // 압축 데이터(가벼움)
    const bmp = new Map<number, ImageBitmap>();               // 디코드된 비트맵(무거움 → 상한)
    const BMP_CAP = MOBILE ? 18 : 34;

    let W = 0, H = 0, cur = -1, loadTick = 0, drawnTick = -1;
    let target = 0, play = 0, lastScroll = 0;
    let headH = 0, startY = 0, travel = 1;

    const clampIdx = (v: number) => Math.max(0, Math.min(N - 1, v));
    const headIdx = () => clampIdx(Math.round(play));

    const measure = () => {
      const header = document.querySelector('header') as HTMLElement | null;
      headH = header ? header.offsetHeight : 0;
      const top = stage.getBoundingClientRect().top + window.scrollY;
      startY = Math.max(0, top - headH);                       // 배너가 있으면 그만큼만 뒤로
      travel = Math.max(1, stage.clientHeight - (window.innerHeight - headH));
      // 페인트 백킹 상한 1920 — 실제 화면 물리 해상도에 맞춰 선명도를 확보
      const dprRaw = Math.min(1.5, window.devicePixelRatio || 1);
      W = stage.clientWidth; H = Math.max(1, window.innerHeight - headH);
      const dpr = Math.min(dprRaw, 1920 / Math.max(1, W));
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      cur = -1;
    };

    const render = () => {
      const h = headIdx();
      let k = -1;
      for (let d = 0; d < N; d++) {
        if (h - d >= 0 && bmp.has(h - d)) { k = h - d; break; }
        if (h + d < N && bmp.has(h + d)) { k = h + d; break; }
      }
      if (k < 0 || (k === cur && drawnTick === loadTick)) return;
      // 모노토닉 표시: 디코드가 스크롤을 못 따라올 때 nearest 가 재생헤드 앞뒤를 오가며
      // 그리면 화면이 앞뒤로 진동한다. 진행 방향과 반대되는 프레임은 그리지 않고
      // 현재 프레임을 유지한다 — 다음 디코드가 도착하면 방향대로만 전진.
      const dir = target > play + 0.4 ? 1 : target < play - 0.4 ? -1 : 0;
      if (cur >= 0 && dir > 0 && k < cur) return;
      if (cur >= 0 && dir < 0 && k > cur) return;
      const im = bmp.get(k)!;
      const sc = Math.max(W / im.width, H / im.height);
      const dw = im.width * sc, dh = im.height * sc;
      ctx.drawImage(im, (W - dw) / 2, (H - dh) / 2, dw, dh);
      cur = k; drawnTick = loadTick;
    };

    const onScroll = () => {
      lastScroll = performance.now();
      const p = Math.min(1, Math.max(0, (window.scrollY - startY) / travel));
      target = p * (N - 1);
      const t = Math.min(1, p / 0.28);
      if (copy) {
        copy.style.opacity = String(1 - t);
        copy.style.transform = `translateY(${-36 * t}px)`;
        copy.style.pointerEvents = t > 0.6 ? 'none' : '';
      }
      if (hint) hint.style.opacity = String(1 - Math.min(1, p / 0.12));
    };

    // ── 디코드: 워커 스레드(createImageBitmap), 재생헤드 주변만, 동시 2개 ──
    let decoding = 0;
    const evict = () => {
      while (bmp.size > BMP_CAP) {
        const h = headIdx();
        let far = -1, fd = -1;
        bmp.forEach((_v, k) => { const d = Math.abs(k - h); if (d > fd) { fd = d; far = k; } });
        if (far < 0) break;
        const b = bmp.get(far);
        bmp.delete(far);
        try { b && b.close(); } catch (e) {}
      }
    };
    const decodeOne = (i: number) => {
      if (bmp.has(i) || !blobs[i] || decoding >= 2) return false;
      decoding++;
      createImageBitmap(blobs[i] as Blob).then((b) => {
        decoding--;
        if (bmp.has(i)) { b.close(); return; }
        bmp.set(i, b); loadTick++; evict();
      }).catch(() => { decoding--; });
      return true;
    };
    const ensureWindow = () => {
      const h = headIdx();
      const dir = target >= play ? 1 : -1;                     // 진행 방향을 먼저 채운다
      const span = MOBILE ? 8 : 16;
      for (let d = 0; d <= span; d++) {
        if (decodeOne(clampIdx(h + d * dir))) return;
        if (d && decodeOne(clampIdx(h - d * dir))) return;
      }
    };

    // ── 다운로드: 성긴 패스 → 촘촘한 패스, 재생헤드 근접 우선, 스크롤 중 정지 ──
    const PASSES = MOBILE ? [8, 4, 2] : [16, 8, 4, 2, 1];
    const requested = new Uint8Array(N);
    let passIdx = 0, active = 0, pumpWait = false;
    const pickNext = () => {
      const h = headIdx();
      for (; passIdx < PASSES.length; passIdx++) {
        const step = PASSES[passIdx];
        let best = -1, bestD = Infinity;
        for (let i = 0; i < N; i += step) {
          if (requested[i]) continue;
          const d = Math.abs(i - h);
          if (d < bestD) { bestD = d; best = i; }
        }
        if (best >= 0) return best;
      }
      return -1;
    };
    const fetchOne = (i: number, cb: () => void) => {
      fetch(src(i), { cache: 'force-cache' })
        .then((r) => r.blob())
        .then((b) => { blobs[i] = b; cb(); })
        .catch(() => cb());
    };
    const pump = () => {
      // 데스크톱·모바일 모두: 스크롤 직후에는 네트워크·디코드를 쉬어 스크럽을 지킨다
      if (performance.now() - lastScroll < 200) {
        if (!pumpWait) { pumpWait = true; setTimeout(() => { pumpWait = false; pump(); }, 220); }
        return;
      }
      while (active < (MOBILE ? 3 : 8)) {
        const i = pickNext();
        if (i < 0) return;
        requested[i] = 1;
        active++;
        fetchOne(i, () => { active--; pump(); });
      }
    };

    measure(); onScroll();
    requested[0] = 1;
    fetchOne(0, () => { decodeOne(0); });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const still = Math.round((N - 1) * 0.62);
      play = target = still;
      requested[still] = 1;
      fetchOne(still, () => { decodeOne(still); setTimeout(render, 300); });
      return;
    }

    let raf = 0, running = false;
    const loop = () => {
      play += (target - play) * 0.18;
      if (Math.abs(target - play) < 0.02) play = target;
      ensureWindow();
      render();
      raf = requestAnimationFrame(loop);
    };
    const startLoop = () => { if (!running) { running = true; raf = requestAnimationFrame(loop); } };
    const stopLoop = () => { if (running) { running = false; cancelAnimationFrame(raf); } };

    let pumpStarted = false;
    const startPump = () => { if (!pumpStarted) { pumpStarted = true; pump(); } };
    if (document.readyState === 'complete') {
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(startPump, { timeout: 400 });
      else setTimeout(startPump, 300);
    } else {
      window.addEventListener('load', () => {
        if ('requestIdleCallback' in window) (window as any).requestIdleCallback(startPump, { timeout: 400 });
        else setTimeout(startPump, 300);
      }, { once: true });
    }
    window.addEventListener('scroll', startPump, { once: true, passive: true });

    window.addEventListener('scroll', onScroll, { passive: true });
    let rT: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => { clearTimeout(rT); rT = setTimeout(() => { measure(); onScroll(); }, 150); });
    new IntersectionObserver((es) => (es[0].isIntersecting ? startLoop() : stopLoop())).observe(stage);
    startLoop();
  })();
</script>

<style>
  .vn-grid {
    background-image:
      linear-gradient(var(--v-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--v-grid-line) 1px, transparent 1px);
    background-size: 42px 42px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 60% at 25% 20%, #000 35%, transparent 100%);
  }
  .vn-glow-a { background: radial-gradient(circle, var(--v-glow-a), transparent 70%); animation: vnDriftA 14s ease-in-out infinite; }
  .vn-glow-b { background: radial-gradient(circle, var(--v-glow-b), transparent 70%); animation: vnDriftB 16s ease-in-out infinite; }
  @keyframes vnDriftA { 0%,100% { transform: translate(0,0); } 50% { transform: translate(46px,26px); } }
  @keyframes vnDriftB { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-38px,-20px); } }
  .vn-bounce { animation: vnBounce 1.8s ease-in-out infinite; }
  @keyframes vnBounce { 0%,100% { transform: translate(-50%,0); opacity: .7; } 50% { transform: translate(-50%,7px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .vn-glow-a, .vn-glow-b, .vn-bounce { animation: none; }
  }
  .vn-copy-in { animation: vnCopyIn .9s cubic-bezier(.2,.7,.2,1) .12s backwards; }
  @keyframes vnCopyIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .vn-copy-in { animation: none; } }
</style>
