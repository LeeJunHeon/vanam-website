---
import { Image } from 'astro:assets';
import teamPhoto from '../../assets/team/team-photo.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SnsChannels from '../SnsChannels.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import FaqSchema from '../FaqSchema.astro';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.contact;
const f = c.form;
const title = c.metaTitle;
const description = c.metaDescription;

// FAQ: published:true 이고 answer가 비어있지 않은 항목만 표시. 언어는 locale별.
const faqs = (await getCollection('faq'))
  .filter((x) => x.data.published && x.data.answer.trim() !== '')
  .sort((a, b) => a.data.order - b.data.order);
const faqQ = (x) => locale === 'en' ? (x.data.question_en ?? x.data.question) : x.data.question;
const faqA = (x) => locale === 'en' ? (x.data.answer_en ?? x.data.answer) : x.data.answer;

// 웨이퍼 상세의 '대량 주문·국내 구매' 링크에서 넘어온 경우(?product=&qty=&dicing=)
// 문의 내용을 미리 채워 준다. 상품명·다이싱 비용은 **여기(웨이퍼 컬렉션)에서만** 읽는다 —
// 주소창 값을 그대로 화면에 쓰면 아무 문장이나 심을 수 있다.
// 파라미터가 없으면 아무것도 하지 않는다(기존 문의 페이지와 완전히 동일).
const waferCatalog = Object.fromEntries(
  (await getCollection('wafers'))
    .filter((w) => w.data.published !== false)
    .map((w) => [
      w.id,
      {
        name: locale === 'ko' ? w.data.name : ((w.data as Record<string, unknown>).name_en as string ?? w.data.name),
        dicingFeeKrw:
          typeof w.data.dicingFeeKrw === 'number' && w.data.dicingFeeKrw > 0 ? w.data.dicingFeeKrw : 0,
      },
    ]),
);

// 회사 위치 (지도 + 정보 블록)
const isKo = locale === 'ko';
const compName = isKo ? company.nameKo : company.nameEn;
const compAddr = isKo ? company.addressKo : company.addressEn;
// 구글 지도 임베드 (API 키 불필요). 주소로 검색해 표시.
const mapQuery = encodeURIComponent(company.addressKo);
const mapEmbedUrl = `https://www.google.com/maps?q=${mapQuery}&hl=${isKo ? 'ko' : 'en'}&z=16&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const locLabels = isKo
  ? { eyebrow: '오시는 길', heading: '회사 위치', addr: '주소', tel: '전화', email: '이메일', directions: '길찾기', channels: '채널' }
  : { eyebrow: 'Location', heading: 'Find us', addr: 'Address', tel: 'Tel', email: 'Email', directions: 'Directions', channels: 'Channels' };

const inputClass =
  'v-input';
const labelClass = 'block text-sm font-medium text-ink/80';
---

<BaseLayout title={title} description={description}>
  <section id="inquiry" class="scroll-mt-24 relative overflow-hidden">
    {/* 팀 사진 배경 (0234) — 본문과 같은 컨테이너(v-wrap) 안에 가둬 좌우 라인을 맞춘다.
        주기율표(MaterialsLibrary)와 동일한 방식: 화면 전체로 퍼지지 않게 한다.
        사진 평균 밝기 116/255 라 오버레이 없이는 글자가 묻히므로 캔버스 그라데이션을 덮는다. */}
    <div class="pointer-events-none absolute inset-0 flex justify-center" aria-hidden="true">
      <div class="flex w-full max-w-6xl px-6">
        <div class="relative ml-auto h-40 w-full overflow-hidden md:h-[26rem] md:w-[76%]">
        <Image src={teamPhoto} alt="" widths={[960, 1440, 1920]} sizes="(max-width: 768px) 100vw, 880px"
          loading="eager" fetchpriority="high" decoding="async"
          class="h-full w-full object-cover object-[65%_50%] opacity-[0.32] dark:opacity-[0.40]"
          style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 94%), linear-gradient(to right, transparent 0%, #000 18%, #000 95%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 94%), linear-gradient(to right, transparent 0%, #000 18%, #000 95%, transparent 100%); mask-composite: intersect;" />
          <div class="absolute inset-0 bg-gradient-to-b from-canvas/55 via-canvas/35 to-canvas"></div>
        </div>
      </div>
    </div>
    <div class="relative v-wrap py-28 md:py-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{c.heroTitle.line1}<br />{c.heroTitle.line2}</h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">{c.intro}</p>
      {c.introCta && (
        <p class="mt-3 text-base leading-relaxed text-ink/60">
          <a href={c.introCtaHref} class="text-accent underline underline-offset-4 transition hover:text-accent/80">{c.introCta}</a>
        </p>
      )}
    </div>

    <form id="inquiry-form" class="v-reveal mt-14 space-y-8"
      data-msg-success={f.msgSuccess}
      data-msg-error={f.msgError}
      data-msg-captcha={f.msgCaptcha}
      data-label-send={f.submit}
      data-label-sending={f.sending}
      data-wafers={JSON.stringify(waferCatalog)}
      data-wafer-t={JSON.stringify({
        tag: f.waferPrefillTag, qty: f.waferPrefillQty, qtyOne: f.waferPrefillQtyOne,
        perBox: f.waferPrefillPerBox,
        dicing: f.waferPrefillDicing, yes: f.waferPrefillYes, no: f.waferPrefillNo,
      })}>
      {/* 웨이퍼 상세에서 넘어온 문의의 구조화 값. 파라미터가 없으면 빈 값 그대로 전송된다
          (서버는 빈 값을 무시하므로 기존 문의와 완전히 동일하게 처리된다). */}
      <input type="hidden" name="product" id="wf-product" value="" />
      <input type="hidden" name="productName" id="wf-product-name" value="" />
      <input type="hidden" name="qty" id="wf-qty" value="" />
      <input type="hidden" name="dicing" id="wf-dicing" value="" />
      <!-- Honeypot: hidden from humans (spam trap) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{f.honeypot}
          <input type="text" name="vanam_hp_note" tabindex="-1" autocomplete="new-password" />
        </label>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="name" class={labelClass}>{f.name} <span class="text-danger">*</span></label>
          <input id="name" name="name" type="text" required class={inputClass} placeholder={f.namePlaceholder} />
        </div>
        <div>
          <label for="email" class={labelClass}>{f.email} <span class="text-danger">*</span></label>
          <input id="email" name="email" type="email" required class={inputClass} placeholder={f.emailPlaceholder} />
        </div>
        <div>
          <label for="phone" class={labelClass}>{f.phone}</label>
          <input id="phone" name="phone" type="tel" class={inputClass} />
        </div>
        <div>
          <label for="company" class={labelClass}>{f.company}</label>
          <input id="company" name="company" type="text" class={inputClass} placeholder={f.companyPlaceholder} />
        </div>
      </div>

      <div>
        <label for="message" class={labelClass}>{f.message} <span class="text-danger">*</span></label>
        <textarea id="message" name="message" rows="7" required class={`${inputClass} resize-y`} placeholder={f.messagePlaceholder}></textarea>
      </div>

      <div class="space-y-6 border-t border-ink/10 pt-8">
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
          <input type="checkbox" name="privacy" required value="agreed"
            class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
          <span>{f.privacy}</span>
        </label>

        {/* Turnstile 봇 검증 위젯. 대부분 방문자에겐 보이지 않거나 로딩 표시만 뜬다.
            테마는 사이트 라이트/다크에 맞춰 auto. */}
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAAD5eNOFVFYfnvXUA"
          data-theme="auto"
          data-language="auto"
        ></div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" id="submit-btn"
            class="v-btn disabled:cursor-not-allowed disabled:opacity-60">
            <span id="submit-label">{f.submit}</span>
          </button>
          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>
  </div>
  </section>

  <!-- 오시는 길: 지도 + 회사 정보 + 채널 -->
  <section id="location" class="scroll-mt-24 v-wrap pb-24">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">{locLabels.eyebrow}</p>
      <h2 class="mt-4 v-h2">{locLabels.heading}</h2>
    </div>
    <div class="v-reveal mt-10 overflow-hidden rounded-xl border border-ink/10">
      <iframe
        src={mapEmbedUrl}
        title={locLabels.heading}
        width="100%"
        height="340"
        style="border:0; display:block;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
    <div class="v-reveal mt-8 grid gap-8 sm:grid-cols-2">
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="font-medium text-ink/45">{locLabels.addr}</dt>
          {/* ⚠️ 길찾기 링크는 반드시 <dd> **안**에 둔다.
              <dl> 안의 그룹에는 <dt>·<dd> 만 올 수 있어서, 밖에 두면 접근성 검사(정의 목록 구조)에 걸리고
              보조기기·에이전트가 주소 항목을 잘못 읽는다. */}
          <dd translate="no" class="mt-1 text-ink/80">
            <span class="block">{compName}<br />{compAddr}</span>
            <a href={mapLinkUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-accent transition hover:underline">
              {locLabels.directions}
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </dd>
        </div>
        <div>
          <dt class="font-medium text-ink/45">{locLabels.tel}</dt>
          <dd class="mt-1"><a href={`tel:${company.tel.replace(/[^0-9+]/g, '')}`} class="text-ink/80 transition hover:text-accent">{company.tel}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-ink/45">{locLabels.email}</dt>
          <dd class="mt-1"><a href={`mailto:${company.email}`} class="text-ink/80 transition hover:text-accent">{company.email}</a></dd>
        </div>
      </dl>
      <div>
        <p class="text-sm font-medium text-ink/45">{locLabels.channels}</p>
        <p class="mt-1 text-xs text-ink/40">{isKo ? '아이콘을 누르면 각 채널이 새 탭으로 열립니다.' : 'Each channel opens in a new tab.'}</p>
        <div class="mt-3"><SnsChannels /></div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section id="faq" class="scroll-mt-24 v-wrap pb-28">
      <div class="v-reveal">
        <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.faqEyebrow}</p>
        <h2 class="mt-4 v-h2">{c.faqHeading}</h2>
      </div>
      <div class="mt-10 divide-y divide-ink/10 border-t border-ink/10">
        {faqs.map((x) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink/90 transition hover:text-ink">
              <span>{faqQ(x)}</span>
              <span class="shrink-0 text-xl leading-none text-accent transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink/60">{faqA(x)}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <FaqSchema />
</BaseLayout>

{/* Turnstile API. explicit 렌더가 아니라 자동 렌더(.cf-turnstile 를 찾아 위젯 생성). */}
{/* 보안 확인 스크립트는 src/lib/turnstile-client.ts 가 붙인다 —
    실패 감지·자동 재시도·안내가 거기 모여 있다. 여기서 직접 부르지 말 것. */}

<script>
  import { initTelInput, normalizeTelInputs } from '../../lib/telInput';
  // 보안 확인 위젯 — 로드 실패 시 자동 재시도·안내까지 여기서 처리한다
  import { mountTurnstile, resetTurnstile } from '../../lib/turnstile-client';
  // 0246: 보안 위젯은 폼을 실제로 쓸 때 필요하다. 유휴 시간에 올려 LCP 경로를 비운다.
  //   (기능·검증 방식은 동일 — 사용자가 폼에 닿기 전에 이미 준비된다)
  const idle = (window as any).requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
  idle(() => mountTurnstile(), { timeout: 2000 });

  // Turnstile 전역 API 타입 (api.js 가 window.turnstile 을 주입한다)
  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }

  // 문의는 서버 라우트로 전송한다. (웹훅 URL은 서버에만 존재 — 클라이언트 노출 금지)
  // 견적 요청은 제품의 견적가 상품 페이지에서 모달로 접수한다.
  const ENDPOINT = "/api/inquiry";

  const form = document.getElementById("inquiry-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status")!;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const label = document.getElementById("submit-label")!;
  const M = form ? form.dataset : ({} as DOMStringMap);

  // 전화번호 입력에 국가번호 드롭다운 적용
  const phoneEl = document.getElementById("phone") as HTMLInputElement | null;
  if (phoneEl) initTelInput(phoneEl, document.documentElement.lang || "en");

  // ── 웨이퍼 문의 프리필 (0829) ────────────────────────────
  // 웨이퍼 상세의 "대량 주문·국내 구매(세금계산서)는 문의하기 →" 링크가
  // ?product=wafer-si-4inch&qty=2&dicing=1 형태로 상태를 넘긴다.
  // 파라미터가 없거나 모르는 상품이면 아무것도 하지 않는다 — 기존 동작 그대로.
  (function prefillWafer() {
    if (!form) return;
    const q = new URLSearchParams(location.search);
    const id = (q.get('product') ?? '').trim();
    if (!id) return;

    type W = { name: string; dicingFeeKrw: number };
    let cat: Record<string, W> = {};
    let L: Record<string, string> = {};
    try {
      cat = JSON.parse(M.wafers ?? '{}');
      L = JSON.parse(M.waferT ?? '{}');
    } catch { return; }

    const w = cat[id];
    if (!w) return;   // 카탈로그에 없는 id 는 무시한다(주소창으로 임의 문구를 심지 못하게)

    const qty = Math.max(1, Math.min(99, parseInt(q.get('qty') ?? '1', 10) || 1));
    const dicing = q.get('dicing') === '1' && w.dicingFeeKrw > 0;

    // 비용은 원화로 적는다 — 담당자가 그대로 확인·회신할 수 있는 확정 금액이기 때문.
    const dTxt = dicing
      ? `${L.dicing}: ${L.yes} (+₩${w.dicingFeeKrw.toLocaleString('ko-KR')}${L.perBox})`
      : `${L.dicing}: ${L.no}`;
    // 영문은 1박스일 때만 단수형(box)을 쓴다 — 한글은 두 문구가 같아 자연히 무시된다.
    const qtyTxt = ((qty === 1 ? L.qtyOne : L.qty) ?? '× {n}').replace('{n}', String(qty));
    const line = `${L.tag} ${w.name} ${qtyTxt} · ${dTxt}`;

    const msg = document.getElementById('message') as HTMLTextAreaElement | null;
    // 이미 사용자가 쓰기 시작했다면 덮어쓰지 않는다.
    if (msg && !msg.value.trim()) msg.value = `${line}\n\n`;

    const set = (elId: string, v: string) => {
      const el = document.getElementById(elId) as HTMLInputElement | null;
      if (el) el.value = v;
    };
    set('wf-product', id);
    set('wf-product-name', w.name);
    set('wf-qty', String(qty));
    set('wf-dicing', dicing ? '1' : '0');
  })();

  function setStatus(msg: string, ok: boolean) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 미끼칸이 차 있어도 조용히 가짜 성공을 띄우지 않는다.
    // 브라우저 자동완성 오탐(이름에 email 포함)이 실제 문의를 "접수된 척"만 하게 만들었다.
    // 값만 비우고 정상 진행한다 — 직접 POST 하는 봇은 서버측 미끼칸 검사와 Turnstile 이 막는다.
    const hp = form.elements.namedItem("vanam_hp_note") as HTMLInputElement | null;
    if (hp) hp.value = "";

    // 전화번호를 국제표준(+82...)으로 변환한 뒤 수집
    normalizeTelInputs(form);
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    delete data.vanam_hp_note;
    data.type = "general";
    data.locale = document.documentElement.lang || "en";

    // Turnstile 토큰 확인. 위젯이 아직 준비 안 됐으면 잠깐 기다리라고 안내.
    // (FormData 가 cf-turnstile-response 를 자동 수집하므로 data 에 이미 들어있다)
    if (!data["cf-turnstile-response"]) {
      setStatus(M.msgCaptcha!, false);
      return;
    }

    btn.disabled = true;
    label.textContent = M.labelSending!;
    setStatus("", true);

    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      // 제출 성공/실패와 무관하게 토큰은 1회용이므로 위젯을 리셋해 다음 제출을 준비한다.
      resetTurnstile();
      setStatus(M.msgSuccess!, true);
    } catch (err) {
      console.error(err);
      resetTurnstile();
      setStatus(M.msgError!, false);
    } finally {
      btn.disabled = false;
      label.textContent = M.labelSend!;
    }
  });
</script>
