---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
import FaqSchema from '../FaqSchema.astro';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.contact;
const f = c.form;
const title = c.metaTitle;
const description = c.metaDescription;

// FAQ: published:true 이고 answer가 비어있지 않은 항목만 표시. 언어는 locale별.
const faqs = (await getCollection('faq'))
  .filter((x) => x.data.published && x.data.answer.trim() !== '')
  .sort((a, b) => a.data.order - b.data.order);
const faqQ = (x) => locale === 'en' ? (x.data.question_en ?? x.data.question) : x.data.question;
const faqA = (x) => locale === 'en' ? (x.data.answer_en ?? x.data.answer) : x.data.answer;
---

<BaseLayout title={title} description={description}>
  <section class="relative mx-auto max-w-3xl px-6 py-28 md:py-36">
    <p class="text-sm font-medium uppercase tracking-widest text-[#1EBBF0]">{c.eyebrow}</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight text-white md:text-5xl">{c.heroTitle.line1}<br />{c.heroTitle.line2}</h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-white/60">{c.intro}</p>

    <form id="contact-form" class="mt-14 space-y-6"
      data-msg-honeypot={f.msgHoneypot}
      data-msg-demo={f.msgDemo}
      data-msg-success={f.msgSuccess}
      data-msg-error={f.msgError}
      data-label-send={f.submit}
      data-label-sending={f.sending}>
      <!-- 허니팟: 사람에게는 보이지 않음(스팸 차단) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{f.honeypot}
          <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-white/80">{f.name}</label>
          <input id="name" name="name" type="text" required
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder={f.namePlaceholder} />
        </div>
        <div>
          <label for="company" class="block text-sm font-medium text-white/80">{f.company}</label>
          <input id="company" name="company" type="text"
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder={f.companyPlaceholder} />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-white/80">{f.email}</label>
          <input id="email" name="email" type="email" required
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder={f.emailPlaceholder} />
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-white/80">{f.phone}</label>
          <input id="phone" name="phone" type="tel"
            class="mt-2 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
            placeholder={f.phonePlaceholder} />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-white/80">{f.message}</label>
        <textarea id="message" name="message" rows="6" required
          class="mt-2 w-full resize-y rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-[#1EBBF0] focus:ring-1 focus:ring-[#1EBBF0]"
          placeholder={f.messagePlaceholder}></textarea>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" id="submit-btn"
          class="inline-flex items-center gap-2 rounded-lg bg-[#1EBBF0] px-7 py-3 font-semibold text-[#06222C] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
          <span id="submit-label">{f.submit}</span>
        </button>
        <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>

  {faqs.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 pb-28">
      <p class="text-sm font-medium uppercase tracking-widest text-[#1EBBF0]">{c.faqEyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold text-white">{c.faqHeading}</h2>
      <div class="mt-10 divide-y divide-white/10 border-t border-white/10">
        {faqs.map((x) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-white/90 transition hover:text-white">
              <span>{faqQ(x)}</span>
              <span class="shrink-0 text-xl leading-none text-[#1EBBF0] transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{faqA(x)}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <FaqSchema />
</BaseLayout>

<script>
  // === 폼 전송 엔드포인트 ===
  // 아래 셋 중 하나로 채우세요. 비워두면 데모 모드로 동작합니다.
  //  1) Formspree:        "https://formspree.io/f/XXXXXXX"
  //  2) 서버리스 함수(권장): "/api/contact"  ← 웹훅을 서버측에 숨겨 안전
  //  3) 기존 PHP 호스트 포워더: "https://vanam.co.kr/contact-forward.php"
  // ⚠️ Google Chat 웹훅 URL을 이 클라이언트 코드에 직접 넣지 마세요(노출됨).
  const FORM_ENDPOINT = "";

  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("form-status");
  const btn = document.getElementById("submit-btn");
  const label = document.getElementById("submit-label");
  const M = form ? form.dataset : {};  // locale별 메시지(data-* 속성)

  function setStatus(msg, ok) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? "#1EBBF0" : "#FF6B6B";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 허니팟이 채워졌으면 봇 → 조용히 성공처럼 처리
    if (form.vanam_hp_email && form.vanam_hp_email.value.trim() !== "") {
      setStatus(M.msgHoneypot, true);
      form.reset();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    delete data.vanam_hp_email;

    if (!FORM_ENDPOINT) {
      console.log("[contact] FORM_ENDPOINT 미설정. 전송 데이터:", data);
      setStatus(M.msgDemo, true);
      return;
    }

    btn.disabled = true;
    label.textContent = M.labelSending;
    setStatus("", true);

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      setStatus(M.msgSuccess, true);
    } catch (err) {
      console.error(err);
      setStatus(M.msgError, false);
    } finally {
      btn.disabled = false;
      label.textContent = M.labelSend;
    }
  });
</script>
