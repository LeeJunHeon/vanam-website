---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
import FaqSchema from '../FaqSchema.astro';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.contact;
const f = c.form;
const title = c.metaTitle;
const description = c.metaDescription;

// FAQ: published:true 이고 answer가 비어있지 않은 항목만 표시. 언어는 locale별.
const faqs = (await getCollection('faq'))
  .filter((x) => x.data.published && x.data.answer.trim() !== '')
  .sort((a, b) => a.data.order - b.data.order);
const faqQ = (x) => locale === 'en' ? (x.data.question_en ?? x.data.question) : x.data.question;
const faqA = (x) => locale === 'en' ? (x.data.answer_en ?? x.data.answer) : x.data.answer;

const inputClass =
  'mt-2 w-full rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-ink placeholder-ink/30 outline-none transition focus:border-accent focus:ring-1 focus:ring-accent';
const labelClass = 'block text-sm font-medium text-ink/80';
---

<BaseLayout title={title} description={description}>
  <section class="relative mx-auto max-w-3xl px-6 py-28 md:py-36">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.eyebrow}</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{c.heroTitle.line1}<br />{c.heroTitle.line2}</h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">{c.intro}</p>

    <form id="inquiry-form" class="mt-14 space-y-8"
      data-msg-honeypot={f.msgHoneypot}
      data-msg-success={f.msgSuccess}
      data-msg-error={f.msgError}
      data-label-send={f.submit}
      data-label-sending={f.sending}>
      <!-- Honeypot: hidden from humans (spam trap) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{f.honeypot}
          <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="name" class={labelClass}>{f.name}</label>
          <input id="name" name="name" type="text" required class={inputClass} placeholder={f.namePlaceholder} />
        </div>
        <div>
          <label for="email" class={labelClass}>{f.email}</label>
          <input id="email" name="email" type="email" required class={inputClass} placeholder={f.emailPlaceholder} />
        </div>
        <div>
          <label for="phone" class={labelClass}>{f.phone}</label>
          <input id="phone" name="phone" type="tel" class={inputClass} placeholder={f.phonePlaceholder} />
        </div>
        <div>
          <label for="company" class={labelClass}>{f.company}</label>
          <input id="company" name="company" type="text" class={inputClass} placeholder={f.companyPlaceholder} />
        </div>
      </div>

      <div>
        <label for="message" class={labelClass}>{f.message}</label>
        <textarea id="message" name="message" rows="7" required class={`${inputClass} resize-y`} placeholder={f.messagePlaceholder}></textarea>
      </div>

      <div class="space-y-6 border-t border-ink/10 pt-8">
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
          <input type="checkbox" name="privacy" required value="agreed"
            class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
          <span>{f.privacy}</span>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" id="submit-btn"
            class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
            <span id="submit-label">{f.submit}</span>
          </button>
          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>
  </section>

  {faqs.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 pb-28">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.faqEyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold text-ink">{c.faqHeading}</h2>
      <div class="mt-10 divide-y divide-ink/10 border-t border-ink/10">
        {faqs.map((x) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink/90 transition hover:text-ink">
              <span>{faqQ(x)}</span>
              <span class="shrink-0 text-xl leading-none text-accent transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink/60">{faqA(x)}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <FaqSchema />
</BaseLayout>

<script>
  // 문의는 서버 라우트로 전송한다. (웹훅 URL은 서버에만 존재 — 클라이언트 노출 금지)
  // 견적 요청은 스토어의 견적가 상품 페이지에서 모달로 접수한다.
  const ENDPOINT = "/api/inquiry";

  const form = document.getElementById("inquiry-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status")!;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const label = document.getElementById("submit-label")!;
  const M = form ? form.dataset : ({} as DOMStringMap);

  function setStatus(msg: string, ok: boolean) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? 'var(--color-accent)' : "#FF6B6B";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 허니팟이 채워졌으면 봇 → 조용히 성공한 척
    const hp = form.elements.namedItem("vanam_hp_email") as HTMLInputElement | null;
    if (hp && hp.value.trim() !== "") {
      setStatus(M.msgHoneypot!, true);
      form.reset();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    delete data.vanam_hp_email;
    data.type = "general";
    data.locale = document.documentElement.lang || "en";

    btn.disabled = true;
    label.textContent = M.labelSending!;
    setStatus("", true);

    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      setStatus(M.msgSuccess!, true);
    } catch (err) {
      console.error(err);
      setStatus(M.msgError!, false);
    } finally {
      btn.disabled = false;
      label.textContent = M.labelSend!;
    }
  });
</script>
