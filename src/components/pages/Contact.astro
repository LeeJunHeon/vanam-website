---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import FaqSchema from '../FaqSchema.astro';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.contact;
const f = c.form;
const title = c.metaTitle;
const description = c.metaDescription;

// FAQ: published:true 이고 answer가 비어있지 않은 항목만 표시. 언어는 locale별.
const faqs = (await getCollection('faq'))
  .filter((x) => x.data.published && x.data.answer.trim() !== '')
  .sort((a, b) => a.data.order - b.data.order);
const faqQ = (x) => locale === 'en' ? (x.data.question_en ?? x.data.question) : x.data.question;
const faqA = (x) => locale === 'en' ? (x.data.answer_en ?? x.data.answer) : x.data.answer;

// 회사 위치 (지도 + 정보 블록)
const isKo = locale === 'ko';
const compName = isKo ? company.nameKo : company.nameEn;
const compAddr = isKo ? company.addressKo : company.addressEn;
// 구글 지도 임베드 (API 키 불필요). 주소로 검색해 표시.
const mapQuery = encodeURIComponent(company.addressKo);
const mapEmbedUrl = `https://www.google.com/maps?q=${mapQuery}&hl=${isKo ? 'ko' : 'en'}&z=16&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const locLabels = isKo
  ? { eyebrow: '오시는 길', heading: '회사 위치', addr: '주소', tel: '전화', email: '이메일', directions: '길찾기', channels: '채널' }
  : { eyebrow: 'Location', heading: 'Find us', addr: 'Address', tel: 'Tel', email: 'Email', directions: 'Directions', channels: 'Channels' };

const inputClass =
  'mt-2 w-full rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-ink placeholder-ink/30 outline-none transition focus:border-accent focus:ring-1 focus:ring-accent';
const labelClass = 'block text-sm font-medium text-ink/80';
---

<BaseLayout title={title} description={description}>
  <section id="inquiry" class="scroll-mt-24 relative mx-auto max-w-3xl px-6 py-28 md:py-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{c.heroTitle.line1}<br />{c.heroTitle.line2}</h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">{c.intro}</p>
    </div>

    <form id="inquiry-form" class="v-reveal mt-14 space-y-8"
      data-msg-honeypot={f.msgHoneypot}
      data-msg-success={f.msgSuccess}
      data-msg-error={f.msgError}
      data-msg-captcha={f.msgCaptcha}
      data-label-send={f.submit}
      data-label-sending={f.sending}>
      <!-- Honeypot: hidden from humans (spam trap) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{f.honeypot}
          <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="name" class={labelClass}>{f.name}</label>
          <input id="name" name="name" type="text" required class={inputClass} placeholder={f.namePlaceholder} />
        </div>
        <div>
          <label for="email" class={labelClass}>{f.email}</label>
          <input id="email" name="email" type="email" required class={inputClass} placeholder={f.emailPlaceholder} />
        </div>
        <div>
          <label for="phone" class={labelClass}>{f.phone}</label>
          <input id="phone" name="phone" type="tel" class={inputClass} />
        </div>
        <div>
          <label for="company" class={labelClass}>{f.company}</label>
          <input id="company" name="company" type="text" class={inputClass} placeholder={f.companyPlaceholder} />
        </div>
      </div>

      <div>
        <label for="message" class={labelClass}>{f.message}</label>
        <textarea id="message" name="message" rows="7" required class={`${inputClass} resize-y`} placeholder={f.messagePlaceholder}></textarea>
      </div>

      <div class="space-y-6 border-t border-ink/10 pt-8">
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
          <input type="checkbox" name="privacy" required value="agreed"
            class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
          <span>{f.privacy}</span>
        </label>

        {/* Turnstile 봇 검증 위젯. 대부분 방문자에겐 보이지 않거나 로딩 표시만 뜬다.
            테마는 사이트 라이트/다크에 맞춰 auto. */}
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAAD5eNOFVFYfnvXUA"
          data-theme="auto"
          data-language="auto"
        ></div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" id="submit-btn"
            class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
            <span id="submit-label">{f.submit}</span>
          </button>
          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>
  </section>

  <!-- 오시는 길: 지도 + 회사 정보 + 채널 -->
  <section id="location" class="scroll-mt-24 mx-auto max-w-3xl px-6 pb-24">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">{locLabels.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold text-ink">{locLabels.heading}</h2>
    </div>
    <div class="v-reveal mt-10 overflow-hidden rounded-xl border border-ink/10">
      <iframe
        src={mapEmbedUrl}
        title={locLabels.heading}
        width="100%"
        height="340"
        style="border:0; display:block;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
    <div class="v-reveal mt-8 grid gap-8 sm:grid-cols-2">
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="font-medium text-ink/45">{locLabels.addr}</dt>
          <dd class="mt-1 text-ink/80">{compName}<br />{compAddr}</dd>
          <a href={mapLinkUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-accent transition hover:underline">
            {locLabels.directions}
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div>
          <dt class="font-medium text-ink/45">{locLabels.tel}</dt>
          <dd class="mt-1"><a href={`tel:${company.tel.replace(/[^0-9+]/g, '')}`} class="text-ink/80 transition hover:text-accent">{company.tel}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-ink/45">{locLabels.email}</dt>
          <dd class="mt-1"><a href={`mailto:${company.email}`} class="text-ink/80 transition hover:text-accent">{company.email}</a></dd>
        </div>
      </dl>
      <div>
        <p class="text-sm font-medium text-ink/45">{locLabels.channels}</p>
        <div class="mt-3 flex items-center gap-3">
          <a href="https://www.youtube.com/@VanaMaterials" target="_blank" rel="noopener noreferrer" aria-label="YouTube"
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 text-ink/50 transition hover:border-transparent hover:bg-ink/[0.04]" onmouseover="this.style.color='#FF0000'" onmouseout="this.style.color=''">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/vanaminc/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 text-ink/50 transition hover:border-transparent hover:bg-ink/[0.04]" onmouseover="this.style.color='#0A66C2'" onmouseout="this.style.color=''">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://smartstore.naver.com/ybjstore" target="_blank" rel="noopener noreferrer" aria-label={isKo ? '네이버 스토어' : 'Naver Store'}
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 text-ink/50 transition hover:border-transparent hover:bg-ink/[0.04]" onmouseover="this.style.color='#03C75A'" onmouseout="this.style.color=''">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.273 12.845 7.376 0H0v24h7.726V11.156L16.624 24H24V0h-7.727v12.845z"/></svg>
          </a>
          <a href="https://linktr.ee/vanaminc" target="_blank" rel="noopener noreferrer" aria-label="Linktree"
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 text-ink/50 transition hover:border-transparent hover:bg-ink/[0.04]" onmouseover="this.style.color='#43E55E'" onmouseout="this.style.color=''">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m13.73635 5.85251 4.00467-4.11665 2.3248 2.3808-4.20064 4.00466h5.9085v3.30473h-5.9365l4.22865 4.10062-2.3248 2.3338L12.0005 12.099l-5.74052 5.76852-2.3248-2.325 4.22864-4.10063h-5.9365V8.12132h5.9085L3.90557 4.11666l2.3248-2.3808 4.00468 4.11665V0h3.5015zm-3.4995 11.14926h3.5015V24h-3.5015z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section id="faq" class="scroll-mt-24 mx-auto max-w-3xl px-6 pb-28">
      <div class="v-reveal">
        <p class="text-sm font-medium uppercase tracking-widest text-accent">{c.faqEyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold text-ink">{c.faqHeading}</h2>
      </div>
      <div class="mt-10 divide-y divide-ink/10 border-t border-ink/10">
        {faqs.map((x) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink/90 transition hover:text-ink">
              <span>{faqQ(x)}</span>
              <span class="shrink-0 text-xl leading-none text-accent transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink/60">{faqA(x)}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <FaqSchema />
</BaseLayout>

{/* Turnstile API. explicit 렌더가 아니라 자동 렌더(.cf-turnstile 를 찾아 위젯 생성). */}
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { initTelInput, normalizeTelInputs } from '../../lib/telInput';

  // Turnstile 전역 API 타입 (api.js 가 window.turnstile 을 주입한다)
  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }

  // 문의는 서버 라우트로 전송한다. (웹훅 URL은 서버에만 존재 — 클라이언트 노출 금지)
  // 견적 요청은 제품의 견적가 상품 페이지에서 모달로 접수한다.
  const ENDPOINT = "/api/inquiry";

  const form = document.getElementById("inquiry-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status")!;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const label = document.getElementById("submit-label")!;
  const M = form ? form.dataset : ({} as DOMStringMap);

  // 전화번호 입력에 국가번호 드롭다운 적용
  const phoneEl = document.getElementById("phone") as HTMLInputElement | null;
  if (phoneEl) initTelInput(phoneEl, document.documentElement.lang || "en");

  function setStatus(msg: string, ok: boolean) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 허니팟이 채워졌으면 봇 → 조용히 성공한 척
    const hp = form.elements.namedItem("vanam_hp_email") as HTMLInputElement | null;
    if (hp && hp.value.trim() !== "") {
      setStatus(M.msgHoneypot!, true);
      form.reset();
      return;
    }

    // 전화번호를 국제표준(+82...)으로 변환한 뒤 수집
    normalizeTelInputs(form);
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    delete data.vanam_hp_email;
    data.type = "general";
    data.locale = document.documentElement.lang || "en";

    // Turnstile 토큰 확인. 위젯이 아직 준비 안 됐으면 잠깐 기다리라고 안내.
    // (FormData 가 cf-turnstile-response 를 자동 수집하므로 data 에 이미 들어있다)
    if (!data["cf-turnstile-response"]) {
      setStatus(M.msgCaptcha!, false);
      return;
    }

    btn.disabled = true;
    label.textContent = M.labelSending!;
    setStatus("", true);

    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      // 제출 성공/실패와 무관하게 토큰은 1회용이므로 위젯을 리셋해 다음 제출을 준비한다.
      window.turnstile?.reset();
      setStatus(M.msgSuccess!, true);
    } catch (err) {
      console.error(err);
      window.turnstile?.reset();
      setStatus(M.msgError!, false);
    } finally {
      btn.disabled = false;
      label.textContent = M.labelSend!;
    }
  });
</script>
