---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import siteData from '../../data/site.json';
import CertificateGallery from '../CertificateGallery.astro';
const locale = Astro.currentLocale ?? 'en';
const lhref = (p) => getRelativeLocaleUrl(locale, p);
const site = siteData[locale] ?? siteData.en;
const about = site.about;
const title = about.metaTitle;
const description = about.metaDescription;

// 파트너 로고 에셋 매핑: partners.json 의 logo 경로(/src/assets/partners/**/*.{png,webp,...}) → ImageMetadata
const partnerLogos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/partners/**/*.{png,webp,jpg,jpeg,svg,avif}', { eager: true });

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// 팀원 프로필 사진 (Keystatic 업로드, 항목별 하위폴더 대응)
const teamPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/team/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

// history: items(영문) 정본을 사용. (index 는 같은 컬렉션의 summaryKo 한글본을 사용)
const history = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order);

const achievements = (await getCollection('achievements')).sort((a, b) => a.data.order - b.data.order);

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);

function initials(name){ const p = name.replace('Dr. ','').split(' '); return (p[0][0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
---
<BaseLayout title={title} description={description} zebra>

  <section class="relative">
    <div class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{about.eyebrowAbout}</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{about.heroTitle.line1}<br/>{about.heroTitle.line2}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/60">{about.heroSubtitle}</p>
    </div>
    </div>
  </section>

  <section id="vision" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="v-reveal grid gap-10 md:grid-cols-3">
      <div class="md:col-span-1"><h2 class="text-2xl font-bold text-ink">{about.companyHeading}</h2></div>
      <div class="md:col-span-2 space-y-5 text-base leading-relaxed text-ink/65">
        <p>{about.companyP1}</p>
        {(about.companyP2.before || about.companyP2.highlight || about.companyP2.after) && (
          <p>{about.companyP2.before}<span class="text-ink">{about.companyP2.highlight}</span>{about.companyP2.after}</p>
        )}
      </div>
    </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{about.visionEyebrow}</p>
        <p class="mt-5 text-2xl font-semibold leading-snug text-ink md:text-3xl">{about.visionBody}</p>
      </div>
    </div>
    </div>
    </div>
  </section>

  <section id="team" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{about.teamHeading}</h2>
      <p class="mt-3 max-w-2xl text-base text-ink/55">{about.teamDesc}</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member) => {
        const m = member.data;
        const role = locale === 'ko' ? (m.role_ko ?? m.role) : m.role;
        const affil = locale === 'ko' ? (m.affiliation_ko ?? m.affiliation) : m.affiliation;
        const photo = m.photo ? teamPhotos[m.photo]?.default : undefined;
        return (
          <div class="v-reveal flex gap-4 rounded-xl border border-ink/10 bg-ink/[0.03] p-5">
            {photo ? (
              <Image src={photo} alt={m.name} width={160} height={160}
                class="size-20 shrink-0 rounded-xl border border-ink/10 bg-ink/[0.03] object-cover" />
            ) : (
              <div class="flex size-20 shrink-0 items-center justify-center rounded-xl bg-accent/15 text-lg font-bold text-accent">
                {initials(m.name)}
              </div>
            )}
            <div class="min-w-0">
              <p translate="no" class="text-sm font-semibold text-ink">{m.name}</p>
              {role && <p class="mt-0.5 text-xs font-medium text-accent">{role}</p>}
              {affil && <p class="mt-1.5 text-xs leading-relaxed text-ink/40">{affil}</p>}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section id="history" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal"><h2 class="text-2xl font-bold text-ink">{about.historyHeading}</h2></div>
      <div class="mt-12 space-y-12">
        {history.map((h) => {
          const items = locale === 'ko' ? (h.data.items_ko ?? h.data.items) : h.data.items;
          const LIMIT = 3;
          // 최신 연도(2026)는 기본으로 모두 펼친다. 나머지는 3개까지만 보이고 더보기로 펼친다.
          const expanded = h.data.year === '2026';
          const hasMore = items.length > LIMIT;
          return (
            <div class="v-reveal grid gap-6 md:grid-cols-[120px_1fr]">
              <div class="text-3xl font-bold text-accent">{h.data.year}</div>
              <div>
                <ul class="space-y-3 border-l border-ink/10 pl-6" data-history-list>
                  {items.map((it, i) => (
                    <li class={`relative text-base text-ink/70 ${(!expanded && i >= LIMIT) ? 'hidden' : ''}`} data-extra={(!expanded && i >= LIMIT) ? '1' : undefined}>
                      <span class="absolute -left-[1.65rem] top-2 h-2 w-2 rounded-full bg-brand"></span>
                      {it}
                    </li>
                  ))}
                </ul>
                {hasMore && !expanded && (
                  <button type="button" class="mt-4 ml-6 text-sm font-medium text-accent transition hover:underline" data-history-toggle
                    data-more={about.showMore} data-less={about.showLess} aria-expanded="false">
                    {about.showMore} ({items.length - LIMIT})
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <script is:inline>
    // 연혁 "더 보기": 클릭하면 숨겨진 항목(data-extra)을 펼치고, 다시 누르면 접는다.
    document.querySelectorAll('[data-history-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var wrap = btn.parentElement;
        var extras = wrap.querySelectorAll('[data-extra="1"]');
        var open = btn.getAttribute('aria-expanded') === 'true';
        extras.forEach(function (el) { el.classList.toggle('hidden', open); });
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        btn.textContent = open
          ? btn.dataset.more + ' (' + extras.length + ')'
          : btn.dataset.less;
      });
    });
  </script>

  <section id="achievement" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal">
        <h2 class="text-2xl font-bold text-ink">{about.globalActivityHeading}</h2>
        <p class="mt-3 text-base text-ink/55">{about.globalActivityDesc}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {achievements.map((a) => (
          <span translate="no" class="v-reveal rounded-full border border-ink/10 bg-ink/[0.04] px-4 py-2 text-sm text-ink/70">{a.data.name}</span>
        ))}
      </div>
    </div>
  </section>

  <CertificateGallery
    heading={about.certHeading}
    subheading={about.certSub}
    prevLabel={about.certPrev}
    nextLabel={about.certNext}
  />

  <section id="collaboration" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal"><h2 class="text-2xl font-bold text-ink">{about.collaborationHeading}</h2></div>
    <div class="v-reveal mt-8 space-y-4">
      {[0, 1].map((row) => {
        // 협력사를 두 줄로 나눠 각 줄이 반대 방향으로 흐르게 한다.
        const half = Math.ceil(partners.length / 2);
        const rowItems = row === 0 ? partners.slice(0, half) : partners.slice(half);
        return (
          <div class="marquee group" data-dir={row === 0 ? 'left' : 'right'}>
            <div class="marquee-track">
              {/* 끊김 없는 무한 루프: 같은 세트를 2번 렌더하고 정확히 한 세트 너비만큼 이동.
                  간격은 트랙 gap이 아니라 각 박스의 mr-3 로 줘야 -50% 지점이 세트 경계와 정확히 일치한다.
                  두 번째 세트는 시각용 복제라 aria-hidden 처리(스크린리더 중복 방지). */}
              {[0, 1].map((copy) => (
                <div class="flex" aria-hidden={copy === 1 ? 'true' : undefined} data-dup={copy === 1 ? '1' : undefined}>
                  {rowItems.map((p) => {
                    const logo = p.data.logo ? partnerLogos[p.data.logo]?.default : undefined;
                    return logo ? (
                      <div class="mr-3 flex h-16 w-44 shrink-0 items-center justify-center rounded-lg border border-ink/10 bg-plate px-3">
                        <Image src={logo} alt={p.data.name} loading="eager" class="max-h-12 max-w-[85%] w-auto object-contain" />
                      </div>
                    ) : (
                      <div class={`mr-3 flex h-16 w-44 shrink-0 items-center justify-center rounded-lg border px-3 text-center text-sm font-medium leading-tight ${p.data.needsCheck ? 'border-danger/40 bg-danger/[0.05] text-danger' : 'border-ink/10 bg-ink/[0.03] text-ink/60'}`}>{p.data.name}</div>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <div class="v-reveal">
        <h2 class="text-3xl font-bold text-ink md:text-4xl" set:html={about.ctaHeadingHtml}></h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-ink/60" set:html={about.ctaBodyHtml}></p>
        <a href={lhref('/contact')} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">{about.ctaButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 협력사 로고 무한 회전(마퀴):
     같은 세트를 2번 렌더하고 -50%(=정확히 한 세트 너비) 이동해 끊김 없이 반복.
     ⚠️ 간격을 track 의 gap 으로 주면 세트 경계에 반 칸 오차가 생겨 루프마다 튄다 —
        간격은 각 박스의 margin(mr-3)으로. 박스 크기(h-16 w-44)를 통일해 한 세트 너비를
        컨테이너보다 넓게 고정 → 회전 중 빈 구간도 생기지 않는다. */
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track { display: flex; width: max-content; animation: marquee-left 48s linear infinite; }
  .marquee[data-dir="right"] .marquee-track { animation-name: marquee-right; }
  @keyframes marquee-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; width: auto; }
    .marquee-track > [data-dup] { display: none; }   /* 복제 세트 숨김(중복 방지) */
    .marquee-track > div { flex-wrap: wrap; row-gap: 0.75rem; }
    .marquee { -webkit-mask-image: none; mask-image: none; }
  }
</style>
