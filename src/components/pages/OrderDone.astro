---
// 주문 완료. 결제 연동 전에는 "접수 완료 + 결제 안내 예정"을 보여준다.
// 토스 연동 후에는 결제 성공 시에만 이 페이지로 오게 된다.
// ⚠️ prerender=false 는 이 컴포넌트가 아니라 '페이지 파일'(src/pages/...)에 있어야 한다.
//    컴포넌트에 써두면 Astro가 읽지 않아 정적 생성되고, 쿼리스트링(?id=, ?quote=)을 못 읽는다.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import company from '../../data/company.json';
import { db } from '../../lib/db';
import { paypalCfg } from '../../lib/paypal';

const locale = (Astro.currentLocale ?? 'en') as 'ko' | 'en';
const isKo = locale === 'ko';
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

const orderId = Astro.url.searchParams.get('id') ?? '';
let order: { id: string; amount: number; currency?: string; status: string; buyer_email: string; tax_invoice: number; paid_at?: string | null; amount_usd?: number | null; paid_usd?: number | null; pay_method?: string | null } | null = null;
// 주문 항목 — 무엇을 얼마에 주문했는지(다이싱 포함) 완료 화면에서 바로 확인할 수 있어야 한다.
type DoneItem = { sku: string; name: string; qty: number; subtotal: number; dicing: number; dicing_fee: number };
let items: DoneItem[] = [];

if (/^ORD-\d{8}-[A-Z0-9]{4}$/.test(orderId)) {
  const d = await db();
  if (d) {
    order = await d
      .prepare(`SELECT id, amount, currency, status, buyer_email, tax_invoice, paid_at, amount_usd, paid_usd, pay_method FROM orders WHERE id = ?`)
      .bind(orderId)
      .first();
    if (order) {
      // dicing·dicing_fee 는 옛 주문에 값이 없다 → DEFAULT 0 으로 '다이싱 아니오'가 된다.
      const r = await d
        .prepare(`SELECT sku, name, qty, subtotal, dicing, dicing_fee FROM order_items WHERE order_id = ?`)
        .bind(orderId)
        .all<DoneItem>();
      items = r.results ?? [];
    }
  }
}

const pp = paypalCfg();
const paypalOn = pp.enabled;
const ppClient = pp.clientId;
// 계좌이체 주문은 결제 단계가 없다 — 주문서에서 넘긴 표식으로 구분한다.
// 저장된 결제수단이 진실이다. URL 표식은 DB 값이 없을 때의 보조 수단으로만 쓴다.
const isBank = order
  ? String(order.pay_method ?? '') === 'bank'
  : Astro.url.searchParams.get('pay') === 'bank';

const usdRate = company.usdRate || 1380;
// 표시 금액 우선순위: 실제 청구액(paid_usd) → 주문 시점 확정액(amount_usd) → 환산 폴백.
// 이 순서를 지켜야 "화면에 보인 금액 ≠ 실제 청구액" 이 생기지 않는다.
const usdValue = order
  ? Number(order.paid_usd) > 0
    ? Number(order.paid_usd)
    : Number(order.amount_usd) > 0
      ? Number(order.amount_usd)
      : order.currency === 'USD'
        ? order.amount
        : order.amount / usdRate
  : 0;

// 항목별 USD 표기 — 위 usdValue 와 같은 기준(주문 시점 확정 환율 우선)을 쓴다.
const lineRate = order && Number(order.amount_usd) > 0 && order.amount > 0
  ? order.amount / Number(order.amount_usd)
  : usdRate;
const usdOf = (krw: number) =>
  '$' + (krw / lineRate).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const wonOf = (krw: number) => '₩' + (Number(krw) || 0).toLocaleString('ko-KR');

const t = isKo
  ? {
      meta: '주문 접수 완료 | 반암(VanaM)',
      heading: '주문이 접수되었습니다',
      notFound: '주문을 찾을 수 없습니다.',
      orderNo: '주문번호',
      amount: '결제 예정 금액',
      pendingTitle: '결제 안내를 보내드립니다',
      pendingBody: '현재 결제 시스템을 연동하는 중입니다. 담당자가 확인 후 입력하신 이메일로 결제 링크와 세부 내용을 안내드립니다.',
      taxNote: '세금계산서는 결제 확인 후 입력하신 이메일로 발행됩니다.',
      payTitle: 'PayPal로 바로 결제 (해외 고객 · USD)',
      payNote: '해외 고객 전용 USD 결제입니다 — 국내 결제(세금계산서·계좌이체)는 별도 안내드립니다.',
      paidDone: '✅ 결제가 완료되었습니다. 담당자가 확인 후 진행 상황을 이메일로 안내드립니다.',
      paidShort: '결제가 완료되었습니다',
      bankTitle: '계좌이체 안내',
      bankBody: '주문이 접수되었습니다. 담당자가 확인 후 이메일로 입금 계좌를 안내드립니다. 입금이 확인되면 제작이 시작됩니다.',
      mApproved: '결제 승인이 완료되었습니다. 확정 처리 중이니 다시 결제하지 마시고, 이 주문번호로 잠시 후 주문 조회에서 상태를 확인해 주세요.',
      rate: '환율',
      contact: '문의',
      home: '홈으로',
      shop: '제품으로',
      keep: '이 주문번호를 저장해 두세요. 나중에 주문번호와 이메일로 진행 상태를 다시 확인하실 수 있습니다.',
      lookup: '주문 조회',
      copy: '복사',
      copied: '복사됨',
      amountLabel: '결제 금액',
      items: '주문 내역',
      dicing: '다이싱', dicingYes: '필요', dicingNo: '불필요', boxUnit: '박스',
      mCreate: '결제 생성에 실패했습니다.',
      mHeld: '결제는 접수되었으나 자동 확인에 실패했습니다. 중복 결제를 피해 다시 시도하지 마시고 hello@vanam.co.kr 로 문의해 주세요.',
      mError: '결제 처리 중 오류가 발생했습니다.',
      mDeclined: '카드 결제가 거절되었습니다. 다른 결제 수단으로 다시 시도해 주세요.',
      mSdk: '결제 모듈을 불러오지 못했습니다.',
      mPaid: '이미 결제가 완료된 주문입니다. 화면을 새로고침합니다.',
    }
  : {
      meta: 'Order received | VanaM',
      heading: 'Your order has been received',
      notFound: 'Order not found.',
      orderNo: 'Order no.',
      amount: 'Amount due',
      pendingTitle: 'We will send payment details',
      pendingBody: 'Our payment gateway is being set up. A member of our team will review your order and email you a payment link with the details.',
      taxNote: 'The tax invoice will be issued to the email you provided once payment is confirmed.',
      payTitle: 'Pay now with PayPal (International · USD)',
      payNote: 'USD payment for international customers. For domestic payment (tax invoice / bank transfer), we will contact you separately.',
      paidDone: '✅ Payment completed. We will follow up by email with the next steps.',
      paidShort: 'Payment completed',
      bankTitle: 'Bank transfer',
      bankBody: 'Your order has been received. We will email you the bank details shortly. Production starts once payment is confirmed.',
      mApproved: 'Your payment was approved and is being finalized. Please do not pay again — check your order status shortly using this order number.',
      rate: 'rate',
      contact: 'Contact',
      home: 'Home',
      shop: 'Products',
      keep: 'Please keep this order number. You can check the status again later with your order number and email.',
      lookup: 'Track order',
      copy: 'Copy',
      copied: 'Copied',
      amountLabel: 'Amount',
      items: 'Items',
      dicing: 'Dicing', dicingYes: 'Required', dicingNo: 'Not required', boxUnit: 'box',
      mCreate: 'Could not start payment.',
      mHeld: 'Payment received but needs manual verification — please do not retry; contact hello@vanam.co.kr.',
      mError: 'Payment error.',
      mDeclined: 'The card was declined. Please try another payment method.',
      mSdk: 'Failed to load payment module.',
      mPaid: 'This order has already been paid. Refreshing…',
    };
---

<BaseLayout title={t.meta} description={t.pendingBody}>
  <section class="v-wrap py-32 text-center">
    {order ? (
      <>
        <div class="mx-auto flex size-16 items-center justify-center rounded-full border border-accent/30 bg-accent/10">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke='var(--color-accent)' stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h1 class="mt-8 text-3xl font-bold text-ink md:text-4xl">{t.heading}</h1>

        <div class="mt-10 rounded-xl border border-ink/10 bg-ink/[0.02] p-8 text-left">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-sm text-ink/45">{t.orderNo}</p>
              <div class="mt-1 flex items-center gap-3">
                <p id="ord-id" class="font-mono text-lg font-semibold text-ink">{order.id}</p>
                <button type="button" id="copy-btn" data-copy={t.copy} data-copied={t.copied}
                  class="rounded border border-ink/15 px-2 py-0.5 text-xs text-ink/50 transition hover:border-ink/40 hover:text-ink">{t.copy}</button>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm text-ink/45">{t.amount}</p>
              <p class="mt-1 text-2xl font-bold text-ink">${usdValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} <span class="text-sm font-normal text-ink/40">USD</span></p>
            </div>
          </div>

          {items.length > 0 && (
            <div class="mt-8 border-t border-ink/10 pt-6">
              <p class="text-xs font-medium uppercase tracking-widest text-accent">{t.items}</p>
              <ul class="mt-4 space-y-3 text-sm">
                {items.map((i) => (
                  <li class="flex justify-between gap-4">
                    <span class="text-ink/70">
                      {i.name} <span class="text-ink/35">× {i.qty}</span>
                      {/* 다이싱 표기는 웨이퍼 줄에만 붙인다 — 옵션이 없는 상품의 '불필요'는 잡음이다.
                          옛 주문은 dicing 값이 없어(0) 자동으로 '불필요'가 된다. */}
                      {String(i.sku ?? '').startsWith('wafer:') && (
                        <span class={`mt-0.5 block text-xs ${i.dicing === 1 ? 'text-accent' : 'text-ink/35'}`}>
                          {/* 다이싱 비용은 원화 확정 금액으로 적는다 — 박스당 단가라 환산하면
                              "얼마짜리 옵션을 골랐는지"가 흐려진다(합계는 위 금액에 이미 포함돼 있다). */}
                          {i.dicing === 1
                            ? `${t.dicing}: ${t.dicingYes} (+${wonOf(i.dicing_fee)}/${t.boxUnit} × ${i.qty})`
                            : `${t.dicing}: ${t.dicingNo}`}
                        </span>
                      )}
                    </span>
                    <span class="shrink-0 text-ink/80">{usdOf(Number(i.subtotal) || 0)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {isBank && !order.paid_at ? (
            <div class="mt-8 rounded-lg border border-info/25 bg-info/10 p-4 text-sm leading-relaxed text-ink/70">
              <p class="font-semibold text-ink/80">{t.bankTitle}</p>
              <p class="mt-1">{t.bankBody}</p>
            </div>
          ) : order.paid_at ? (
            <p class="mt-8 rounded-lg border border-ok/25 bg-ok/10 p-4 text-center text-sm font-semibold text-ok">{t.paidDone}</p>
          ) : paypalOn && order.status === 'pending' ? (
            <div class="mt-8 rounded-lg border border-accent/25 bg-accent/[0.05] p-5">
              <p class="text-sm font-semibold text-ink/80">{t.payTitle}</p>
              <p class="mt-1 text-sm text-ink/55">{t.amountLabel}: ${usdValue.toFixed(2)} USD</p>
              <div id="pp-done-btn" class="mt-4" data-ref={order.id} data-client={ppClient}
                data-m-create={t.mCreate} data-m-held={t.mHeld} data-m-error={t.mError} data-m-sdk={t.mSdk} data-m-paid={t.mPaid} data-m-ok={t.paidShort} data-m-approved={t.mApproved} data-m-declined={t.mDeclined}></div>
              <p class="mt-3 text-[11px] leading-relaxed text-ink/45">{t.payNote}</p>
              <p id="pp-done-err" class="mt-2 hidden text-sm font-semibold text-danger"></p>
            </div>
          ) : (
            <div class="mt-8 rounded-lg border border-warn/25 bg-warn/[0.06] p-5">
              <p class="text-sm font-semibold text-warn">{t.pendingTitle}</p>
              <p class="mt-2 text-sm leading-relaxed text-warn/70">{t.pendingBody}</p>
            </div>
          )}

          {order.tax_invoice === 1 && (
            <p class="mt-5 text-sm leading-relaxed text-ink/50">{t.taxNote}</p>
          )}

          <p class="mt-6 border-t border-ink/10 pt-6 text-sm leading-relaxed text-ink/50">{t.keep}</p>

          <p class="mt-4 text-sm text-ink/45">{company.email} · {company.tel}</p>
        </div>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href={lhref('/product')} class="v-btn-ghost-sm">{t.shop}</a>
          <a href={`${lhref('/order/lookup')}?id=${order.id}`} class="v-btn-ghost-sm">{t.lookup}</a>
          <a href={lhref('/contact')} class="v-btn-sm">{t.contact}</a>
        </div>

        <script is:inline>
          const cb = document.getElementById('copy-btn');
          cb?.addEventListener('click', async () => {
            await navigator.clipboard.writeText(document.getElementById('ord-id').textContent.trim());
            cb.textContent = cb.dataset.copied;
            setTimeout(() => { cb.textContent = cb.dataset.copy; }, 1600);
          });
        </script>

        <script is:inline>
          // PayPal 즉시 결제 (주문 접수 직후)
          (function () {
            var host = document.getElementById('pp-done-btn');
            if (!host) return;
            var perr = document.getElementById('pp-done-err');
            var showErr = function (m) { if (perr) { perr.textContent = m; perr.classList.remove('hidden'); } };
            // 재결제 시 이중 청구가 날 수 있는 상태에서는 결제 수단 자체를 닫는다.
            var disablePay = function () { host.style.pointerEvents = 'none'; host.style.opacity = '0.45'; };
            // 구체적인 안내를 이미 표시했는데 SDK 의 onError 가 'Payment error.' 로 덮어쓰면
            // 사용자는 다시 결제를 시도하게 된다. 그 덮어쓰기를 막는 플래그.
            var handled = false;
            var showSpecific = function (m) { handled = true; showErr(m); };
            var s = document.createElement('script');
            s.src = 'https://www.paypal.com/sdk/js?client-id=' + encodeURIComponent(host.dataset.client) + '&currency=USD&intent=capture';
            s.onload = function () {
              window.paypal.Buttons({
                style: { layout: 'horizontal', height: 40, tagline: false },
                createOrder: function () {
                  handled = false;
                  return fetch('/api/paypal/create-order', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ref: host.dataset.ref }),
                  }).then(function (r) { return r.json(); }).catch(function () {
                    showSpecific(host.dataset.mCreate);     // 조용한 실패 금지
                    throw new Error('create_failed');
                  }).then(function (j) {
                    if (!j.ok) {
                      // 창을 닫았다 복원한 뒤 다시 누르는 경우 — 이미 결제된 주문이면 재결제가 아니라 새로고침이 맞다
                      if (j.error === 'already_paid') {
                        // 자동 새로고침 금지 — 화면의 주문번호를 아직 적어두지 못한 사용자가 있을 수 있다.
                        showSpecific(host.dataset.mPaid);
                        disablePay();
                        throw new Error('already_paid');
                      }
                      showSpecific(host.dataset.mCreate);
                      throw new Error(j.error || 'create_failed');
                    }
                    return j.id;
                  });
                },
                onApprove: function (data) {
                  return fetch('/api/paypal/capture', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: data.orderID }),
                  }).then(function (r) { return r.json(); }).then(function (j) {
                    if (!j.ok) {
                      // verify_failed/not_found = PayPal 결제는 성사됐으나 서버 대조에 실패한 상태.
                      // 여기서 '실패'로만 안내하면 고객이 재결제해 이중 청구가 난다.
                      var held = j.error === 'verify_failed' || j.error === 'not_found';
                      showSpecific(held ? host.dataset.mHeld : (j.restart ? host.dataset.mDeclined || host.dataset.mError : host.dataset.mError));
                      if (held) disablePay();
                      throw new Error(j.error || 'capture_failed');
                    }
                    var box = host.closest('div.mt-8');
                    if (box) box.outerHTML = '<p class="mt-8 rounded-lg border border-ok/25 bg-ok/10 p-4 text-center text-sm font-semibold text-ok">✅ ' + host.dataset.mOk + ' — $' + Number(j.paidUsd).toFixed(2) + '</p>';
                  }).catch(function (err) {
                    // 여기 도달했다면 PayPal 승인은 이미 끝난 상태다.
                    // 통신 끊김 등으로 확정 요청이 실패해도 '오류' 로만 안내하면 고객이 재결제해 이중 청구가 난다.
                    // 웹훅이 곧 확정하므로 결제 수단을 닫고 상태 확인을 안내한다.
                    var m = String((err && err.message) || '');
                    if (m !== 'capture_failed' && m !== 'already_paid') {
                      showSpecific(host.dataset.mApproved);
                      disablePay();
                    }
                    throw err;
                  });
                },
                onError: function (e) { console.error(e); if (!handled) showErr(host.dataset.mError); },
              }).render(host);
            };
            s.onerror = function () { showErr(host.dataset.mSdk); };
            document.head.appendChild(s);
          })();
        </script>
      </>
    ) : (
      <>
        <h1 class="text-2xl font-bold text-ink">{t.notFound}</h1>
        <a href={lhref('/')} class="mt-6 inline-block text-sm text-accent hover:underline">{t.home} →</a>
      </>
    )}
  </section>
</BaseLayout>
