---
// 주문 완료. 결제 연동 전에는 "접수 완료 + 결제 안내 예정"을 보여준다.
// 토스 연동 후에는 결제 성공 시에만 이 페이지로 오게 된다.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import company from '../../data/company.json';
import { db } from '../../lib/db';

const locale = (Astro.currentLocale ?? 'en') as 'ko' | 'en';
const isKo = locale === 'ko';
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

const orderId = Astro.url.searchParams.get('id') ?? '';
let order: { id: string; amount: number; status: string; buyer_email: string; tax_invoice: number } | null = null;

if (/^ORD-\d{8}-[A-Z0-9]{4}$/.test(orderId)) {
  const d = await db();
  if (d) {
    order = await d
      .prepare(`SELECT id, amount, status, buyer_email, tax_invoice FROM orders WHERE id = ?`)
      .bind(orderId)
      .first();
  }
}

const t = isKo
  ? {
      meta: '주문 접수 완료 | VANAM',
      heading: '주문이 접수되었습니다',
      notFound: '주문을 찾을 수 없습니다.',
      orderNo: '주문번호',
      amount: '결제 예정 금액',
      pendingTitle: '결제 안내를 보내드립니다',
      pendingBody: '현재 결제 시스템을 연동하는 중입니다. 담당자가 확인 후 입력하신 이메일로 결제 링크와 세부 내용을 안내드립니다.',
      taxNote: '세금계산서는 결제 확인 후 입력하신 이메일로 발행됩니다.',
      contact: '문의',
      home: '홈으로',
      shop: '스토어로',
    }
  : {
      meta: 'Order received | VANAM',
      heading: 'Your order has been received',
      notFound: 'Order not found.',
      orderNo: 'Order no.',
      amount: 'Amount due',
      pendingTitle: 'We will send payment details',
      pendingBody: 'Our payment gateway is being set up. A member of our team will review your order and email you a payment link with the details.',
      taxNote: 'The tax invoice will be issued to the email you provided once payment is confirmed.',
      contact: 'Contact',
      home: 'Home',
      shop: 'Store',
    };
---

<BaseLayout title={t.meta} description={t.pendingBody}>
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    {order ? (
      <>
        <div class="mx-auto flex size-16 items-center justify-center rounded-full border border-[#1EBBF0]/30 bg-[#1EBBF0]/10">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1EBBF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h1 class="mt-8 text-3xl font-bold text-white md:text-4xl">{t.heading}</h1>

        <div class="mt-10 rounded-xl border border-white/10 bg-white/[0.02] p-8 text-left">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-sm text-white/45">{t.orderNo}</p>
              <p class="mt-1 font-mono text-lg font-semibold text-white">{order.id}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-white/45">{t.amount}</p>
              <p class="mt-1 text-2xl font-bold text-white">₩{order.amount.toLocaleString('ko-KR')}</p>
            </div>
          </div>

          <div class="mt-8 rounded-lg border border-amber-400/25 bg-amber-400/[0.06] p-5">
            <p class="text-sm font-semibold text-amber-100">{t.pendingTitle}</p>
            <p class="mt-2 text-sm leading-relaxed text-amber-200/70">{t.pendingBody}</p>
          </div>

          {order.tax_invoice === 1 && (
            <p class="mt-5 text-sm leading-relaxed text-white/50">{t.taxNote}</p>
          )}

          <p class="mt-6 border-t border-white/10 pt-6 text-sm text-white/45">
            {company.email} · {company.tel}
          </p>
        </div>

        <div class="mt-10 flex justify-center gap-4">
          <a href={lhref('/shop')} class="rounded-lg border border-white/15 px-6 py-3 text-sm text-white/70 transition hover:border-white/40 hover:text-white">{t.shop}</a>
          <a href={lhref('/contact')} class="rounded-lg bg-[#1EBBF0] px-6 py-3 text-sm font-semibold text-[#06222C] transition hover:brightness-110">{t.contact}</a>
        </div>
      </>
    ) : (
      <>
        <h1 class="text-2xl font-bold text-white">{t.notFound}</h1>
        <a href={lhref('/')} class="mt-6 inline-block text-sm text-[#1EBBF0] hover:underline">{t.home} →</a>
      </>
    )}
  </section>
</BaseLayout>
