---
// 비회원 주문 조회. 주문번호 + 이메일로 상태를 확인한다.
// ⚠️ prerender=false 는 페이지 파일(src/pages/order/lookup.astro)에 있다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import company from '../../data/company.json';

import { getCollection } from 'astro:content';
import { SUBSTRATE_SIZES, DELIVERY_METHODS } from '../../lib/processes';
import siteData from '../../data/site.json';

const locale = (Astro.currentLocale ?? 'en') as 'ko' | 'en';
const isKo = locale === 'ko';
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);
// 예상·확정 견적 상자 문구 — 완료 화면과 같은 문구(site.json quote.view)
const QV = ((siteData as Record<string, any>)[locale] ?? siteData.en).quote.view;

// 주문 완료 화면에서 넘어오면 주문번호가 채워져 있다
const prefill = Astro.url.searchParams.get('id') ?? '';
// 견적 요청(INQ-)으로 들어오면(접수 확인 메일·견적 완료 화면의 [진행 상태 조회]) 제목을 견적 요청에 맞춘다
// — 같은 화면이 주문(ORD-)도 조회하므로 주문으로 들어온 경우의 제목은 그대로 둔다.
const inqEntry = /^INQ-/i.test(prefill.trim());

// 견적 접수 시 저장되는 product_name 은 **접수 당시 페이지 언어**로 굳는다.
// 한글로 넣은 견적을 영문 화면에서 조회하면 상품명만 한글로 남는 문제가 있었다.
// 상품 id(product_sku)도 함께 저장하므로, 표시할 때는 **보고 있는 언어**의 카탈로그 이름으로 다시 그린다.
// (카탈로그에 없는 옛 항목은 저장된 이름을 그대로 쓴다)
// 견적 폼의 코드값(4inch·direct …) → 이 페이지 언어의 라벨.
// 폼과 같은 원본(lib/processes)을 쓰므로 선택지가 늘어도 따로 손댈 곳이 없다.
const sizeMap = Object.fromEntries(SUBSTRATE_SIZES.map((x) => [x.value, isKo ? x.ko : x.en]));
const deliveryMap = Object.fromEntries(DELIVERY_METHODS.map((x) => [x.value, isKo ? x.ko : x.en]));

const productNames: Record<string, string> = Object.fromEntries([
  ...(await getCollection('products')).map((p) => [
    p.id,
    isKo ? p.data.name : (p.data.name_en ?? p.data.name),
  ]),
  // 웨이퍼 문의(0829)도 product_sku 로 저장되므로 같은 지도에 넣어 언어를 맞춘다.
  ...(await getCollection('wafers')).map((w) => [
    w.id,
    isKo ? w.data.name : ((w.data as Record<string, unknown>).name_en as string ?? w.data.name),
  ]),
]);

const t = isKo
  ? {
      meta: '주문 조회 | VanaM', metaDesc: '주문번호와 이메일로 주문 상태를 확인하세요.',
      eyebrow: '주문 조회', heading: '주문 확인',
      metaInq: '견적 요청 조회 | VanaM', eyebrowInq: '견적 요청 조회', headingInq: '진행 상태 확인',
      metaDescInq: '접수번호와 이메일로 견적 요청의 진행 상태를 확인하세요.',
      lead: '주문번호(ORD-…) 또는 견적·주문 요청 접수번호(INQ-…)와 입력하신 이메일을 넣으시면 진행 상태를 확인하실 수 있습니다.',
      idLabel: '주문/접수번호', email: '이메일',
      submit: '조회하기', loading: '조회 중…',
      notFound: '주문번호와 이메일이 일치하지 않습니다. 다시 확인해 주세요.',
      notFoundInq: '접수번호와 이메일이 일치하지 않습니다. 다시 확인해 주세요.',
      fail: '조회에 실패했습니다. 잠시 후 다시 시도해 주세요.',
      status: '진행 상태', amount: '결제 금액', ordered: '주문일',
      items: '주문 내역', shipTo: '배송지', taxYes: '세금계산서 요청됨',
      dicing: '다이싱', dicingYes: '필요', dicingNo: '불필요', boxUnit: '박스',
      orderNo: '주문번호', vat: '(부가세 포함)',
      ordSheetBtn: '주문서 인쇄 · PDF 저장',
      noShip: '실물 배송 없음 (결과는 이메일로 안내)',
      help: '주문번호를 잊으셨나요? 아래로 연락 주시면 확인해 드립니다.',
      inq: {
        title: '견적·주문 요청', received: '접수일', product: '요청 상품',
        method: '공정', substrate: '기판', reqBody: '요청 내용 보기',
        dSeq: '[공정 시퀀스]', dAnalysis: '[분석]', dDelivery: '기판 전달',
        dSamples: '총 샘플 수량', dDue: '완료 희망일', dNotes: '주의사항',
        dShip: '[배송 주소]', dCountry: '국가', dSecSub: '[기판 정보]', dRecip: '수령인', dAddr: '주소', dPostal: '우편번호', dShipMemo: '배송 요청',
        dPreFilm: '박막 증착 여부', dPreFilmNone: '없음', dPreFilmYes: '있음',
        amount: '견적 금액', vat: '(부가세 포함)',
        wQty: '수량', wQtyOne: '{n}박스', wQtyMany: '{n}박스',
        wDicing: '다이싱', wYes: '필요', wNo: '불필요', wPerBox: '/박스',
        sheetBtn: '견적서 인쇄 · PDF 저장',
        reqSheetBtn: '요청서 인쇄 · PDF 저장',
        sheetBank: '입금 계좌',
        pending: '산정 중입니다 — 견적이 확정되면 이메일로 안내드립니다.',
        st: { new: '접수됨 (검토 대기)', quoted: '견적 완료', replied: '회신 완료', paid: '결제 완료', closed: '종료' },
      } as Record<string, unknown>,
      st: {
        pending: '결제 대기', paid: '결제 완료', preparing: '제작 중',
        shipped: '발송 완료', done: '완료', cancelled: '취소됨', refunded: '환불됨',
      } as Record<string, string>,
      mCreate: '결제 생성에 실패했습니다.',
      mHeld: '결제는 접수되었으나 자동 확인에 실패했습니다. 중복 결제를 피해 다시 시도하지 마시고 hello@vanam.co.kr 로 문의해 주세요.',
      mDeclined: '카드가 거절되었습니다 — 다른 수단으로 시도해 주세요.',
      mCapture: '결제 확정에 실패했습니다.',
      mError: '결제 처리 중 오류가 발생했습니다.',
      mPaid: '이미 결제가 완료된 주문입니다. 위 주문 상태를 확인해 주세요.',
      mApproved: '결제 승인이 완료되었습니다. 확정 처리 중이니 다시 결제하지 마시고, 이 주문번호로 잠시 후 다시 조회해 주세요.',
      mSetup: '결제 준비 중입니다.',
      payTitle: 'PayPal 결제',
      payNote: '해외 고객 전용 USD 결제입니다 — 국내 결제(세금계산서·계좌이체)는 별도 문의해 주세요.',
      paidDone: '결제가 완료되었습니다',
      paidAt: '결제 완료',
      tracking: '배송 정보',
      trackingCourier: '택배사',
      trackingNo: '송장번호',
    }
  : {
      meta: 'Track your order | VanaM', metaDesc: 'Check your order status with your order number and email.',
      eyebrow: 'Order lookup', heading: 'Track your order',
      metaInq: 'Quote request lookup | VanaM', eyebrowInq: 'Quote request lookup', headingInq: 'Check status',
      metaDescInq: 'Check the status of your quote request with its number and your email.',
      lead: 'Enter your order number (ORD-…) or request number (INQ-…) with the email you used, to check the status.',
      idLabel: 'Order / request number', email: 'Email',
      submit: 'Look up', loading: 'Searching…',
      notFound: 'The order number and email do not match. Please check and try again.',
      notFoundInq: 'The request number and email do not match. Please check and try again.',
      fail: 'Lookup failed. Please try again shortly.',
      status: 'Status', amount: 'Amount', ordered: 'Ordered',
      items: 'Items', shipTo: 'Ship to', taxYes: 'Tax invoice requested',
      dicing: 'Dicing', dicingYes: 'Required', dicingNo: 'Not required', boxUnit: 'box',
      orderNo: 'Order no.', vat: '(VAT included)',
      ordSheetBtn: 'Print order sheet (PDF)',
      noShip: 'No physical delivery (results sent by email)',
      help: 'Lost your order number? Contact us and we will look it up for you.',
      inq: {
        title: 'Quote / order request', received: 'Received', product: 'Requested item',
        method: 'Process', substrate: 'Substrate', reqBody: 'View request details',
        dSeq: '[Process sequence]', dAnalysis: '[Analysis]', dDelivery: 'Substrate delivery',
        dSamples: 'Total samples', dDue: 'Target completion', dNotes: 'Notes',
        dShip: '[Shipping address]', dCountry: 'Country', dSecSub: '[Substrate info]', dRecip: 'Recipient', dAddr: 'Address', dPostal: 'Postal code', dShipMemo: 'Delivery notes',
        dPreFilm: 'Existing thin film on sample', dPreFilmNone: 'No', dPreFilmYes: 'Yes',
        amount: 'Quoted amount', vat: '(VAT included)',
        wQty: 'Quantity', wQtyOne: '{n} box', wQtyMany: '{n} boxes',
        wDicing: 'Dicing', wYes: 'Required', wNo: 'Not required', wPerBox: '/box',
        sheetBtn: 'Print quotation (PDF)',
        reqSheetBtn: 'Print request (PDF)',
        sheetBank: 'Bank account',
        pending: 'Being prepared — we will email you once the quote is ready.',
        st: { new: 'Received (in review)', quoted: 'Quote ready', replied: 'Replied', closed: 'Closed', paid: 'Paid' },
      } as Record<string, unknown>,
      st: {
        pending: 'Awaiting payment', paid: 'Paid', preparing: 'In production',
        shipped: 'Shipped', done: 'Completed', cancelled: 'Cancelled', refunded: 'Refunded',
      } as Record<string, string>,
      mCreate: 'Could not start payment.',
      mHeld: 'Payment received but needs manual verification — please do not retry; contact hello@vanam.co.kr.',
      mDeclined: 'Card declined — please try another method.',
      mCapture: 'Capture failed.',
      mError: 'Payment error.',
      mPaid: 'This order has already been paid. Please check the order status above.',
      mApproved: 'Your payment was approved and is being finalized. Please do not pay again — check the status again shortly using this order number.',
      mSetup: 'Payment is being set up.',
      payTitle: 'Pay with PayPal',
      payNote: 'USD payment for international customers. For domestic payment (tax invoice / bank transfer), please contact us.',
      paidDone: 'Payment completed',
      paidAt: 'Paid',
      tracking: 'Shipment',
      trackingCourier: 'Carrier',
      trackingNo: 'Tracking no.',
    };

const inputClass =
  'v-input';
---

<BaseLayout title={inqEntry ? t.metaInq : t.meta} description={inqEntry ? t.metaDescInq : t.metaDesc}>
  <section class="v-wrap py-28 md:py-32">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{inqEntry ? t.eyebrowInq : t.eyebrow}</p>
    <h1 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">{inqEntry ? t.headingInq : t.heading}</h1>
    <p class="mt-5 text-base leading-relaxed text-ink/55">{t.lead}</p>

    <form id="lookup-form" class="mt-10 space-y-6"
      data-msg-notfound={t.notFound}
      data-msg-notfound-inq={t.notFoundInq}
      data-msg-fail={t.fail}
      data-label-send={t.submit}
      data-label-loading={t.loading}
      data-labels={JSON.stringify(t.st)}
      data-inq={JSON.stringify(t.inq)}
      data-qv={JSON.stringify(QV)}
      data-product-names={JSON.stringify(productNames)}
      data-map-size={JSON.stringify(sizeMap)}
      data-map-delivery={JSON.stringify(deliveryMap)}
      data-pay={JSON.stringify({ tracking: t.tracking, trackingCourier: t.trackingCourier, trackingNo: t.trackingNo, paidDone: t.paidDone, paidAt: t.paidAt, mApproved: t.mApproved, mCreate: t.mCreate, mHeld: t.mHeld, mDeclined: t.mDeclined, mCapture: t.mCapture, mError: t.mError, mPaid: t.mPaid, mSetup: t.mSetup, payTitle: t.payTitle, payNote: t.payNote })}
      data-copy={JSON.stringify({
        status: t.status, amount: t.amount, ordered: t.ordered,
        items: t.items, shipTo: t.shipTo, taxYes: t.taxYes, noShip: t.noShip,
        dicing: t.dicing, dicingYes: t.dicingYes, dicingNo: t.dicingNo, boxUnit: t.boxUnit,
        orderNo: t.orderNo, vat: t.vat,
        ordSheetBtn: t.ordSheetBtn,
      })}>
      <div>
        <label for="lk-id" class="block text-sm font-medium text-ink/80">{t.idLabel} *</label>
        <input id="lk-id" name="id" type="text" required value={prefill}
          placeholder="ORD-… / INQ-…" class={`${inputClass} font-mono`} />
      </div>
      <div>
        <label for="lk-email" class="block text-sm font-medium text-ink/80">{t.email} *</label>
        <input id="lk-email" name="email" type="email" required autocomplete="email" class={inputClass} />
      </div>
      <button type="submit" id="lk-btn"
        class="v-btn-block disabled:opacity-50">
        <span id="lk-label">{t.submit}</span>
      </button>
      <p id="lk-error" class="text-sm text-danger" role="status" aria-live="polite"></p>
    </form>

    <div id="lk-result" class="mt-10" hidden></div>

    <p class="mt-14 border-t border-ink/10 pt-8 text-sm leading-relaxed text-ink/40">
      {t.help}<br />
      <a href={`mailto:${company.email}`} class="text-accent hover:underline">{company.email}</a> · {company.tel}
    </p>
  </section>
</BaseLayout>

<script>
  // 견적 요약 상자·엑셀형 견적서 — 금액은 서버가 준 inquiry.quote 만 쓴다(화면에서 계산하지 않는다)
  import { renderQuoteBox, docOptions, injectQuoteViewStyle } from '../../lib/quote-view-render.js';
  // 고객이 넣은 글 — 이 화면은 링크 하나로 바로 조회되므로, 남이 넣은 글이 vanam.co.kr 화면에서 피싱 문구가 되지 않게
  // 한 줄 항목(상품·공정·기판)은 짧게 + 주소 모양은 링크가 안 되게, 여러 줄 요청 내용은 주소 모양만 바꾼다(확인 메일과 같은 규칙).
  import { safeShort, defang } from '../../lib/safe-text.js';
  // 서류(견적서·요청서·주문서)는 모두 엑셀 「견적서」 틀(src/lib/doc-excel.js)
  import {
    buildQuoteDoc, buildRequestDoc, buildOrderDoc, openDoc,
    quoteFromAmount, requestDocFrom, orderDocFrom, docContact, ymdLocal, specFromDetails,
  } from '../../lib/quote-doc';
  const form = document.getElementById('lookup-form') as HTMLFormElement | null;
  if (form) {
    const M = form.dataset;
    const P = JSON.parse(M.pay || '{}') as Record<string, string>;
    const P2 = P;   // 결과 렌더 템플릿에서도 동일 문자열 사용
    const ST: Record<string, string> = JSON.parse(M.labels ?? '{}');
    const C = JSON.parse(M.copy ?? '{}');
    const INQ = JSON.parse(M.inq ?? '{}');
    const QVT: Record<string, string> = JSON.parse(M.qv ?? '{}');
    const PAGE_LANG: 'ko' | 'en' = document.documentElement.lang === 'ko' ? 'ko' : 'en';
    // 상품 id → 이 페이지 언어의 상품명. 접수 당시 언어로 굳은 이름 대신 이걸 우선 쓴다.
    const PNAMES: Record<string, string> = JSON.parse(M.productNames ?? '{}');
    const SIZE_MAP: Record<string, string> = JSON.parse(M.mapSize ?? '{}');
    const DELIV_MAP: Record<string, string> = JSON.parse(M.mapDelivery ?? '{}');

    // 박스 수량 표기. 영문만 1개일 때 단수(box), 그 외 복수(boxes)로 갈린다 —
    // 한글은 두 문구가 같아 자연히 무시된다.
    const qtyBox = (n: unknown): string => {
      const q = Number(n) || 1;
      return String((q === 1 ? INQ.wQtyOne : INQ.wQtyMany) ?? '{n}').replace('{n}', String(q));
    };

    // 요청 내용을 **보고 있는 언어**로 다시 그린다.
    // 접수 시 함께 저장한 구조화 사본(details_json)에는 라벨이 붙기 전의 값만 들어 있다.
    // 자유 입력(완료 희망일·요청사항)은 고객이 쓴 그대로 — 번역하지 않는다.
    // 구조화 사본이 없는 옛 접수 건은 저장된 문장(details)을 그대로 보여준다.
    const renderDetails = (raw: unknown, fallback: string): string => {
      if (!raw) return fallback;
      let dj: Record<string, any>;
      try { dj = JSON.parse(String(raw)); } catch { return fallback; }
      if (!dj || typeof dj !== 'object') return fallback;

      // 웨이퍼 문의(0829)는 공정 견적과 형태가 완전히 다르다 — 먼저 갈라 처리한다.
      // (아래 공정 견적용 조립을 그대로 태우면 '[기판 정보]' 머리글만 남는다)
      if (dj.wafer) {
        const w = dj.wafer;
        const fee = Number(w.dicingFeeKrw) || 0;
        return [
          `${INQ.product}: ${PNAMES[String(w.sku ?? '')] ?? w.sku ?? ''}`,
          `${INQ.wQty}: ${qtyBox(w.qty)}`,
          `${INQ.wDicing}: ${w.dicing ? `${INQ.wYes} (+₩${fee.toLocaleString('ko-KR')}${INQ.wPerBox} × ${Number(w.qty) || 1})` : INQ.wNo}`,
        ].join('\n');
      }

      const seqLines = (Array.isArray(dj.seq) ? dj.seq : []).map((r: any, i: number) => {
        let line = `${i + 1}. ${r.process ?? ''}`;
        if (r.material) line += ` | ${r.material}`;
        if (r.value) line += ` | ${r.value}${r.unit ?? ''}`;
        if (r.etc) line += ` | ${r.etc}`;
        return line;
      });
      const delivery = DELIV_MAP[String(dj.delivery ?? '')] ?? String(dj.delivery ?? '');
      const out = [
        INQ.dSecSub,
        [dj.substrateType, dj.substrateSize].filter(Boolean).length ? `${INQ.substrate}: ${[dj.substrateType, SIZE_MAP[String(dj.substrateSize ?? '')] ?? dj.substrateSize, dj.substrateGrade].filter(Boolean).join(' / ')}` : '',
        delivery ? `${INQ.dDelivery}: ${delivery}` : '',
        dj.sampleCount ? `${INQ.dSamples}: ${dj.sampleCount}` : '',
        dj.completionDate ? `${INQ.dDue}: ${dj.completionDate}` : '',
        // 박막 증착 여부(0910c). 이 항목이 생기기 전 접수 건에는 아예 없으므로,
        // boolean 이 실제로 들어 있을 때만 줄을 만든다 — 옛 건에 '없음'을 지어내지 않는다.
        typeof dj.preFilm === 'boolean' ? `${INQ.dPreFilm}: ${dj.preFilm ? INQ.dPreFilmYes : INQ.dPreFilmNone}` : '',
        typeof dj.preFilm === 'boolean' && dj.preFilm && dj.preFilmNote ? String(dj.preFilmNote) : '',
        ...(dj.ship ? [
          '\n' + INQ.dShip,
          dj.ship.country ? `${INQ.dCountry}: ${dj.ship.country}` : '',
          `${INQ.dRecip}: ${dj.ship.name ?? ''}${dj.ship.phone ? ' \u00b7 ' + dj.ship.phone : ''}`,
          `${INQ.dAddr}: ${dj.ship.addr ?? ''}`,
          dj.ship.zip ? `${INQ.dPostal}: ${dj.ship.zip}` : '',
          dj.ship.memo ? `${INQ.dShipMemo}: ${dj.ship.memo}` : '',
        ].filter(Boolean) : []),
        seqLines.length ? '\n' + String(INQ.dSeq) : '',
        ...seqLines,
        Array.isArray(dj.measures) && dj.measures.length ? `\n${INQ.dAnalysis} ${dj.measures.join(', ')}` : '',
        dj.notes ? `\n${INQ.dNotes}: ${dj.notes}` : '',
      ].filter((x) => x !== '').join('\n');
      return out || fallback;
    };

    // 기판 표기도 코드값을 이 페이지 언어로 — "Silicon oxide / 2 inch 이하 or 조각 시편" 같은 혼용 방지
    const renderSubstrate = (raw: unknown, fallback: string): string => {
      if (!raw) return fallback;
      try {
        const dj = JSON.parse(String(raw));
        const size = SIZE_MAP[String(dj.substrateSize ?? '')] ?? String(dj.substrateSize ?? '');
        // 등급(Test·Prime)은 코드값이 곧 표기다 — 구매 요청 + Silicon 계열일 때만 들어 있다
        const joined = [dj.substrateType, size, dj.substrateGrade].filter(Boolean).join(' / ');
        return joined || fallback;
      } catch { return fallback; }
    };

    const btn = document.getElementById('lk-btn') as HTMLButtonElement;
    const label = document.getElementById('lk-label')!;
    const errEl = document.getElementById('lk-error')!;
    const resEl = document.getElementById('lk-result')!;

    // 표시는 전부 USD (PayPal 이 KRW 결제를 지원하지 않으므로 원화 병기는 혼선만 준다)
    const usdOf = (v: unknown, cur?: unknown) => {
      const n = Number(v) || 0;
      const u = String(cur ?? 'KRW') === 'USD' ? n : n / (usdRateClient || 1380);
      return `$${u.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    };
    // 견적 금액 환산용 환율 — PayPal config 에서 받아 캐시(없으면 기본값)
    let usdRateClient = 0;
    (async () => {
      try {
        const w = window as unknown as { __ppCfg?: { usdRate?: number } };
        if (!w.__ppCfg) w.__ppCfg = await (await fetch('/api/paypal/config')).json();
        usdRateClient = Number(w.__ppCfg?.usdRate) || 0;
      } catch { /* 실패 시 기본값 사용 */ }
    })();

    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
      );
    const when = (s: string) => {
      const d = new Date(s);
      return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
    };

    // 주문 항목의 다이싱 표기. 웨이퍼 줄에만 붙인다 —
    // 다이싱이 존재하지 않는 상품에 '불필요'를 적으면 정보가 아니라 잡음이 된다.
    // 옛 주문은 dicing 값이 없어(0) 자동으로 '불필요'가 된다.
    const wonOf = (v: unknown) => '₩' + (Number(v) || 0).toLocaleString('ko-KR');

    const dicingNote = (i: any): string => {
      if (!String(i.sku ?? '').startsWith('wafer:')) return '';
      const on = Number(i.dicing) === 1;
      const fee = Number(i.dicing_fee) || 0;
      // 금액 표시는 USD 지만, 다이싱 비용만은 **원화 확정 금액**으로 적는다.
      // 박스당 단가라 환산하면 "얼마짜리 옵션을 골랐는지"가 흐려진다
      // (환산이 필요한 결제 총액은 아래 '결제 금액'에 이미 반영돼 있다).
      const txt = on
        ? `${C.dicing}: ${C.dicingYes} (+${wonOf(fee)}/${C.boxUnit} × ${i.qty})`
        : `${C.dicing}: ${C.dicingNo}`;
      return `<span class="mt-0.5 block text-xs ${on ? 'text-accent' : 'text-ink/35'}">${esc(txt)}</span>`;
    };

    const COLOR: Record<string, string> = {
      pending: 'border-warn/30 bg-warn/10 text-warn',
      paid: 'border-accent/30 bg-accent/10 text-accent',
      preparing: 'border-accent/30 bg-accent/10 text-accent',
      shipped: 'border-ok/30 bg-ok/10 text-ok',
      done: 'border-ok/30 bg-ok/10 text-ok',
      cancelled: 'border-ink/10 bg-ink/5 text-ink/40',
      refunded: 'border-ink/10 bg-ink/5 text-ink/40',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.textContent = '';
      resEl.hidden = true;
      btn.disabled = true;
      label.textContent = M.labelLoading!;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      // 견적 요약의 담당자 확인 문구 언어 — 이 페이지 언어
      data.locale = PAGE_LANG;

      try {
        const res = await fetch('/api/order/lookup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const j = await res.json();

        if (res.status === 404) {
          errEl.textContent = (/^INQ-/i.test(String(data.id ?? '').trim()) ? M.msgNotfoundInq : M.msgNotfound) ?? '';
          return;
        }
        if (!res.ok || !j.ok) throw new Error(j.error ?? res.status);

        // ── PayPal 결제 블록 (INQ: USD 견적 / ORD: pending 주문) — 해외 고객 전용 USD
        const payBlock = (ref: string, amountKrw?: number, cur?: string) => `
          <div class="mt-5 rounded-lg border border-accent/25 bg-accent/[0.05] p-4" data-pp data-ref="${esc(ref)}">
            <p class="text-sm font-semibold text-ink/80">${P.payTitle} <span class="font-normal text-ink/45">(International · USD)</span></p>
            ${amountKrw && cur !== 'USD' ? `<p class="mt-1 text-xs text-ink/50" data-pp-usd data-krw="${amountKrw}"></p>` : ''}
            <div class="mt-3" data-pp-btn></div>
            <p class="mt-2 text-[11px] leading-relaxed text-ink/40">${P.payNote}</p>
            <p class="mt-2 hidden text-sm font-semibold text-danger" data-pp-err></p>
          </div>`;

        const initPP = async (email: string) => {
          const wrap = resEl.querySelector<HTMLElement>('[data-pp]');
          if (!wrap) return;
          const btnEl = wrap.querySelector<HTMLElement>('[data-pp-btn]');
          const perr = wrap.querySelector<HTMLElement>('[data-pp-err]');
          const showErr = (m: string) => { if (perr) { perr.textContent = m; perr.classList.remove('hidden'); } };
          // 재결제 시 이중 청구가 날 수 있는 상태에서는 결제 수단을 닫는다.
          const killPay = () => { if (btnEl) { btnEl.style.pointerEvents = 'none'; btnEl.style.opacity = '0.45'; } };
          let handled = false;                       // 구체 안내를 SDK onError 가 덮어쓰지 못하게
          const showSpecific = (m: string) => { handled = true; showErr(m); };
          try {
            const w = window as unknown as Record<string, any>;
            if (!w.__ppCfg) w.__ppCfg = await (await fetch('/api/paypal/config')).json();
            const cfg = w.__ppCfg;
            const usdEl = wrap.querySelector<HTMLElement>('[data-pp-usd]');
            if (usdEl && cfg.usdRate) {
              const krw = Number(usdEl.dataset.krw || 0);
              usdEl.textContent = `$${(krw / cfg.usdRate).toFixed(2)} USD`;
            }
            if (!cfg.enabled) {
              wrap.innerHTML = `<p class="text-sm text-ink/50">${P.mSetup}</p>`;
              return;
            }
            if (!w.paypal) {
              await new Promise((res2, rej2) => {
                const s = document.createElement('script');
                s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(cfg.clientId)}&currency=USD&intent=capture`;
                s.onload = () => res2(null); s.onerror = rej2;
                document.head.appendChild(s);
              });
            }
            w.paypal.Buttons({
              style: { layout: 'horizontal', height: 40, tagline: false },
              createOrder: async () => {
                const r2 = await fetch('/api/paypal/create-order', {
                  method: 'POST', headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ ref: wrap.dataset.ref, email }),
                });
                const j2 = await r2.json();
                if (!r2.ok || !j2.ok) {
                    // 창을 닫았다 복원한 뒤 재시도한 경우 — 이미 결제됐다면 재결제가 아니라 새로고침이 맞다
                    if (j2.error === 'already_paid') {
                      // 자동 새로고침 금지 — 조회 결과와 주문번호가 화면에서 사라지면 안 된다.
                      showSpecific(P.mPaid);
                      killPay();
                      throw new Error('already_paid');
                    }
                    showSpecific(P.mCreate);
                    throw new Error(j2.error || 'create_failed');
                  }
                return j2.id;
              },
              onApprove: async (data2: { orderID: string }) => {
                const r2 = await fetch('/api/paypal/capture', {
                  method: 'POST', headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ orderID: data2.orderID }),
                });
                const j2 = await r2.json();
                if (!r2.ok || !j2.ok) {
                  // verify_failed/not_found = 결제는 성사·자동 확정 불가 → 재결제 금지 안내(이중 청구 방지)
                  const held = j2.error === 'verify_failed' || j2.error === 'not_found';
                  showSpecific(held ? P.mHeld : (j2.restart ? P.mDeclined : P.mCapture));
                  if (held) killPay();
                  throw new Error(j2.error || 'capture_failed');
                }
                wrap.innerHTML = `<p class="rounded-lg border border-ok/25 bg-ok/10 p-3 text-center text-sm font-semibold text-ok">✅ ${P.paidDone} — $${Number(j2.paidUsd).toFixed(2)} USD</p>`;
                // 결제로 상태가 바뀌었으므로 조회를 다시 실행한다.
                // (버튼만 바꾸면 상단 상태 배지가 옛 값으로 남는다)
                setTimeout(function () { form.requestSubmit(); }, 900);
              },
              onError: (e2: unknown) => { console.error(e2); if (!handled) showErr(P.mError); },
            }).render(btnEl);
          } catch (e2) {
            console.error(e2);
            showErr('결제 모듈을 불러오지 못했습니다 · Failed to load payment module.');
          }
        };

        // 견적·주문 요청(INQ-) 결과 — 접수 상태 카드
        if (j.inquiry) {
          const q = j.inquiry;
          const ICOLOR: Record<string, string> = {
            new: 'border-warn/30 bg-warn/10 text-warn',
            quoted: 'border-accent/30 bg-accent/10 text-accent',
            replied: 'border-ok/30 bg-ok/10 text-ok',
            closed: 'border-ink/10 bg-ink/5 text-ink/40',
          };
          // KRW 견적을 USD 로 환산 표시하면 소액에서 $0.00 으로 왜곡된다 — 산정 통화 그대로 보여준다.
          // 표시용 값은 전부 '보는 언어' 기준으로 먼저 만들어 둔다(카드·견적서가 같은 값을 쓴다)
          const dTxt = renderDetails(q.details_json, String(q.details ?? ''));
          const dSub = renderSubstrate(q.details_json, String(q.substrate ?? ''));
          const amt = q.quoted_amount == null ? null
            : q.quote_currency === 'USD'
              ? `$${Number(q.quoted_amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
              : `₩${Number(q.quoted_amount).toLocaleString('ko-KR')}`;
          // 견적 요약(자동 견적·담당자 개정) — 예상·검토 중이면 금액 줄 자리에, 확정이면 금액 줄 아래에 상자를 둔다
          const qv = q.quote ?? null;
          const qvState = String(qv?.state ?? '');
          const qvBox = renderQuoteBox(qv, QVT);
          if (qvBox) injectQuoteViewStyle(document);
          const amountRow = `
              <div class="mt-5 flex items-center justify-between border-t border-ink/10 pt-5">
                <span class="text-sm text-ink/60">${esc(INQ.amount)} <span class="text-ink/35">${esc(INQ.vat)}</span></span>
                <span class="text-xl font-bold text-ink">${amt ?? `<span class="text-base font-medium text-ink/45">${esc(INQ.pending)}</span>`}</span>
              </div>`;
          // 견적 상자에 [견적서 보기]가 있으면 아래 예전 [견적서 인쇄]는 그리지 않는다(같은 문서를 여는 버튼이 둘이 되지 않게)
          const hasDocBtn = qvBox.includes('data-qv-doc');
          // 담당자가 금액만 넣은 견적(편집기 개정 없음)이 있으면 [견적서 인쇄], 아직 금액이 없으면 [요청서 인쇄]
          const hasAmount = q.quoted_amount != null && Number(q.quoted_amount) > 0;
          // 일반 문의(상품·공정 없음)는 금액이 없으면 뽑을 서류가 없다 — 버튼을 그리지 않는다
          const canPrint = hasAmount || q.type !== 'general';
          const amountBlock = qvBox && (qvState === 'estimate' || qvState === 'reviewing')
            ? `<div class="mt-5 border-t border-ink/10 pt-1">${qvBox}</div>`
            : amountRow + (qvBox ? qvBox : '');
          resEl.innerHTML = `
            <div class="rounded-xl border border-ink/10 bg-ink/[0.02] p-7">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-medium uppercase tracking-widest text-accent">${esc(INQ.title)}</p>
                  <p class="mt-1 font-mono text-lg font-semibold text-ink">${esc(q.id)}</p>
                  <p class="mt-1 text-sm text-ink/40">${esc(INQ.received)} ${when(q.created_at)}</p>
                </div>
                <span class="rounded-full border px-3 py-1 text-sm font-medium ${ICOLOR[q.status] ?? ICOLOR.closed}">
                  ${esc(INQ.st?.[q.status] ?? q.status)}
                </span>
              </div>
              ${q.product_name || q.material ? `
                <p class="mt-6 border-t border-ink/10 pt-5 text-sm text-ink/60">
                  ${esc(INQ.product)}: <span class="text-ink/80">${esc(PNAMES[String(q.product_sku ?? '')] ?? safeShort(q.product_name ?? q.material, 80))}</span>
                </p>` : ''}
              ${q.method || dSub ? `
                <p class="mt-2 text-sm text-ink/60">
                  ${q.method ? `${esc(INQ.method)}: <span class="text-ink/80">${esc(safeShort(q.method, 120))}</span>` : ''}${q.method && q.substrate ? ' · ' : ''}${dSub ? `${esc(INQ.substrate)}: <span class="text-ink/80">${esc(safeShort(dSub, 80))}</span>` : ''}
                </p>` : ''}
              ${dTxt ? `
                <details class="mt-4 rounded-lg border border-ink/10 bg-ink/[0.03]">
                  <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink/70">${esc(INQ.reqBody)}</summary>
                  <pre class="whitespace-pre-wrap border-t border-ink/10 px-4 py-3 font-sans text-sm leading-relaxed text-ink/65">${esc(defang(dTxt))}</pre>
                </details>` : ''}
              ${amountBlock}
              ${q.quote_bank ? `
                <p class="mt-5 rounded-lg border border-ink/10 bg-ink/[0.03] p-4 text-sm leading-relaxed text-ink/70"><span class="text-ink/45">${esc(INQ.sheetBank)}</span><br>${esc(q.quote_bank)}</p>` : ''}
              ${q.quote_note ? `
                <p class="mt-5 rounded-lg bg-ink/[0.05] p-4 text-sm leading-relaxed text-ink/65">${esc(q.quote_note)}</p>` : ''}
              ${hasDocBtn || !canPrint ? '' : `<button type="button" id="inq-sheet" class="mt-5 v-btn-ghost-sm">🖨 ${esc(hasAmount ? INQ.sheetBtn : INQ.reqSheetBtn)}</button>
                <p class="mt-2 text-sm text-danger" data-doc-msg hidden></p>`}
              ${q.paid_at ? `
                <p class="mt-5 rounded-lg border border-ok/25 bg-ok/10 p-3 text-center text-sm font-semibold text-ok">✅ ${P2.paidAt} — ${when(q.paid_at)}</p>` : ''}
              ${!q.paid_at && q.quote_currency === 'USD' && Number(q.quoted_amount) > 0 && q.status !== 'closed' ? payBlock(q.id) : ''}
            </div>`;
          resEl.hidden = false;

          // 엑셀형 견적서(견적 요약에 견적서가 있을 때) — 팝업이 막히면 상자 안에 안내
          const openSavedDoc = (): boolean => {
            const o = docOptions(qv, QVT, PAGE_LANG);
            if (!o) return false;
            const ok = openDoc(buildQuoteDoc(o));
            const msg = resEl.querySelector('[data-qv-msg]') as HTMLElement | null;
            if (msg) { msg.textContent = ok ? '' : QVT.popupBlocked; msg.hidden = ok; }
            return true;
          };
          resEl.querySelector('[data-qv-doc]')?.addEventListener('click', () => { openSavedDoc(); });

          // 견적서·요청서 인쇄 — 접수 확인 페이지를 이미 닫았거나 나중에 다시 찾은 고객이
          // 조회 화면에서 바로 서류를 뽑을 수 있어야 한다(구매팀에 넘길 서류가 된다).
          // 자동 인쇄하지 않는다 — 창 안의 버튼을 눌러야 인쇄창이 뜬다. 모든 서류는 엑셀 「견적서」 틀이다.
          //   견적 요약에 견적서(doc)가 있으면 → 그 견적서
          //   금액만 있는 예전 방식 견적 → 엑셀 견적서 품목 1줄(요청 상품 · 1식, 금액은 부가세 포함으로 보고 공급가액·세액을 나눈다)
          //   금액이 아직 없으면 → 견적 요청서(견적 폼의 [견적 요청서 다운로드]와 같은 함수)
          // 팝업이 막히면 버튼 아래에 안내(문구는 견적 상자와 같은 popupBlocked)
          const docMsg = (ok: boolean) => {
            const m = resEl.querySelector('[data-doc-msg]') as HTMLElement | null;
            if (m) { m.textContent = ok ? '' : QVT.popupBlocked; m.hidden = ok; }
          };
          document.getElementById('inq-sheet')?.addEventListener('click', () => {
            if (qv?.doc && openSavedDoc()) return;
            let dj: Record<string, any> | null = null;
            try { dj = JSON.parse(String(q.details_json ?? 'null')); } catch { dj = null; }
            const pName = String(PNAMES[String(q.product_sku ?? '')] ?? q.product_name ?? q.material ?? '');
            if (hasAmount) {
              // 규격 칸 = 요청 내용(공정 순서·기판 / 웨이퍼는 수량·다이싱). 옛 건은 공정 · 기판
              const spec = specFromDetails({ lang: PAGE_LANG, dj, sizeMap: SIZE_MAP,
                fallback: [String(q.method ?? ''), dSub].filter((x) => x.trim()).join(' · ') });
              // 견적일 = 담당자가 금액을 저장한 날(updated_at). 오늘 날짜로 찍으면 옛 금액이 오늘 견적처럼 보인다
              docMsg(openDoc(buildQuoteDoc(quoteFromAmount({
                lang: PAGE_LANG, id: String(q.id), date: ymdLocal(q.updated_at || q.created_at) || ymdLocal(),
                customer: [q.company, q.name].map((x: unknown) => String(x ?? '').trim()).filter(Boolean).join(' '),
                title: pName, spec, amount: Number(q.quoted_amount), currency: String(q.quote_currency ?? 'KRW'),
                bank: String(q.quote_bank ?? ''), memo: String(q.quote_note ?? ''), contact: docContact(PAGE_LANG),
              }))));
              return;
            }
            // 금액 전 — 견적 요청서. 담당자가 금액 없이 남긴 안내·입금 계좌도 싣는다
            docMsg(openDoc(buildRequestDoc(requestDocFrom({
              lang: PAGE_LANG, id: String(q.id), draft: false, date: ymdLocal(q.created_at),
              statusText: String(INQ.st?.[q.status] ?? q.status ?? ''),
              requester: { company: q.company, name: q.name, phone: q.phone, email: String(data.email ?? '') },
              product: pName, dj, detailsText: dTxt, sizeMap: SIZE_MAP, deliveryMap: DELIV_MAP,
              staffNote: String(q.quote_note ?? ''), bank: String(q.quote_bank ?? ''),
            }))));
          });

          initPP(data.email as string);
          return;
        }

        const o = j.order;
        const items = j.items ?? [];
        const addr = [o.ship_addr1, o.ship_addr2, o.ship_city, o.ship_state]
          .filter(Boolean).join(', ');

        resEl.innerHTML = `
          <div class="rounded-xl border border-ink/10 bg-ink/[0.02] p-7">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="font-mono text-lg font-semibold text-ink">${esc(o.id)}</p>
                <p class="mt-1 text-sm text-ink/40">${C.ordered} ${when(o.created_at)}</p>
              </div>
              <span class="rounded-full border px-3 py-1 text-sm font-medium ${COLOR[o.status] ?? COLOR.cancelled}">
                ${esc(ST[o.status] ?? o.status)}
              </span>
            </div>

            <div class="mt-7 border-t border-ink/10 pt-6">
              <p class="text-xs font-medium uppercase tracking-widest text-accent">${C.items}</p>
              <ul class="mt-4 space-y-3 text-sm">
                ${items.map((i: any) => `
                  <li class="flex justify-between gap-4">
                    <span class="text-ink/70">${esc(i.name)} <span class="text-ink/35">× ${esc(i.qty)}</span>${dicingNote(i)}</span>
                    <span class="shrink-0 text-ink/80">${usdOf(i.subtotal, o.currency)}</span>
                  </li>`).join('')}
              </ul>
              <div class="mt-5 flex items-center justify-between border-t border-ink/10 pt-5">
                <span class="text-sm text-ink/60">${C.amount}</span>
                <span class="text-xl font-bold text-ink">${Number(o.amount_usd) > 0 ? `$${Number(o.amount_usd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : usdOf(o.amount, o.currency)}</span>
              </div>
              ${o.paid_at ? `
                <p class="mt-4 rounded-lg border border-ok/25 bg-ok/10 p-3 text-center text-sm font-semibold text-ok">✅ ${P2.paidAt} — ${when(o.paid_at)}${o.paid_usd ? ` ($${Number(o.paid_usd).toFixed(2)})` : ''}</p>` : ''}
              ${!o.paid_at && o.status === 'pending' ? payBlock(o.id, Number(o.amount), String(o.currency ?? 'KRW')) : ''}
            </div>

            ${o.tracking_no || o.tracking_courier ? `
            <div class="mt-7 border-t border-ink/10 pt-6 text-sm">
              <p class="text-xs font-medium uppercase tracking-widest text-accent">${P.tracking}</p>
              <dl class="mt-3 space-y-1.5">
                ${o.tracking_courier ? `<div class="flex gap-3">
                  <dt class="w-20 shrink-0 text-ink/40">${P.trackingCourier}</dt>
                  <dd class="text-ink/80">${esc(o.tracking_courier)}</dd>
                </div>` : ''}
                ${o.tracking_no ? `<div class="flex gap-3">
                  <dt class="w-20 shrink-0 text-ink/40">${P.trackingNo}</dt>
                  <dd class="font-mono text-ink/80">${esc(o.tracking_no)}</dd>
                </div>` : ''}
              </dl>
            </div>` : ''}

            <div class="mt-7 border-t border-ink/10 pt-6 text-sm">
              <p class="text-xs font-medium uppercase tracking-widest text-accent">${C.shipTo}</p>
              ${o.needs_shipping
                ? `<p class="mt-3 leading-relaxed text-ink/60">
                     ${esc([o.ship_name, o.ship_phone].filter(Boolean).join(' · '))}<br />
                     ${esc([o.ship_zip, addr].filter(Boolean).join(' '))}<br />
                     <span class="text-ink/35">${esc(o.ship_country)}</span>
                   </p>`
                : `<p class="mt-3 text-ink/50">${C.noShip}</p>`}
              ${o.tax_invoice ? `<p class="mt-4 text-ink/50">📄 ${C.taxYes}</p>` : ''}
            </div>

            <div class="mt-7 border-t border-ink/10 pt-6">
              <button type="button" id="ord-sheet" class="v-btn-ghost-sm">🖨 ${esc(C.ordSheetBtn)}</button>
              <p class="mt-2 text-sm text-danger" data-doc-msg hidden></p>
            </div>
          </div>`;
        resEl.hidden = false;

        // 주문서 인쇄 — 견적서와 같은 엑셀 틀(src/lib/doc-excel.js). 금액은 원화(부가세 포함), PayPal 이면 USD 금액을 결제 칸에.
        // 구매팀에 넘길 서류이므로 웨이퍼 다이싱은 원화 확정 금액으로 별도 줄에 적는다.
        // 자동 인쇄하지 않는다 — 창 안의 버튼을 눌러야 인쇄창이 뜬다.
        document.getElementById('ord-sheet')?.addEventListener('click', () => {
          const ok = openDoc(buildOrderDoc(orderDocFrom({
            lang: PAGE_LANG, order: o, items, statusText: String(ST[o.status] ?? o.status ?? ''),
            noShipText: String(C.noShip ?? ''), email: String(data.email ?? ''),
          })));
          // 팝업이 막히면 버튼 아래에 안내
          const m = resEl.querySelector('[data-doc-msg]') as HTMLElement | null;
          if (m) { m.textContent = ok ? '' : QVT.popupBlocked; m.hidden = ok; }
        });

        initPP(data.email as string);
      } catch (err) {
        console.error(err);
        errEl.textContent = M.msgFail!;
      } finally {
        btn.disabled = false;
        label.textContent = M.labelSend!;
      }
    });

    // ── 바로 조회 — 접수 확인 메일·견적 완료 화면의 [진행 상태 조회]는 주소 뒤 #e=이메일 을 붙여 보낸다.
    //    이메일 칸을 채우고 바로 조회한다(접수번호는 ?id= 로 서버가 이미 채워 둠).
    //    # 뒤는 브라우저가 서버로 보내지 않는다(서버 로그·리퍼러에 안 남음). 읽은 즉시 주소창에서 지운다
    //    — 새로고침·주소 복사·화면 공유에 이메일이 남지 않게.
    //    ⚠️ 그래도 이 링크는 '접수번호 + 이메일' 열쇠다 — 전달받은 사람도 같은 조회를 하고, 방문 기록에는 처음 주소가 남을 수 있다.
    //       운영에서 자동으로 붙는 Cloudflare 방문 통계 비콘도 처음 주소(탐색 기록)를 Cloudflare 로 보낼 수 있다
    //       — 사이트를 호스팅하며 접수 내용을 이미 처리하는 곳이라 새로 새는 곳은 아니다(빼려면 Web Analytics 규칙에서 /order/lookup 제외).
    //    값은 직접 꺼내 decodeURIComponent 로 푼다(URLSearchParams 는 '+' 를 공백으로 바꿔 a+b@x 주소가 깨진다).
    const hashMatch = /(?:^|&)e=([^&]*)/.exec(location.hash.slice(1));
    if (hashMatch) {
      let hashEmail = '';
      try { hashEmail = decodeURIComponent(hashMatch[1]).trim(); } catch { hashEmail = ''; }
      try { history.replaceState(history.state, '', location.pathname + location.search); } catch { /* 주소창 정리 실패는 무시 */ }
      const emailEl = document.getElementById('lk-email') as HTMLInputElement | null;
      const idEl = document.getElementById('lk-id') as HTMLInputElement | null;
      if (emailEl && hashEmail.length <= 254 && /^[^\s@]+@[^\s@]+$/.test(hashEmail)) {
        emailEl.value = hashEmail;
        if (idEl?.value.trim()) form.requestSubmit();
      }
    }
  }
</script>
