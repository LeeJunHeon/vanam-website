---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import { formatUsd } from '../../lib/price';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';

// 상품 이미지 에셋 매핑: products/*.json 의 image 경로 → ImageMetadata
const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

// 웨이퍼 세부 제품 이미지: Wafers 카드의 대표 이미지를 이 사진들의 슬라이드쇼로 보여준다.
const waferImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/wafers/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const allWafers = await getCollection('wafers');
const waferSlides = allWafers
  .filter((w) => w.data.published && w.data.image && waferImages[w.data.image])
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({
    src: waferImages[w.data.image!].default,
    alt: isKo ? w.data.name : (w.data.name_en ?? w.data.name),
  }));

const products = (await getCollection('products'))
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const CATS = [
  { key: 'all', label: s.all },
  { key: 'sample', label: s.catSample },
  { key: 'coating', label: s.catCoating },
  { key: 'analysis', label: s.catAnalysis },
  { key: 'wafer', label: s.catWafer },
  { key: 'etc', label: s.catEtc },
].filter((c) => c.key === 'all' || products.some((p) => p.data.category === c.key));

const name = (p) => (isKo ? p.data.name : (p.data.name_en ?? p.data.name));
const summary = (p) => (isKo ? p.data.summary : (p.data.summary_en ?? p.data.summary));
const won = (n: number) => new Intl.NumberFormat('ko-KR').format(n);

// ── Technology 에서 옮겨온 섹션들(주문 절차·분석·장비) — 문구는 site.json tech.* 그대로 사용
const tech = site.technology;
const processSteps = (tech.process ?? []) as { t: string; d: string }[];
const analysisAll = (await getCollection('analysis')).sort((a, b) => a.data.order - b.data.order);
const analysisMaterial = analysisAll.filter((a) => a.data.group === 'material');
const analysisDevice = analysisAll.filter((a) => a.data.group === 'device');
const equipment = (await getCollection('equipment')).sort((a, b) => a.data.order - b.data.order);

// 장비 사진 (배경 제거 투명 PNG — plate 흰 박스에 표시, 미등록 시 카드 자동 숨김)
const equipImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/equipment/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

// 라이트박스(클릭 확대)용 대형 이미지 — 빌드 시 webp 생성 (장비 카드 + 빅데이터 다이어그램 자산)

// 빅데이터 다이어그램: 장비 사진 위 보라 하이라이트(센서 장착 위치) 좌표(%) — 명칭 매핑은 연구팀 확인값
const BD_POINTS = [
  { n: 'RGA', x: 28.4, y: 22.3, side: 'r' },
  { n: 'OES', x: 14.3, y: 60.2, side: 'r' },
  { n: 'TSP', x: 85.7, y: 55.2, side: 'l' },
];
const bdAsset = (pth: string) => equipImages[`/src/assets/equipment/bigdata/${pth}`]?.default;

// 웨이퍼 카드 가격: 등록된 웨이퍼 최저가를 "From $X"/"$X 부터" 로 표시 (환율=사업자 정보 usdRate)
const usdRate = company.usdRate || 1500;
const waferKrws = allWafers
  .filter((w) => w.data.published && typeof w.data.priceKrw === 'number' && w.data.priceKrw > 0)
  .map((w) => w.data.priceKrw as number);
const waferFromLabel = waferKrws.length
  ? (isKo ? `${formatUsd(Math.min(...waferKrws), usdRate)} 부터` : `From ${formatUsd(Math.min(...waferKrws), usdRate)}`)
  : null;
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} zebra>
  <section id="products" class="scroll-mt-24 relative">
  <div class="mx-auto max-w-6xl px-6 py-28 md:py-36">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="v-reveal">
        <p class="text-sm font-medium uppercase tracking-widest text-accent">{s.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-ink md:text-5xl">{s.heroTitle.line1}<br />{s.heroTitle.line2}</h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">{s.intro}</p>
        <p class="mt-3 text-sm text-ink/40">{s.guestNote}</p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a href={`${base}/order/lookup`} class="inline-flex items-center rounded-lg border border-ink/15 px-5 py-2.5 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">{s.trackOrder}</a>
        <a href={`${base}/cart`} class="inline-flex items-center gap-2 rounded-lg border border-ink/15 px-5 py-2.5 text-sm font-medium text-ink/80 transition hover:border-accent hover:text-ink">
          {s.cart} <span class="cart-count rounded bg-brand px-1.5 py-0.5 text-xs font-bold text-onbrand">0</span>
        </a>
      </div>
    </div>

    {products.length === 0 ? (
      <p class="mt-16 text-ink/50">{s.empty}</p>
    ) : (
      <>
        <div class="mt-12 flex flex-wrap gap-2">
          {CATS.map((c, i) => (
            <button type="button" data-cat={c.key}
              class:list={[
                'cat-btn rounded-full border px-4 py-1.5 text-sm transition',
                i === 0 ? 'border-accent bg-accent/10 text-accent' : 'border-ink/15 text-ink/60 hover:border-ink/40 hover:text-ink',
              ]}>{c.label}</button>
          ))}
        </div>

        <div class="v-reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => {
            const img = p.data.image ? productImages[p.data.image]?.default : undefined;
            // 'wafer' 분류 상품(=Wafers 카드)은 상세가 아니라 웨이퍼 목록(/wafers)으로 이동
            const href = p.data.category === 'wafer' ? `${base}/wafers` : `${base}/product/${p.id}`;
            return (
              <article data-cat={p.data.category}
                class="product-card group flex flex-col overflow-hidden rounded-xl border border-ink/10 bg-ink/[0.02] transition hover:border-accent/50">
                <a href={href} class="block">
                  <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-panel2 to-canvas">
                    {p.data.category === 'wafer' && waferSlides.length > 0 ? (
                      <div class="wafer-slider absolute inset-0" data-wafer-slider>
                        {waferSlides.map((sl, i) => (
                          <Image src={sl.src} alt={sl.alt} width={600} height={450}
                            data-slide={i}
                            class:list={["wafer-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-500", i === 0 ? "opacity-100" : "opacity-0"]} />
                        ))}
                        {waferSlides.length > 1 && (
                          <>
                            <button type="button" data-wafer-prev aria-label="Previous"
                              class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/35 p-1.5 text-white opacity-0 backdrop-blur transition hover:bg-black/55 group-hover:opacity-100">
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            </button>
                            <button type="button" data-wafer-next aria-label="Next"
                              class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/35 p-1.5 text-white opacity-0 backdrop-blur transition hover:bg-black/55 group-hover:opacity-100">
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </button>
                            <div class="absolute bottom-2.5 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                              {waferSlides.map((_, i) => (
                                <button type="button" data-wafer-dot={i} aria-label={`Slide ${i + 1}`}
                                  class:list={["h-1.5 w-1.5 rounded-full transition", i === 0 ? "bg-white" : "bg-white/45"]}></button>
                              ))}
                            </div>
                          </>
                        )}
                      </div>
                    ) : img ? (
                      <Image src={img} alt={name(p)} width={600} height={450} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center">
                        <span class="text-3xl font-bold text-ink/15">VanaM</span>
                      </div>
                    )}
                  </div>
                </a>
                <div class="flex flex-1 flex-col p-5">
                  <a href={href}>
                    <h2 class="text-lg font-semibold leading-snug text-ink transition group-hover:text-accent">{name(p)}</h2>
                  </a>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/50">{summary(p)}</p>
                  <div class="mt-5 flex items-end justify-between gap-3 pt-1">
                    {p.data.category === 'wafer' && waferFromLabel ? (
                      <p class="text-lg font-bold text-ink">{waferFromLabel}</p>
                    ) : p.data.pricingType === 'fixed' && p.data.price ? (
                      <p class="text-xl font-bold text-ink">₩{won(p.data.price)}<span class="ml-1.5 text-xs font-normal text-ink/40">{s.vatIncluded}</span></p>
                    ) : (
                      <p class="text-base font-semibold text-accent">{s.priceOnRequest}</p>
                    )}
                    <a href={href} class="shrink-0 text-sm font-medium text-ink/60 transition hover:text-accent">{p.data.category === 'wafer' ? s.viewList : s.viewDetail} →</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </>
    )}
  </div>
  </section>

  <!-- ── 증착 의뢰 프로세스 ──────────────────────────────
       WP의 "Deposition Process" 설명을 6단계로 정리했다.
       마지막에 견적 요청으로 이어진다 — 제품과 연결되는 지점. -->
  <section id="process" class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.processHeading}</h2>
      <p class="mt-3 text-base text-ink/55">{tech.processSub}</p>
    </div>

    <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((st, i) => (
        <li class="v-reveal bg-canvas p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-bold text-ink">{st.t}</h3>
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-ink/50">{st.d}</p>
        </li>
      ))}
    </ol>

    <div class="v-reveal mt-8 flex flex-wrap items-center gap-4">
      <a href={`${base}/product`}
        class="inline-flex items-center gap-2 rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-onbrand transition hover:brightness-110">
        {tech.processCta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
  </section>

  <!-- ── 분석 · 측정 ─────────────────────────────────────
       WP에만 있던 장비 목록(SEM/TEM/XRD/XPS…)을 옮겨왔다.
       제품의 분석 서비스 상품과 직결되는 정보라, 칩 형태로 한눈에 보이게 한다. -->
  <section id="analysis" class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="v-reveal">
      <h2 class="text-2xl font-bold text-ink">{tech.analysisHeading}</h2>
      <p class="mt-3 text-base text-ink/55">{tech.analysisSub}</p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {[
        { title: tech.analysisMaterial, items: analysisMaterial },
        { title: tech.analysisDevice, items: analysisDevice },
      ].map((g) => (
        <div class="v-reveal rounded-2xl border border-ink/10 bg-ink/[0.03] p-6">
          <p class="text-xs font-medium uppercase tracking-widest text-accent">{g.title}</p>
          <ul class="mt-5 space-y-3">
            {g.items.map((a) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 border-b border-ink/[0.06] pb-3 last:border-b-0 last:pb-0">
                <span class="font-mono text-sm font-semibold text-ink">{a.data.name}</span>
                <span class="text-xs text-ink/40">
                  {locale === 'ko' ? (a.data.description_ko ?? a.data.description) : a.data.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  </section>

  <!-- ── 장비 ────────────────────────────────────────────
       "30년 경력 진공장비 전문가와 자체 개발" — WP에 묻혀 있던 강력한 신뢰 요소. -->
  <section id="equipment" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal">
        <h2 class="text-2xl font-bold text-ink">{tech.equipmentHeading}</h2>
        <p class="mt-3 max-w-3xl text-base text-ink/55">{tech.equipmentSub}</p>
      </div>

      {(() => {
        // 재편(지시서 슬라이드 5): 증착 3카드 → "PVD & ALD" 그룹 + 개별 장비 카드(특허 갤러리 문법).
        // 사진이 등록된 장비만 카드로 표시 — 사진이 없으면 그룹 타이틀·설명만 보인다 (빈 박스 노출 없음).
        const label = (e: (typeof equipment)[number]) => (locale === 'ko' ? (e.data.name_ko ?? e.data.name) : e.data.name);
        const img = (e: (typeof equipment)[number]) => (e.data.image ? equipImages[e.data.image]?.default : undefined);
        const cards = equipment.filter((e) => e.data.category === 'deposition' && img(e));
        return (
          <div class="v-reveal mt-10 rounded-xl border border-ink/10 bg-ink/[0.03] p-6">
            <h3 class="text-lg font-bold text-ink">{tech.equipGroupTitle}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink/55">{tech.equipGroupDesc}</p>
            {cards.length > 0 && (
              <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                {cards.map((e) => (
                  <div>
                    <div class="block w-full rounded-xl border border-ink/10 bg-plate p-3">
                      <Image src={img(e)!} alt={label(e)} width={480} class="aspect-square w-full object-contain" />
                    </div>
                    <p class="mt-2.5 text-sm font-semibold leading-snug text-ink/80">{label(e)}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })()}

      {equipment.filter((e) => e.data.category === 'data').map((e) => {
        const bd = (tech as any).bigdataViz;
        const chamber = e.data.image ? equipImages[e.data.image]?.default : undefined;
        return (
          <div class="v-reveal mt-4 rounded-xl border border-accent/25 bg-accent/[0.05] p-6">
            <h3 class="text-base font-bold text-accent">{locale === 'ko' ? (e.data.name_ko ?? e.data.name) : e.data.name}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink/60">
              {locale === 'ko' ? (e.data.description_ko ?? e.data.description) : e.data.description}
            </p>

            {/* P2 다이어그램 — 라벨·캡션 전부 실제 텍스트(SEO 크롤 가능), 이미지는 개별 alt + 라이트박스 */}
            <div class="mt-7">
              <div class="grid gap-5 md:grid-cols-3">
                {bd.stages.map((s: { no: string; t: string; s: string }) => (
                  <div class="flex items-start gap-3">
                    <span class="text-4xl font-bold leading-none text-accent/20">{s.no}</span>
                    <span>
                      <span class="block text-sm font-bold tracking-wide text-ink">{s.t}</span>
                      <span class="mt-0.5 block text-xs text-ink/50">{s.s}</span>
                    </span>
                  </div>
                ))}
              </div>
              <div class="relative mt-3 hidden h-px bg-accent/25 md:block">
                <span class="absolute left-0 top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-accent"></span>
                <span class="absolute left-1/3 top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-accent"></span>
                <span class="absolute left-2/3 top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-accent"></span>
              </div>

              <div class="mt-5 grid gap-4 md:grid-cols-[1.18fr_1fr_1fr]">
                {/* 01 — 장비 + 센서 위치 콜아웃 */}
                <div class="flex flex-col rounded-xl border border-ink/10 bg-canvas p-4 shadow-lg shadow-ink/5">
                  {chamber && (
                    <div class="relative">
                      <div class="block w-full rounded-lg border border-ink/10 bg-plate p-1">
                        <Image src={chamber} alt={locale === 'ko' ? '자체 개발 스퍼터 장비 — RGA·OES·TSP 센서 장착 위치' : 'Self-developed sputter system with RGA, OES and TSP sensors highlighted'} width={560} class="aspect-[7/6] w-full object-contain" />
                      </div>
                      {BD_POINTS.map((pt) => (
                        <span class="pointer-events-none absolute" style={`left:${pt.x}%; top:${pt.y}%;`}>
                          <span class="absolute block h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-fuchsia-500/90 bg-fuchsia-400/20"></span>
                          <span class={`absolute top-0 -translate-y-1/2 whitespace-nowrap rounded-full border border-accent/40 bg-canvas/95 px-2 py-0.5 text-[11px] font-bold text-ink ${pt.side === 'l' ? 'right-3' : 'left-3'}`}>{pt.n}</span>
                        </span>
                      ))}
                    </div>
                  )}
                  <p class="mt-3 text-sm font-bold text-ink">{bd.sputter}</p>
                  <p class="mt-1 text-[11px] leading-relaxed text-ink/45">{bd.sensorLegend}</p>
                </div>

                {/* 02 — 센서 실측(기기·스펙트럼) + AI: 3그룹을 세로로 고르게 분배해
                    옆 컬럼들과 높이 밸런스를 맞춘다(하단 몰림 여백 제거). */}
                <div class="flex flex-col justify-between gap-3 rounded-xl border border-ink/10 bg-canvas p-4 shadow-lg shadow-ink/5">
                  <div>
                    <div class="grid grid-cols-2 gap-2">
                      <div class="overflow-hidden rounded-lg border border-ink/10">
                        <Image src={bdAsset('rga-device.jpg')!} alt={locale === 'ko' ? 'RGA 잔류 가스 분석기' : 'RGA residual gas analyzer device'} width={420} class="aspect-[4/3] w-full object-cover" />
                      </div>
                      <div class="overflow-hidden rounded-lg border border-ink/10">
                        <Image src={bdAsset('rga-spectrum.png')!} alt={locale === 'ko' ? 'RGA 실측 잔류 가스 스펙트럼' : 'Measured residual gas spectrum from RGA'} width={420} class="aspect-[4/3] w-full object-cover" />
                      </div>
                    </div>
                    <p class="mt-1.5 text-[11px] text-ink/45">{bd.rgaCap}</p>
                  </div>
                  <div>
                    <div class="grid grid-cols-2 gap-2">
                      <div class="overflow-hidden rounded-lg border border-ink/10">
                        <Image src={bdAsset('oes-device.jpg')!} alt={locale === 'ko' ? 'OES 광학 발광 분광기' : 'OES optical emission spectrometer device'} width={420} class="aspect-[4/3] w-full object-cover" />
                      </div>
                      <div class="overflow-hidden rounded-lg border border-ink/10">
                        <Image src={bdAsset('oes-spectrum.png')!} alt={locale === 'ko' ? 'OES 발광 스펙트럼 그래프' : 'Optical emission spectrum graph from OES'} width={420} class="aspect-[4/3] w-full object-cover" />
                      </div>
                    </div>
                    <p class="mt-1.5 text-[11px] text-ink/45">{bd.oesCap}</p>
                  </div>
                  <div class="rounded-lg bg-accent px-4 py-3">
                    <p class="text-sm font-bold text-white">{bd.aiTitle}</p>
                    <p class="mt-0.5 text-[11px] text-white/75">{bd.aiSub}</p>
                  </div>
                </div>

                {/* 03 — 산출 */}
                <div class="flex flex-col gap-4">
                  {bd.outputs.map((o: { t: string; s: string; img: string; alt: string }) => (
                    <div class="flex flex-1 flex-col rounded-xl border border-accent/30 bg-canvas p-3.5 shadow-lg shadow-ink/5">
                      <div class="block w-full flex-1 overflow-hidden rounded-lg border border-ink/10">
                        <Image src={bdAsset(o.img)!} alt={o.alt} width={640} class="aspect-[5/2] h-full w-full object-cover" />
                      </div>
                      <p class="mt-2.5 text-sm font-bold text-accent">{o.t}</p>
                      <p class="mt-0.5 text-xs text-ink/50">{o.s}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}

    </div>
  </section>
</BaseLayout>

<script>
  // 카테고리 필터 (클라이언트)
  const btns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const ON = ['border-accent', 'bg-accent/10', 'text-accent'];
  const OFF = ['border-ink/15', 'text-ink/60'];
  btns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.cat;
    btns.forEach((x) => {
      const on = x === b;
      x.classList.toggle('border-accent', on);
      x.classList.toggle('bg-accent/10', on);
      x.classList.toggle('text-accent', on);
      x.classList.toggle('border-ink/15', !on);
      x.classList.toggle('text-ink/60', !on);
    });
    cards.forEach((c) => { c.hidden = cat !== 'all' && c.dataset.cat !== cat; });
  }));

  // 장바구니 개수 표시
  try {
    const cart = JSON.parse(localStorage.getItem('vanam_cart') ?? '[]');
    const n = cart.reduce((sum: number, i: { qty: number }) => sum + i.qty, 0);
    document.querySelectorAll('.cart-count').forEach((el) => { el.textContent = String(n); });
  } catch {}

  // 웨이퍼 카드 슬라이드쇼 (세부 제품 대표사진 순환)
  document.querySelectorAll<HTMLElement>('[data-wafer-slider]').forEach((slider) => {
    const slides = slider.querySelectorAll<HTMLElement>('.wafer-slide');
    const dots = slider.querySelectorAll<HTMLElement>('[data-wafer-dot]');
    if (slides.length < 2) return;
    let cur = 0;
    const go = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((sl, i) => {
        sl.classList.toggle('opacity-100', i === cur);
        sl.classList.toggle('opacity-0', i !== cur);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('bg-white', i === cur);
        d.classList.toggle('bg-white/45', i !== cur);
      });
    };
    // 카드 전체가 링크(<a>)라 화살표·점 클릭이 페이지 이동으로 새지 않게 막는다
    const stop = (e: Event) => { e.preventDefault(); e.stopPropagation(); };

    // 3초 간격 자동 넘김. 수동 조작 시 타이머를 리셋해 바로 넘어가지 않게 한다.
    let timer = window.setInterval(() => go(cur + 1), 3000);
    const reset = () => { clearInterval(timer); timer = window.setInterval(() => go(cur + 1), 3000); };

    slider.querySelector('[data-wafer-prev]')?.addEventListener('click', (e) => { stop(e); go(cur - 1); reset(); });
    slider.querySelector('[data-wafer-next]')?.addEventListener('click', (e) => { stop(e); go(cur + 1); reset(); });
    dots.forEach((d, i) => d.addEventListener('click', (e) => { stop(e); go(i); reset(); }));

    // 마우스 올리면 잠깐 멈춤(읽기 편하게), 벗어나면 재개
    slider.addEventListener('mouseenter', () => clearInterval(timer));
    slider.addEventListener('mouseleave', reset);
  });
</script>
