---
// 웨이퍼 상세 페이지. /wafers/[id]. 공정가 즉시 구매(카트 → 체크아웃 → PayPal).
// 인적·배송 정보 입력은 전부 체크아웃에서 — 상세 페이지에는 입력 폼을 두지 않는다.
// 대량·국내(세금계산서) 구매와 가격 미정 웨이퍼는 문의 페이지로 안내한다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import { formatUsd } from '../../lib/price';

const { wafer } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';
const usdRate = company.usdRate || 1380;   // 달러 환산 환율 (Keystatic '사업자 정보')

const waferImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/wafers/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const d = wafer.data;
const name = isKo ? d.name : (d.name_en ?? d.name);
const summary = isKo ? (d.summary ?? '') : (d.summary_en ?? d.summary ?? '');
const description = isKo ? d.description : (d.description_en ?? d.description);
const leadTime = isKo ? d.leadTime : (d.leadTime_en ?? d.leadTime);
const refundPolicy = isKo ? d.refundPolicy : (d.refundPolicy_en ?? d.refundPolicy);
const img = d.image ? waferImages[d.image]?.default : undefined;

// 다이싱 옵션 — 금액의 유일한 출처는 웨이퍼 컬렉션의 dicingFeeKrw(박스당 원화)다.
// 비어 있는 웨이퍼(예: 2인치 사파이어)는 체크박스 자체를 렌더하지 않는다.
const dicingFee = typeof d.dicingFeeKrw === 'number' && d.dicingFeeKrw > 0 ? d.dicingFeeKrw : 0;

// 검색 결과에 노출되는 설명.
// ⚠️ 웨이퍼 6종 모두 CMS 의 summary 가 비어 있어서 `<meta name="description" content>` 가
//    **빈 값으로** 나가고 있었다(설명 없음보다 나쁜 상태다 — 검색엔진이 발췌를 임의로 만든다).
//    실제로 결제가 일어나는 유일한 페이지들이라 그냥 두면 손해가 크다.
// → summary 를 채우면 그대로 쓰고, 비어 있으면 사양표 앞부분으로 사실 그대로 만들어 준다.
//    (Keystatic 에서 summary 를 채우면 이 폴백은 자동으로 물러난다)
const specText = (d.specs ?? [])
  .slice(0, 4)
  .map((sp) => `${sp.label} ${sp.value}`)
  .join(' · ');
const metaDesc = summary?.trim()
  || (isKo
    ? `${name} — ${specText}. VanaM 에서 사양을 확인하고 바로 주문할 수 있습니다.`
    : `${name} — ${specText}. Check the full specification and order directly from VanaM.`);
---

<BaseLayout title={`${name} | VanaM`} description={metaDesc}>
  <section class="relative v-wrap py-28 md:py-32">
    <a href={`${base}/wafers`} class="text-sm text-ink/50 transition hover:text-accent">← {s.catWafer}</a>

    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      <!-- 이미지 -->
      <div class="overflow-hidden rounded-xl border border-ink/10 bg-gradient-to-br from-panel2 to-canvas">
        <div class="aspect-[4/3]">
          {img ? (
            <Image src={img} alt={name} width={900} height={675} class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-4xl font-bold text-ink/15" aria-hidden="true">VanaM</span>
            </div>
          )}
        </div>
      </div>

      <!-- 정보 -->
      <div>
        <h1 class="text-3xl font-bold leading-tight text-ink md:text-4xl">{name}</h1>
        {summary && <p class="mt-4 text-base leading-relaxed text-ink/60">{summary}</p>}

        <div class="mt-8 border-y border-ink/10 py-6">
          {typeof d.priceKrw === 'number' && d.priceKrw > 0 ? (
            <div>
              <p class="text-3xl font-bold text-ink"><span data-krw={d.priceKrw}>{formatUsd(d.priceKrw, usdRate)}</span><span class="ml-1.5 text-sm font-normal text-ink/40">USD</span></p>
              <p class="mt-1.5 text-xs text-ink/35">{s.fxNote}</p>
            </div>
          ) : (
            <p class="text-2xl font-semibold text-accent">{s.priceOnRequest}</p>
          )}
        </div>

        <div class="mt-8">
          {typeof d.priceKrw === 'number' && d.priceKrw > 0 ? (
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center rounded-lg border border-ink/15">
                  <button type="button" data-qty="-1" class="grid h-12 w-10 place-items-center text-lg text-ink/60 transition hover:text-accent" aria-label={s.qtyDec}>−</button>
                  {/* ⚠️ 보이는 라벨이 없는 입력칸이라 aria-label 이 필수다.
                      ± 버튼과 달리 이 칸만 이름이 없어서, 스크린리더와 AI 에이전트가
                      "무엇을 입력하는 칸인지" 알 수 없었다(에이전트형 브라우징 감사 실패 원인). */}
                  <input id="buy-qty" type="number" min="1" max="99" value="1" aria-label={s.quantity}
                    class="h-12 w-14 border-x border-ink/15 bg-transparent text-center text-sm font-semibold text-ink outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" />
                  <button type="button" data-qty="1" class="grid h-12 w-10 place-items-center text-lg text-ink/60 transition hover:text-accent" aria-label={s.qtyInc}>＋</button>
                </div>
                <button type="button" id="add-cart" data-sku={`wafer:${wafer.id}`} data-cart-url={`${base}/cart`}
                  class="v-btn">
                  {s.addToCart}
                </button>
                <button type="button" id="buy-now" data-checkout-url={`${base}/checkout`}
                  class="inline-flex items-center gap-2 rounded-lg border-2 border-accent px-6 py-3 font-semibold text-accent transition hover:bg-accent hover:text-white">
                  {s.buyNow}
                </button>
              </div>
              {dicingFee > 0 && (
                <div class="mt-5">
                  <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/75">
                    <input type="checkbox" id="opt-dicing" data-fee={dicingFee}
                      class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
                    <span>
                      {s.dicingAdd}
                      <span class="text-ink/50"> (+<span data-krw={dicingFee}>{formatUsd(dicingFee, usdRate)}</span> USD / {s.dicingPerBox})</span>
                    </span>
                  </label>
                  {/* 체크·수량 변경이 즉시 반영되는 예상 합계.
                      금액은 여기서 '보여주기만' 한다 — 실제 청구액은 서버(/api/order)가 다시 계산한다. */}
                  <p class="mt-3 text-sm text-ink/60">
                    {s.estTotal}
                    <span id="est-total" data-unit-krw={d.priceKrw} data-usd-rate={usdRate}
                      class="ml-2 font-semibold text-ink">{formatUsd(d.priceKrw as number, usdRate)}</span>
                    <span class="ml-1 text-xs font-normal text-ink/40">USD</span>
                  </p>
                  <p class="mt-1 text-xs text-ink/35">{s.fxNote}</p>
                </div>
              )}
              <p id="added-msg" class="mt-3 hidden text-sm font-medium text-ok">
                {s.addedToCart} <a href={`${base}/cart`} class="underline">{s.goCart}</a>
              </p>
              <p class="mt-5 text-sm text-ink/45">
                {/* 문의 링크는 클릭 시점의 상품·수량·다이싱 상태를 쿼리로 넘긴다(아래 스크립트가 href 를 갱신).
                    JS 가 죽어도 파라미터 없는 문의 페이지로 가므로 기존 동작이 유지된다. */}
                <a id="bulk-link" href={`${base}/contact`} data-contact-url={`${base}/contact`} data-product={wafer.id}
                  class="underline underline-offset-2 transition hover:text-accent">{s.bulkQuoteLink}</a>
              </p>
            </div>
          ) : (
            <a href={`${base}/contact`}
              class="v-btn">
              {s.requestQuote} →
            </a>
          )}
        </div>

        <p class="mt-6 text-sm text-ink/40">{s.guestNote}</p>
        <p class="mt-2 text-xs leading-relaxed text-ink/35">{s.cartLocalNote}</p>

        {leadTime && (
          <dl class="mt-8 space-y-2 text-sm">
            <div class="flex gap-3">
              <dt class="w-20 shrink-0 text-ink/40">{s.leadTimeLabel}</dt>
              <dd class="text-ink/70">{leadTime}</dd>
            </div>
          </dl>
        )}
      </div>
    </div>

    {d.specs.length > 0 && (
      <div class="mt-20 max-w-3xl">
        <h2 class="text-sm font-medium uppercase tracking-widest text-accent">{s.specs}</h2>
        <dl class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
          {d.specs.map((sp) => (
            <div class="grid grid-cols-3 gap-4 py-4">
              <dt class="text-sm text-ink/50">{isKo ? sp.label : (sp.label_en ?? sp.label)}</dt>
              <dd class="col-span-2 text-sm text-ink/90">{isKo ? sp.value : (sp.value_en ?? sp.value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {description && (
      <div class="mt-16 max-w-3xl whitespace-pre-line text-base leading-relaxed text-ink/70">{description}</div>
    )}

    {refundPolicy && (
      <div class="mt-16 max-w-3xl rounded-xl border border-ink/10 bg-ink/[0.02] p-6">
        <h2 class="text-sm font-medium uppercase tracking-widest text-ink/50">{s.refundLabel}</h2>
        <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink/70">{refundPolicy}</p>
      </div>
    )}

  </section>
<script>
  // 저장소 접근은 전부 lib/cart 한 곳을 통한다 (가격은 저장하지 않는다 — 서버·카탈로그 조회)
  import { addToCart, clampQty, writeBuyNow } from '../../lib/cart';
  // 예상 합계도 상품가와 같은 환율을 쓴다 (data-krw 표기와 어긋나지 않게)
  import { liveRate, cachedRate } from '../../lib/fx-client';

  const addBtn = document.getElementById('add-cart');
  const buyBtn = document.getElementById('buy-now');
  const qtyEl = document.getElementById('buy-qty') as HTMLInputElement | null;
  const msgEl = document.getElementById('added-msg');
  const dicingEl = document.getElementById('opt-dicing') as HTMLInputElement | null;
  const estEl = document.getElementById('est-total');
  const bulkEl = document.getElementById('bulk-link') as HTMLAnchorElement | null;

  const qty = () => clampQty(qtyEl?.value);
  const dicing = () => dicingEl?.checked === true;

  // ── 예상 합계 · 문의 링크 갱신 ─────────────────────────────
  // 금액(원)은 서버가 쓰는 값과 같은 출처(웨이퍼 컬렉션)에서 HTML 로 내려온 것만 읽는다.
  const unitKrw = Number(estEl?.dataset.unitKrw) || 0;
  const feeKrw = Number(dicingEl?.dataset.fee) || 0;
  let RATE = cachedRate() || Number(estEl?.dataset.usdRate) || 0;

  const paint = () => {
    if (estEl && unitKrw > 0 && RATE > 0) {
      const krw = (unitKrw + (dicing() ? feeKrw : 0)) * qty();
      estEl.textContent =
        '$' + (krw / RATE).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (bulkEl) {
      const url = bulkEl.dataset.contactUrl ?? '/contact';
      const q = new URLSearchParams({
        product: bulkEl.dataset.product ?? '',
        qty: String(qty()),
        dicing: dicing() ? '1' : '0',
      });
      bulkEl.href = `${url}?${q.toString()}`;
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!qtyEl) return;
      qtyEl.value = String(clampQty(qty() + Number(b.dataset.qty)));
      paint();
    });
  });
  qtyEl?.addEventListener('input', paint);
  dicingEl?.addEventListener('change', paint);

  // 정적 페이지라 첫 렌더 환율은 빌드 시점 값이다. 현재 환율을 받아 예상 합계를 맞춘다.
  // (data-krw 표기는 fx-client 가 알아서 갱신한다 — 여기서는 계산식이 있는 합계만 다시 그린다)
  void liveRate(RATE || 1380).then((r) => { if (r > 0) { RATE = r; paint(); } });
  paint();

  addBtn?.addEventListener('click', () => {
    const sku = addBtn.dataset.sku;
    if (!sku) return;
    addToCart(sku, qty(), dicing());
    if (msgEl) msgEl.classList.remove('hidden');
  });

  // 즉시 구매는 장바구니에 담지 않는다.
  // 담아버리면 결제하지 않고 나갔을 때 항목이 남아, 다음 즉시 구매 때 함께 주문된다.
  // 세션 한정 키에 이번 건만 넣고, 주문서에는 ?buynow=1 로 소스를 '선언'해 이동한다.
  // (주문서는 선언된 소스만 읽는다 — 키 존재 여부로 추측하지 않는다)
  buyBtn?.addEventListener('click', () => {
    const sku = addBtn?.dataset.sku;
    if (!sku) return;
    const url = buyBtn.dataset.checkoutUrl ?? '/checkout';
    if (!writeBuyNow([{ sku, qty: qty(), dicing: dicing() }])) {
      // 세션 저장이 막힌 환경(강화된 시크릿 모드 등)에서는 장바구니 경로로 폴백한다.
      addToCart(sku, qty(), dicing());
      location.href = url;
      return;
    }
    location.href = url + (url.includes('?') ? '&' : '?') + 'buynow=1';
  });

</script>
</BaseLayout>

<script>
  // 정적 페이지라 가격이 빌드 시점 환율로 박힌다. 현재 환율로 표시만 갱신한다.
  import '../../lib/fx-client';
</script>
