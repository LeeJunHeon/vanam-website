---
// 웨이퍼 상세 페이지. /wafers/[id]. 공정가 즉시 구매(카트 → 체크아웃 → PayPal).
// 인적·배송 정보 입력은 전부 체크아웃에서 — 상세 페이지에는 입력 폼을 두지 않는다.
// 대량·국내(세금계산서) 구매와 가격 미정 웨이퍼는 문의 페이지로 안내한다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
import company from '../../data/company.json';
import { formatUsd } from '../../lib/price';

const { wafer } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const s = site.shop;
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';
const usdRate = company.usdRate || 1500;   // 달러 환산 환율 (Keystatic '사업자 정보')

const waferImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/wafers/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const d = wafer.data;
const name = isKo ? d.name : (d.name_en ?? d.name);
const summary = isKo ? (d.summary ?? '') : (d.summary_en ?? d.summary ?? '');
const description = isKo ? d.description : (d.description_en ?? d.description);
const leadTime = isKo ? d.leadTime : (d.leadTime_en ?? d.leadTime);
const refundPolicy = isKo ? d.refundPolicy : (d.refundPolicy_en ?? d.refundPolicy);
const img = d.image ? waferImages[d.image]?.default : undefined;
---

<BaseLayout title={`${name} | VANAM`} description={summary}>
  <section class="relative mx-auto max-w-6xl px-6 py-28 md:py-32">
    <a href={`${base}/wafers`} class="text-sm text-ink/50 transition hover:text-accent">← {s.catWafer}</a>

    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      <!-- 이미지 -->
      <div class="overflow-hidden rounded-xl border border-ink/10 bg-gradient-to-br from-panel2 to-canvas">
        <div class="aspect-[4/3]">
          {img ? (
            <Image src={img} alt={name} width={900} height={675} class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-4xl font-bold text-ink/15">VANAM</span>
            </div>
          )}
        </div>
      </div>

      <!-- 정보 -->
      <div>
        <h1 class="text-3xl font-bold leading-tight text-ink md:text-4xl">{name}</h1>
        {summary && <p class="mt-4 text-base leading-relaxed text-ink/60">{summary}</p>}

        <div class="mt-8 border-y border-ink/10 py-6">
          {typeof d.priceKrw === 'number' && d.priceKrw > 0 ? (
            <p class="text-3xl font-bold text-ink">{formatUsd(d.priceKrw, usdRate)}<span class="ml-1.5 text-sm font-normal text-ink/40">USD</span></p>
          ) : (
            <p class="text-2xl font-semibold text-accent">{s.priceOnRequest}</p>
          )}
        </div>

        <div class="mt-8">
          {typeof d.priceKrw === 'number' && d.priceKrw > 0 ? (
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center rounded-lg border border-ink/15">
                  <button type="button" data-qty="-1" class="grid h-12 w-10 place-items-center text-lg text-ink/60 transition hover:text-accent" aria-label="수량 감소">−</button>
                  <input id="buy-qty" type="number" min="1" max="99" value="1"
                    class="h-12 w-14 border-x border-ink/15 bg-transparent text-center text-sm font-semibold text-ink outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" />
                  <button type="button" data-qty="1" class="grid h-12 w-10 place-items-center text-lg text-ink/60 transition hover:text-accent" aria-label="수량 증가">＋</button>
                </div>
                <button type="button" id="add-cart" data-sku={`wafer:${wafer.id}`} data-cart-url={`${base}/cart`}
                  class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">
                  {s.addToCart}
                </button>
                <button type="button" id="buy-now" data-checkout-url={`${base}/checkout`}
                  class="inline-flex items-center gap-2 rounded-lg border-2 border-accent px-6 py-3 font-semibold text-accent transition hover:bg-accent hover:text-white">
                  {s.buyNow}
                </button>
              </div>
              <p id="added-msg" class="mt-3 hidden text-sm font-medium text-ok">
                {s.addedToCart} <a href={`${base}/cart`} class="underline">{s.goCart}</a>
              </p>
              <p class="mt-5 text-sm text-ink/45">
                <a href={`${base}/contact`} class="underline underline-offset-2 transition hover:text-accent">{s.bulkQuoteLink}</a>
              </p>
            </div>
          ) : (
            <a href={`${base}/contact`}
              class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110">
              {s.requestQuote} →
            </a>
          )}
        </div>

        <p class="mt-6 text-sm text-ink/40">{s.guestNote}</p>
        <p class="mt-2 text-xs leading-relaxed text-ink/35">{s.cartLocalNote}</p>

        {leadTime && (
          <dl class="mt-8 space-y-2 text-sm">
            <div class="flex gap-3">
              <dt class="w-20 shrink-0 text-ink/40">{s.leadTimeLabel}</dt>
              <dd class="text-ink/70">{leadTime}</dd>
            </div>
          </dl>
        )}
      </div>
    </div>

    {d.specs.length > 0 && (
      <div class="mt-20 max-w-3xl">
        <h2 class="text-sm font-medium uppercase tracking-widest text-accent">{s.specs}</h2>
        <dl class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
          {d.specs.map((sp) => (
            <div class="grid grid-cols-3 gap-4 py-4">
              <dt class="text-sm text-ink/50">{isKo ? sp.label : (sp.label_en ?? sp.label)}</dt>
              <dd class="col-span-2 text-sm text-ink/90">{isKo ? sp.value : (sp.value_en ?? sp.value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {description && (
      <div class="mt-16 max-w-3xl whitespace-pre-line text-base leading-relaxed text-ink/70">{description}</div>
    )}

    {refundPolicy && (
      <div class="mt-16 max-w-3xl rounded-xl border border-ink/10 bg-ink/[0.02] p-6">
        <h2 class="text-sm font-medium uppercase tracking-widest text-ink/50">{s.refundLabel}</h2>
        <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink/70">{refundPolicy}</p>
      </div>
    )}

  </section>
<script>
  // 웨이퍼 즉시 구매: localStorage 'vanam_cart' 에 {sku, qty} 저장 (가격은 항상 서버·카탈로그 조회)
  const CART_KEY = 'vanam_cart';
  const addBtn = document.getElementById('add-cart');
  const buyBtn = document.getElementById('buy-now');
  const qtyEl = document.getElementById('buy-qty') as HTMLInputElement | null;
  const msgEl = document.getElementById('added-msg');

  const readCart = (): { sku: string; qty: number }[] => {
    try { return JSON.parse(localStorage.getItem(CART_KEY) ?? '[]'); } catch { return []; }
  };
  const clampQty = () => Math.max(1, Math.min(99, Math.floor(Number(qtyEl?.value)) || 1));

  document.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!qtyEl) return;
      qtyEl.value = String(Math.max(1, Math.min(99, clampQty() + Number(b.dataset.qty))));
    });
  });

  const addToCart = (): boolean => {
    const sku = addBtn?.dataset.sku;
    if (!sku) return false;
    const qty = clampQty();
    const items = readCart();
    const hit = items.find((i) => i && i.sku === sku);
    if (hit) hit.qty = Math.min(99, (Math.floor(Number(hit.qty)) || 0) + qty);
    else items.push({ sku, qty });
    localStorage.setItem(CART_KEY, JSON.stringify(items));
    document.querySelectorAll('.cart-count').forEach((el) => {
      el.textContent = String(items.reduce((s2, i) => s2 + (Math.floor(Number(i.qty)) || 0), 0));
    });
    return true;
  };

  addBtn?.addEventListener('click', () => {
    if (addToCart() && msgEl) msgEl.classList.remove('hidden');
  });
  buyBtn?.addEventListener('click', () => {
    if (addToCart()) location.href = buyBtn.dataset.checkoutUrl ?? '/checkout';
  });

</script>
</BaseLayout>
