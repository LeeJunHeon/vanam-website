---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BrandGuard from '../BrandGuard.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const copy = site.news;
const title = copy.metaTitle;
const description = copy.metaDescription;
// 최신 기사가 위로 오도록 order 내림차순 정렬.
// (order 는 엑셀 Press Release List 행 순서 = 오래된→최신이므로, 내림차순이면 최신이 맨 위)
const news = (await getCollection('news')).sort((a, b) => b.data.order - a.data.order);
// 제목: EN 페이지는 영문(title_en, 없으면 title), KO 페이지는 원문(title)
const newsTitle = (n) => (locale === 'ko' ? n.data.title : (n.data.title_en ?? n.data.title));

// ── Blog 섹션 (0167 통합) — 구 Blog.astro 의 로직·마크업 원문 이식 ──
const isKo = locale === 'ko';
const base = isKo ? '/ko' : '';
// 썸네일(Keystatic 업로드, 항목별 하위폴더 대응)
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/blog/**/*.{png,jpg,jpeg,webp,avif,gif}',
  { eager: true },
);

const posts = (await getCollection('blog'))
  .filter((p) => p.data.published)
  .sort((a, b) => {
    const da = a.data.date?.valueOf() ?? 0;
    const db = b.data.date?.valueOf() ?? 0;
    return db - da || a.data.order - b.data.order;   // 최신 날짜 우선, 같은 날은 order 작은 순
  });

// fmtDate 는 위 News 것을 재사용 (0167 통합 시 중복 선언 제거)
const postTitle = (p) => (isKo ? (p.data.title_ko ?? p.data.title) : p.data.title);
const excerpt = (p) => (isKo ? (p.data.excerpt_ko ?? p.data.excerpt) : p.data.excerpt);
const postHref = (p) => p.data.url || p.data.linkedinUrl || '';
// 본문이 있는 글 → 우리 상세 페이지(같은 탭), 없는 글 → 원문 링크(새 탭)
const hasBody = (p) => !!p.data.body;
const detailHref = (p) => `${base}/blog/${p.id}`;
const hasExternalOnly = () => posts.some((p) => !hasBody(p) && postHref(p));
const postCat = (p) => p.data.category ?? 'linkedin';

// 카테고리 칩 — 글이 있는 카테고리만 노출 (Agent 는 첫 글이 등록되면 자동으로 나타난다)
const CAT_LABEL: Record<string, string> = { linkedin: 'LinkedIn', agent: 'Agent' };
const cats = [
  { key: 'all', label: isKo ? '전체' : 'All' },
  ...(['linkedin', 'agent'] as const)
    .filter((k) => posts.some((p) => postCat(p) === k))
    .map((k) => ({ key: k, label: CAT_LABEL[k] })),
];

// SEO: Blog 구조화 데이터 (BlogPosting 목록)
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'VanaM Blog',
  url: new URL(isKo ? '/ko/news' : '/news', Astro.site).href,
  inLanguage: isKo ? 'ko-KR' : 'en-US',
  publisher: { '@type': 'Organization', name: 'VanaM Inc.', url: 'https://vanam.co.kr' },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: postTitle(p),
    ...(p.data.date ? { datePublished: p.data.date.toISOString().slice(0, 10) } : {}),
    ...(hasBody(p)
      ? { url: new URL(detailHref(p), Astro.site).href }
      : postHref(p) ? { url: postHref(p) } : {}),
  })),
};

const bt = {
  heading: isKo ? '블로그' : 'Blog',
  sub: isKo ? 'VanaM의 기술과 산업 이야기를 전합니다.' : 'Insights and stories on our technology and industry.',
  pressHeading: isKo ? '뉴스' : 'News',
  emptyTitle: isKo ? '준비 중입니다' : 'Coming soon',
  emptyBody: isKo ? '곧 새로운 글로 찾아뵙겠습니다.' : 'New posts will be published here soon.',
  openNote: isKo ? '카드를 누르면 원문이 새 탭으로 열립니다.' : 'Cards open the original post in a new tab.',
};
const fmtDate = (d) =>
  d.toLocaleDateString(locale === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description}>

  <section class="mx-auto max-w-5xl px-6 pt-28 pb-12 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{copy.eyebrow}</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-6xl">{locale === 'ko' ? '뉴스 · 블로그' : 'News & Blog'}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/60" set:html={copy.heroSubtitleHtml}></p>
    </div>
  </section>

  <section id="press" class="mx-auto max-w-5xl scroll-mt-24 px-6 pb-20">
    <h2 class="v-reveal v-h2">{bt.pressHeading}</h2>
    <div class="mt-8 space-y-4">
      {news.map((n) => (
        <a href={n.data.url} target="_blank" rel="noopener noreferrer"
           class="v-reveal group flex items-start gap-5 v-card p-6 transition hover:border-accent/40 hover:bg-ink/[0.05]">
          <span class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-accent/25 bg-accent/[0.08] text-accent transition group-hover:border-accent/50 group-hover:bg-accent/[0.14]" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V6" /><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z" /></svg>
          </span>
          <span class="flex-1">
            <span class="block text-base font-medium leading-relaxed text-ink/85 group-hover:text-ink"><BrandGuard text={newsTitle(n)} /></span>
            {(n.data.outlet || n.data.date) && (
              <span class="mt-1.5 block text-xs text-ink/45">
                {n.data.outlet}{n.data.outlet && n.data.date && ' · '}{n.data.date && fmtDate(n.data.date)}
              </span>
            )}
          </span>
          <svg class="mt-1 h-5 w-5 shrink-0 text-ink/30 transition group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          <span class="sr-only">(새 창에서 열림)</span>
        </a>
      ))}
    </div>
  </section>

  <section id="blog" class="mx-auto max-w-6xl scroll-mt-24 px-6 pb-24">
    <h2 class="v-reveal v-h2">{bt.heading}</h2>
    <p class="v-reveal mt-3 max-w-2xl text-base text-ink/55">{bt.sub}</p>
    <div class="mt-8">
    {posts.length > 0 ? (
      <>
        <div class="v-reveal flex flex-wrap items-center gap-2">
          {cats.map((c, i) => (
            <button type="button" data-cat={c.key}
              class:list={[
                'blog-cat-btn rounded-full border px-4 py-1.5 text-sm transition',
                i === 0 ? 'border-accent bg-accent/10 text-accent' : 'border-ink/15 text-ink/60 hover:border-ink/40 hover:text-ink',
              ]}>{c.label}</button>
          ))}
          {hasExternalOnly() && <span class="ml-2 text-xs text-ink/35">{bt.openNote}</span>}
        </div>

        <div class="v-reveal mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => {
            const internal = hasBody(p);
            const href = internal ? detailHref(p) : postHref(p);
            const cat = postCat(p);
            const th = p.data.thumbnail ? thumbs[p.data.thumbnail]?.default : undefined;
            const Tag = href ? 'a' : 'div';
            return (
              <Tag
                href={href || undefined}
                target={!internal && href ? '_blank' : undefined}
                rel={!internal && href ? 'noopener noreferrer' : undefined}
                data-cat={cat}
                class="blog-card group flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-ink/[0.02] transition hover:border-accent/50 hover:bg-ink/[0.04]"
              >
                <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-panel2 to-canvas">
                  {th ? (
                    <Image src={th} alt={postTitle(p)} width={640} height={400}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  ) : cat === 'linkedin' ? (
                    <div class="flex h-full w-full items-center justify-center">
                      <svg class="h-12 w-12 text-ink/15 transition group-hover:text-[#0A66C2]/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </div>
                  ) : (
                    <div class="flex h-full w-full items-center justify-center">
                      <svg class="h-12 w-12 text-ink/15 transition group-hover:text-accent/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
                    </div>
                  )}
                  <span class={`absolute left-3 top-3 rounded-full border border-ink/10 bg-canvas/95 px-2.5 py-1 text-[11px] font-semibold ${cat === 'linkedin' ? 'text-[#0A66C2]' : 'text-accent'}`}>
                    {CAT_LABEL[cat] ?? cat}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h2 class="line-clamp-2 text-base font-semibold leading-snug text-ink/90 transition group-hover:text-ink">{postTitle(p)}</h2>
                  {excerpt(p) && (
                    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/50">{excerpt(p)}</p>
                  )}
                  <div class="mt-auto flex items-center justify-between pt-4 text-xs text-ink/40">
                    <span>{p.data.date ? fmtDate(p.data.date) : ''}</span>
                    {href && (
                      <svg class="h-4 w-4 shrink-0 text-ink/30 transition group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        {internal ? <path d="M5 12h14M13 6l6 6-6 6" /> : <path d="M7 17 17 7M7 7h10v10" />}
                      </svg>
                    )}
                  </div>
                </div>
              </Tag>
            );
          })}
        </div>
      </>
    ) : (
      <div class="v-reveal flex flex-col items-center justify-center gap-3 v-card py-20 text-center">
        <svg class="h-12 w-12 text-ink/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <p class="text-lg font-semibold text-ink/70">{bt.emptyTitle}</p>
        <p class="text-sm text-ink/45">{bt.emptyBody}</p>
      </div>
    )}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogLd)} />

  <script>
    // 카테고리 필터 (클라이언트) — Shop 페이지와 동일 패턴
    const btns = document.querySelectorAll<HTMLButtonElement>('.blog-cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');
    btns.forEach((b) => b.addEventListener('click', () => {
      const cat = b.dataset.cat;
      btns.forEach((x) => {
        const on = x === b;
        x.classList.toggle('border-accent', on);
        x.classList.toggle('bg-accent/10', on);
        x.classList.toggle('text-accent', on);
        x.classList.toggle('border-ink/15', !on);
        x.classList.toggle('text-ink/60', !on);
      });
      cards.forEach((c) => { c.hidden = cat !== 'all' && c.dataset.cat !== cat; });
    }));
  </script>
</BaseLayout>
