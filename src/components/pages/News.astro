---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const copy = site.news;
const title = copy.metaTitle;
const description = copy.metaDescription;
const news = (await getCollection('news')).sort((a, b) => {
  // 게재일(date) 최신순 정렬, 날짜가 같거나 없으면 order(작을수록 위)로 보조 정렬
  const da = a.data.date?.valueOf() ?? 0;
  const db = b.data.date?.valueOf() ?? 0;
  return db - da || a.data.order - b.data.order;
});
const fmtDate = (d) =>
  d.toLocaleDateString(locale === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description}>

  <section class="mx-auto max-w-5xl px-6 pt-28 pb-12 md:pt-36">
    <div class="v-reveal">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-[#1EBBF0]">{copy.eyebrow}</p>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-white md:text-6xl">{copy.heroTitle}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60" set:html={copy.heroSubtitleHtml}></p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="space-y-4">
      {news.map((n) => (
        <a href={n.data.url} target="_blank" rel="noopener noreferrer"
           class="v-reveal group flex items-start gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-[#1EBBF0]/40 hover:bg-white/[0.05]">
          <span class="mt-1 shrink-0 rounded-full border border-[#1EBBF0]/30 bg-[#1EBBF0]/10 px-3 py-1 text-xs font-semibold text-[#1EBBF0]">{n.data.tag}</span>
          <span class="flex-1">
            <span class="block text-base font-medium leading-relaxed text-white/85 group-hover:text-white">{n.data.title}</span>
            {(n.data.outlet || n.data.date) && (
              <span class="mt-1.5 block text-xs text-white/45">
                {n.data.outlet}{n.data.outlet && n.data.date && ' · '}{n.data.date && fmtDate(n.data.date)}
              </span>
            )}
          </span>
          <svg class="mt-1 h-5 w-5 shrink-0 text-white/30 transition group-hover:text-[#1EBBF0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          <span class="sr-only">(새 창에서 열림)</span>
        </a>
      ))}
    </div>

    <p class="v-reveal mt-10 text-sm text-white/55">{copy.footnote}</p>
  </section>
</BaseLayout>
