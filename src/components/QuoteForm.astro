---
// 증착 공정 견적 요청 폼 (구글 폼 "증착 공정 의뢰서" + 엑셀 "공정 의뢰 양식"을 웹으로 구현).
// Product 4종(Oxides/Nitrides/Metals/Multilayers) 상세 페이지의 한 섹션으로 들어간다.
// 구성: ①연락처 ②기판 정보 ③공정 시퀀스 빌더(엑셀 대체) ④기타 요청.
// 공정 시퀀스는 "공정 추가"로 행을 쌓고, 공정을 고르면 그에 맞는 물질/단위가 자동으로 바뀐다.
// 제출 시 시퀀스를 사람이 읽을 수 있는 텍스트로 정리해 details 에, 원본은 JSON 으로 함께 보낸다.
import siteData from '../data/site.json';
import company from '../data/company.json';
import { PROCESSES, MEASUREMENTS, SUBSTRATES, SUBSTRATE_SIZES, DELIVERY_METHODS, DELIVERY_NEEDS_SHIPPING, PRODUCT_MAT_FILTER, type MatCat } from '../lib/processes';
import { COUNTRIES } from '../lib/countries';
// 기판 등급 — 선택지·대상 종류의 단일 출처(서버 검증·자동 견적과 같은 목록)
import { SUBSTRATE_GRADES, GRADED_SUBSTRATES } from '../lib/quote-fields.js';
// 예상 견적(운영 스위치 '자동 견적'이 켜졌을 때만 화면에 나타난다 — 꺼져 있으면 숨은 채로 지금 화면 그대로)
import QuoteEstimate from './QuoteEstimate.astro';

const { product, productName, simple = false } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const isKo = locale === 'ko';
const c = site.contact.form;   // 연락처 필드 라벨 (문의 폼과 공용)
const q = site.quote.form;     // 견적 전용

const inputClass =
  'v-input';
const selectClass = inputClass;
const labelClass = 'block text-sm font-medium text-ink/80';
const legendClass = 'text-sm font-medium uppercase tracking-widest text-accent';

// 이 제품에 맞는 물질 분류만 남긴다(산화물 제품 → 산화물+가스 등). null 이면 전체.
const allow = PRODUCT_MAT_FILTER[product.id as string] ?? null;
const filteredProcesses = PROCESSES.map((p) => ({
  ...p,
  materials: allow ? p.materials.filter(([, cat]) => allow.includes(cat)) : p.materials,
})).filter((p) => p.materials.length > 0 || p.unit === null); // 물질이 다 걸러진 공정은 제외(측정류 제외)

// 공정 데이터를 클라이언트 스크립트로 넘기기 위해 JSON 으로 직렬화
const processData = JSON.stringify(filteredProcesses);
const measurementData = JSON.stringify(MEASUREMENTS);

// 기판 크기·전달 방식은 언어별 라벨을 미리 고른다
const sizeOpts = SUBSTRATE_SIZES.map((s) => ({ value: s.value, label: isKo ? s.ko : s.en }));
const deliveryOpts = DELIVERY_METHODS.map((d) => ({ value: d.value, label: isKo ? d.ko : d.en }));
// 배송형 전달값 — 이 값 선택 시에만 배송지 블록 노출.
// ⚠️ 예전에는 라벨에 정규식을 돌려 판정했다. 'In-person delivery'(방문 전달)처럼 라벨에
//    delivery 가 들어가면 방문 전달에도 배송지가 뜨고 필수까지 걸린다.
//    → 판정은 processes.ts 의 needsShipping 플래그 한 곳에서만 한다.
const shipValues = DELIVERY_NEEDS_SHIPPING;
// 배송 국가 (simple=고정가 주문 폼 전용)
const countryOpts = COUNTRIES.map((cn) => ({ value: cn.code, label: isKo ? cn.ko : cn.en }));
// 증착 공정 목록(두께 nm 단위) — 대표 소재 판정용 (세정 가스가 '소재'로 잡히던 문제 방지)
const DEP_PROCESSES = PROCESSES.filter((p) => p.unit === 'nm').map((p) => p.name);
// Turnstile 사이트 키 — 빌드가 정한다(src/lib/turnstile-key.js · astro.config.mjs define).
declare const __VANAM_TURNSTILE_SITEKEY__: string;
---

<section id="quote" class="mt-20 scroll-mt-24 border-t border-ink/10 pt-16">
  <div class="max-w-3xl">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{simple ? q.titleOrder : q.title}</p>
    <h2 class="mt-4 text-3xl font-bold leading-tight text-ink">{productName}</h2>
    <p class="mt-4 text-base leading-relaxed text-ink/60">{simple ? q.introOrder : q.intro}</p>

    {/* method="post": 스크립트가 못 뜬 상태에서 Enter 로 제출돼도 이름·이메일·전화가 주소창(GET)에 실리지 않게 */}
    <form id="quote-form" method="post" novalidate class="mt-12 space-y-12"
      data-product={product.id}
      data-product-name={productName}
      data-simple={simple ? '1' : ''}
      data-msg-success={simple ? q.msgSuccessOrder : q.msgSuccess}
      data-msg-error={c.msgError}
      data-msg-required={c.msgRequired}
      data-msg-captcha={c.msgCaptcha.replaceAll('{email}', company.email || 'hello@vanam.co.kr')}
      data-msg-noprocess={q.msgNoProcess}
      data-msg-seq-process={q.msgSeqProcess}
      data-msg-seq-material={q.msgSeqMaterial}
      data-msg-seq-value={q.msgSeqValue}
      data-msg-prefilm={q.msgPreFilmNote}
      data-msg-other={q.msgOtherEmpty}
      data-msg-max-rows={q.msgMaxRows}
      data-err={JSON.stringify(c.errors).replaceAll('{email}', company.email || 'hello@vanam.co.kr')}
      data-label-send={simple ? q.submitOrder : q.submit}
      data-sheet-mail={company.email || 'hello@vanam.co.kr'}
      data-msg-popup={site.quote.view.popupBlocked}
      data-lbl-material2={q.lblMaterial}
      data-lbl-method2={q.lblMethod}
      data-lbl-substrate2={q.lblSubstrate}
      data-label-sending={c.sending}
      data-lbl-step={q.processStep}
      data-lbl-process={q.processType}
      data-lbl-process-ph={q.processTypePlaceholder}
      data-lbl-material={q.processMaterial}
      data-lbl-material-ph={q.processMaterialPlaceholder}
      data-lbl-value={q.processValue}
      data-lbl-etc={q.processEtc}
      data-lbl-etc-ph={q.processEtcPlaceholder}
      data-lbl-remove={q.processRemove}
      data-map-size={JSON.stringify(Object.fromEntries(sizeOpts.map((s) => [s.value, s.label])))}
      data-map-delivery={JSON.stringify(Object.fromEntries(deliveryOpts.map((d) => [d.value, d.label])))}
      data-map-country={JSON.stringify(Object.fromEntries(countryOpts.map((cn) => [cn.value, cn.label])))}
      data-dep-processes={JSON.stringify(DEP_PROCESSES)}>
      <!-- Honeypot: 사람에겐 안 보임 (스팸 트랩) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{c.honeypot}
          <input type="text" name="vanam_hp_note" tabindex="-1" autocomplete="new-password" />
        </label>
      </div>

      <!-- ① 연락처 -->
      <fieldset>
        <legend class={legendClass}>{c.sectionContact}</legend>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <label for="q-name" class={labelClass}>{c.name} <span class="text-danger">*</span></label>
            <input id="q-name" name="name" type="text" required maxlength="100" autocomplete="name" class={inputClass} placeholder={c.namePlaceholder} />
          </div>
          <div>
            <label for="q-email" class={labelClass}>{c.email} <span class="text-danger">*</span></label>
            <input id="q-email" name="email" type="email" required maxlength="254" autocomplete="email" class={inputClass} placeholder={c.emailPlaceholder} />
          </div>
          <div>
            <label for="q-phone" class={labelClass}>{c.phone} <span class="text-danger">*</span></label>
            <input id="q-phone" name="phone" type="tel" required maxlength="40" class={inputClass} />
          </div>
          <div>
            <label for="q-company" class={labelClass}>{c.company}</label>
            <input id="q-company" name="company" type="text" maxlength="200" autocomplete="organization" class={inputClass} placeholder={c.companyPlaceholder} />
          </div>
        </div>
      </fieldset>

      <!-- ② 기판 정보 (필수) — 공정 제품 전용. 단일 상품(웨이퍼 등)은 수량만 받는다. -->
      {!simple ? (
      <fieldset>
        <legend class={legendClass}>{q.sectionSubstrate}</legend>
        <div class="mt-6 space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-substrate-type" class={labelClass}>{q.substrateType} <span class="text-danger">*</span></label>
              <select id="q-substrate-type" name="substrateType" required class={selectClass}>
                <option value="" disabled selected>{q.substrateTypePlaceholder}</option>
                {SUBSTRATES.map(([value, lbl]) => <option value={value}>{lbl}</option>)}
                <option value="__other__">{q.substrateTypeOther}</option>
              </select>
              <input id="q-substrate-type-other" name="substrateTypeOther" type="text" hidden maxlength="100"
                class={`${inputClass} mt-3`} placeholder={q.substrateTypeOtherPlaceholder} />
            </div>
            <div>
              <label for="q-substrate-size" class={labelClass}>{q.substrateSize} <span class="text-danger">*</span></label>
              <select id="q-substrate-size" name="substrateSize" required class={selectClass}>
                <option value="" disabled selected>{q.substrateSizePlaceholder}</option>
                {sizeOpts.map((s) => <option value={s.value}>{s.label}</option>)}
                <option value="__other__">{q.substrateSizeOther}</option>
              </select>
              <input id="q-substrate-size-other" name="substrateSizeOther" type="text" hidden maxlength="100"
                class={`${inputClass} mt-3`} placeholder={q.substrateSizeOtherPlaceholder} />
            </div>
          </div>
          <!-- 박막 증착 여부 — 기판 종류·크기 바로 아래 전체 폭 한 줄.
               선택 순서는 '있음 → 없음', 기본 선택은 '없음'이다. -->
          <div>
            <span class={labelClass}>{q.preFilm} <span class="text-danger">*</span></span>
            <div id="q-prefilm-group" class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
              <label for="q-prefilm-yes" class="flex items-center gap-2 text-sm text-ink/70">
                <input id="q-prefilm-yes" type="radio" name="preFilm" value="1"
                  class="h-4 w-4 border-ink/30 text-accent" />
                {q.preFilmYes}
              </label>
              <label for="q-prefilm-no" class="flex items-center gap-2 text-sm text-ink/70">
                <input id="q-prefilm-no" type="radio" name="preFilm" value="0" checked
                  class="h-4 w-4 border-ink/30 text-accent" />
                {q.preFilmNone}
              </label>
            </div>
          </div>
          <!-- '있음'일 때만 펼쳐지는 자유 입력. 라디오 묶음의 자식이 아니라 기판 정보 섹션의
               **독립 필드 그룹**이라, 위 space-y-6 이 다른 필드 그룹과 같은 간격을 준다.
               hidden 이면 display:none 이라 그 간격도 함께 사라진다(빈 여백이 남지 않는다). -->
          <div id="q-prefilm-wrap" hidden>
            <label for="q-prefilm-note" class={labelClass}>{q.preFilmNote} <span class="text-danger">*</span></label>
            <textarea id="q-prefilm-note" name="preFilmNote" rows="3" maxlength="1000"
              class={inputClass} placeholder={q.preFilmNotePlaceholder}></textarea>
          </div>
          <div>
            <label for="q-delivery" class={labelClass}>{q.delivery} <span class="text-danger">*</span></label>
            <select id="q-delivery" name="delivery" required class={selectClass}>
              <option value="" disabled selected>{q.deliveryPlaceholder}</option>
              {deliveryOpts.map((m) => <option value={m.value}>{m.label}</option>)}
            </select>
            <!-- '구매 요청'을 고르면 기판을 보내지 않는다는 점을 바로 아래에서 알려준다 -->
            <p id="q-delivery-help" hidden class="mt-2 text-sm leading-relaxed text-ink/55">{q.deliveryHelpPurchase}</p>
            <!-- 기판 등급 — 구매 요청 + 등급이 있는 종류(Silicon 계열)일 때만 보이고 필수가 된다.
                 숨을 때는 disabled 라 제출 데이터(FormData)에 들어가지 않는다. -->
            <div id="q-grade-wrap" hidden class="mt-4" data-graded={JSON.stringify(GRADED_SUBSTRATES)}>
              <label for="q-grade" class={labelClass}>{q.grade} <span class="text-danger">*</span></label>
              <select id="q-grade" name="substrateGrade" disabled class={selectClass}>
                <option value="" disabled selected>{q.gradePlaceholder}</option>
                {SUBSTRATE_GRADES.map((g) => <option value={g}>{g}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="q-sample-count" class={labelClass}>{q.sampleCount} <span class="text-danger">*</span></label>
            <input id="q-sample-count" name="sampleCount" type="number" min="1" step="1" required
              class={inputClass} placeholder={q.sampleCountPlaceholder} />
          </div>
        </div>
      </fieldset>
      ) : (
      <fieldset>
        <legend class={legendClass}>{q.sectionQuantity}</legend>
        <div class="mt-6">
          <label for="q-sample-count" class={labelClass}>{q.quantity} <span class="text-danger">*</span></label>
          <input id="q-sample-count" name="sampleCount" type="number" min="1" step="1" required
            class={inputClass} placeholder={q.quantityPlaceholder} />
        </div>
      </fieldset>
      )}

      {simple && (
      <!-- ②-b 배송 주소 — 고정가 상품 주문용. 국제 주소 대응(국가 선택 + 자유 서식 입력) -->
      <fieldset>
        <legend class={legendClass}>{q.sectionShipping}</legend>
        <div class="mt-6 space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-country" class={labelClass}>{q.country} <span class="text-danger">*</span></label>
              <select id="q-country" name="shipCountry" required class={selectClass}>
                <option value="" disabled selected>{q.countryPlaceholder}</option>
                {countryOpts.map((cn) => <option value={cn.value}>{cn.label}</option>)}
                <option value="__other__">{q.countryOther}</option>
              </select>
              <input id="q-country-other" name="shipCountryOther" type="text" hidden
                class={`${inputClass} mt-3`} placeholder={q.countryOtherPlaceholder} />
            </div>
            <div>
              <label for="q-postal" class={labelClass}>{q.postal} <span class="text-danger">*</span></label>
              <input id="q-postal" name="shipPostal" type="text" required class={inputClass} placeholder={q.postalPlaceholder} autocomplete="postal-code" />
            </div>
          </div>
          <div>
            <label for="q-addr1" class={labelClass}>{q.addr1} <span class="text-danger">*</span></label>
            <input id="q-addr1" name="shipAddr1" type="text" required class={inputClass} placeholder={q.addr1Placeholder} autocomplete="address-line1" />
          </div>
          <div>
            <label for="q-addr2" class={labelClass}>{q.addr2}</label>
            <input id="q-addr2" name="shipAddr2" type="text" class={inputClass} placeholder={q.addr2Placeholder} autocomplete="address-line2" />
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-city" class={labelClass}>{q.city} <span class="text-danger">*</span></label>
              <input id="q-city" name="shipCity" type="text" required class={inputClass} placeholder={q.cityPlaceholder} autocomplete="address-level2" />
            </div>
            <div>
              <label for="q-state" class={labelClass}>{q.state}</label>
              <input id="q-state" name="shipState" type="text" class={inputClass} placeholder={q.statePlaceholder} autocomplete="address-level1" />
            </div>
          </div>
        </div>
      </fieldset>
      )}

      {!simple && (
      <>
      <!-- ②-1 배송지 — 기판 전달 방식이 '배송/택배'일 때만 표시 (0216: 웨이퍼 주문과 동일 구성) -->
      <div id="q-ship" hidden data-ship-values={JSON.stringify(shipValues)} class="mt-6 space-y-6 rounded-2xl border border-ink/10 bg-ink/[0.02] p-5">
        <p class="text-sm font-semibold text-ink/70">{isKo ? '배송지' : 'Shipping address'}</p>

        <label class="flex items-center gap-2 text-sm text-ink/70">
          <input id="q-ship-same" type="checkbox" checked class="h-4 w-4 rounded border-ink/30" />
          {isKo ? '주문자와 동일' : 'Same as contact above'}
        </label>

        <div id="q-ship-rec" hidden class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="q-ship-name" class={labelClass}>{isKo ? '수령인' : 'Recipient'} <span class="text-danger">*</span></label>
            <input id="q-ship-name" name="shipName" type="text" maxlength="100" class={inputClass} />
          </div>
          <div>
            <label for="q-ship-phone" class={labelClass}>{isKo ? '수령인 연락처' : 'Recipient phone'} <span class="text-danger">*</span></label>
            <input id="q-ship-phone" name="shipPhone" type="tel" maxlength="40" class={inputClass} />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="q-ship-country" class={labelClass}>{isKo ? '국가' : 'Country'} <span class="text-danger">*</span></label>
            <select id="q-ship-country" name="shipCountry" class={selectClass}>
              {countryOpts.map((cn) => <option value={cn.value} selected={cn.value === 'KR'}>{cn.label}</option>)}
            </select>
            <input type="hidden" id="q-ship-clabel" name="shipCountryLabel" />
          </div>
          <div id="q-ship-other-wrap" hidden>
            <label for="q-ship-other" class={labelClass}>{isKo ? '국가명 직접 입력' : 'Country name'} <span class="text-danger">*</span></label>
            <input id="q-ship-other" name="shipCountryOther" type="text" maxlength="60" class={inputClass} />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-3">
          <div>
            <label for="q-ship-zip" class={labelClass}>{isKo ? '우편번호' : 'Postal code'} <span class="text-danger">*</span></label>
            <input id="q-ship-zip" name="shipZip" type="text" maxlength="20" autocomplete="postal-code" class={inputClass} />
          </div>
          <div class="sm:col-span-2">
            <label for="q-ship-addr1" class={labelClass}>{isKo ? '주소' : 'Address'} <span class="text-danger">*</span></label>
            <input id="q-ship-addr1" name="shipAddr1" type="text" maxlength="200" autocomplete="street-address" class={inputClass} />
          </div>
        </div>
        <div>
          <label for="q-ship-addr2" class={labelClass}>{isKo ? '상세 주소' : 'Address line 2'}</label>
          <input id="q-ship-addr2" name="shipAddr2" type="text" maxlength="200" class={inputClass} />
        </div>
        <div>
          <label for="q-ship-memo" class={labelClass}>{isKo ? '배송 요청사항' : 'Delivery notes'}</label>
          <textarea id="q-ship-memo" name="shipMemo" rows="2" maxlength="300" class={inputClass}></textarea>
        </div>
      </div>

      <script is:inline>
        (() => {
          const $ = (i) => document.getElementById(i);
          const sel = $('q-delivery'), box = $('q-ship');
          if (!sel || !box) return;
          const shipVals = JSON.parse(box.dataset.shipValues || '[]');
          const same = $('q-ship-same'), rec = $('q-ship-rec');
          const country = $('q-ship-country'), otherWrap = $('q-ship-other-wrap');
          const clabel = $('q-ship-clabel');
          const help = $('q-delivery-help');
          // 박막 증착 여부 — '있음'일 때만 자유 입력란을 펼친다.
          const pfYes = $('q-prefilm-yes'), pfWrap = $('q-prefilm-wrap'), pfGroup = $('q-prefilm-group');
          const pfNote = $('q-prefilm-note');
          // 기판 등급 — 구매 요청 + 등급 대상 종류일 때만 표시·활성·필수
          const gradeWrap = $('q-grade-wrap'), grade = $('q-grade'), subType = $('q-substrate-type');
          const graded = gradeWrap ? JSON.parse(gradeWrap.dataset.graded || '[]') : [];
          const setReq = (id, on) => { const el = $(id); if (el) el.required = on; };
          const sync = () => {
            const on = shipVals.includes(sel.value);
            box.hidden = !on;
            // 구매 요청: 기판을 보내지 않으므로 배송지는 숨은 채로 두고 안내만 띄운다.
            if (help) help.hidden = sel.value !== 'purchase';
            if (gradeWrap && grade) {
              const g = sel.value === 'purchase' && !!subType && graded.includes(subType.value);
              gradeWrap.hidden = !g;
              grade.disabled = !g;
              grade.required = g;
              // 값은 지우지 않는다(박막 여부 칸과 같은 원칙 — 되돌렸다 다시 고를 때 복구). 숨으면 disabled 라 제출되지 않는다.
            }
            rec.hidden = same.checked;
            const other = country.value === 'OTHER';
            otherWrap.hidden = !other;
            clabel.value = other ? ($('q-ship-other').value || 'OTHER')
                                 : (country.selectedOptions[0]?.textContent || country.value);
            ['q-ship-zip', 'q-ship-addr1'].forEach((i) => setReq(i, on));
            ['q-ship-name', 'q-ship-phone'].forEach((i) => setReq(i, on && !same.checked));
            setReq('q-ship-other', on && other);

            if (pfWrap && pfYes) {
              const yes = pfYes.checked;
              pfWrap.hidden = !yes;
              if (pfGroup) pfGroup.setAttribute('aria-expanded', yes ? 'true' : 'false');
              // ⚠️ textarea 에 required 를 걸지 않는다. collectIssues 는 숨은 요소도 검사하므로
              //    '없음'으로 되돌렸을 때 보이지도 않는 칸 때문에 제출이 막힌다.
              //    필수 판정은 collectIssues 의 명시적 검사 한 곳에서만 한다(문구도 그쪽이 낸다).
              // '없음'으로 되돌려도 입력값은 지우지 않는다(잘못 눌렀다 되돌릴 때 복구가 안 됐다).
              // 저장으로 나가는 값은 제출 조립(preFilmFields)에서 preFilm=false 면 빈 문자열이 된다.
              if (pfNote) pfNote.setAttribute('aria-required', yes ? 'true' : 'false');
            }
          };
          sel.addEventListener('change', sync);
          same.addEventListener('change', sync);
          country.addEventListener('change', sync);
          $('q-ship-other').addEventListener('input', sync);
          if (pfGroup) pfGroup.addEventListener('change', sync);
          if (subType) subType.addEventListener('change', sync);
          sync();
          // 새로고침·뒤로가기(bfcache)에서 브라우저가 폼 값을 되살리는 시점은 이 스크립트보다 늦다.
          // 그때 한 번 더 맞춰야 라디오 상태와 펼침 상태가 어긋나지 않는다.
          document.addEventListener('DOMContentLoaded', sync);
          window.addEventListener('pageshow', sync);
        })();
      </script>

      <!-- ③ 공정 시퀀스 빌더 (엑셀 대체) — 필수 -->
      <fieldset>
        <legend class={legendClass}>{q.sectionProcess} <span class="text-danger">*</span></legend>
        <p class="mt-4 text-sm leading-relaxed text-ink/50">{q.processIntro}</p>

        <!-- 공정 행이 여기에 동적으로 추가된다 -->
        <div id="q-process-list" class="mt-6 space-y-4"></div>

        <!-- 비어 있을 때 안내 -->
        <p id="q-process-empty" class="mt-6 rounded-lg border border-dashed border-ink/15 py-8 text-center text-sm text-ink/40">{q.processEmpty}</p>

        <button type="button" id="q-process-add"
          class="mt-4 inline-flex items-center gap-2 rounded-lg border border-accent/40 bg-accent/5 px-5 py-2.5 text-sm font-medium text-accent transition hover:bg-accent/10">
          {q.processAdd}
        </button>
        <p class="mt-3 text-xs leading-relaxed text-ink/40">{q.processSampleNote}</p>

        <!-- 직렬화된 시퀀스가 담기는 hidden 필드 (제출용) -->
        <input type="hidden" name="processSequence" id="q-process-sequence" />
      </fieldset>

      <!-- ④ 분석 (선택) -->
      <fieldset>
        <legend class={legendClass}>{q.sectionMeasure}</legend>
        <p class="mt-4 text-sm leading-relaxed text-ink/50">{q.measureIntro}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          {MEASUREMENTS.map((m) => (
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-sm text-ink/80 transition hover:border-accent/40">
              <input type="checkbox" name="measurements" value={m.name}
                class="size-4 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
              {m.name}
            </label>
          ))}
        </div>
      </fieldset>
      </>
      )}

      <!-- ④ 기타 요청 -->
      <fieldset>
        <legend class={legendClass}>{q.sectionEtc}</legend>
        <div class="mt-6 space-y-6">
          {!simple && (
          <div>
            <label for="q-completion" class={labelClass}>{q.completionDate}</label>
            <input id="q-completion" name="completionDate" type="text" maxlength="100" class={inputClass} placeholder={q.completionDatePlaceholder} />
          </div>
          )}
          <div>
            <label for="q-notes" class={labelClass}>{q.notes}</label>
            <textarea id="q-notes" name="notes" rows="4" maxlength="2000" class={`${inputClass} resize-y`} placeholder={q.notesPlaceholder}></textarea>
          </div>
        </div>
      </fieldset>

      <!-- 개인정보 동의 + Turnstile + 제출 -->
      <div class="space-y-6 border-t border-ink/10 pt-8">
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
          <input type="checkbox" name="privacy" required value="agreed"
            class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
          <span>{q.privacy}</span>
        </label>

        {/* Turnstile 봇 검증 위젯 */}
        <div
          class="cf-turnstile"
          data-sitekey={__VANAM_TURNSTILE_SITEKEY__}
          data-theme="auto"
          data-language="auto"
        ></div>

        {/* 다운로드 안내 — '견적 요청서 다운로드'는 전송이 아니라는 점을 버튼 옆에서 분명히 한다 */}
        {!simple && <p id="q-download-hint" class="text-sm leading-relaxed text-ink/45">{q.downloadHint}</p>}
        {/* 자동 견적 스위치가 켜졌을 때만(QuoteEstimate 가 보인다) — 다운로드 안내 대신 '누르면 확인 메일이 간다'만 남긴다 */}
        {!simple && <p id="q-ack-hint" class="text-sm leading-relaxed text-ink/45" hidden>{q.ackHint}</p>}
        {!simple && <QuoteEstimate part="panel" />}

        <div class="flex flex-wrap items-center justify-end gap-4">
          <p id="quote-status" class="mr-auto text-sm" role="status" aria-live="polite"></p>
          {!simple && (
            <button type="button" id="quote-print" class="v-btn-ghost disabled:cursor-not-allowed disabled:opacity-60">{q.downloadSheet}</button>
          )}
          {!simple && <QuoteEstimate part="button" />}
          <button type="submit" id="quote-submit"
            class="v-btn disabled:cursor-not-allowed disabled:opacity-60">
            <span id="quote-submit-label">{simple ? q.submitOrder : q.submit}</span>
          </button>

        </div>

      </div>
    </form>
  </div>
</section>

{/* 공정 행 템플릿 — JS 가 복제해서 사용 */}
<template id="q-process-row-template">
  <div class="q-process-row rounded-xl border border-ink/10 bg-ink/[0.02] p-5">
    <div class="flex items-center justify-between">
      <span class="q-step-label text-xs font-semibold uppercase tracking-wider text-accent"></span>
      <button type="button" class="q-process-remove text-xs font-medium text-ink/40 transition hover:text-danger"></button>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      <div class="md:col-span-1">
        <label class="q-lbl-type block text-xs font-medium text-ink/60"></label>
        <select class="q-row-process mt-1.5 v-input-sm"></select>
      </div>
      <div class="q-material-wrap md:col-span-1">
        <label class="q-lbl-material block text-xs font-medium text-ink/60"></label>
        <select class="q-row-material mt-1.5 v-input-sm"></select>
      </div>
      <div class="q-value-wrap md:col-span-1">
        <label class="q-lbl-value block text-xs font-medium text-ink/60"></label>
        <div class="mt-1.5 flex items-center gap-2">
          <input type="text" inputmode="decimal" maxlength="20" class="q-row-value v-input-sm" />
          <span class="q-row-unit shrink-0 text-sm text-ink/50"></span>
        </div>
      </div>
      <div class="md:col-span-1">
        <label class="q-lbl-etc block text-xs font-medium text-ink/60"></label>
        <input type="text" maxlength="100" class="q-row-etc mt-1.5 v-input-sm" />
      </div>
    </div>
  </div>
</template>

{/* 공정 데이터 (클라이언트 스크립트에서 사용) */}
<script type="application/json" id="q-process-data" is:inline set:html={processData}></script>

{/* 보안 확인 스크립트는 src/lib/turnstile-client.ts 가 붙인다 —
    실패 감지·자동 재시도·안내가 거기 모여 있다. 여기서 직접 부르지 말 것. */}

<script>
  import { initTelInput, applyTelValues } from '../lib/telInput';
  // 입력칸 판정 공통 규칙(견적·주문·문의 같은 규칙) — 남은 '틀림 표시' 지우기 · 보이는 칸만 · 서버와 같은 이메일 규칙
  import { firstFieldIssue, firstInDocument, isShown, msgs, type Issue } from '../lib/form-check';
  // 소재 value 문자열을 만드는 함수는 한 곳뿐이다 — 옵션 파생·CTA 링크·여기(프리필)가 같은 걸 쓴다.
  import { materialValue, formProcessFor } from '../lib/material-value.js';
  // 박막 증착 여부의 저장값 정규화 — 서버 검증·검증 스크립트와 같은 파일을 쓴다.
  import { preFilmFields } from '../lib/quote-fields.js';
  import { showHint, hideHint } from '../lib/formHint';
  // 보안 확인 위젯 — 로드 실패 시 자동 재시도·안내까지 여기서 처리한다
  import { mountTurnstile, resetTurnstile } from '../lib/turnstile-client';
  mountTurnstile();
  // 견적 요청서 — 견적서·주문서와 같은 엑셀 틀(src/lib/doc-excel.js). 완료·조회 화면도 같은 requestDocFrom 을 쓴다.
  import { buildRequestDoc, openDoc, requestDocFrom, ymdLocal } from '../lib/quote-doc';

  // Turnstile 전역 API 타입
  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }

  type MatPair = [string, string]; // [물질명, 분류(Oxide/Nitride/Metal/gas)]
  type ProcessDef = { name: string; materials: MatPair[]; unit: 'nm' | 'min' | null };

  // 분류 → 표시 라벨 (드롭다운 optgroup 제목). 언어에 맞춰 고른다.
  const CAT_LABELS: Record<string, { en: string; ko: string }> = {
    Oxide: { en: 'Oxides', ko: '산화물' },
    Nitride: { en: 'Nitrides', ko: '질화물' },
    Metal: { en: 'Metals', ko: '금속' },
    gas: { en: 'Gases', ko: '가스' },
    // 0907b — 소재 라이브러리에서 파생하며 새로 들어온 분류(Si). 기존 그룹 순서는 건드리지 않고 뒤에 붙인다.
    Semiconductor: { en: 'Semiconductors', ko: '반도체' },
  };
  const CAT_ORDER = ['Oxide', 'Nitride', 'Metal', 'gas', 'Semiconductor'];
  const isKoDoc = () => (document.documentElement.lang || 'en') === 'ko';

  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("quote-status")!;
  const btn = document.getElementById("quote-submit") as HTMLButtonElement;
  const label = document.getElementById("quote-submit-label")!;
  const M = form ? form.dataset : ({} as DOMStringMap);

  // 공정 데이터 로드
  const PROCESSES: ProcessDef[] = JSON.parse(
    document.getElementById("q-process-data")?.textContent || "[]"
  );

  // 라벨(번역) — 폼의 data 속성에서 가져온다
  const L = {
    step: M.lblStep || "Step",
    process: M.lblProcess || "Process",
    processPh: M.lblProcessPh || "Select process",
    material: M.lblMaterial || "Material / Gas",
    materialPh: M.lblMaterialPh || "Select",
    value: M.lblValue || "Thickness / Time",
    etc: M.lblEtc || "Notes",
    etcPh: M.lblEtcPh || "Conditions, etc.",
    remove: M.lblRemove || "Remove",
  };

  // 전화번호 입력에 국가번호 드롭다운 적용
  const qPhoneEl = document.getElementById("q-phone") as HTMLInputElement | null;
  if (qPhoneEl) initTelInput(qPhoneEl, document.documentElement.lang || "en");
  const qShipPhoneEl = document.getElementById("q-ship-phone") as HTMLInputElement | null;
  if (qShipPhoneEl) initTelInput(qShipPhoneEl, document.documentElement.lang || "en");

  function setStatus(msg: string, ok: boolean) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
  }

  // 상단 "견적 요청" 버튼 → 폼으로 스크롤 + 첫 칸 포커스
  document.querySelectorAll("[data-open-quote]").forEach((el) =>
    el.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("quote")?.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => (document.getElementById("q-name") as HTMLInputElement | null)?.focus({ preventScroll: true }), 500);
    }),
  );

  // ── 기판 종류/크기 "기타" 선택 시 직접입력 칸 토글 ──
  // 칸 표시는 **선택값에서만** 정한다 — change · pageshow(뒤로가기 복원) · 검사 직전.
  // 예전에는 change 때만 맞춰서, 뒤로가기로 선택값만 '기타'로 되살아나면 입력칸은 숨은 채 남았다(10-12 점검).
  const OTHER_PAIRS: [string, string][] = [
    ["q-substrate-type", "q-substrate-type-other"],
    ["q-substrate-size", "q-substrate-size-other"],
    ["q-country", "q-country-other"],   // 배송 국가 "기타" (simple 폼 전용 — 없으면 no-op)
  ];
  function syncOther(selectId: string, otherId: string, clearWhenOff: boolean) {
    const sel = document.getElementById(selectId) as HTMLSelectElement | null;
    const other = document.getElementById(otherId) as HTMLInputElement | null;
    if (!sel || !other) return;
    const isOther = sel.value === "__other__";
    other.hidden = !isOther;
    if (!isOther && clearWhenOff) other.value = "";
  }
  for (const [s, o] of OTHER_PAIRS) {
    document.getElementById(s)?.addEventListener("change", () => syncOther(s, o, true));
  }
  const syncOthers = () => { for (const [s, o] of OTHER_PAIRS) syncOther(s, o, false); };
  window.addEventListener("pageshow", syncOthers);
  syncOthers();

  // ── 공정 시퀀스 빌더 ──────────────────────────────
  // 단일 상품(simple) 폼에는 이 요소들이 없다 → 옵셔널 처리
  const listEl = document.getElementById("q-process-list");
  const emptyEl = document.getElementById("q-process-empty");
  const addBtn = document.getElementById("q-process-add");
  const tmpl = document.getElementById("q-process-row-template") as HTMLTemplateElement | null;
  const seqInput = document.getElementById("q-process-sequence") as HTMLInputElement | null;

  function refreshStepLabels() {
    if (!listEl) return;
    const rows = listEl.querySelectorAll(".q-process-row");
    rows.forEach((row, i) => {
      const lbl = row.querySelector(".q-step-label") as HTMLElement;
      if (lbl) lbl.textContent = `${L.step} ${i + 1}`;
    });
    if (emptyEl) emptyEl.hidden = rows.length > 0;
  }

  // 공정 선택 시 물질 드롭다운 + 단위 + 값 입력 노출을 그 공정에 맞게 바꾼다
  function applyProcess(row: HTMLElement) {
    const procSel = row.querySelector(".q-row-process") as HTMLSelectElement;
    const matSel = row.querySelector(".q-row-material") as HTMLSelectElement;
    const matWrap = row.querySelector(".q-material-wrap") as HTMLElement;
    const valWrap = row.querySelector(".q-value-wrap") as HTMLElement;
    const unitEl = row.querySelector(".q-row-unit") as HTMLElement;
    const def = PROCESSES.find((p) => p.name === procSel.value);
    if (!def) return;

    if (def.materials.length > 0) {
      matWrap.hidden = false;
      const ko = isKoDoc();
      // 물질을 분류별로 묶는다. 실제 존재하는 분류만, 정해진 순서로.
      const groups = new Map<string, string[]>();
      for (const [mat, cat] of def.materials) {
        if (!groups.has(cat)) groups.set(cat, []);
        groups.get(cat)!.push(mat);
      }
      const cats = CAT_ORDER.filter((c) => groups.has(c));
      let html = `<option value="" disabled selected>${L.materialPh}</option>`;
      // 분류가 2개 이상이면 optgroup 으로 묶고, 1개뿐이면 그냥 나열
      if (cats.length > 1) {
        html += cats
          .map((cat) => {
            const lbl = CAT_LABELS[cat] ? (ko ? CAT_LABELS[cat].ko : CAT_LABELS[cat].en) : cat;
            const opts = groups.get(cat)!.map((m) => `<option value="${m}">${m}</option>`).join("");
            return `<optgroup label="${lbl}">${opts}</optgroup>`;
          })
          .join("");
      } else {
        html += def.materials.map(([m]) => `<option value="${m}">${m}</option>`).join("");
      }
      matSel.innerHTML = html;
    } else {
      matWrap.hidden = true;
      matSel.innerHTML = "";
    }

    if (def.unit) {
      valWrap.hidden = false;
      unitEl.textContent = def.unit;
    } else {
      valWrap.hidden = true;
    }
  }

  // 공정 행 상한 — 요청 내용이 서버 길이 상한(api/inquiry.ts)을 넘지 않게 한다(조용히 잘리던 문제 · 10-12).
  const MAX_ROWS = 30;
  function addRow() {
    if (!tmpl || !listEl) return;
    if (listEl.querySelectorAll(".q-process-row").length >= MAX_ROWS) {
      if (addBtn) showHint(addBtn as HTMLElement, M.msgMaxRows || "");
      return;
    }
    const frag = tmpl.content.cloneNode(true) as DocumentFragment;
    const row = frag.querySelector(".q-process-row") as HTMLElement;

    (row.querySelector(".q-lbl-type") as HTMLElement).textContent = L.process;
    (row.querySelector(".q-lbl-material") as HTMLElement).textContent = L.material;
    (row.querySelector(".q-lbl-value") as HTMLElement).textContent = L.value;
    (row.querySelector(".q-lbl-etc") as HTMLElement).textContent = L.etc;
    (row.querySelector(".q-row-etc") as HTMLInputElement).placeholder = L.etcPh;
    (row.querySelector(".q-process-remove") as HTMLElement).textContent = L.remove;

    const procSel = row.querySelector(".q-row-process") as HTMLSelectElement;
    procSel.innerHTML =
      `<option value="" disabled selected>${L.processPh}</option>` +
      PROCESSES.map((p) => `<option value="${p.name}">${p.name}</option>`).join("");

    procSel.addEventListener("change", () => applyProcess(row));

    (row.querySelector(".q-process-remove") as HTMLElement).addEventListener("click", () => {
      row.remove();
      refreshStepLabels();
    });

    listEl.appendChild(row);
    refreshStepLabels();
  }

  addBtn?.addEventListener("click", addRow);

  // ── 소재 라이브러리 → 견적 폼 프리필 (0907b) ──────────────────
  // 소재 라이브러리·상세의 "이 물질로 견적 문의" 링크가
  // ?material=BaTiO3&system=sputter#quote 형태로 넘어온다.
  // 채우는 것은 Step 1 의 공정·소재 두 칸뿐 — 두께·시간은 사람이 정할 값이라 비워 둔다.
  // 파라미터가 없거나, 이 페이지의 선택지에 없는 값이면 아무 일도 하지 않는다
  // (주소창으로 임의 문구를 심지 못하게. 행도 남기지 않아 진입 상태가 빈 폼 그대로다).
  (function prefillMaterial() {
    if (!form || !listEl || !tmpl) return;   // 단일 상품(simple) 폼에는 시퀀스 빌더가 없다
    const q = new URLSearchParams(location.search);
    const rawMat = (q.get('material') ?? '').trim();
    if (!rawMat) return;
    // 라이브러리 system(+물질) → 폼 공정 이름. Ag·Te 처럼 라이브러리에선 sputter 지만 폼에선
    // Evaporator 로 받는 물질도 여기서 갈린다. 규칙은 material-value.js 한 곳(소재 JSON 을 끌고 오지 않는 파일).
    const procName = formProcessFor(q.get('system') ?? '', rawMat);
    const want = materialValue(rawMat);

    addRow();
    const rows = listEl.querySelectorAll<HTMLElement>('.q-process-row');
    const row = rows[rows.length - 1];
    if (!row) return;
    const drop = () => { row.remove(); refreshStepLabels(); };

    const procSel = row.querySelector('.q-row-process') as HTMLSelectElement;
    // 이 제품 페이지에 그 공정이 없으면(필터로 빠졌거나 system 이 이상하면) 되돌린다
    if (!procName || !Array.from(procSel.options).some((o) => o.value === procName)) return drop();
    procSel.value = procName;
    applyProcess(row);

    const matSel = row.querySelector('.q-row-material') as HTMLSelectElement;
    // 옵션에 실제로 있을 때만 대입한다. 없으면 행째로 걷어낸다(행 0개 = 진입 전 상태).
    if (!Array.from(matSel.options).some((o) => o.value === want)) return drop();
    matSel.value = want;
  })();

  // 제출 시: 시퀀스를 사람이 읽을 텍스트 + 구조화 JSON 으로
  function collectSequence(): { text: string; json: any[] } {
    if (!listEl) return { text: "", json: [] };
    const rows = listEl.querySelectorAll(".q-process-row");
    const json: any[] = [];
    const lines: string[] = [];
    rows.forEach((row, i) => {
      const proc = (row.querySelector(".q-row-process") as HTMLSelectElement).value;
      if (!proc) return;
      const matSel = row.querySelector(".q-row-material") as HTMLSelectElement;
      const mat = matSel && !(row.querySelector(".q-material-wrap") as HTMLElement).hidden ? matSel.value : "";
      const valInput = row.querySelector(".q-row-value") as HTMLInputElement;
      const val = valInput && !(row.querySelector(".q-value-wrap") as HTMLElement).hidden ? valInput.value.trim() : "";
      const unit = (row.querySelector(".q-row-unit") as HTMLElement).textContent || "";
      const etc = (row.querySelector(".q-row-etc") as HTMLInputElement).value.trim();

      json.push({ step: i + 1, process: proc, material: mat, value: val, unit: val ? unit : "", etc });

      let line = `${i + 1}. ${proc}`;
      if (mat) line += ` | ${mat}`;
      if (val) line += ` | ${val}${unit}`;
      if (etc) line += ` | ${etc}`;
      lines.push(line);
    });
    return { text: lines.join("\n"), json };
  }

  // ── 버튼 ──────────────────────────────────────────
  // 0221: 두 버튼은 상시 활성이고, 막히는 사유는 누를 때 그 자리 말풍선으로 안내한다.
  // ⚠️ 10-12: 예전 '게이트'는 1초마다 입력칸을 checkValidity() 로 검사했다(결과는 쓰지도 않았다).
  //    그 호출이 빈 필수 칸에 '틀림 표시'를 붙였고, 그 칸이 나중에 숨으면(택배 → 방문 전달) 표시가 남아
  //    제출이 영영 막혔다. 또 1초마다 [견적 요청하기]를 다시 열어 전송 중 두 번 눌리는 틈도 있었다.
  //    → 주기 검사를 없앴다. 검사는 누를 때 한 번, src/lib/form-check.ts 공통 규칙으로만 한다.
  // ⚠️ printBtn 은 여기서 선언한다. 사용처보다 아래에서 선언하면 TDZ 로 스크립트가 통째로 죽는다(전례 있음).
  const submitBtn = document.getElementById("quote-submit") as HTMLButtonElement | null;
  const printBtn = document.getElementById("quote-print") as HTMLButtonElement | null;
  if (submitBtn) submitBtn.disabled = false;
  if (printBtn) printBtn.disabled = false;

  const tokenOk = () =>
    Boolean((form?.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value);

  // 단계 안내 문구 — {n} 자리에 단계 번호(예전 문구는 앞에 번호만 붙였다: 영문이 '2st step' 으로 나왔다)
  const stepMsg = (tpl: string | undefined, n: number) =>
    (tpl ?? "").includes("{n}") ? (tpl ?? "").replace("{n}", String(n)) : `${n}${tpl ?? ""}`;

  // 0222: 검증 단일화 — 폼 위→아래 "첫 문제 지점" 하나만 골라, 그 자리에서 말풍선으로 알린다.
  //   입력칸 판정은 공통 규칙(firstFieldIssue — 남은 표시를 지우고 지금 규칙으로 · 보이는 칸만 ·
  //   서버와 같은 이메일 규칙 · 공백만 입력 금지). 여기서는 그 규칙으로 못 보는 것만 더한다:
  //   공정 행 · 박막 메모 · '기타 (직접 입력)' · 보안 확인.
  function collectIssues(forSubmit: boolean): Issue | null {
    if (!form) return null;
    syncOthers();
    const cands: Issue[] = [];
    // 다운로드는 서버로 보내지 않으므로 개인정보 동의는 보지 않는다
    const f = firstFieldIssue(form, (el) => !forSubmit && el.name === "privacy");
    if (f) cands.push(f);
    if (!M.simple && listEl) {
      const rows = Array.from(listEl.querySelectorAll(".q-process-row")) as HTMLElement[];
      if (rows.length === 0) {
        cands.push({ el: listEl as HTMLElement, msg: M.msgNoprocess });
      } else {
        // 행 단위 미입력도 같은 게이트에서 — 요청·다운로드 동작을 일치시킨다
        rows.forEach((row, i) => {
          const proc = row.querySelector(".q-row-process") as HTMLSelectElement | null;
          if (proc && !proc.value) { cands.push({ el: proc, msg: stepMsg(M.msgSeqProcess, i + 1) }); return; }
          const matWrap = row.querySelector(".q-material-wrap") as HTMLElement | null;
          const matSel = row.querySelector(".q-row-material") as HTMLSelectElement | null;
          if (matWrap && !matWrap.hidden && matSel && !matSel.value) { cands.push({ el: matSel, msg: stepMsg(M.msgSeqMaterial, i + 1) }); return; }
          const valWrap = row.querySelector(".q-value-wrap") as HTMLElement | null;
          const valInput = row.querySelector(".q-row-value") as HTMLInputElement | null;
          if (valWrap && !valWrap.hidden && valInput && !valInput.value.trim()) cands.push({ el: valInput, msg: stepMsg(M.msgSeqValue, i + 1) });
        });
      }
    }
    // 박막 증착 여부 '있음'인데 내용이 비어 있으면 차단. (textarea 에 required 를 걸지 않는 이유는
    //  위 토글 스크립트 주석 참고 — 숨은 칸이 조용히 제출을 막는 사고를 피한다)
    if (!M.simple) {
      const pfYes = document.getElementById("q-prefilm-yes") as HTMLInputElement | null;
      const pfNote = document.getElementById("q-prefilm-note") as HTMLTextAreaElement | null;
      if (pfYes?.checked && pfNote && !pfNote.value.trim())
        cands.push({ el: pfNote as unknown as HTMLElement, msg: M.msgPrefilm });
    }
    // '기타 (직접 입력)'을 골랐으면 그 칸이 비면 안 된다(비면 기판 정보가 통째로 빠진 채 접수됐다 — 10-12).
    // 같은 이유로 required 는 걸지 않는다(숨은 칸 사고) — 여기서 선택값을 보고 판정한다.
    for (const [s, o] of OTHER_PAIRS) {
      const sel = document.getElementById(s) as HTMLSelectElement | null;
      const other = document.getElementById(o) as HTMLInputElement | null;
      if (sel && other && sel.value === "__other__" && isShown(other) && !other.value.trim())
        cands.push({ el: other, msg: M.msgOther });
    }
    if (forSubmit && !tokenOk())
      cands.push({ el: form.querySelector(".cf-turnstile") as HTMLElement | null, msg: M.msgCaptcha });
    return firstInDocument(cands);
  }
  // 0224: 안내는 자체 팁 "하나"로만 — 크롬 네이티브 말풍선(reportValidity)은 스크롤 중 닫힌다.
  // 0225: 안내는 공통 모듈(formHint)로 — 레이아웃에 영향 없는 고정 오버레이 1개.
  //       말풍선 위치는 formHint 가 정한다(감싼 label → 칸 → 화면에 보이는 조상 — 숨은 칸이면 구석에 뜨지 않게).
  function flagInvalid(issue: Issue) {
    const el = issue.el;
    if (!el) return;
    showHint(el, issue.msg || M.msgRequired || "", el);
  }

  // 견적 내용 조립 — '견적 요청'(서버 전송)과 '장바구니에 추가'(브라우저 저장)가 **같은 함수**를 쓴다.
  // 두 곳에 따로 짜두면 한쪽만 고쳐져 화면과 실제 전송 내용이 어긋난다(같은 부류 사고 다수).
  // 검증에 걸리면 상태 문구를 띄우고 null 을 돌려준다.
  function buildQuote(): { data: Record<string, string>; lines: { l: string; v: string }[] } | null {
    // 미끼칸이 차 있어도 조용히 가짜 성공을 띄우지 않는다.
    // 브라우저 자동완성이 채우는 오탐이 흔해서(이름에 email 이 들어가면 특히),
    // 실제 고객의 견적이 "접수된 척"만 하고 서버·관리자에 도달하지 못했다.
    // 값만 비우고 정상 진행한다 — 직접 POST 하는 봇은 서버측 미끼칸 검사와 Turnstile 이 막는다.
    const hp = form.elements.namedItem("vanam_hp_note") as HTMLInputElement | null;
    if (hp) hp.value = "";

    // details 라벨 로캘 — 이 텍스트는 고객의 완료 페이지·요청서 PDF·주문 조회에 그대로 노출되므로
    // 페이지 언어를 따른다. (기존엔 한국어 고정이라 영문 제출에도 [공정 시퀀스] 등이 섞였다)
    const isKoDoc = document.documentElement.lang === "ko";
    const DL = isKoDoc
      ? { qty: "수량", shipHdr: "[배송 주소]", country: "국가", addr: "주소", cityState: "도시/주", postal: "우편번호",
          notes: "요청사항", seqHdr: "[공정 시퀀스]", analysis: "[분석]", delivery: "기판 전달",
          samples: "총 샘플 수량", due: "완료 희망일", caution: "주의사항", recip: "수령인", shipMemo: "배송 요청", secSub: "[기판 정보]", subLbl: "기판",
          preFilm: "박막 증착 여부", preFilmNone: "없음", preFilmYes: "있음" }
      : { qty: "Quantity", shipHdr: "[Shipping address]", country: "Country", addr: "Address", cityState: "City/State", postal: "Postal code",
          notes: "Notes", seqHdr: "[Process sequence]", analysis: "[Analysis]", delivery: "Substrate delivery",
          samples: "Total samples", due: "Target completion", caution: "Notes", recip: "Recipient", shipMemo: "Delivery notes", secSub: "[Substrate info]", subLbl: "Substrate",
          preFilm: "Existing thin film on sample", preFilmNone: "No", preFilmYes: "Yes" };

    const isSimple = !!M.simple;
    { const bad = collectIssues(false); if (bad) { flagInvalid(bad); return null; } }

    // 공정 시퀀스 (최소 1개) — 단일 상품(simple)은 공정이 없으므로 건너뛴다
    const seq = collectSequence();
    if (!isSimple && seq.json.length === 0) {
      flagInvalid({ el: listEl as HTMLElement | null, msg: M.msgNoprocess });
      return null;
    }
    // 행을 추가만 하고 내용을 비워두는 경우가 많다.
    // 화면에 보이는 입력칸(물질·수치)은 모두 채워야 한다. '기타 조건'은 선택 사항이다.
    if (!isSimple && listEl) {
      const rows = Array.from(listEl.querySelectorAll<HTMLElement>('.q-process-row'));
      for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const proc = (row.querySelector('.q-row-process') as HTMLSelectElement)?.value ?? '';
        if (!proc) { flagInvalid({ el: row.querySelector('.q-row-process') as HTMLElement | null, msg: stepMsg(M.msgSeqProcess, i + 1) }); return null; }
        const matWrap = row.querySelector('.q-material-wrap') as HTMLElement | null;
        const matSel = row.querySelector('.q-row-material') as HTMLSelectElement | null;
        if (matWrap && !matWrap.hidden && matSel && !matSel.value) {
          flagInvalid({ el: matSel as unknown as HTMLElement, msg: stepMsg(M.msgSeqMaterial, i + 1) }); return null;
        }
        const valWrap = row.querySelector('.q-value-wrap') as HTMLElement | null;
        const valInput = row.querySelector('.q-row-value') as HTMLInputElement | null;
        if (valWrap && !valWrap.hidden && valInput && !valInput.value.trim()) {
          flagInvalid({ el: valInput as unknown as HTMLElement, msg: stepMsg(M.msgSeqValue, i + 1) }); return null;
        }
      }
    }
    if (seqInput) seqInput.value = JSON.stringify(seq.json);

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    // 전화번호 제출값 — 번호 규칙으로 확인된 것만 국제표준(+82…), 아니면 쓴 그대로. 입력칸은 바꾸지 않는다(telInput.ts).
    applyTelValues(form, data);
    delete data.vanam_hp_note;

    if (data.substrateType === "__other__") data.substrateType = (data.substrateTypeOther || "").trim();
    if (data.substrateSize === "__other__") data.substrateSize = (data.substrateSizeOther || "").trim();
    delete data.substrateTypeOther;
    delete data.substrateSizeOther;

    // 크기/전달 코드값 → 사람이 읽는 라벨로 변환(알림용). 사용자가 고른 언어 라벨을 쓴다.
    const sizeMap: Record<string, string> = JSON.parse(M.mapSize || "{}");
    const deliveryMap: Record<string, string> = JSON.parse(M.mapDelivery || "{}");
    const sizeLabel = sizeMap[data.substrateSize] || data.substrateSize || "";
    const deliveryLabel = deliveryMap[data.delivery] || data.delivery || "";
    // 기판 등급 — 칸이 켜져 있을 때만 FormData 에 들어온다. 기판 표기(data.substrate)와 구조화 사본에만 쓴다.
    const substrateGrade = String(data.substrateGrade ?? "");
    delete data.substrateGrade;

    // 박막 증착 여부 — 라디오 값('1'/'0') → boolean, '없음'이면 메모는 빈 문자열.
    // 화면에서는 값을 지우지 않으므로(되돌려도 입력 보존) **여기가 저장값을 정하는 유일한 지점**이다.
    // 규칙은 quote-fields.js 에 두어 서버 검증·게이트가 같은 함수를 본다.
    const { preFilm, preFilmNote } = preFilmFields(data.preFilm, data.preFilmNote);
    const preFilmLabel = preFilm ? DL.preFilmYes : DL.preFilmNone;
    delete data.preFilm;
    delete data.preFilmNote;

    // 분석 항목(체크박스 다중) 수집
    const measures = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="measurements"]:checked')).map((el) => el.value);

    // 배송지(0217) — details 뿐 아니라 아래 detailsJson·요약 lines 에서도 쓴다.
    // 분기 안에서 const 로 잡으면 블록 밖(요약 lines)에서 ReferenceError 라 여기서 선언한다.
    let shipBlock: string[] = [];
    let shipAddrQ = "", shipRecip = "", shipRecPh = "";
    let shipKeep = { zip: "", country: "", memo: "" };

    if (isSimple) {
      // 단일 상품(고정가 주문): 수량 + 배송 주소 + 메모를 details 로 정리
      const countryMap: Record<string, string> = JSON.parse(M.mapCountry || "{}");
      const shipCountry = data.shipCountry === "__other__"
        ? String(data.shipCountryOther || "").trim()
        : (countryMap[String(data.shipCountry)] || String(data.shipCountry || ""));
      const shipAddr = [data.shipAddr1, data.shipAddr2].filter(Boolean).join(", ");
      const shipCityLine = [data.shipCity, data.shipState].filter(Boolean).join(" / ");
      data.material = M.productName || "Product request";
      data.substrate = "";
      data.details = [
        data.sampleCount ? `${DL.qty}: ${data.sampleCount}` : "",
        "\n" + DL.shipHdr,
        shipCountry ? `${DL.country}: ${shipCountry}` : "",
        shipAddr ? `${DL.addr}: ${shipAddr}` : "",
        shipCityLine ? `${DL.cityState}: ${shipCityLine}` : "",
        data.shipPostal ? `${DL.postal}: ${data.shipPostal}` : "",
        data.notes ? `\n${DL.notes}: ${data.notes}` : "",
      ].filter(Boolean).join("\n");
      delete data.shipCountry; delete data.shipCountryOther;
      delete data.shipAddr1; delete data.shipAddr2;
      delete data.shipCity; delete data.shipState; delete data.shipPostal;
    } else {
      // 서버 호환: 시퀀스 텍스트를 details 에, 대표 물질을 material 에
      //   대표 소재 = "증착 공정"(nm 단위)의 물질만 — 세정 가스(Ar 등)가 소재로 잡히던 문제 수정
      const depSet = new Set(JSON.parse(M.depProcesses || "[]") as string[]);
      const uniq = (xs: string[]) => [...new Set(xs)];
      const depRows = seq.json.filter((s) => depSet.has(s.process) && s.material);
      data.material = uniq(depRows.map((s) => s.material as string)).join(", ")
        || seq.json.find((s) => s.material)?.material
        || seq.json[0]?.process
        || "Process request";
      data.method = uniq(depRows.map((s) => s.process)).join(", ");
      data.substrate = [data.substrateType, sizeLabel, substrateGrade].filter(Boolean).join(" / ");
      // 배송지(0217) — 전달 방식이 배송형일 때만. '주문자와 동일'이면 상단 연락처로 폴백.
      const shipOn = !(document.getElementById("q-ship") as HTMLElement | null)?.hidden;
      const shipSame = (document.getElementById("q-ship-same") as HTMLInputElement | null)?.checked ?? true;
      shipAddrQ = [data.shipAddr1, data.shipAddr2].filter(Boolean).join(", ");
      shipRecip = shipOn ? String((shipSame ? data.name : data.shipName) ?? "") : "";
      shipRecPh = shipOn ? String((shipSame ? data.phone : data.shipPhone) ?? "") : "";
      shipKeep = { zip: String(data.shipZip ?? ""), country: String(data.shipCountryLabel ?? ""), memo: String(data.shipMemo ?? "") };
      shipBlock = shipOn && data.shipAddr1 ? [
        DL.shipHdr,
        shipKeep.country ? `${DL.country}: ${shipKeep.country}` : "",
        `${DL.recip}: ${shipRecip}${shipRecPh ? ` \u00b7 ${shipRecPh}` : ""}`,
        `${DL.addr}: ${shipAddrQ}`,
        shipKeep.zip ? `${DL.postal}: ${shipKeep.zip}` : "",
        shipKeep.memo ? `${DL.shipMemo}: ${shipKeep.memo}` : "",
      ].filter(Boolean) : [];
      // 0221: 폼 입력 순서 그대로, [섹션] 헤더 + 섹션 사이 빈 줄. 산출 로직(material/method 등)은 불변.
      const shipSec = shipBlock.length ? ["\n" + shipBlock[0], ...shipBlock.slice(1)] : [];
      data.details = [
        DL.secSub,
        data.substrate ? `${DL.subLbl}: ${data.substrate}` : "",
        deliveryLabel ? `${DL.delivery}: ${deliveryLabel}` : "",
        data.sampleCount ? `${DL.samples}: ${data.sampleCount}` : "",
        data.completionDate ? `${DL.due}: ${data.completionDate}` : "",
        `${DL.preFilm}: ${preFilmLabel}`,
        preFilmNote,
        ...shipSec,
        "\n" + DL.seqHdr,
        seq.text,
        measures.length ? `\n${DL.analysis} ${measures.join(", ")}` : "",
        data.notes ? `\n${DL.caution}: ${data.notes}` : "",
      ].filter(Boolean).join("\n");
      delete data.shipZip; delete data.shipAddr1; delete data.shipAddr2;
      delete data.shipCountry; delete data.shipCountryOther; delete data.shipCountryLabel;
      delete data.shipName; delete data.shipPhone; delete data.shipMemo;
    }

    data.type = "quote";
    data.product = M.product!;
    data.productName = M.productName!;
    data.locale = document.documentElement.lang || "en";

    // ── 조회 화면에서 '보는 언어'로 다시 그리기 위한 구조화 사본 ──────────────
    // details 는 사람이 읽는 문장이라 **작성한 언어로 굳는다**. 알림·관리자에는 그게 낫지만,
    // 한국어로 넣은 견적을 영문 화면에서 조회하면 라벨과 선택지가 한글로 남는다.
    // → 라벨을 붙이기 **전의 값**(공정 시퀀스·분석·전달 코드·기판 코드)을 그대로 함께 보낸다.
    //   자유 입력(완료 희망일·요청사항)은 고객이 쓴 그대로 두고 번역하지 않는다.
    if (!isSimple) {
      data.detailsJson = JSON.stringify({
        v: 1,
        seq: seq.json,
        measures,
        delivery: String(data.delivery ?? ""),            // 코드값(courier·direct)
        substrateType: String(data.substrateType ?? ""),  // 영문 또는 직접 입력
        substrateSize: String(data.substrateSize ?? ""),  // 코드값(4inch 등) 또는 직접 입력
        substrateGrade,                                    // Test·Prime 또는 '' (구매 요청 + Silicon 계열일 때만)
        sampleCount: String(data.sampleCount ?? ""),
        preFilm,                                           // 박막 증착 여부(boolean)
        preFilmNote,                                       // 자유 입력 — 그대로

        completionDate: String(data.completionDate ?? ""), // 자유 입력 — 그대로
        notes: String(data.notes ?? ""),                   // 자유 입력 — 그대로
        ship: shipBlock.length ? {                          // 배송지(0217) — 조회 화면 언어 재구성용
          country: shipKeep.country, name: shipRecip, phone: shipRecPh,
          zip: shipKeep.zip, addr: shipAddrQ, memo: shipKeep.memo,
        } : null,
      });
    }

    // 요청 내용 요약 — 화면·요청서에 그대로 쓰인다. (저장하지 않고 그때그때 만든다)
    const lines = [
      { l: M.lblMaterial2 || 'Material', v: String(data.material ?? '') },
      { l: M.lblMethod2 || 'Process', v: String(data.method ?? '') },
      { l: M.lblSubstrate2 || 'Substrate', v: String(data.substrate ?? '') },
      { l: DL.samples, v: String(data.sampleCount ?? '') },
      { l: DL.seqHdr.replace(/[[\]]/g, ''), v: seq.text },
      { l: DL.analysis.replace(/[[\]]/g, ''), v: measures.join(', ') },
      { l: DL.delivery, v: deliveryLabel },
      // 단일 상품(고정가 주문)에는 없는 항목이라 요약·요청서에서도 빼야 한다(빈 값은 아래 filter 가 지운다).
      { l: DL.preFilm, v: isSimple ? "" : (preFilmNote ? `${preFilmLabel} — ${preFilmNote}` : preFilmLabel) },
      { l: DL.shipHdr.replace(/[[\]]/g, ''), v: shipBlock.slice(1).join('\n') },
      { l: DL.due, v: String(data.completionDate ?? '') },
      { l: DL.caution, v: String(data.notes ?? '') },
    ].filter((x) => x.v.trim());

    return { data, lines };
  }

  // 견적 요청서 데이터 — [견적 요청서 다운로드](접수 전, id 없음)와 완료 화면(접수 후)이 **같은 함수**로 만든다.
  // 조회 화면도 저장된 구조화 사본(details_json)으로 같은 함수를 부른다(src/lib/doc-excel.js requestDocFrom).
  function requestDoc(d: Record<string, string>, id: string) {
    let dj: unknown = null;
    try { dj = JSON.parse(d.detailsJson || "null"); } catch { dj = null; }
    return requestDocFrom({
      lang: document.documentElement.lang === "ko" ? "ko" : "en",
      id, draft: !id, date: ymdLocal(),
      requester: { company: d.company, name: d.name, phone: d.phone, email: d.email },
      product: String(d.productName ?? ""),
      dj, detailsText: String(d.details ?? ""),
      sizeMap: JSON.parse(M.mapSize || "{}"), deliveryMap: JSON.parse(M.mapDelivery || "{}"),
      supportEmail: M.sheetMail || "",
    });
  }

  // 서버가 거절한 이유를 고객이 고칠 수 있는 말로 — 예전에는 400·429·502 모두 '잠시 후 다시'뿐이라
  // 이메일 오타처럼 다시 해도 안 되는 경우에도 같은 말을 반복했다(10-12 점검). 문구는 site.json contact.form.errors.
  const ERR = (() => { try { return JSON.parse(M.err || "{}") as Record<string, string>; } catch { return {} as Record<string, string>; } })();
  function failText(status: number, j: { error?: string; retryAfterSec?: number }): string {
    const code = String(j?.error ?? "");
    if (status === 429 || code === "rate_limited") {
      const min = Math.max(1, Math.ceil(Number(j?.retryAfterSec || 600) / 60));
      return (ERR.rateLimited || M.msgError || "").replace("{min}", String(min));
    }
    if (code === "captcha_failed") return ERR.captcha || M.msgCaptcha || "";
    if (code === "too_long") return ERR.tooLong || M.msgError || "";
    if (status === 400 && code) return ERR.check || M.msgRequired || "";
    return ERR.fail || M.msgError || "";
  }

  let sending = false; // 전송 중 두 번 눌러 같은 견적이 두 번 접수되지 않게
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending) return;
    setStatus("", true);
    hideHint();
    { const bad = collectIssues(true); if (bad) { flagInvalid(bad); return; } }
    const built = buildQuote();
    if (!built) return;
    const data = built.data;

    if (!data["cf-turnstile-response"]) {
      flagInvalid({ el: form?.querySelector(".cf-turnstile") as HTMLElement | null, msg: M.msgCaptcha });
      return;
    }

    sending = true;
    btn.disabled = true;
    label.textContent = M.labelSending!;
    setStatus("", true);
    // 완료 화면으로 떠나는 중에는 버튼을 다시 열지 않는다 — 이동이 끝나기 전 한 번 더 눌려 같은 견적이 또 접수되지 않게
    let leaving = false;

    try {
      let res: Response;
      try {
        res = await fetch("/api/inquiry", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(data),
        });
      } catch (netErr) {
        // 네트워크 자체가 끊긴 경우 — 서버에 닿지 않았다
        console.error(netErr);
        resetTurnstile();
        setStatus(ERR.fail || M.msgError!, false);
        return;
      }
      const j = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; retryAfterSec?: number; id?: string; quote?: boolean; ack?: boolean };
      if (!res.ok || j.ok === false) {
        resetTurnstile(); // 토큰은 1회용 — 다시 보낼 수 있게 새로 받는다
        if (j.error === "invalid_email") {
          // 화면 검사와 같은 규칙이라 보통은 여기까지 오지 않는다(옛 화면이 캐시된 경우 등)
          const em = form?.querySelector('[name="email"]') as HTMLElement | null;
          if (em) { flagInvalid({ el: em, msg: msgs().email }); return; }
        }
        setStatus(failText(res.status, j), false);
        try { statusEl.scrollIntoView({ block: "center", behavior: "smooth" }); } catch (err2) { /* 무시 */ }
        return;
      }
      // 완료 페이지에서 "무엇을 제출했는지"를 조회 없이 보여주기 위해
      // 방금 구성한 내용을 세션에 담아 넘긴다. 완료 페이지는 정적이고 DB 를 읽지 않으므로
      // 접수번호만 아는 제3자에게 연락처·공정 정보가 노출될 표면이 없다.
      const doneData = {
        id: j.id ?? "",
        at: new Date().toISOString(),
        product: String(data.productName ?? ""),
        name: String(data.name ?? ""),
        company: String(data.company ?? ""),
        email: String(data.email ?? ""),
        phone: String(data.phone ?? ""),
        material: String(data.material ?? ""),
        method: String(data.method ?? ""),
        substrate: String(data.substrate ?? ""),
        details: String(data.details ?? ""),
        // 이번 접수로 견적 개정이 저장됐을 때만 완료 페이지가 조회 API 를 부른다(스위치 꺼짐이면 호출 없음)
        quote: j.quote === true,
        // 접수 확인 메일이 나갈 건일 때만 완료 페이지가 '확인 메일을 보내드렸습니다'를 띄운다(서버 판정 — api/inquiry.ts ack)
        ack: j.ack === true,
        // 완료 화면 [요청서 인쇄] — 다운로드와 같은 데이터(접수번호만 채워진다).
        // 이미 접수된 뒤라, 여기서 오류가 나도 '전송 실패'로 보이면 안 된다(중복 접수 유도) → 실패하면 요청서만 생략
        doc: (() => { try { return j.id ? requestDoc(data, j.id) : null; } catch { return null; } })(),
      };
      form.reset();
      // 공정 빌더는 풀 모드에만 존재 — simple(웨이퍼 주문) 폼에서는 null 이라
      // 여기서 예외가 나면 "성공했는데 실패 메시지"가 뜨는 버그가 됨 (가드 필수)
      if (listEl) {
        listEl.innerHTML = "";
        refreshStepLabels();
      }
      resetTurnstile();
      if (j.id) {
        // 주문 흐름과 같은 규칙(PRG): 접수번호가 보이는 완료 페이지로 이동하고,
        // 제출이 성공한 폼 페이지는 히스토리에서 제거한다.
        try { sessionStorage.setItem("vanam_quote_done", JSON.stringify(doneData)); } catch (err2) { /* 세션 불가 — 완료 페이지가 접수번호만 표시 */ }
        const base = document.documentElement.lang === "ko" ? "/ko" : "";
        leaving = true;
        location.replace(`${base}/quote/done?id=${encodeURIComponent(j.id)}`);
        return;
      }
      // 구버전 응답(id 없음) 폴백 — 인라인 성공 안내
      setStatus(M.msgSuccess!, true);
      try { statusEl.scrollIntoView({ block: "center", behavior: "smooth" }); } catch (err2) { /* 무시 */ }
    } catch (err) {
      // 접수 뒤 화면 정리 중 오류 — 여기까지 왔다면 서버는 이미 받았다. 다시 누르게 하지 않는다.
      console.error(err);
      setStatus(M.msgSuccess!, true);
    } finally {
      if (!leaving) {
        sending = false;
        btn.disabled = false;
        label.textContent = M.labelSend!;
      }
    }
  });

  // ── 견적 요청서 다운로드 — 서버로 보내지 않는다 ──────────────────────────────
  // 작성한 내용 그대로 견적 요청서(엑셀 틀)를 새 창에 띄운다. 고객이 PDF 로 저장해 두었다가
  // 원할 때 메일로 보낼 수 있게 하는 용도다. 접수번호가 없으므로 "아직 접수되지 않음"을 명시한다.
  // 내용 조립은 '견적 요청'과 **같은 buildQuote()** 를 쓴다(두 벌로 나뉘면 반드시 어긋난다).
  printBtn?.addEventListener("click", () => {
    if (!form) return;
    // ⚠️ 여기서 form.reportValidity() 를 부르지 않는다.
    //    버튼 게이트가 이미 필수 항목(동의·보안확인 제외)과 공정 시퀀스를 확인했고,
    //    예전 방식(개인정보 동의의 required 를 잠깐 내렸다 올리기)은
    //    BaseLayout 의 전역 invalid 핸들러가 setCustomValidity 로 남긴 문구가
    //    지워지지 않아 '계속하려면 동의해 주세요' 가 계속 뜨는 문제가 있었다.
    //    (setCustomValidity 는 required 와 무관하게 요소를 계속 invalid 로 만든다)
    { const bad = collectIssues(false); if (bad) { flagInvalid(bad); return; } }
    const built = buildQuote();
    if (!built) return;
    // 연락처는 고객이 직접 저장·발송하는 문서이므로 채워서 낸다(브라우저에 남기지 않는다).
    if (!openDoc(buildRequestDoc(requestDoc(built.data, "")))) setStatus(M.msgPopup || "", false);
  });
</script>
