---
// 견적가 상품 전용 견적 요청 폼.
// 상품 상세 페이지의 한 섹션으로 들어간다(모달 아님). 위쪽 "견적 요청" 버튼이 여기로 스크롤한다.
// #quote 앵커가 있으므로 메일·광고에서 폼으로 바로 링크할 수 있다.
import { getCollection } from 'astro:content';
import siteData from '../data/site.json';

const { product, productName } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = siteData[locale] ?? siteData.en;
const c = site.contact.form;   // 연락처 필드 라벨 (문의 폼과 공용 — 번역 재사용)
const q = site.quote.form;     // 견적 전용

const materials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const grouped = (['Oxide', 'Nitride', 'Metal'] as const)
  .map((cat) => ({ cat, items: materials.filter((m) => m.data.category === cat) }))
  .filter((g) => g.items.length > 0);

const methods = [
  { value: 'PVD (Sputtering / Evaporation)', label: q.methodPvd },
  { value: 'ALD', label: q.methodAld },
  { value: 'Undecided', label: q.methodOther },
];

const inputClass =
  'mt-2 w-full rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3 text-ink placeholder-ink/30 outline-none transition focus:border-accent focus:ring-1 focus:ring-accent';
const labelClass = 'block text-sm font-medium text-ink/80';
const legendClass = 'text-sm font-medium uppercase tracking-widest text-accent';
---

<section id="quote" class="mt-20 scroll-mt-24 border-t border-ink/10 pt-16">
  <div class="max-w-3xl">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">{q.title}</p>
    <h2 class="mt-4 text-3xl font-bold leading-tight text-ink">{productName}</h2>
    <p class="mt-4 text-base leading-relaxed text-ink/60">{q.intro}</p>

    <form id="quote-form" class="mt-12 space-y-12"
      data-product={product.id}
      data-product-name={productName}
      data-msg-honeypot={c.msgHoneypot}
      data-msg-success={q.msgSuccess}
      data-msg-error={c.msgError}
      data-msg-required={c.msgRequired}
      data-msg-captcha={c.msgCaptcha}
      data-label-send={q.submit}
      data-label-sending={c.sending}>
      <!-- Honeypot: hidden from humans (spam trap) -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label>{c.honeypot}
          <input type="text" name="vanam_hp_email" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <fieldset>
        <legend class={legendClass}>{c.sectionContact}</legend>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <label for="q-name" class={labelClass}>{c.name}</label>
            <input id="q-name" name="name" type="text" required class={inputClass} placeholder={c.namePlaceholder} />
          </div>
          <div>
            <label for="q-email" class={labelClass}>{c.email}</label>
            <input id="q-email" name="email" type="email" required class={inputClass} placeholder={c.emailPlaceholder} />
          </div>
          <div>
            <label for="q-phone" class={labelClass}>{c.phone}</label>
            <input id="q-phone" name="phone" type="tel" class={inputClass} placeholder={c.phonePlaceholder} />
          </div>
          <div>
            <label for="q-company" class={labelClass}>{c.company}</label>
            <input id="q-company" name="company" type="text" class={inputClass} placeholder={c.companyPlaceholder} />
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend class={legendClass}>{q.sectionSpec}</legend>
        <div class="mt-6 space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-material" class={labelClass}>{q.material}</label>
              <select id="q-material" name="material" required class={inputClass}>
                <option value="" disabled selected>{q.materialPlaceholder}</option>
                {grouped.map((g) => (
                  <optgroup label={g.cat}>
                    {g.items.map((m) => <option value={m.data.formula}>{m.data.formula}</option>)}
                  </optgroup>
                ))}
                <option value="__other__">{q.materialOther}</option>
              </select>
            </div>
            <div>
              <label for="q-method" class={labelClass}>{q.method}</label>
              <select id="q-method" name="method" class={inputClass}>
                <option value="" selected>{q.methodPlaceholder}</option>
                {methods.map((m) => <option value={m.value}>{m.label}</option>)}
              </select>
            </div>
          </div>

          <!-- 소재에서 "기타"를 고를 때만 노출 -->
          <div id="q-other-wrap" hidden>
            <label for="q-material-other" class={labelClass}>{q.materialOtherLabel}</label>
            <input id="q-material-other" name="materialOther" type="text" class={inputClass} placeholder={q.materialOtherPlaceholder} />
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-substrate" class={labelClass}>{q.substrate}</label>
              <input id="q-substrate" name="substrate" type="text" class={inputClass} placeholder={q.substratePlaceholder} />
            </div>
            <div>
              <label for="q-thickness" class={labelClass}>{q.thickness}</label>
              <input id="q-thickness" name="thickness" type="text" class={inputClass} placeholder={q.thicknessPlaceholder} />
            </div>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend class={legendClass}>{q.sectionSchedule}</legend>
        <div class="mt-6 space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="q-quantity" class={labelClass}>{q.quantity}</label>
              <input id="q-quantity" name="quantity" type="text" class={inputClass} placeholder={q.quantityPlaceholder} />
            </div>
            <div>
              <label for="q-deadline" class={labelClass}>{q.deadline}</label>
              <input id="q-deadline" name="deadline" type="text" class={inputClass} placeholder={q.deadlinePlaceholder} />
            </div>
          </div>
          <div>
            <label for="q-details" class={labelClass}>{q.details}</label>
            <textarea id="q-details" name="details" rows="5" class={`${inputClass} resize-y`} placeholder={q.detailsPlaceholder}></textarea>
            <p class="mt-2 text-xs leading-relaxed text-ink/40">{q.attachmentNote}</p>
          </div>
        </div>
      </fieldset>

      <div class="space-y-6 border-t border-ink/10 pt-8">
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink/70">
          <input type="checkbox" name="privacy" required value="agreed"
            class="mt-0.5 size-4 shrink-0 rounded border-ink/20 bg-ink/[0.03] accent-brand" />
          <span>{q.privacy}</span>
        </label>

        {/* Turnstile 봇 검증 위젯 */}
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAAD2FGmnAciuP8Mbo"
          data-theme="auto"
          data-language="auto"
        ></div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" id="quote-submit"
            class="inline-flex items-center gap-2 rounded-lg bg-brand px-7 py-3 font-semibold text-onbrand transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
            <span id="quote-submit-label">{q.submit}</span>
          </button>
          <p id="quote-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>
  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Turnstile 전역 API 타입 (api.js 가 window.turnstile 을 주입한다)
  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }

  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("quote-status")!;
  const btn = document.getElementById("quote-submit") as HTMLButtonElement;
  const label = document.getElementById("quote-submit-label")!;
  const materialSel = document.getElementById("q-material") as HTMLSelectElement | null;
  const otherWrap = document.getElementById("q-other-wrap") as HTMLElement | null;
  const otherInput = document.getElementById("q-material-other") as HTMLInputElement | null;
  const M = form ? form.dataset : ({} as DOMStringMap);

  function setStatus(msg: string, ok: boolean) {
    statusEl.textContent = msg;
    statusEl.style.color = ok ? 'var(--color-accent)' : 'var(--color-danger)';
  }

  // 상단 "견적 요청" 버튼 → 폼으로 부드럽게 스크롤 + 첫 칸에 포커스
  document.querySelectorAll("[data-open-quote]").forEach((el) =>
    el.addEventListener("click", (e) => {
      e.preventDefault();
      const target = document.getElementById("quote");
      target?.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => (document.getElementById("q-name") as HTMLInputElement | null)?.focus({ preventScroll: true }), 500);
    }),
  );

  // 소재 "기타" 선택 시 직접 입력 칸을 연다
  materialSel?.addEventListener("change", () => {
    const isOther = materialSel.value === "__other__";
    if (otherWrap) otherWrap.hidden = !isOther;
    if (otherInput) {
      otherInput.required = isOther;
      if (!isOther) otherInput.value = "";
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 허니팟이 채워졌으면 봇 → 조용히 성공한 척
    const hp = form.elements.namedItem("vanam_hp_email") as HTMLInputElement | null;
    if (hp && hp.value.trim() !== "") {
      setStatus(M.msgHoneypot!, true);
      form.reset();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    delete data.vanam_hp_email;

    if (data.material === "__other__") {
      if (!otherInput?.value.trim()) {
        setStatus(M.msgRequired!, false);
        return;
      }
      data.material = otherInput.value.trim();
    }
    delete data.materialOther;

    data.type = "quote";
    data.product = M.product!;
    data.productName = M.productName!;
    data.locale = document.documentElement.lang || "en";

    // Turnstile 토큰 확인 (FormData 가 cf-turnstile-response 를 자동 수집한다)
    if (!data["cf-turnstile-response"]) {
      setStatus(M.msgCaptcha!, false);
      return;
    }

    btn.disabled = true;
    label.textContent = M.labelSending!;
    setStatus("", true);

    try {
      const res = await fetch("/api/inquiry", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      form.reset();
      if (otherWrap) otherWrap.hidden = true;
      window.turnstile?.reset();
      setStatus(M.msgSuccess!, true);
    } catch (err) {
      console.error(err);
      window.turnstile?.reset();
      setStatus(M.msgError!, false);
    } finally {
      btn.disabled = false;
      label.textContent = M.labelSend!;
    }
  });
</script>
