---
// 특허·인증서 갤러리 — 가로 한 줄 캐러셀.
// 작은 썸네일을 가로로 나열하고, 항목이 많으면 좌우 화살표로 스크롤한다.
// (클릭 확대/라이트박스 기능은 없음 — 번호 확인 위주의 간결한 진열)
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { eyebrow, heading, subheading, prevLabel, nextLabel, swipeLabel } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const isKo = locale === 'ko';

const certImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/certificates/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const certs = (await getCollection('certificates'))
  .filter((c) => c.data.published && certImages[c.data.image])
  .sort((a, b) => a.data.order - b.data.order);

const label = (c) => (isKo ? c.data.name : (c.data.name_en ?? c.data.name));
const kindLabel = (k: string) =>
  isKo ? (k === 'patent' ? '특허' : '인증') : (k === 'patent' ? 'Patent' : 'Certification');
---

{certs.length > 0 && (
  <section id="patent" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="v-reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          {eyebrow && <p class="mb-3 font-mono text-xs tracking-[0.16em] text-accent">{eyebrow}</p>}
          <h2 class="text-3xl font-semibold text-ink">{heading}</h2>
          {subheading && <p class="mt-3 text-base text-ink/55">{subheading}</p>}
        </div>
        <!-- 좌우 이동 버튼 (스크롤할 내용이 있을 때만 활성) -->
        <div id="cert-nav" class="hidden gap-2 max-md:!hidden">
          <button type="button" id="cert-prev" aria-label={prevLabel}
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/15 text-ink/60 transition hover:border-accent hover:text-accent disabled:opacity-30 disabled:hover:border-ink/15 disabled:hover:text-ink/60">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" id="cert-next" aria-label={nextLabel}
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/15 text-ink/60 transition hover:border-accent hover:text-accent disabled:opacity-30 disabled:hover:border-ink/15 disabled:hover:text-ink/60">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <!-- 가로 스크롤 트랙 -->
      <ul id="cert-track" class="v-reveal mt-10 flex snap-x gap-5 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {certs.map((c) => {
          const img = certImages[c.data.image].default;
          return (
            <li class="shrink-0 snap-start">
              <div class="w-[170px]">
                <div class="overflow-hidden rounded-lg border border-ink/10 bg-plate">
                  <Image src={img} alt={label(c)} width={340} height={481}
                    class="h-auto w-full object-contain" />
                </div>
                <div class="mt-3 flex items-center justify-between gap-2">
                  <p class="text-[11px] font-medium uppercase tracking-widest text-accent">{kindLabel(c.data.kind)}</p>
                  {c.data.country && (
                    <span class="rounded border border-ink/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-ink/60">{c.data.country}</span>
                  )}
                </div>
                <p class="mt-1 text-sm font-medium leading-snug text-ink/80 break-words">{label(c)}</p>
                {c.data.number && <p class="mt-0.5 text-xs text-ink/50 break-words">{c.data.number}</p>}
              </div>
            </li>
          );
        })}
      </ul>

      <!-- 모바일 스와이프 안내 — 데스크톱은 화살표가 있지만 모바일은 없어서
           "좌우로 넘길 수 있다"는 신호가 필요하다. 트랙이 실제로 넘칠 때만 보이고,
           한 번 넘기면 사라진다. (md 이상에서는 항상 숨김) -->
      {swipeLabel && (
        <p id="cert-swipe" class="mt-4 hidden items-center gap-2 text-xs text-ink/45 transition-opacity duration-300 md:!hidden" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 8l-4 4 4 4"/><path d="M17 8l4 4-4 4"/><path d="M4 12h16"/></svg>
          {swipeLabel}
        </p>
      )}
    </div>
  </section>
)}

<script>
  // 가로 캐러셀: 화살표로 한 화면씩 스크롤. 트랙이 넘칠 때만 화살표를 보인다.
  const track = document.getElementById('cert-track');
  const nav = document.getElementById('cert-nav');
  const prev = document.getElementById('cert-prev') as HTMLButtonElement | null;
  const next = document.getElementById('cert-next') as HTMLButtonElement | null;

  if (track && nav && prev && next) {
    const overflowing = () => track.scrollWidth > track.clientWidth + 4;

    function updateArrows() {
      if (!overflowing()) { nav.classList.add('hidden'); nav.classList.remove('flex'); return; }
      nav.classList.remove('hidden'); nav.classList.add('flex');
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    }

    const step = () => Math.max(track.clientWidth * 0.8, 200);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    updateArrows();

    // ── 모바일 스와이프 신호 ────────────────────────────────────────────
    // 화살표가 없는 모바일에서는 넘길 수 있다는 걸 알 방법이 없다.
    // ① 트랙이 넘칠 때만 안내 문구를 띄우고 ② 화면에 들어오면 한 번 살짝 밀었다 되돌린다.
    // 되돌리는 동안의 스크롤 이벤트로 안내가 사라지지 않도록 nudging 플래그로 구분한다.
    const swipe = document.getElementById('cert-swipe');
    let nudging = false;

    if (swipe && overflowing()) { swipe.classList.remove('hidden'); swipe.classList.add('flex'); }
    track.addEventListener('scroll', () => {
      if (!nudging && swipe && track.scrollLeft > 8) swipe.style.opacity = '0';
    }, { passive: true });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (isMobile && !reduceMotion && overflowing()) {
      const io = new IntersectionObserver((es) => {
        if (!es[0].isIntersecting) return;
        io.disconnect();
        nudging = true;
        setTimeout(() => {
          track.scrollTo({ left: 46, behavior: 'smooth' });
          setTimeout(() => track.scrollTo({ left: 0, behavior: 'smooth' }), 520);
          setTimeout(() => { nudging = false; }, 1100);
        }, 420);
      }, { threshold: 0.3 });
      io.observe(track);
    }
  }
</script>
