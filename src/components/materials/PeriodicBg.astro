// 본표 6·7주기 3족의 자리표시(그 자리에 f-블록이 들어간다는 표기)
const PLACE: [number, number, string][] = [[6, 3, '57-71'], [7, 3, '89-103']];

// 우리 소재군(산화물·질화물·금속)과 맞닿은 원소만 은은히 강조
const HL = new Set(['O', 'N', 'Al', 'Si', 'Ti', 'Zr', 'Hf', 'Ta', 'W']);

const S = 10.4;      // 셀 간격
const C = 10.0;      // 셀 크기
const GAP = 4.6;     // 본표와 f-블록 사이 여백
const x = (g: number) => (g - 1) * S;
const y = (p: number) => (p - 1) * S + (p >= 8 ? GAP : 0);
// 긴 이름(Praseodymium·Rutherfordium 등)이 셀 밖으로 나가지 않도록 글자 크기를 줄인다
const nameSize = (n: string) => (n.length > 11 ? 1.02 : n.length > 9 ? 1.16 : 1.3);
const ALL: Cell[] = [...CELLS, ...FCELLS];
---
<svg viewBox="0 0 187 99" class="h-full w-full" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
  {/* 셀 배경·테두리 — 강조 원소만 옅게 채운다 */}
  {ALL.map((c) => (
    <rect x={x(c[1])} y={y(c[0])} width={C} height={C} rx="1.1"
      fill="currentColor" fill-opacity={HL.has(c[3]) ? 0.16 : 0}
      stroke="currentColor" stroke-opacity="0.85" stroke-width="0.5" />
  ))}
  {/* 원자번호 (좌상단) */}
  {ALL.map((c) => (
    <text x={x(c[1]) + 0.9} y={y(c[0]) + 2.7} font-size="1.9" fill="currentColor">{c[2]}</text>
  ))}
  {/* 원소기호 (가운데, 크게) */}
  {ALL.map((c) => (
    <text x={x(c[1]) + C / 2} y={y(c[0]) + 6.4} text-anchor="middle" font-size="4.3" font-weight="700" fill="currentColor">{c[3]}</text>
  ))}
  {/* 원소 이름 */}
  {ALL.map((c) => (
    <text x={x(c[1]) + C / 2} y={y(c[0]) + 8.1} text-anchor="middle" font-size={nameSize(c[4])} fill="currentColor">{c[4]}</text>
  ))}
  {/* 원자량 */}
  {ALL.map((c) => (
    <text x={x(c[1]) + C / 2} y={y(c[0]) + 9.5} text-anchor="middle" font-size="1.3" fill="currentColor">{c[5]}</text>
  ))}
  {/* 6·7주기 3족 자리표시 */}
  {PLACE.map((q) => (
    <rect x={x(q[1])} y={y(q[0])} width={C} height={C} rx="1.1" fill="none" stroke="currentColor" stroke-opacity="0.85" stroke-width="0.5" />
  ))}
  {PLACE.map((q) => (
    <text x={x(q[1]) + C / 2} y={y(q[0]) + 6.0} text-anchor="middle" font-size="2.4" font-weight="600" fill="currentColor">{q[2]}</text>
  ))}
  {/* f-블록 좌측 라벨 */}
  <text x={x(3) - 1.6} y={y(8) + 5.9} text-anchor="end" font-size="2.1" font-weight="600" fill="currentColor">Lanthanides</text>
  <text x={x(3) - 1.6} y={y(9) + 5.9} text-anchor="end" font-size="2.1" font-weight="600" fill="currentColor">Actinides</text>
</svg>
